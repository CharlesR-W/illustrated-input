          "pos": "prep.",
          "en": "to; for"
        }
      ]
    },
    "cy-brenin-01-l22-s085": {
      "text": "\"Wel, mae Cai'n dweud ein bod ni'n mynd yn y cwch,\" meddai Elen yn dawel, \"felly dyn ni'n mynd yn y cwch.\"",
      "items": [
        {
          "text": "ein bod ni",
          "lemma": "bod",
          "pos": "phr.",
          "en": "that we are"
        },
        {
          "text": " yn ",
          "lemma": "yn",
          "pos": "prep.",
          "en": "in"
        },
        {
          "text": " yn ",
          "lemma": "yn",
