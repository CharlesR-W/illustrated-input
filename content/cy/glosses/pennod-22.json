      ]
    },
    "cy-brenin-01-l22-s094": {
      "text": "\"Dw i'n meddwl ei fod e'n dod o'r afon.\"",
      "items": [
        {
          "text": "ei fod e",
          "lemma": "bod",
          "pos": "phr.",
          "en": "that he is"
        }
      ]
    },
    "cy-brenin-01-l22-s095": {
      "text": "\"Dafarnwr!\" meddai Cynyr yn uchel.",
