    },
    "cy-brenin-01-l22-s103": {
      "text": "\"Dw i'n gobeithio eich bod chi'n hoffi dŵr!\"",
      "items": [
        {
          "text": "eich bod chi'n hoffi",
          "lemma": "hoffi",
          "pos": "phr.",
          "en": "that you like"
        }
      ]
    },
    "cy-brenin-01-l22-s104": {
      "text": "\"Felly byddwn ni'n mynd yn y cwch,\" meddai Elen, a gwenodd hi ar Cai.",
