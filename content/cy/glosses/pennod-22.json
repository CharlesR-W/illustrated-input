          "form": "predicative",
          "en": "links to a description"
        }
      ]
    },
    "cy-brenin-01-l22-s079": {
      "text": "\"Dwy geiniog y ceffyl, a cheiniog y plentyn.\"",
      "items": [
        {
          "text": " y ",
