          "form": "adverbial",
          "en": "marks manner"
        }
      ]
    },
    "cy-brenin-01-l22-s099": {
      "text": "\"Mae dyn y cwch yn dweud hynny wrth bob teithiwr: mae e'n gwerthu teithiau yn ei gwch e.\"",
      "items": [
        {
          "text": " yn",
          "lemma": "yn",
