          "pos": "prep.",
          "en": "in"
        }
      ]
    },
    "cy-brenin-01-l22-s100": {
      "text": "\"Wrth gwrs, dyw dyn y cwch ddim yn lleidr: mae ei gwch e'n dda.\"",
