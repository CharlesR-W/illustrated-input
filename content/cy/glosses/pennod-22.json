          "en": "I was"
        }
      ]
    },
    "cy-brenin-01-l22-s108": {
      "text": "\"Dw i ddim yn sôn am y chwe cheiniog, Cai,\" meddai Elen, ond roedd hi'n gwenu.",
      "items": [
        {
          "text": "sôn am",
          "lemma": "sôn am",
          "pos": "phr.",
          "en": "talk about"
        }
      ]
    },
    "cy-brenin-01-l22-s112": {
      "text": "\"Os wyt ti yn yr het, byddi di'n sych, Dafi,\" meddai Myrddin.",
