          "en": "in"
        }
      ]
    },
    "cy-brenin-01-l22-s074": {
      "text": "\"Os bydd lladron ar y bont, byddan nhw'n cymryd y ceffylau!\" meddai Cai yn gyflym.",
      "items": [
        {
          "text": " yn ",
          "lemma": "yn",
          "pos": "part.",
          "form": "adverbial",
          "en": "marks manner"
        }
      ]
    },
    "cy-brenin-01-l22-s078": {
      "text": "\"Mae cwch mawr ar Afon Wysg, ac mae dyn y cwch yn ddyn da iawn.\"",
