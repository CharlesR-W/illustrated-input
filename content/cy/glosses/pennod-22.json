          "pos": "art.",
          "en": "per"
        }
      ]
    },
    "cy-brenin-01-l22-s081": {
      "text": "\"Dw i'n credu bod y bont yn ddiogel.\"",
      "items": [
        {
          "text": " yn ",
          "lemma": "yn",
          "pos": "part.",
          "form": "predicative",
          "en": "links to a description"
        }
      ]
    },
    "cy-brenin-01-l22-s084": {
      "text": "Talodd Cai chwe cheiniog i'r dyn, a chuddiodd y dyn yr arian dan ei glogyn e.",
