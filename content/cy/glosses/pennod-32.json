    },
    "cy-brenin-01-l32-s049": {
      "text": "\"Ro't ti'n dywysog ddoe hefyd,\" meddai Myrddin, ac roedd e'n gwenu. \"Ond doedd Arth ddim yn gwybod.\"",
      "items": [
