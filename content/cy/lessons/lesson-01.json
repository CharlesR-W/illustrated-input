  "learning_contract": {
    "primary_new_grammar": {
      "id": "G01",
      "label": "Mae + subject + yn/'n + place or description",
      "description": "Use mae to locate or describe a named subject. Before an adjective, yn causes soft mutation: bach → fach, mawr → fawr, coch → goch.",
      "minimum_demonstrations": 12
    },
    "recycled_grammar": [],
    "incidental_grammar": [
      {
        "form": "y / 'r",
        "note": "The definite article is made inferable through repeated labelled images; productive choice among y/yr/'r is deferred."
      },
      {
        "form": "a",
        "note": "Coordination appears once with a visual plus sign and is not tested productively."
      }
    ],
    "communicative_goals": [
      "identify a dragon, dog, box, and library",
      "say where a named character or object is",
      "understand three visually grounded descriptions"
    ],
    "new_lexeme_ids": [
      "cy-mae",
