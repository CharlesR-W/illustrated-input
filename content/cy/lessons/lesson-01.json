  "learning_contract": {
    "primary_new_grammar": {
      "id": "G01",
      "label": "Mae + subject + yn/'n + place or description",
      "description": "Use mae to locate or describe a named subject. Before a description, yn causes soft mutation: bach → fach, mawr → fawr, coch → goch.",
      "minimum_demonstrations": 6
    },
    "recycled_grammar": [],
    "incidental_grammar": [
      {
        "form": "y / 'r",
        "note": "The definite article is established through repeated labelled diagrams; productive choice among its forms is deferred."
      },
      {
        "form": "a",
        "note": "Coordination is established by a two-to-one visual diagram and is not a production target."
      }
    ],
    "communicative_goals": [
      "identify a dragon, dog, box, and library",
      "locate a named person, animal, or object",
      "understand descriptions of size and colour"
    ],
    "new_lexeme_ids": [
