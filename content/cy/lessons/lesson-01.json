  "grammar_observation": {
    "target_language": "Mae Mali yn y llyfrgell. Mae Dafi yn y bocs. Mae'r bocs yn fawr. Mae Dafi'n fach. Mawr → fawr; bach → fach; coch → goch.",
    "bridge_language": "Here mae … yn/'n … locates or describes. Before a description, yn soft-mutates the following word; after a vowel, it normally contracts to 'n."
  },
  "pensa": {
    "a": {
      "id": "cy-draig-01-l01-pa",
      "title": "Pensa A — Y patrwm",
      "directions": "Cwblhewch y patrwm. Complete the pattern.",
      "items": [
        {
          "id": "pa1",
          "prompt": "Mae Mali ___ y llyfrgell.",
          "type": "cloze",
          "accepted_answers": ["yn"],
          "explanation": "A place phrase uses yn."
        },
        {
          "id": "pa2",
          "prompt": "Mae Dafi___ fach.",
          "type": "cloze",
          "accepted_answers": ["'n", "’n"],
          "explanation": "After the vowel in Dafi, yn contracts to 'n."
        },
        {
          "id": "pa3",
          "prompt": "Mae'r bocs yn ___. (mawr)",
          "type": "cloze",
          "accepted_answers": ["fawr"],
          "explanation": "After descriptive yn, mawr soft-mutates to fawr."
        },
        {
          "id": "pa4",
          "prompt": "Mae Dafi'n ___. (coch)",
          "type": "cloze",
          "accepted_answers": ["goch"],
          "explanation": "After descriptive yn, coch soft-mutates to goch."
        }
      ]
    },
