      "title": "Pensa C — Y stori",
      "directions": "Atebwch yn Gymraeg. Answer in Welsh; a short answer is enough.",
      "items": [
        {
          "id": "pc1",
          "prompt": "Dafi: yn y bocs / yn y llyfrgell?",
