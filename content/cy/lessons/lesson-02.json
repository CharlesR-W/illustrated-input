  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l02-s01",
        "title": "Mali a Dafi",
        "segments": [
          {
            "id": "cy-draig-01-l02-s001",
            "text": "Mae Mali yn y llyfrgell. Mae Dafi yn y bocs mawr. Mae Pero yn y llyfrgell.",
            "lexeme_ids": [
              "cy-mali",
              "cy-dafi",
              "cy-pero"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-library-introductions",
                "presentation": "inline_scene",
                "src": "media/images/cy-l02-library-introductions.svg",
                "alt": "In the warm library, Mali crouches by the open box while tiny red Dafi introduces himself; Pero barks beside an open old book showing an unidentified sleeping boy.",
                "covers_lexeme_ids": [
                  "cy-mali",
                  "cy-dafi",
                  "cy-pero"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s002",
            "text": "Mae Pero'n gi mawr. Mae Dafi'n ddraig fach goch. Mae Pero'n fawr. Mae Dafi'n fach.",
            "lexeme_ids": [
              "cy-pero",
              "cy-dafi"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s006",
            "text": "“Pwy wyt ti?” Mae Mali yn y llyfrgell. Mae Dafi yn y bocs. “Dafi dw i.”",
            "lexeme_ids": [
              "cy-pwy",
              "cy-wyt",
              "cy-ti",
              "cy-mali",
              "cy-dafi",
              "cy-dw",
              "cy-i-pron"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-speaker-arrows",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l02-speaker-arrows.svg",
                "alt": "Speaker arrows contrast Dafi pointing to himself for Dafi dw i with Dafi pointing to Mali for Pwy wyt ti?",
                "covers_lexeme_ids": [
                  "cy-dw",
                  "cy-i-pron",
                  "cy-wyt",
                  "cy-ti",
                  "cy-pwy"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s011",
            "text": "“Pwy wyt ti?” Mae Dafi yn y bocs. Mae Mali yn y llyfrgell. “Mali dw i.”",
            "lexeme_ids": [
              "cy-pwy",
              "cy-wyt",
              "cy-ti",
              "cy-dafi",
              "cy-mali",
              "cy-dw",
              "cy-i-pron"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s012",
            "text": "“Mali?” “Mali dw i.” Mae Mali yn y llyfrgell, a mae Dafi yn y bocs mawr.",
            "lexeme_ids": [
              "cy-mali",
              "cy-dafi",
              "cy-dw",
              "cy-i-pron"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-name-cards",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l02-name-cards.svg",
                "alt": "Three clear name cards pair Mali, Dafi, and Pero with their silhouettes; each card is headed enw.",
                "covers_lexeme_ids": [
                  "cy-enw",
                  "cy-mali",
                  "cy-dafi",
                  "cy-pero"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s013",
            "text": "Enw'r ddraig: Dafi.",
            "lexeme_ids": [
              "cy-enw",
              "cy-dafi",
              "cy-mali",
              "cy-dw",
              "cy-i-pron"
            ],
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s02",
        "title": "Pero a Wff?",
        "segments": [
          {
            "id": "cy-draig-01-l02-s023",
            "text": "Mae Dafi yn y bocs, a mae Pero yn y llyfrgell. “Pwy wyt ti?” “Wff!”",
            "lexeme_ids": [
              "cy-dafi",
              "cy-pero",
              "cy-pwy",
              "cy-wyt",
              "cy-ti"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-pero-wff-joke",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l02-pero-wff-joke.svg",
                "alt": "Pero barks Wff; Dafi mistakenly treats Wff as the dog's name, while Mali points to a Pero name card and says Pero ydy e.",
                "covers_lexeme_ids": [
                  "cy-pero",
                  "cy-wyt",
                  "cy-ti",
                  "cy-ydy"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s027",
            "text": "“Wff wyt ti?” Mae Pero'n fawr. Mae Dafi'n fach. “Wff?” Pero: “Wff! Wff! Wff!”",
            "lexeme_ids": [
              "cy-wyt",
              "cy-ti",
              "cy-pero",
              "cy-dafi"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s030",
            "text": "“Pero ydy e.” Mae Pero'n gi mawr. “Pero?” “Wff!” “Pero ydy e: Pero.”",
            "lexeme_ids": [
              "cy-pero",
              "cy-ydy"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s031",
            "text": "“Pero wyt ti?” “Wff!” Mae Pero'n fawr, mae Dafi'n fach, a mae Mali yn y llyfrgell.",
            "lexeme_ids": [
              "cy-pero",
              "cy-wyt",
              "cy-ti",
              "cy-dafi",
              "cy-mali"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s033",
            "text": "“Dafi dw i. Pwy wyt ti?” “Wff!” “Pero ydy e.” Mae Dafi a Pero yn y llyfrgell.",
            "lexeme_ids": [
              "cy-dafi",
              "cy-dw",
              "cy-i-pron",
              "cy-pwy",
              "cy-wyt",
              "cy-ti",
              "cy-pero",
              "cy-ydy"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s035",
            "text": "Enw'r ci: Pero. Enw'r ddraig: Dafi. Enw Mali: Mali.",
            "lexeme_ids": [
              "cy-enw",
              "cy-pero",
              "cy-dafi",
              "cy-mali"
            ],
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s03",
        "title": "Pwy ydy e?",
        "segments": [
          {
            "id": "cy-draig-01-l02-s028",
            "text": "Mae Mali, Dafi a Pero yn y llyfrgell. Mae Mali'n fawr. Mae Dafi'n fach. Mae Pero'n fawr.",
            "lexeme_ids": [
              "cy-mali",
              "cy-dafi",
              "cy-pero"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s029",
            "text": "“Pwy ydy e?” Mae e'n fach. “Dafi ydy e?” “Dafi?” Mae Dafi yn y bocs. Enw?",
            "lexeme_ids": [
              "cy-pwy",
              "cy-ydy"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-unknown-sleeper",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l02-unknown-sleeper.svg",
                "alt": "An open old book contains the picture of a dark-haired sleeping boy without a name card; Dafi points at him under the question Pwy ydy e?",
                "covers_lexeme_ids": [
                  "cy-pwy",
                  "cy-ydy"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s032",
            "text": "“Dafi ydy e?” “Dafi dw i.” Mae Dafi yn y bocs. Mae Dafi'n goch. “Pwy ydy e?”",
            "lexeme_ids": [
              "cy-dafi",
              "cy-ydy",
              "cy-dw",
              "cy-i-pron"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s034",
            "text": "“Pero ydy e.” Mae Pero'n gi mawr. Mae Pero yn y llyfrgell. “Pwy ydy e?” Mae e'n fach.",
            "lexeme_ids": [
              "cy-pero",
              "cy-ydy"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s038",
            "text": "Dafi: “Pwy ydy e? Pwy ydy e?” Mae Dafi'n fach. Mae Dafi'n goch. Mae e'n fach. Enw?",
            "lexeme_ids": [
              "cy-dafi",
              "cy-pwy",
              "cy-ydy",
              "cy-enw"
            ],
            "inference_aids": []
          }
        ]
      }
    ]
