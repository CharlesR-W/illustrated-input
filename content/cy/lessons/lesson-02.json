        "title": "Mali a'r ddraig",
        "segments": [
          {
            "id": "cy-draig-01-l02-s001",
            "text": "Mae Mali yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l02-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l02-scene.png",
                "alt": "Mae Mali a Pero yn cyfarch Dafi yn y llyfrgell."
              },
              {
                "type": "image",
                "ref": "cy-l02-identity",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l02-identity.svg",
                "alt": "Pwy wyt ti? Mali dw i. Dafi dw i."
              }
            ]
          },
          {
            "id": "cy-draig-01-l02-s002",
            "text": "Mae Dafi yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s003",
            "text": "Mae Dafi'n fach ac yn goch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s004",
            "text": "Mae Mali wrth y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s005",
            "text": "Mae Dafi wrth Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s006",
            "text": "“Pwy wyt ti?” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s007",
            "text": "“Dafi dw i,” meddai'r ddraig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s008",
            "text": "Dafi yw enw'r ddraig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s009",
            "text": "Mae Mali a Dafi yn y llyfrgell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s02",
        "title": "Enw Mali",
        "segments": [
          {
            "id": "cy-draig-01-l02-s010",
            "text": "Mae Dafi'n edrych ar Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s011",
            "text": "“Pwy wyt ti?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s012",
            "text": "“Mali dw i,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s013",
            "text": "“Mali,” meddai Dafi. “Mali dw i,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s014",
            "text": "“Mali?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s015",
            "text": "“Ie. Mali dw i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s016",
            "text": "“Dafi dw i,” meddai Dafi eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s017",
            "text": "Mae Mali'n fawr; mae Dafi'n fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s018",
            "text": "Mae Mali a Dafi yn y llyfrgell fawr.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s03",
        "title": "Pero",
        "segments": [
          {
            "id": "cy-draig-01-l02-s019",
            "text": "Mae Pero yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s020",
            "text": "Mae Pero'n gi mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s021",
            "text": "Mae Pero'n edrych ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s022",
            "text": "Mae Dafi'n edrych ar Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s023",
            "text": "“Pwy wyt ti?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s024",
            "text": "“Pero,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s025",
            "text": "Pero yw enw'r ci.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s026",
            "text": "Mae Pero'n dweud, “Wff!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s027",
            "text": "“Wff wyt ti?” meddai Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s04",
        "title": "Tri enw",
        "segments": [
          {
            "id": "cy-draig-01-l02-s028",
            "text": "“Nac ydw,” meddai Pero: “Wff!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s029",
            "text": "Mae Mali yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s030",
            "text": "“Pero ydy e,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s031",
            "text": "“Pero wyt ti?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s032",
            "text": "Mae Pero'n dweud, “Wff!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s033",
            "text": "“Dafi dw i. Pwy wyt ti?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s034",
            "text": "“Mali dw i,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s035",
            "text": "Mali, Dafi a Pero: enw, enw ac enw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l02-s036",
            "text": "Mae Mali, Dafi a Pero yn y llyfrgell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l02-s05",
        "title": "Enw, nid sŵn",
        "segments": [
          {
            "id": "cy-draig-01-l02-s037",
            "text": "Mae Dafi'n edrych ar Mali. “Pwy wyt ti?” “Mali dw i.” Mae Mali'n edrych ar Dafi. “Pwy wyt ti?” “Dafi dw i.” Mae'r ddau enw'n glir: Mali a Dafi. Yna mae Pero'n dod at y bocs. Mae Dafi'n edrych ar y ci mawr. “Pwy wyt ti?” Mae Pero'n dweud “Wff!” Mae Dafi'n edrych ar Mali. “Wff wyt ti?” “Nage,” meddai Mali. “Pero ydy e.” Mae Dafi'n edrych ar Pero eto. “Pero wyt ti?” Mae Pero'n dweud “Wff!” eto. Mae Mali'n hapus, ac mae Dafi'n hapus hefyd. Dafi yw enw'r ddraig fach, Pero yw enw'r ci mawr, a Mali yw enw'r ferch. Tri chymeriad, tri enw, ac un sŵn doniol: “Wff!”",
            "inference_aids": []
          }
        ]
      }
    ]
