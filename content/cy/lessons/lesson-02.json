  "learning_contract": {
    "primary_new_grammar": {
      "id": "G02",
      "label": "dw i / wyt ti; bounded identity frames",
      "description": "Use dw i to give the speaker's identity and wyt ti to ask one person. Pwy ydy e? and X ydy e appear only as fixed third-person identity formulae.",
      "minimum_demonstrations": 10
    },
    "recycled_grammar": [
      "G01"
    ],
    "incidental_grammar": [
      {
        "form": "e",
        "note": "A visually anchored masculine pronoun for the pictured boy or a known male character. Any ydy identity use remains inside the complete curriculum-authorized Pwy ydy e? / X ydy e formula and does not license general focus grammar."
      },
      {
        "form": "Wff!",
        "note": "Pero's bark is a transparent sound effect, not productive vocabulary."
      }
    ],
    "communicative_goals": [
      "ask one person who they are",
      "give one's own name",
      "follow a comic mistaken identity",
      "recognize that the pictured person's identity is still unknown"
    ],
