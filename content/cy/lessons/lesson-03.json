  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l03-s01",
        "title": "Y bocs mawr",
        "segments": [
          {
            "id": "cy-draig-01-l03-s001",
            "text": "Mae'r bocs mawr yn y llyfrgell. Mae Mali yma. Mae Pero yma. Mae Dafi yn y bocs.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l03-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l03-scene.svg",
                "alt": "Mali kneels beside the open box in the warm library. Dafi is inside; Pero is nearby. An apple, a spoon, and two papers lie together, and one torn paper pictures Dafi beside an unnamed sleeping boy.",
                "covers_lexeme_ids": [
                  "cy-afal",
                  "cy-llwy",
                  "cy-papur"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l03-yma",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l03-yma.svg",
                "alt": "A bold arrow labelled yma points to Mali and the box in the immediate scene.",
                "covers_lexeme_ids": [
                  "cy-yma"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l03-s002",
            "text": "“Beth sydd yn y bocs?”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l03-box",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l03-box.svg",
                "alt": "A question mark points into an open box containing an apple, spoon, and papers: Beth sydd yn y bocs?",
                "covers_lexeme_ids": [
                  "cy-beth"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l03-s003",
            "text": "“Oes afal yn y bocs?” “Oes.” “Oes llwy yn y bocs?” “Oes.” “Oes papur yn y bocs?” “Oes.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l03-existence",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l03-existence.svg",
                "alt": "A contrast diagram: an apple is present, so Oes afal? Oes. A dog is absent, so Oes ci? Nac oes. Does dim ci.",
                "covers_lexeme_ids": [
                  "cy-oes",
                  "cy-dim"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l03-s004",
            "text": "“Oes ci bach yn y bocs?” “Nac oes. Does dim ci bach yn y bocs.” Mae Pero'n fawr, a Dafi'n fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s005",
            "text": "Mae un afal coch yma, un llwy fach yma, a dau bapur yma. Mae Dafi yn y bocs.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l03-count",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l03-count.svg",
                "alt": "One apple, one spoon, and two sheets of paper are arranged in a clear counting row labelled un, un, dau.",
                "covers_lexeme_ids": [
                  "cy-un",
                  "cy-dau"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "cy-draig-01-l03-s02",
        "title": "Un a dau",
        "segments": [
          {
            "id": "cy-draig-01-l03-s006",
            "text": "Mae Mali yma, a'r afal yma. Mae Dafi yn y bocs. Mae'r afal yn goch; mae Dafi'n goch hefyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l03-hefyd",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l03-hefyd.svg",
                "alt": "A red apple is shown first; then the same red apple and red Dafi appear together, with a plus sign and the Welsh word hefyd.",
                "covers_lexeme_ids": [
                  "cy-hefyd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l03-s007",
            "text": "Mae'r llwy yn y bocs. Mae Dafi yn y bocs hefyd. Mae'r llwy'n fach; mae Dafi'n fach hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s008",
            "text": "Mae papur mawr yma. Mae papur bach yma hefyd. Un papur, dau bapur. Mae dau bapur yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s009",
            "text": "Oes afal yn y bocs? Nac oes. Does dim afal yn y bocs. Mae'r afal yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s010",
            "text": "Oes papur yn y bocs? Nac oes. Does dim papur yn y bocs. Mae dau bapur yma.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l03-s03",
        "title": "Y papur",
        "segments": [
          {
            "id": "cy-draig-01-l03-s011",
            "text": "Mae'r papur mawr yma. “Beth sydd yn y bocs?” Y papur mawr: draig goch. “Dafi?” “Dafi dw i!” Mae Dafi yma hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s012",
            "text": "Mae Dafi yma. Dafi: y ddraig goch. Y papur mawr: Dafi hefyd. Dafi: draig fach goch. Papur mawr, draig fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s013",
            "text": "“Pwy ydy e?” “Dim enw.” Y papur mawr: Dafi ac e hefyd. Mae'r papur bach yn fach. Enw? Dim enw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s014",
            "text": "Mae'r papur bach yma, a'r papur mawr yma. Mae'r papur mawr yn fawr, a'r papur bach yn fach. Un papur, un papur: dau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l03-s015",
            "text": "“Beth sydd yn y bocs?” Mae Dafi yn y bocs. Mae'r papur mawr yn y bocs hefyd. “Pwy ydy e?” Dim enw.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
