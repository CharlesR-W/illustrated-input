  "learning_contract": {
    "primary_new_grammar": {
      "id": "G03",
      "label": "oes? / mae; existential questions",
      "description": "Ask whether something is present with oes and answer with oes or the fixed negative nac oes; use mae to state what is present.",
      "minimum_demonstrations": 10
    },
    "recycled_grammar": [
      "G01",
      "G02"
    ],
    "incidental_grammar": [
      {
        "form": "Beth sydd yn ...?",
        "note": "A fixed receptive G03 question formula only. It does not license productive relatives or focus constructions before G20/G29."
      },
      {
        "form": "does dim",
        "note": "A fixed negative existential counterpart, visually contrasted with mae; open production is not required."
      },
      {
        "form": "dau bapur",
        "note": "The mutation in this pictured counting chunk is lexicalised here; productive number-triggered mutation remains deferred."
      }
    ],
    "communicative_goals": [
      "understand the fixed question Beth sydd yn ...?",
      "ask whether a concrete object is present and answer positively or negatively",
      "identify one and two pictured objects",
      "notice that the torn paper shows Dafi and an unnamed sleeper"
    ],
    "new_lexeme_ids": [
