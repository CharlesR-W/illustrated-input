              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s011",
            "text": "Mae Mali'n darllen y papur. Mae Dafi eisiau darllen y papur hefyd.",
            "lexeme_ids": [
              "cy-darllen",
              "cy-eisiau"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s012",
            "text": "Mae Dafi'n edrych ar y papur, ond dydy Dafi ddim yn darllen y papur.",
            "lexeme_ids": [
              "cy-edrych",
              "cy-ond",
              "cy-ddim",
              "cy-darllen"
