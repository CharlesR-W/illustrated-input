              "cy-ond",
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s018",
            "text": "Mae Dafi eisiau darllen, ond dydy Dafi ddim yn darllen. Mae Dafi'n edrych ar Mali.",
            "lexeme_ids": [
              "cy-eisiau",
              "cy-ond",
              "cy-ddim",
              "cy-darllen",
              "cy-edrych"
            ],
            "inference_aids": []
          }
        ]
