          },
          {
            "id": "cy-draig-01-l04-s007",
            "text": "“Wyt ti'n hoffi'r afal?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s008",
            "text": "“Ydw. Dw i'n hoffi'r afal.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s009",
            "text": "Mae'r afal yn dda.",
