              }
            ]
          },
          {
            "id": "cy-draig-01-l04-s013",
            "text": "Mae'r llyfr yn y bocs. Mae Dafi'n edrych ar y llyfr.",
            "lexeme_ids": [
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s014",
            "text": "Mae Dafi eisiau darllen y llyfr. Mae Mali'n darllen y llyfr.",
            "lexeme_ids": [
              "cy-eisiau",
              "cy-darllen"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s015",
            "text": "Mae Dafi'n edrych ar y llyfr. Mae Mali'n darllen.",
            "lexeme_ids": [
              "cy-edrych",
              "cy-darllen"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s016",
            "text": "Mae Dafi'n edrych ar y llyfr mawr. Dydy Dafi ddim yn darllen.",
