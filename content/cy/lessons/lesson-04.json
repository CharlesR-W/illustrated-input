                  "cy-bwyta",
                  "cy-yfed",
                  "cy-dwr",
                  "cy-edrych",
                  "cy-darllen",
                  "cy-hoffi",
                  "cy-eisiau",
                  "cy-ond",
                  "cy-ddim",
                  "cy-da"
