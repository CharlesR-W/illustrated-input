              "cy-ddim",
              "cy-darllen"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s017",
            "text": "Mae Mali'n darllen. Ond mae Dafi'n edrych.",
            "lexeme_ids": [
