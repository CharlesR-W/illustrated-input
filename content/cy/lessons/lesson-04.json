          },
          {
            "id": "cy-draig-01-l04-s017",
            "text": "Mae'r dŵr yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s018",
            "text": "Mae Dafi yn y llyfrgell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l04-s03",
        "title": "Y llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l04-s019",
            "text": "Mae llyfr yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s020",
            "text": "Mae Mali'n darllen y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s021",
            "text": "Mae Dafi'n edrych ar Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s022",
            "text": "Mae Dafi eisiau'r llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s023",
            "text": "Mae e'n agor y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s024",
            "text": "Ond dydy Dafi ddim yn darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s025",
            "text": "Mae Dafi'n bwyta'r llyfr!",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s026",
            "text": "“Na, Dafi!” meddai Mali.",
