                  "cy-bwyta",
                  "cy-yfed",
                  "cy-dwr",
                  "cy-edrych",
                  "cy-darllen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l04-s003",
            "text": "Mae Dafi'n edrych ar yr afal. Mae Dafi'n edrych ar y llyfr.",
            "lexeme_ids": [
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s004",
            "text": "Mae Dafi eisiau'r afal. Mae Dafi'n bwyta'r afal coch.",
            "lexeme_ids": [
              "cy-eisiau",
              "cy-bwyta"
            ],
            "inference_aids": [
              {
