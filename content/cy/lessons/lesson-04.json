      {
        "id": "cy-draig-01-l04-s03",
        "title": "Yr afal a'r llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l04-s019",
            "text": "Mae Mali'n darllen y llyfr. Mae Dafi'n edrych ar y llyfr.",
            "lexeme_ids": [
              "cy-darllen",
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s020",
            "text": "Mae Dafi eisiau'r llyfr. Mae Dafi'n hoffi'r llyfr. Mae Dafi eisiau darllen.",
            "lexeme_ids": [
              "cy-eisiau",
              "cy-hoffi",
              "cy-darllen"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s021",
            "text": "Ond dydy Dafi ddim yn darllen y llyfr. Mae Dafi'n bwyta'r llyfr!",
            "lexeme_ids": [
              "cy-ond",
              "cy-ddim",
              "cy-darllen",
              "cy-bwyta"
