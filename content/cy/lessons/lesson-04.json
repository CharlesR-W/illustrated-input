          },
          {
            "id": "cy-draig-01-l04-s027",
            "text": "“Na, Dafi! Dydy llyfr ddim yn fwyd.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l04-s04",
        "title": "Darllen, nid bwyta",
        "segments": [
          {
            "id": "cy-draig-01-l04-s028",
            "text": "Dydy Dafi ddim yn bwyta'r llyfr nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s029",
            "text": "Mae Mali'n darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s030",
            "text": "Mae Dafi'n edrych ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s031",
            "text": "Mae Mali'n darllen y papur hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s032",
            "text": "Mae Dafi'n edrych ar y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s033",
            "text": "Mae e eisiau darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s034",
            "text": "Mae Dafi'n hoffi llyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s035",
            "text": "Mae e'n hoffi bwyd hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s036",
            "text": "Mae Mali'n darllen ac mae Dafi'n edrych. Mae Mali'n darllen y llyfr eto. Mae Dafi'n edrych ar Mali ac ar y llyfr. Dydy Dafi ddim yn bwyta'r llyfr nawr. Mae e'n bwyta bwyd ac yn yfed dŵr. Mae e'n hoffi'r afal a'r dŵr. Mae e eisiau darllen y llyfr hefyd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l04-s05",
        "title": "Bwyd neu lyfr?",
        "segments": [
          {
            "id": "cy-draig-01-l04-s037",
            "text": "Mae Dafi'n edrych ar yr afal coch. Mae e eisiau'r afal, ac mae e'n bwyta'r afal. Mae'r afal yn dda. Mae Pero'n edrych ar y dŵr. Mae Pero'n yfed, ac mae Dafi'n yfed hefyd. Mae'r dŵr yn dda. Mae Mali'n darllen; dydy Mali ddim yn bwyta nac yn yfed. Mae Dafi'n edrych ar y llyfr. Mae e eisiau'r llyfr, ond dydy e ddim yn darllen. Mae e'n ceisio bwyta'r llyfr. “Na, Dafi! Dydy llyfr ddim yn fwyd.” Nawr dydy Dafi ddim yn bwyta'r llyfr. Mae Mali'n darllen y llyfr yn araf, ac mae Dafi'n edrych ar y papur a'r llyfr. Mae e'n hoffi bwyd, ond mae e eisiau darllen hefyd. Yn y diwedd mae Dafi'n bwyta afal, yn yfed dŵr, ac yn edrych ar y llyfr gyda Mali.",
            "inference_aids": []
          }
        ]
      }
    ]
