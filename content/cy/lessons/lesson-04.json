      {
        "id": "cy-draig-01-l04-s01",
        "title": "Yr afal a'r dŵr",
        "segments": [
          {
            "id": "cy-draig-01-l04-s001",
            "text": "Mae Mali, Pero a Dafi yn y llyfrgell. Mae'r bocs mawr yma.",
