                  "cy-eisiau",
                  "cy-hoffi"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l04-s005",
            "text": "Mae Pero'n edrych ar Dafi.",
            "lexeme_ids": [
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s006",
            "text": "Mae Dafi'n hoffi'r afal. Mae'r afal yn dda. Mae Dafi'n hoffi'r afal coch.",
            "lexeme_ids": [
              "cy-hoffi",
              "cy-da"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s007",
            "text": "Mae Dafi eisiau dŵr. Mae Dafi'n yfed y dŵr.",
            "lexeme_ids": [
              "cy-eisiau",
              "cy-yfed",
              "cy-dwr"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s008",
            "text": "Mae Pero'n yfed y dŵr hefyd. Dydy Mali ddim yn yfed.",
            "lexeme_ids": [
              "cy-yfed",
              "cy-dwr",
              "cy-ddim"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s009",
            "text": "Mae Dafi'n hoffi'r dŵr. Mae'r dŵr yn dda. Mae Dafi'n bwyta. Mae Dafi'n yfed.",
            "lexeme_ids": [
              "cy-hoffi",
              "cy-dwr",
              "cy-da",
              "cy-bwyta",
              "cy-yfed"
            ],
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l04-s02",
        "title": "Edrych a darllen",
        "segments": [
          {
            "id": "cy-draig-01-l04-s010",
            "text": "Mae Mali'n edrych ar y papur mawr.",
