                  "cy-ddim",
                  "cy-da"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l04-s022",
            "text": "Mae Mali'n edrych ar Dafi. Mae Pero'n edrych ar Dafi.",
            "lexeme_ids": [
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s023",
            "text": "Does dim afal. Mae Dafi'n edrych ar y llyfr.",
            "lexeme_ids": [
              "cy-edrych"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s024",
            "text": "Mae afal yn dda. Ond dydy llyfr ddim yn afal.",
            "lexeme_ids": [
              "cy-da",
              "cy-ond",
              "cy-ddim"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s025",
            "text": "Dydy Dafi ddim yn bwyta'r llyfr. Mae Mali'n darllen y llyfr.",
            "lexeme_ids": [
              "cy-ddim",
              "cy-bwyta",
              "cy-darllen"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l04-s026",
            "text": "Mae Dafi'n edrych ar y llyfr. Mae Dafi eisiau darllen.",
            "lexeme_ids": [
