  "learning_contract": {
    "primary_new_grammar": {
      "id": "G04",
      "label": "mae + subject + yn + verbal noun",
      "description": "Use mae + subject + yn/'n + verbal noun to present an action in progress.",
      "minimum_demonstrations": 6
    },
    "recycled_grammar": [
      "G01",
      "G02",
      "G03"
    ],
    "incidental_grammar": [
      {
        "form": "Dydy + subject + ddim yn + verbal noun",
        "note": "A complete illustrated negative action frame paired only with the positive G04 frame. It does not license G05 yes/no questions or answers."
      },
      {
        "form": "edrych ar + object",
        "note": "The governed lexical frame for edrych is learned as one pictured chunk. Ar is not used independently or spatially before G10."
      },
      {
        "form": "mae + subject + eisiau + noun/verbal noun",
        "note": "Eisiau appears only in this fixed visually contrasted desire frame; no broader complement system is inferred."
      }
    ],
    "communicative_goals": [
      "describe someone eating, drinking, looking, or reading",
      "contrast looking at a book with reading it",
      "say what Dafi likes and wants",
      "understand that Dafi wants to read but bites the book instead"
    ],
