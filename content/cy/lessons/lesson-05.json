                "src": "media/diagrams/cy-l05-needs.svg",
                "alt": "Llwglyd, sychedig, hapus nawr."
              }
            ]
          },
          {
            "id": "cy-draig-01-l05-s002",
            "text": "Mae e ddim yn bwyta.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s003",
            "text": "Mae e ddim yn yfed.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s004",
            "text": "Mae Dafi'n edrych yn drist.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s005",
            "text": "“Ydy Dafi'n hapus?” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s006",
            "text": "Nac ydy. Dydy Dafi ddim yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s007",
            "text": "“Ydy e'n drist?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s008",
            "text": "Ydy. Mae e'n drist.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s009",
            "text": "Ond pam mae Dafi'n drist?",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l05-s02",
        "title": "Dafi llwglyd",
        "segments": [
          {
            "id": "cy-draig-01-l05-s010",
            "text": "Mae Mali'n edrych ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s011",
            "text": "“Wyt ti'n llwglyd?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s012",
            "text": "“Ydw,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s013",
            "text": "Ydy Dafi'n llwglyd?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s014",
            "text": "Ydy. Mae Dafi'n llwglyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s015",
            "text": "Mae bwyd yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s016",
            "text": "Mae afal ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s017",
            "text": "Mae Dafi eisiau bwyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s018",
            "text": "Mae'r afal wrth Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l05-s03",
        "title": "Dafi sychedig",
        "segments": [
          {
            "id": "cy-draig-01-l05-s019",
            "text": "Mae Dafi'n bwyta'r afal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s020",
            "text": "Ydy e'n hapus nawr?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s021",
            "text": "Nac ydy. Mae e'n edrych ar y dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s022",
            "text": "“Wyt ti'n sychedig?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s023",
            "text": "“Ydw. Dw i'n sychedig.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s024",
            "text": "Mae'r dŵr wrth Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s025",
            "text": "Mae Dafi'n yfed.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s026",
            "text": "Ydy Dafi'n sychedig nawr?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s027",
            "text": "Nac ydy. Dydy e ddim yn sychedig.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l05-s04",
        "title": "Hapus nawr",
        "segments": [
          {
            "id": "cy-draig-01-l05-s028",
            "text": "Mae bwyd a dŵr wrth Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s029",
            "text": "Mae e ddim yn llwglyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s030",
            "text": "Mae e ddim yn sychedig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s031",
            "text": "Ydy Dafi'n drist?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s032",
            "text": "Nac ydy.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s033",
            "text": "Ydy Dafi'n hapus?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s034",
            "text": "Ydy. Mae e'n hapus nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s035",
            "text": "Mae Mali'n hapus hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l05-s036",
            "text": "Mae Pero'n edrych ar y bwyd. Ydy Pero'n llwglyd? Ydy, mae Pero'n edrych yn llwglyd. Mae afal a dŵr yma. Ydy Pero'n sychedig? Nac ydy. Mae Pero eisiau bwyd. Mae Dafi'n edrych ar Pero. Mae Dafi'n hapus, ond dydy Pero ddim yn hapus. Pam? Mae Pero'n llwglyd. Mae Mali'n edrych ar y bwyd ac ar Pero.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l05-s05",
        "title": "Beth sydd ei angen?",
        "segments": [
          {
            "id": "cy-draig-01-l05-s037",
            "text": "Mae Dafi'n edrych yn drist. Ydy e'n hapus? Nac ydy. Ydy e'n llwglyd? Ydy: mae Dafi eisiau bwyd. Mae afal yn y bocs, ac mae Dafi'n bwyta'r afal. Ydy e'n hapus nawr? Nac ydy. Mae e'n edrych ar y dŵr. Ydy e'n sychedig? Ydy. Mae Dafi'n yfed y dŵr. Ydy e'n sychedig nawr? Nac ydy. Ydy e'n llwglyd nawr? Nac ydy. Nawr mae Dafi'n hapus. Ond mae Pero'n edrych ar y bwyd. Ydy Pero'n sychedig? Nac ydy. Ydy Pero'n llwglyd? Ydy. Mae Mali'n edrych ar Pero, ac mae Dafi'n edrych ar yr afal. Nawr mae'r ateb yn glir: dydy Pero ddim yn drist; mae Pero'n llwglyd. Mae bwyd i Pero hefyd, ac yn y diwedd mae'r ci a'r ddraig yn hapus.",
            "inference_aids": []
          }
        ]
      }
    ]
