        "segments": [
          {
            "id": "cy-draig-01-l05-s001",
            "text": "Mae Dafi yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l05-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l05-scene.svg",
