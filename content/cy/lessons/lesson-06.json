                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-mutation.svg",
                "alt": "Cath fach, cath wen, y gath fach wen."
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s002",
            "text": "Nia yw enw'r ferch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s003",
            "text": "Mae hi gyda Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s004",
            "text": "Mae Nia'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s005",
            "text": "Mae cath gyda hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s006",
            "text": "Mae'r gath yn fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s007",
            "text": "Mae'r gath yn wyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s008",
            "text": "Cath wen yw hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s009",
            "text": "Mae Nia a'r gath yn y llyfrgell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s02",
        "title": "Y gath wen",
        "segments": [
          {
            "id": "cy-draig-01-l06-s010",
            "text": "Mae'r gath wen yn edrych ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s011",
            "text": "Mae Dafi'n ddraig fach goch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s012",
            "text": "Mae'r gath yn wyn; mae Dafi'n goch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s013",
            "text": "Mae'r gath yn newydd yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s014",
            "text": "Mae'r llyfrgell yn hen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s015",
            "text": "Mae Nia'n hoffi'r hen lyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s016",
            "text": "Mae'r ferch a'r gath yn edrych ar y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s017",
            "text": "Mae'r gath fach wrth y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s018",
            "text": "“Helo,” meddai Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s03",
        "title": "Cath a chi",
        "segments": [
          {
            "id": "cy-draig-01-l06-s019",
            "text": "Mae Pero'n gi mawr du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s020",
            "text": "Mae'r gath fach wen yn edrych ar Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s021",
            "text": "Mae hi'n ofni Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s022",
            "text": "Ydy Pero'n ofni'r gath?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s023",
            "text": "Nac ydy. Mae Pero'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s024",
            "text": "Mae Pero'n edrych ar y gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s025",
            "text": "Mae'r gath yn edrych ar y ci du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s026",
            "text": "Mae'r ci mawr yn edrych ar y gath wen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s027",
            "text": "Dydy'r gath ddim yn mynd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s04",
        "title": "Cyfarfod",
        "segments": [
          {
            "id": "cy-draig-01-l06-s028",
            "text": "Mae Pero a'r gath yn cyfarfod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s029",
            "text": "Mae Pero wrth y gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s030",
            "text": "Mae’r gath wrth Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s031",
            "text": "Dydy hi ddim yn ofni nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s032",
            "text": "Mae Nia'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s033",
            "text": "Mae Mali'n hapus hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s034",
            "text": "Mae Dafi'n edrych ar y gath fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s035",
            "text": "“Cath wen, ci du, draig goch,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s036",
            "text": "Mae Nia, Mali, Pero, Dafi a'r gath yn yr hen lyfrgell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s05",
        "title": "Y gath fach wen",
        "segments": [
          {
            "id": "cy-draig-01-l06-s037",
            "text": "Mae Nia'n dod i'r llyfrgell gyda chath. Mae'r gath yn fach ac yn wyn: cath fach wen yw hi. Mae Pero'n gi mawr du, a Dafi'n ddraig fach goch. Mae'r gath fach wen yn edrych ar y ci mawr du. Mae hi'n ofni Pero. Ydy Pero'n ofni'r gath? Nac ydy. Mae Pero'n aros wrth y bocs ac yn edrych ar y gath. Mae'r gath yn edrych ar Pero hefyd. Dydy hi ddim yn rhedeg. Mae Pero a'r gath yn dod yn agosach ac yn cyfarfod wrth y bocs. Nawr dydy'r gath ddim yn ofni Pero. Mae Nia'n hapus, mae Mali'n hapus, ac mae Dafi'n hapus hefyd. Yn yr hen lyfrgell mae cath wen, ci du a draig goch. Mae'r gath yn newydd, ond mae'r llyfrgell yn hen. Mae'r tri anifail yn edrych ar ei gilydd, ac mae'r ferch newydd yn aros gyda Mali.",
            "inference_aids": []
          }
        ]
      }
    ]
