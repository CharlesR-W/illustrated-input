  "learning_contract": {
    "primary_new_grammar": {
      "id": "G06",
      "label": "feminine nouns and adjective soft mutation",
      "description": "Notice that selected adjectives undergo soft mutation after a singular feminine noun, while the same adjectives remain unmutated after a masculine noun.",
      "minimum_demonstrations": 10
    },
    "recycled_grammar": [
      "G01",
      "G02",
      "G03",
      "G04",
      "G05"
    ],
    "incidental_grammar": [
      {
        "form": "y gath; y ferch",
        "note": "The article-triggered forms are presented only with the two pictured feminine nouns. Productive mutation after the article is not separately tested."
      },
      {
        "form": "Pwy ydy hi? Nia ydy hi.",
        "note": "This remains the bounded identity formula licensed by G02 and does not introduce general focus syntax."
      }
    ],
    "communicative_goals": [
      "describe Nia's small white cat and contrast it with Pero and Dafi",
      "say who is with whom and who is afraid",
      "understand a cautious meeting among a cat, dog, and dragon",
      "recognize Nia's contrast between a new book and the old mysterious book"
    ],
