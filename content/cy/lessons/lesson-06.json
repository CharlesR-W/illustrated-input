  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l06-s01",
        "title": "Nia a'r gath",
        "segments": [
          {
            "id": "cy-draig-01-l06-s001",
            "text": "Mae Nia yn y llyfrgell gyda Mali.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-with",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-with.svg",
                "alt": "Nia stands with her white cat; Mali stands with Pero.",
                "covers_lexeme_ids": [
                  "cy-gyda",
                  "cy-hi",
                  "cy-merch"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s002",
            "text": "Mae cath gyda hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s003",
            "text": "Pwy ydy hi?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s004",
            "text": "Nia ydy hi, a mae hi'n ferch newydd yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s005",
            "text": "Mae'r ferch newydd yn hapus gyda Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s006",
            "text": "Mae'r gath yn fach ac yn wyn.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-feminine-colours",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-feminine-colours.svg",
                "alt": "A white cat is labelled cath wen, while the black-and-white dog Pero is labelled ci du; arrows show gwyn becoming wen and du becoming ddu after cath.",
                "covers_lexeme_ids": [
                  "cy-cath",
                  "cy-gwyn",
                  "cy-du"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s007",
            "text": "Mae hi'n gath fach wen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s008",
            "text": "Dydy'r gath fach wen ddim yn fawr, a dydy hi ddim yn gath ddu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s009",
            "text": "Cath fach wen gyda Nia: merch newydd gyda chath newydd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s02",
        "title": "Cyfarfod yn y llyfrgell",
        "segments": [
          {
            "id": "cy-draig-01-l06-s010",
            "text": "Mae Pero'n gi mawr du, ond mae'r gath yn fach ac yn wyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s011",
            "text": "Mae Dafi'n ddraig fach goch, ac mae e'n edrych ar y gath fach wen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s012",
            "text": "Mae'r gath fach wen yn edrych ar Pero, y ci mawr du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s013",
            "text": "Mae'r ferch, y gath, y ci, a'r ddraig yn cyfarfod yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-meeting",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-meeting.svg",
                "alt": "A girl, white cat, large dog, and small red dragon approach the old book from four sides; a central arrow ring shows that they meet.",
                "covers_lexeme_ids": [
                  "cy-cyfarfod",
                  "cy-merch",
                  "cy-cath"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s014",
            "text": "Mae Pero a'r gath yn cyfarfod, a mae Pero'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s015",
            "text": "Mae Dafi a'r gath yn cyfarfod hefyd, ond dydy Dafi ddim yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s016",
            "text": "Mae Nia gyda'r gath, a mae Mali gyda Dafi a Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s017",
            "text": "Mae Nia gyda chath wen, a mae Mali gyda chi du a draig goch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s018",
            "text": "Mae'r hen lyfr yn y bocs; mae Dafi a'r gath yn edrych ar y llyfr.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l06-scene.svg",
                "alt": "In the warm library, Nia and Mali watch as Nia's small white cat and the tiny red dragon Dafi face one another across the large old book in its box; Pero waits calmly beside them.",
                "covers_lexeme_ids": [
                  "cy-cath",
                  "cy-merch",
                  "cy-gwyn",
                  "cy-du",
                  "cy-hen",
                  "cy-ofni",
                  "cy-cyfarfod",
                  "cy-gyda",
                  "cy-hi"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s03",
        "title": "Y gath a Dafi",
        "segments": [
          {
            "id": "cy-draig-01-l06-s019",
            "text": "Mae'r gath fach wen yn edrych ar Dafi ac ar yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s020",
            "text": "Mae hi'n ofni Dafi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-fear",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-fear.svg",
                "alt": "The white cat and red dragon face each other with wide eyes; arrows marked ofni point in both directions.",
                "covers_lexeme_ids": [
                  "cy-ofni",
                  "cy-hi"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s021",
            "text": "Ydy hi'n ofni Pero hefyd?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s022",
            "text": "Nac ydy; dydy hi ddim yn ofni'r ci mawr du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s023",
            "text": "Mae Dafi'n edrych ar y gath fach wen a'r hen lyfr hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s024",
            "text": "Mae e'n ofni'r gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s025",
            "text": "Ydy Dafi'n ofni Pero?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s026",
            "text": "Nac ydy; mae Dafi'n ofni'r gath, a mae'r gath yn ofni Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s027",
            "text": "Mae Pero'n edrych ar y gath ac ar Dafi, ond mae Pero'n hapus.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l06-s04",
        "title": "Hen lyfr, llyfr newydd",
        "segments": [
          {
            "id": "cy-draig-01-l06-s028",
            "text": "Mae llyfr bach newydd yn y llyfrgell, a mae hen lyfr mawr yma.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l06-old-new-books",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l06-old-new-books.svg",
                "alt": "A crisp small new book is contrasted with the worn large old book, whose title is damaged and unreadable.",
                "covers_lexeme_ids": [
                  "cy-newydd",
                  "cy-hen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l06-s029",
            "text": "Mae Nia'n edrych ar y llyfr bach newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s030",
            "text": "Mae hi'n darllen y llyfr newydd, a mae hi'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s031",
            "text": "Ond dydy Dafi ddim yn edrych ar y llyfr newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s032",
            "text": "Mae Dafi a'r gath fach wen yn edrych ar yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s033",
            "text": "Mae Nia'n edrych ar y bocs, y papur, a'r hen lyfr hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s034",
            "text": "Ydy'r llyfr mawr yn newydd?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s035",
            "text": "Nia: “Dydy'r llyfr ddim yn newydd. Mae'r llyfr yn hen.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l06-s036",
            "text": "Mae hi'n edrych ar enw'r llyfr, ond dydy hi ddim yn darllen yr enw.",
            "inference_aids": []
          }
        ]
      }
    ]
