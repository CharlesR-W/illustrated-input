          }
        ]
      },
      {
        "id": "cy-draig-01-l07-s02",
        "title": "O'r llyfrgell",
        "segments": [
          {
            "id": "cy-draig-01-l07-s010",
            "text": "Nawr mae Dafi'n mynd o'r llyfrgell i'r stryd. Mae e'n mynd gyda Mali, Nia, Pero, a'r gath.",
            "lexeme_ids": [
              "cy-mynd",
              "cy-o",
              "cy-i-prep",
              "cy-stryd"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l07-go-come",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l07-go-come.svg",
                "alt": "From the same viewpoint, Mali moves away toward the café under mynd i'r caffi while Dafi moves from the library toward Mali under dod o'r llyfrgell.",
                "covers_lexeme_ids": [
                  "cy-mynd",
                  "cy-dod",
                  "cy-i-prep",
                  "cy-o",
                  "cy-caffi"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l07-s011",
            "text": "Mae Mali yn y stryd. Mae'r llyfrgell yma; mae'r caffi ycw. Mae Mali'n mynd i'r caffi.",
            "lexeme_ids": [
              "cy-stryd",
              "cy-caffi",
              "cy-mynd",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s012",
            "text": "Ond mae Dafi'n edrych yn ôl. Mae e'n edrych ar ddrws y llyfrgell. Mae'r drws yn agor. Mae Dafi'n mynd yn ôl i'r llyfrgell.",
            "lexeme_ids": [
              "cy-yn-ol",
              "cy-drws",
              "cy-agor",
              "cy-mynd",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s013",
            "text": "Mae Dafi'n agor y drws. Mae e'n mynd i'r llyfrgell ac yn edrych ar yr hen lyfr.",
            "lexeme_ids": [
              "cy-agor",
              "cy-drws",
              "cy-mynd",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s014",
            "text": "Mae Dafi'n cau'r drws, yn dod o'r llyfrgell, ac yn mynd i'r caffi.",
            "lexeme_ids": [
              "cy-cau",
              "cy-drws",
              "cy-dod",
              "cy-o",
              "cy-mynd",
              "cy-i-prep",
              "cy-caffi"
            ],
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l07-s03",
        "title": "Yn ôl",
        "segments": [
          {
            "id": "cy-draig-01-l07-s019",
            "text": "Mae Dafi'n mynd i'r caffi, ond mae e'n edrych yn ôl. Mae'r hen lyfr yn y llyfrgell. Mae Dafi'n edrych ar Mali.",
            "lexeme_ids": [
              "cy-mynd",
              "cy-i-prep",
              "cy-caffi",
              "cy-yn-ol"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l07-three-turns",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l07-three-turns.svg",
                "alt": "Three numbered panels trace tiny Dafi going toward the café, turning back toward the library and hill, then coming from the library carrying the old book.",
                "covers_lexeme_ids": [
                  "cy-mynd",
                  "cy-dod",
                  "cy-i-prep",
                  "cy-o",
                  "cy-caffi",
                  "cy-yn-ol"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l07-s020",
            "text": "Ydy Dafi'n mynd i'r caffi nawr? Nac ydy. Mae e'n mynd yn ôl i'r llyfrgell. Mae Pero'n edrych ar Dafi.",
            "lexeme_ids": [
              "cy-mynd",
              "cy-i-prep",
              "cy-caffi",
              "cy-yn-ol"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s021",
            "text": "Mae drws y llyfrgell yn cau. Mae Dafi'n agor y drws. Mae e'n mynd i'r llyfrgell, ac mae Pero'n dod i'r drws.",
            "lexeme_ids": [
              "cy-drws",
              "cy-cau",
              "cy-agor",
              "cy-mynd",
              "cy-dod",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s022",
            "text": "Mae Dafi'n edrych ar y papur ac yn edrych ycw.",
            "lexeme_ids": [],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s023",
            "text": "Nawr mae'r hen lyfr gyda Dafi. Mae e'n cau'r drws ac yn dod o'r llyfrgell.",
            "lexeme_ids": [
              "cy-cau",
              "cy-drws",
              "cy-dod",
              "cy-o"
            ],
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l07-s04",
        "title": "I'r caffi",
        "segments": [
          {
            "id": "cy-draig-01-l07-s028",
            "text": "Mae Dafi'n dod o'r llyfrgell i'r stryd. Mae'r hen lyfr gyda Dafi. Mae Mali'n hapus nawr.",
            "lexeme_ids": [
              "cy-dod",
              "cy-o",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s029",
            "text": "Mae Mali'n mynd i'r caffi. Mae Pero'n mynd gyda Mali. Mae Nia a'r gath yn mynd hefyd. Mae Dafi'n mynd i'r caffi gyda'r hen lyfr.",
            "lexeme_ids": [
              "cy-mynd",
              "cy-i-prep",
              "cy-caffi"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s031",
            "text": "Mae Dafi'n agor drws y caffi. Mae Mali'n mynd i'r caffi. Mae Nia, Pero, a'r gath yn dod i'r caffi. Mae Dafi'n dod hefyd.",
            "lexeme_ids": [
              "cy-agor",
              "cy-drws",
              "cy-caffi",
              "cy-mynd",
              "cy-dod",
              "cy-i-prep"
            ],
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l07-s032",
            "text": "Nawr mae'r hen lyfr yn y caffi. Mae Dafi'n edrych ar y llyfr, ac mae e'n edrych ycw hefyd. Ond dydy Dafi ddim yn mynd yn ôl nawr.",
            "lexeme_ids": [
              "cy-caffi",
