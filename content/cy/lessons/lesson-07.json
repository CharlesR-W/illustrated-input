  "grammar_observation": {
    "target_language": "Mae Mali'n mynd i'r caffi. Mae Dafi'n dod o'r llyfrgell. i + y = i'r; o + y = o'r.",
    "bridge_language": "Mynd i means go to; dod o means come from. Before the article, i + y becomes i'r and o + y becomes o'r."
  },
