        "segments": [
          {
            "id": "cy-draig-01-l07-s001",
            "text": "Mae Mali, Nia, Pero, y gath, a Dafi yn y llyfrgell. Mae'r hen lyfr yn y bocs, a mae'r papur gyda'r llyfr.",
            "lexeme_ids": [],
            "inference_aids": [
              {
