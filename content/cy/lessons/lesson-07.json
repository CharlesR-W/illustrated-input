                  "cy-cau"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l07-s003",
            "text": "Mae Mali'n mynd o'r llyfrgell i'r caffi. Mae Pero'n mynd gyda Mali. Mae Nia a'r gath yn mynd o'r llyfrgell i'r caffi hefyd.",
            "lexeme_ids": [
              "cy-mynd",
              "cy-o",
              "cy-i-prep",
              "cy-caffi"
            ],
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l07-route",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l07-route.svg",
                "alt": "A simple street route runs from a small library at left to a café at right. A teal arrow points from O'r llyfrgell to I'r caffi.",
                "covers_lexeme_ids": [
                  "cy-mynd",
                  "cy-i-prep",
                  "cy-o",
                  "cy-caffi",
                  "cy-stryd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l07-s004",
            "text": "Mae Dafi'n mynd i'r drws. Ond mae e'n edrych ar yr hen lyfr. Mae e'n edrych ycw hefyd. Mae e'n trist.",
            "lexeme_ids": [
              "cy-mynd",
