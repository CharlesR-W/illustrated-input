  "grammar_observation": {
    "target_language": "Mae Mali'n mynd i'r caffi. Mae Dafi'n dod o'r llyfrgell. Mae e'n mynd o'r llyfrgell i'r caffi. i + y = i'r; o + y = o'r.",
    "bridge_language": "Use mynd i for motion to a place and dod o for motion from one. Before the article, i + y contracts to i'r and o + y contracts to o'r."
