  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l08-s01",
        "title": "Cacen a phapur Sam",
        "segments": [
          {
            "id": "cy-draig-01-l08-s001",
            "text": "Mae Mali, Dafi, Pero a Nia yn y caffi gyda Sam.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l08-possession",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l08-possession.svg",
                "alt": "Owner-and-object pairs show that Sam has a cake and paper, while Dafi has a pencil but no money.",
                "covers_lexeme_ids": [
                  "cy-gan",
                  "cy-gen",
                  "cy-cacen",
                  "cy-arian",
                  "cy-pensil"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l08-s002",
            "text": "Mae gan Sam gacen a phapur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s003",
            "text": "Mae'r gacen a'r papur gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s004",
            "text": "Mae'r gacen yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s005",
            "text": "Mae Dafi'n edrych ar y gacen; mae e'n llwglyd ac eisiau'r gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s006",
            "text": "Oes arian gan Dafi? Nac oes: does gan Dafi ddim arian.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s007",
            "text": "Dafi: “Does gen i ddim arian. Ond mae gen i bensil.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s008",
            "text": "Mae gan Dafi bensil bach, ond does gan Dafi ddim papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s009",
            "text": "Mae Sam yn rhoi papur i Ddafi, ac mae Dafi'n cael y papur.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l08-give-receive",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l08-give-receive.svg",
                "alt": "An arrow follows a sheet of paper from Sam's hand to Dafi: Sam gives; Dafi receives.",
                "covers_lexeme_ids": [
                  "cy-rhoi",
                  "cy-cael"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s02",
        "title": "Y pensil ar y papur",
        "segments": [
          {
            "id": "cy-draig-01-l08-s010",
            "text": "Nawr mae papur a phensil gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s011",
            "text": "Mae llawer o bapur gyda Sam, ond ychydig o bapur gyda Dafi: un papur.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l08-much-little",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l08-much-little.svg",
                "alt": "Two clear contrasts show a large pile labelled llawer and a tiny amount labelled ychydig.",
                "covers_lexeme_ids": [
                  "cy-llawer",
                  "cy-ychydig"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l08-s012",
            "text": "Mae llawer o gacen gyda Sam hefyd, ond does dim cacen gyda Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s013",
            "text": "Mae Dafi'n edrych ar y papur bach yn yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s014",
            "text": "Mae e yn y papur bach: mae e'n fawr, a Dafi'n fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s015",
            "text": "Mae Dafi'n edrych ar e, ar y pensil, ac ar bapur Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s016",
            "text": "Mae'r pensil yn mynd yma ac ycw ar y papur; nawr mae llun newydd yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s017",
            "text": "Mae Dafi yn y llun, ac mae e yn y llun hefyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l08-scene-drawing-clue",
                "presentation": "inline_scene",
                "src": "media/images/cy-l08-scene-drawing-clue.svg",
                "alt": "At the café table, Dafi finishes a striking drawing of himself beside a sleeping dark-haired boy on a hill; above them is the same crown-shaped mark seen in the old paper.",
                "covers_lexeme_ids": [
                  "cy-llun"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l08-s018",
            "text": "Mae llawer o goch yn y llun, ac ychydig o ddu.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s03",
        "title": "Mae Mali'n cael y llun",
        "segments": [
          {
            "id": "cy-draig-01-l08-s019",
            "text": "Mae Mali'n edrych ar lun Dafi, ac mae hi'n edrych ar yr hen bapur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s020",
            "text": "Ydy e yn y papur ac yn llun Dafi? Ydy.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s021",
            "text": "Mae e yma ac ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s022",
            "text": "Mae Mali eisiau'r llun; dydy hi ddim eisiau'r gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s023",
            "text": "Oes llun gan Dafi? Oes: mae gan Dafi lun mawr coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s024",
            "text": "Mae Dafi'n rhoi'r llun i Fali, ac mae Mali'n cael y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s025",
            "text": "Nawr mae llun Dafi gan Mali, a does gan Dafi ddim llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s026",
            "text": "Mae'r llun gyda Mali, ond mae'r pensil gyda Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s027",
            "text": "Mae Mali'n hapus gyda'r llun; mae Dafi'n edrych ar gacen Sam.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s04",
        "title": "Ychydig o gacen",
        "segments": [
          {
            "id": "cy-draig-01-l08-s028",
            "text": "Mae ychydig o arian gan Mali, ac mae hi'n rhoi'r arian i Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s029",
            "text": "Mae Sam yn cael yr arian; nawr mae llawer o arian gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s030",
            "text": "Mae Sam yn rhoi ychydig o gacen i Ddafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s031",
            "text": "Mae Dafi'n cael y gacen ac yn edrych yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s032",
            "text": "Dafi: “Nawr mae gen i gacen. Mae gen i bensil hefyd.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s033",
            "text": "Mae Dafi'n bwyta ychydig o gacen, ond mae llawer o gacen gyda Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s034",
            "text": "Mae Pero eisiau cacen, ond mae Sam yn rhoi dŵr i Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s035",
            "text": "Mae Pero'n cael y dŵr; dydy Pero ddim yn cael cacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s036",
            "text": "Mae'r llun gyda Mali, mae'r gacen gyda Dafi, ac mae'r hen bapur gyda'r llyfr.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
