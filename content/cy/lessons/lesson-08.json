  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l08-s01",
        "title": "Cacen Sam",
        "segments": [
          {
            "id": "cy-draig-01-l08-s001",
            "text": "Mae Sam yn y caffi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l08-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l08-scene.svg",
                "alt": "Llun am gacen"
              },
              {
                "type": "image",
                "ref": "cy-l08-possession",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l08-possession.svg",
                "alt": "Mae gan Sam gacen. Mae gan Dafi pensil."
              }
            ]
          },
          {
            "id": "cy-draig-01-l08-s002",
            "text": "Mae cacen ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s003",
            "text": "Mae gan Sam gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s004",
            "text": "Mae'r gacen yn fawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s005",
            "text": "Mae'r gacen yn edrych yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s006",
            "text": "Mae Dafi'n edrych ar y gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s007",
            "text": "Mae e'n llwglyd eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s008",
            "text": "“Wyt ti eisiau cacen?” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s009",
            "text": "“Ydw!” meddai Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s02",
        "title": "Dim arian",
        "segments": [
          {
            "id": "cy-draig-01-l08-s010",
            "text": "Mae cacen gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s011",
            "text": "Mae arian gan Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s012",
            "text": "Mae ychydig o arian gan Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s013",
            "text": "Oes arian gan Dafi?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s014",
            "text": "Nac oes. Does dim arian gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s015",
            "text": "“Does gen i ddim arian,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s016",
            "text": "Mae Dafi'n drist.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s017",
            "text": "Mae Sam yn edrych ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s018",
            "text": "“Beth sydd gen ti?” meddai Sam.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s03",
        "title": "Pensil a llun",
        "segments": [
          {
            "id": "cy-draig-01-l08-s019",
            "text": "Mae pensil gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s020",
            "text": "Mae papur gan Dafi hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s021",
            "text": "Mae’r papur a’r pensil gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s022",
            "text": "Mae Dafi’n edrych ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s023",
            "text": "Mae llun o Sam ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s024",
            "text": "Mae'r llun yn fawr ac yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s025",
            "text": "Mae llawer o goch yn y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s026",
            "text": "“Mae gen i lun,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s027",
            "text": "Mae Sam yn hoffi'r llun.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s04",
        "title": "Y fasnach",
        "segments": [
          {
            "id": "cy-draig-01-l08-s028",
            "text": "Mae Dafi'n rhoi'r llun i Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s029",
            "text": "Mae Sam yn cael y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s030",
            "text": "Mae Sam yn rhoi cacen i Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s031",
            "text": "Mae Dafi'n cael y gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s032",
            "text": "Nawr mae llun gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s033",
            "text": "Nawr mae cacen gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s034",
            "text": "Mae Dafi'n bwyta ychydig o gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s035",
            "text": "Mae Pero eisiau cacen hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l08-s036",
            "text": "Ond mae Sam yn rhoi dŵr i Pero. Mae Sam yn edrych ar ei lun newydd. Mae llawer o liw coch yn y llun. Mae Dafi'n edrych ar ei gacen. Mae ychydig o gacen gan Dafi nawr. Does dim cacen gan Pero, ond mae dŵr gan Pero.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l08-s05",
        "title": "Llun am gacen",
        "segments": [
          {
            "id": "cy-draig-01-l08-s037",
            "text": "Mae gan Sam gacen fawr yn y caffi. Mae Dafi'n edrych ar y gacen ac mae e eisiau cacen. Oes arian gan Dafi? Nac oes. Does dim arian gan Dafi. Mae ychydig o arian gan Nia ac mae arian gan Mali, ond mae gan Dafi bapur a phensil. Mae Dafi'n gwneud llun mawr coch o Sam a'r caffi. Nawr mae llun gan Dafi. Mae Sam yn edrych ar y llun ac mae e'n hoffi'r llun. Mae Dafi'n rhoi'r llun i Sam, ac mae Sam yn rhoi cacen i Dafi. Nawr mae llun gan Sam a chacen gan Dafi. Mae Dafi'n bwyta ychydig o gacen; dydy e ddim yn bwyta gormod. Mae Pero eisiau cacen hefyd, ond mae Sam yn rhoi dŵr i Pero. Mae Pero'n yfed, mae Dafi'n bwyta, ac mae Sam yn rhoi'r llun coch wrth y bwrdd. Does dim arian yn y fasnach, ond mae gan y ddau rywbeth maen nhw'n ei hoffi.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
