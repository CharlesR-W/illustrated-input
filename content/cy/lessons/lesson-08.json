  "learning_contract": {
    "primary_new_grammar": {
      "id": "G08",
      "label": "possession with gan; soft mutation in the possession pattern",
      "description": "Express possession with mae/oes/does + gan, use gen i for first-person possession, and contrast soft mutation in positive and question forms with mutation blocked after ddim.",
      "minimum_demonstrations": 6
    },
    "recycled_grammar": [
