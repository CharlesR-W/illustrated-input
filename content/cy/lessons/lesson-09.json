        "title": "Ar y bwrdd",
        "segments": [
          {
            "id": "cy-draig-01-l09-s001",
            "text": "Mae tair cacen ar y bwrdd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l09-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l09-scene.svg",
                "alt": "Tri neu bedwar?"
              },
              {
                "type": "image",
                "ref": "cy-l09-numbers",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l09-numbers.svg",
                "alt": "Tri chwpan, tair cacen, pedwar cwpan, pedair cadair."
              }
            ]
          },
          {
            "id": "cy-draig-01-l09-s002",
            "text": "Mae pedwar cwpan ar y bwrdd hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s003",
            "text": "Mae Dafi'n cyfrif y cacennau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s004",
            "text": "“Un, dau, tri,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s005",
            "text": "Mae tair cacen fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s006",
            "text": "Mae Dafi'n cyfrif eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s007",
            "text": "“Un, dau, tri, pedwar!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s008",
            "text": "Ond does dim pedair cacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s009",
            "text": "Mae tair cacen.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s02",
        "title": "Cwpanau",
        "segments": [
          {
            "id": "cy-draig-01-l09-s010",
            "text": "Mae Sam yn rhoi cwpan ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s011",
            "text": "Mae Mali’n rhoi ail gwpan ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s012",
            "text": "Mae Nia'n rhoi cwpan ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s013",
            "text": "Mae Dafi'n rhoi cwpan ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s014",
            "text": "Mae pedwar cwpan ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s015",
            "text": "Mae Dafi'n cyfrif: un, dau, tri, pedwar.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s016",
            "text": "Pedwar cwpan, ond tair cacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s017",
            "text": "Mae llawer o gwpanau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s018",
            "text": "“Dim gormod,” meddai Sam.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s03",
        "title": "Cadeiriau",
        "segments": [
          {
            "id": "cy-draig-01-l09-s019",
            "text": "Mae pedair cadair wrth y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s020",
            "text": "Mae Mali ar un gadair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s021",
            "text": "Mae Nia ar gadair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s022",
            "text": "Mae Sam ar gadair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s023",
            "text": "Mae'r gath ar gadair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s024",
            "text": "Mae Dafi'n edrych ar y cadeiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s025",
            "text": "“Un, dau, tri, pedair,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s026",
            "text": "Cadair: un. Pedair cadair: pedair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s027",
            "text": "Felly: pedair cadair.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s04",
        "title": "Gormod o gacen",
        "segments": [
          {
            "id": "cy-draig-01-l09-s028",
            "text": "Mae Dafi'n rhoi un gacen i'r gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s029",
            "text": "Mae e’n rhoi ail gacen i’r gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s030",
            "text": "Mae e’n rhoi trydedd gacen i’r gath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s031",
            "text": "Mae tair cacen gan y gath!",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s032",
            "text": "“Dafi, mae hynny'n ormod,” meddai Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s033",
            "text": "Dydy'r gath ddim yn bwyta tair cacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s034",
            "text": "Mae hi'n bwyta ychydig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s035",
            "text": "Mae Dafi'n cyfrif y cacennau eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s036",
            "text": "Nawr mae'r cacennau ar y bwrdd eto. Mae Dafi'n cyfrif y cwpanau: un, dau, tri, pedwar. Mae e'n cyfrif y cadeiriau: un, dau, tri, pedair. Mae e'n cyfrif y cacennau: un, dau, tri. Mae pedwar cwpan, pedair cadair a thair cacen. Mae tair cacen i un gath yn ormod. Mae'r gath yn bwyta ychydig, ac mae Dafi'n cyfrif eto.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s05",
        "title": "Tri neu bedwar?",
        "segments": [
          {
            "id": "cy-draig-01-l09-s037",
            "text": "Mae cacennau a chwpanau ar y bwrdd. Mae Dafi'n cyfrif y cacennau: un, dau, tri. Mae tair cacen fach. Mae e'n cyfrif eto: un, dau, tri, pedwar. Ond does dim pedair cacen: tair cacen sydd yma. Mae Sam, Mali, Nia a Dafi yn rhoi cwpanau ar y bwrdd. Nawr mae pedwar cwpan ar y bwrdd. Mae pedair cadair wrth y bwrdd hefyd. Mae Mali, Nia, Sam a'r gath ar y pedair cadair. Mae Dafi'n rhoi un gacen i'r gath, yna ail gacen, ac yna drydedd gacen. Mae tair cacen gan un gath: mae hynny'n ormod. Dydy'r gath ddim yn bwyta tair cacen; mae hi'n bwyta ychydig. Mae Dafi'n rhoi'r cacennau yn ôl ar y bwrdd ac yn cyfrif eto. Pedwar cwpan, pedair cadair, tair cacen ac un gath. Y tro hwn mae'r cyfrif yn gywir, ac mae'r bwyd yn ddiogel.",
            "inference_aids": []
          }
        ]
      }
    ]
