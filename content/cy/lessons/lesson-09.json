  "grammar_observation": {
    "target_language": "Un cwpan, dau gwpan, tri chwpan, pedwar cwpan. Un gadair, tair cadair, pedair cadair.",
    "bridge_language": "Welsh uses masculine tri/pedwar and feminine tair/pedair. Some nouns mutate after numerals: un gadair, dau gwpan, dau bapur, tri chwpan."
  },
