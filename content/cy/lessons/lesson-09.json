  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l09-s01",
        "title": "Dafi'n cyfrif",
        "segments": [
          {
            "id": "cy-draig-01-l09-s001",
            "text": "Mae Sam, Mali, Nia, Pero a Dafi yn y caffi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l09-scene-paper-quest",
                "presentation": "inline_scene",
                "src": "media/images/cy-l09-scene-paper-quest.svg",
                "alt": "At the café table, Dafi counts cakes while Mali compares three present torn paper pieces with a fourth missing space.",
                "covers_lexeme_ids": [
                  "cy-cacen",
                  "cy-cwpan",
                  "cy-cadair",
                  "cy-bwrdd",
                  "cy-cyfrif",
                  "cy-tri",
                  "cy-tair",
                  "cy-pedwar",
                  "cy-pedair"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l09-too-many",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l09-too-many.svg",
                "alt": "One small dragon with four cakes is contrasted with four friends each having one cake, making too much visually clear.",
                "covers_lexeme_ids": [
                  "cy-gormod",
                  "cy-pedair"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l09-s002",
            "text": "Mae bwrdd mawr yn y caffi, a mae tair cacen fach yma. Mae'r bwrdd yn fawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s003",
            "text": "Mae pedwar cwpan dŵr yma hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s004",
            "text": "Mae Dafi'n edrych ar y gacen. Mae e'n llwglyd eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s005",
            "text": "“Ydy Dafi eisiau cacen?” “Ydy!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s006",
            "text": "Mae Dafi'n cyfrif y gacen: “Un, dau, tri, pedwar.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l09-count-again",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l09-count-again.svg",
                "alt": "Dafi first counts three cakes as four, then follows Mali's pointing and counts the three correctly on a second attempt.",
                "covers_lexeme_ids": [
                  "cy-cyfrif",
                  "cy-eto",
                  "cy-tri",
                  "cy-pedwar"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l09-s007",
            "text": "“Pedair? Mae pedair cacen yn ormod.” “Nac oes.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s008",
            "text": "Oes pedair cacen? Nac oes. Mae tair cacen yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s009",
            "text": "Ond mae Dafi'n cyfrif eto: “Un, dau, tri, pedwar.” Mae e eisiau pedair cacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s010",
            "text": "Mae pedair cacen i un ddraig fach yn ormod. Mae Sam yn rhoi ychydig o gacen i Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s02",
        "title": "Cwpan a chadair",
        "segments": [
          {
            "id": "cy-draig-01-l09-s011",
            "text": "Mae cwpan gan Sam, cwpan gan Mali, cwpan gan Nia, a chwpan gan Dafi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l09-number-gender",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l09-number-gender.svg",
                "alt": "Numbered rows contrast masculine cups with feminine cakes and chairs: three and four use different Welsh forms.",
                "covers_lexeme_ids": [
                  "cy-tri",
                  "cy-tair",
                  "cy-pedwar",
                  "cy-pedair",
                  "cy-cwpan",
                  "cy-cadair"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l09-s014",
            "text": "Mae Dafi'n cyfrif: un cwpan, dau gwpan, tri chwpan, pedwar cwpan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s015",
            "text": "“Tri chwpan, Dafi?” Nac oes: mae pedwar cwpan a bwrdd yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s016",
            "text": "Mae pedair cadair yn y caffi hefyd. Mae un gadair gyda Mali, ac un gadair gyda Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s017",
            "text": "Mae un gadair gyda Sam, ac un gadair gyda'r gath fach wen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s018",
            "text": "Mae Dafi'n edrych: “Tair cadair?” Nac oes. Mae pedair cadair yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s019",
            "text": "Mae Dafi'n cael pedwar cwpan. Mae pedwar cwpan i un ddraig fach yn ormod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s020",
            "text": "Mae e'n rhoi tri chwpan yn ôl i Sam, Mali a Nia. Nawr mae un cwpan gan Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s03",
        "title": "Tri phapur",
        "segments": [
          {
            "id": "cy-draig-01-l09-s021",
            "text": "Mae'r hen lyfr gan Mali. Mae tri phapur o'r llyfr gyda Mali: un papur mawr a dau bapur bach.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l09-paper-parts",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l09-paper-parts.svg",
                "alt": "Four interlocking torn-paper positions form one picture; three contain paper and the fourth is an empty dotted silhouette.",
                "covers_lexeme_ids": [
                  "cy-tri",
                  "cy-pedwar",
                  "cy-papur"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l09-s025",
            "text": "Mae llun newydd gan Sam. Mae Dafi yn y llun newydd hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s026",
            "text": "Mae Dafi'n rhoi'r tri phapur gyda'r llun newydd. Un papur, dau bapur, tri phapur — a dim.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s027",
            "text": "Oes pedwar papur yma? Nac oes. Mae tri phapur yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s028",
            "text": "Dydy un papur ddim yma. Mae Dafi'n cyfrif eto: “Un, dau, tri — dim.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s029",
            "text": "Mae Mali'n cyfrif hefyd: “Un, dau, tri — dim.” Pedwar papur, ond tri phapur yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s030",
            "text": "Mae Dafi'n trist eto. Pam? Dydy un papur ddim yma.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l09-s04",
        "title": "I'r llyfrgell",
        "segments": [
          {
            "id": "cy-draig-01-l09-s031",
            "text": "Mae Mali'n cael y tri phapur. Mae Dafi'n cael yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s033",
            "text": "“Pedwar papur?” “Nac oes. Tri phapur yma; dydy un papur ddim yma.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s034",
            "text": "Mae Dafi'n edrych o'r caffi i'r stryd. Mae'r llyfrgell ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s035",
            "text": "Ydy'r papur yn y llyfrgell? Mae Dafi eisiau mynd i'r llyfrgell nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s036",
            "text": "Mae Mali, Dafi, Nia a Pero'n mynd o'r caffi i'r llyfrgell. Mae Sam yn dod hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l09-s037",
            "text": "Mae tair cacen yn y caffi, ond dydy Dafi ddim yn edrych ar y gacen nawr. Mae e'n edrych ar yr hen lyfr. Mae tri phapur gyda Mali. Dydy un papur ddim yma. Un llun, pedwar papur. Mae Dafi'n cyfrif eto: “Un, dau, tri — dim.” Ydy'r papur yn y llyfrgell?",
            "inference_aids": []
          }
        ]
      }
    ]
  },
