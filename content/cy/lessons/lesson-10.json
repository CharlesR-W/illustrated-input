  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l10-s01",
        "title": "Yr ystafell fawr",
        "segments": [
          {
            "id": "cy-draig-01-l10-s001",
            "text": "Mae Mali, Dafi, Pero, Nia a Sam yn dod yn ôl i'r llyfrgell. Mae'r tri phapur gyda Mali, a'r hen lyfr gyda Dafi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l10-scene-library-search",
                "presentation": "inline_scene",
                "src": "media/images/cy-l10-scene.svg",
                "alt": "A cutaway library search: Mali and Dafi search the warm main room while Pero peers behind a shelf, where sleeping Iwan and an old box hide from view; the missing torn paper protrudes beneath the box.",
                "covers_lexeme_ids": [
                  "cy-ble",
                  "cy-ar",
                  "cy-dan",
                  "cy-wrth",
                  "cy-tu-ol",
                  "cy-o-flaen",
                  "cy-silff",
                  "cy-ffenestr",
                  "cy-ystafell",
                  "cy-chwilio"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l10-room",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l10-room.svg",
                "alt": "A simple labelled library room containing a shelf, window, table, and door.",
                "covers_lexeme_ids": [
                  "cy-ystafell",
                  "cy-silff",
                  "cy-ffenestr"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l10-s002",
            "text": "Mae ystafell fawr yn y llyfrgell. Mae bwrdd yn yr ystafell, mae ffenestr o flaen y bwrdd, a silff wrth y ffenestr.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l10-places",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l10-places.svg",
                "alt": "Five small panels show a red paper on, under, beside, behind, and in front of the same table.",
                "covers_lexeme_ids": [
                  "cy-ar",
                  "cy-dan",
                  "cy-wrth",
                  "cy-tu-ol",
                  "cy-o-flaen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l10-s003",
            "text": "Mae Mali'n rhoi tri phapur ar y bwrdd: un, dau, tri, a dim.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s004",
            "text": "“Ble mae'r papur?” Mae Mali'n chwilio. Mae Dafi'n chwilio hefyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l10-search",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l10-search.svg",
                "alt": "Mali asks where the torn paper is while Dafi searches three possible places, ending at a question-mark silhouette.",
                "covers_lexeme_ids": [
                  "cy-ble",
                  "cy-chwilio"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l10-s005",
            "text": "Mae Pero'n edrych ar y bwrdd ac ar y silff. Mae Nia wrth y drws yn yr ystafell, ac mae Sam o flaen y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s006",
            "text": "Dydy'r papur ddim ar y bwrdd. Dydy e ddim wrth y ffenestr. Mae Mali, Dafi a Pero'n chwilio.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s02",
        "title": "Ble mae'r papur?",
        "segments": [
          {
            "id": "cy-draig-01-l10-s007",
            "text": "Mae Dafi'n edrych dan y bwrdd. Oes papur dan y bwrdd? Nac oes. Mae cwpan dan y bwrdd, ond does dim papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s008",
            "text": "Mae'r gath ar y silff. Oes papur wrth y gath? Nac oes.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s009",
            "text": "Mae Nia'n chwilio wrth y ffenestr, ond dydy'r papur ddim yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s010",
            "text": "Mae Sam yn chwilio o flaen y silff. Mae e'n edrych dan un gadair, ond does dim papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s011",
            "text": "Mae Dafi'n edrych tu ôl i'r bwrdd ac wrth y drws. Dydy'r papur ddim yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s012",
            "text": "Mae Mali'n trist, ond mae Pero'n edrych ar y silff. Mae Pero'n mynd o flaen y silff, ac mae e'n edrych tu ôl i'r silff.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s03",
        "title": "Tu ôl i'r silff",
        "segments": [
          {
            "id": "cy-draig-01-l10-s013",
            "text": "Ble mae Pero nawr? Dydy Pero ddim wrth Mali. Dydy e ddim o flaen y ffenestr. Mae Pero tu ôl i'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s014",
            "text": "Mae Mali, Dafi, Nia a Sam yn mynd tu ôl i'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s015",
            "text": "Mae hen focs mawr tu ôl i'r silff. Mae Tad-cu Iwan tu ôl i'r silff hefyd, wrth yr hen focs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s016",
            "text": "Dydy Iwan ddim yn edrych ar Mali. Mae Pero wrth Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s017",
            "text": "“Tad-cu!” Mae Iwan yn edrych ar Mali nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s018",
            "text": "Mae Iwan yn edrych ar Dafi, ar Pero, ac ar yr hen focs. “Ble mae'r papur, Tad-cu?” Mae Iwan yn edrych dan y bocs.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s04",
        "title": "Y papur dan y bocs",
        "segments": [
          {
            "id": "cy-draig-01-l10-s019",
            "text": "Mae'r papur dan yr hen focs. Mae Dafi'n edrych dan y bocs hefyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l10-paper-under-box",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l10-paper-under-box.svg",
                "alt": "The fourth torn paper piece projects clearly from beneath an old box; three matching pieces on a nearby table leave exactly its shape empty.",
                "covers_lexeme_ids": [
                  "cy-dan",
                  "cy-ar",
                  "cy-wrth"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l10-s020",
            "text": "“Y papur!” Mae Dafi'n hapus. Mae Mali'n rhoi'r hen focs ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s021",
            "text": "Mae Mali'n rhoi'r papur wrth y tri phapur. Un, dau, tri, pedwar: mae pedwar papur yn un llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s022",
            "text": "Mae Iwan wrth Mali, a Pero wrth Iwan. Mae Dafi ar y bwrdd!",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s023",
            "text": "Mae Dafi'n edrych ar y llun. Mae'r ddraig fach yn y llun, ac mae e yn y llun hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s024",
            "text": "Mae Dafi'n edrych ar Iwan. “Pwy ydy e?” Mae Iwan yn edrych ar y llun, ond dydy e ddim yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s025",
            "text": "Mae'r pedwar papur ar y bwrdd. Mae Dafi o flaen Iwan, a'r llun o flaen Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s026",
            "text": "Dydy Iwan ddim yn darllen yr hen lyfr. Mae e'n edrych ar y papur, ac mae e'n trist.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
