              }
            ]
          },
          {
            "id": "cy-draig-01-l10-s002",
            "text": "Mae hi'n chwilio am Dad-cu Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s003",
            "text": "“Ble mae Tad-cu?” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s004",
            "text": "Dydy Tad-cu ddim wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s005",
            "text": "Dydy e ddim o flaen y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s006",
            "text": "Mae Pero'n chwilio hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s007",
            "text": "Mae Dafi'n edrych dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s008",
            "text": "Dydy Tad-cu ddim dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s009",
            "text": "Mae'r gath ar y bwrdd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s02",
        "title": "Yr ystafell fawr",
        "segments": [
          {
            "id": "cy-draig-01-l10-s010",
            "text": "Mae ystafell fawr yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s011",
            "text": "Mae pedair cadair yn yr ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s012",
            "text": "Mae silff wrth y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s013",
            "text": "Mae ffenestr o flaen y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s014",
            "text": "Mae Dafi'n chwilio tu ôl i'r cadeiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s015",
            "text": "Mae Pero'n chwilio dan y cadeiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s016",
            "text": "“Ble mae Tad-cu?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s017",
            "text": "Dydy e ddim yn yr ystafell fawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s018",
            "text": "Ond mae drws bach tu ôl i’r silff.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s03",
        "title": "Tu ôl i'r silff",
        "segments": [
          {
            "id": "cy-draig-01-l10-s019",
            "text": "Mae Mali wrth y drws bach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s020",
            "text": "Mae drws bach tu ôl i'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s021",
            "text": "Mae'r drws ddim ar agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s022",
            "text": "Mae Mali'n agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s023",
            "text": "Mae ystafell fach tu ôl i'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s024",
            "text": "Mae Dafi'n mynd i'r ystafell fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s025",
            "text": "Mae Pero wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s026",
            "text": "Mae Mali o flaen Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s027",
            "text": "Mae Dafi'n edrych yn yr ystafell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s04",
        "title": "Wedi ei ganfod",
        "segments": [
          {
            "id": "cy-draig-01-l10-s028",
            "text": "Mae Tad-cu Iwan yn yr ystafell fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s029",
            "text": "Mae e dan hen lyfr mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s030",
            "text": "“Tad-cu!” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s031",
            "text": "Mae Mali'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s032",
            "text": "Mae Mali’n rhoi’r llyfr ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s033",
            "text": "Mae Tad-cu'n dod o'r ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s034",
            "text": "Mae e wrth Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s035",
            "text": "Mae’r llyfr o flaen Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l10-s036",
            "text": "Nawr mae pawb gyda Tad-cu. Mae Mali wrth Dad-cu. Mae Pero wrth y drws. Mae Dafi o flaen y map. Mae'r gath ar y bwrdd. Mae'r silff tu ôl i Mali, ac mae'r drws bach tu ôl i'r silff. Mae'r ffenestr o flaen y bwrdd. Nawr dydy pawb ddim yn chwilio: mae Tad-cu yma.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l10-s05",
        "title": "Yr ystafell gudd",
        "segments": [
          {
            "id": "cy-draig-01-l10-s037",
            "text": "Mae Mali'n chwilio am Dad-cu yn y llyfrgell. Ble mae Tad-cu? Dydy e ddim wrth y drws nac o flaen y llyfrgell. Mae Dafi'n edrych dan y bwrdd, ond dim Tad-cu sydd yno; mae'r gath ar y bwrdd. Mae Pero'n chwilio yn yr ystafell fawr. Mae silff wrth y wal, ffenestr o flaen y bwrdd, a phedair cadair yn yr ystafell. Mae Dafi'n chwilio tu ôl i'r cadeiriau ac mae Pero'n chwilio dan y cadeiriau. Dydy Tad-cu ddim yno. Yna mae Mali'n gweld drws bach tu ôl i'r silff. Mae hi'n agor y drws. Mae ystafell fach tu ôl i'r silff. Mae Dafi'n mynd i'r ystafell fach, mae Pero wrth y drws, ac mae Mali o flaen Pero. Ble mae Tad-cu? Mae Tad-cu yn yr ystafell fach, dan hen fap mawr. Mae Mali'n symud y map, ac mae Tad-cu'n dod allan. Nawr mae'r map ar y bwrdd o flaen Dafi, a Tad-cu wrth Mali.",
            "inference_aids": []
          }
        ]
      }
    ]
