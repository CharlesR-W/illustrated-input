        "title": "Pedwar llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l11-s001",
            "text": "Mae pedwar llyfr ar y bwrdd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l11-scene.svg",
                "alt": "Pob llyfr yn ei fag"
              },
              {
                "type": "image",
                "ref": "cy-l11-possessives",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-possessives.svg",
                "alt": "Fy llyfr i, dy lyfr di, ei lyfr e, ei llyfr hi."
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s002",
            "text": "Mae llyfr coch gan Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s003",
            "text": "Mae llyfr du gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s004",
            "text": "Mae llyfr gwyn gan Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s005",
            "text": "Mae hen lyfr gan Tad-cu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s006",
            "text": "Mae Dafi'n edrych ar y llyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s007",
            "text": "Mae e'n rhoi'r llyfrau yn y bag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s008",
            "text": "Ond dydy Dafi ddim yn gwybod pa lyfr sydd i bwy.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s009",
            "text": "Mae'r pedwar llyfr yn y bag.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s02",
        "title": "Fy llyfr i",
        "segments": [
          {
            "id": "cy-draig-01-l11-s010",
            "text": "Mae Mali'n agor y bag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s011",
            "text": "“Ble mae fy llyfr i?” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s012",
            "text": "Mae Dafi’n rhoi llyfr du i Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s013",
            "text": "“Nage. Dydy hwn ddim yn fy llyfr i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s014",
            "text": "Mae Mali'n cael y llyfr coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s015",
            "text": "“Ie, fy llyfr i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s016",
            "text": "Fy mag i. Fy llyfr i.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s017",
            "text": "Fy mag i, ond fy llyfr i.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s018",
            "text": "Mae Dafi'n rhoi'r llyfr du yn ôl.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s03",
        "title": "Dy lyfr di",
        "segments": [
          {
            "id": "cy-draig-01-l11-s019",
            "text": "Mae Sam yn chwilio hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s020",
            "text": "“Dafi, ble mae dy lyfr di?” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s021",
            "text": "“Does gen i ddim llyfr,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s022",
            "text": "Mae Dafi’n codi’r llyfr du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s023",
            "text": "“Dy lyfr di?” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s024",
            "text": "“Ie, fy llyfr i,” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s025",
            "text": "“Dy lyfr di?” meddai Dafi wrth Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s026",
            "text": "“Ie, fy llyfr i,” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s027",
            "text": "Mae Sam yn rhoi ei lyfr yn ei fag.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s04",
        "title": "Ei llyfr hi",
        "segments": [
          {
            "id": "cy-draig-01-l11-s028",
            "text": "Mae Nia'n gweld y llyfr gwyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s029",
            "text": "“Ei llyfr hi yw hwn,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s030",
            "text": "Mae'r llyfr gwyn yn perthyn i Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s031",
            "text": "Mae Nia'n rhoi ei llyfr hi yn ei bag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s032",
            "text": "Mae Tad-cu'n cael ei hen lyfr e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s033",
            "text": "Mae ei hallwedd hi gan Nia hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s034",
            "text": "Mae Mali'n ffrind i Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s035",
            "text": "Mae gan Mali frawd a chwaer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s036",
            "text": "Nawr mae pob llyfr gyda’r person cywir.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s05",
        "title": "Pob llyfr yn ei fag",
        "segments": [
          {
            "id": "cy-draig-01-l11-s037",
          "text": "Mae pedwar llyfr ar y bwrdd: llyfr coch Mali, llyfr du Sam, llyfr gwyn Nia a hen lyfr Tad-cu. Mae Dafi'n rhoi'r pedwar llyfr mewn un bag. Mae Mali'n agor y bag. “Ble mae fy llyfr i?” Mae Dafi'n rhoi'r llyfr du iddi. “Nage, dydy hwn ddim yn fy llyfr i.” Mae Dafi'n rhoi'r llyfr coch iddi. “Ie, fy llyfr i.” Mae Sam yn chwilio hefyd. Mae Dafi'n dangos y llyfr du. “Dy lyfr di?” “Ie, fy llyfr i,” meddai Sam. Mae Sam yn rhoi ei lyfr e yn ei fag e. Mae Nia'n gweld y llyfr gwyn. “Ei llyfr hi,” meddai Mali. Mae Nia'n rhoi ei llyfr hi yn ei bag hi. Yn olaf mae Tad-cu'n cael ei hen lyfr e. Mae Dafi'n edrych ar fag Mali ac ar fag Sam. “Dy fag di?” meddai Dafi wrth Mali. “Nage, fy mag i yw'r bag coch.” Mae Dafi'n edrych ar Nia. Mae ei llyfr hi yn ei bag hi, ac mae ei hallwedd hi gyda hi. Mae pedwar llyfr, pedwar perchennog a phedwar bag. Mae llyfr coch Mali yn ei bag hi, llyfr du Sam yn ei fag e, llyfr gwyn Nia yn ei bag hi, a hen lyfr Tad-cu gyda Tad-cu. Nawr does dim llyfr yn y bag anghywir.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
