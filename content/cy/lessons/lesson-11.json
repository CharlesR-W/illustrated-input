  "learning_contract": {
    "primary_new_grammar": {
      "id": "G11",
      "label": "possessives fy/dy/ei with echo pronouns",
      "description": "Mark possession with fy, dy, and ei, apply the associated initial mutation, and use i, di, e, or hi to make the owner clear.",
      "minimum_demonstrations": 6
    },
    "recycled_grammar": [
      "G04",
      "G06",
      "G08",
      "G10"
    ],
    "incidental_grammar": [],
    "communicative_goals": [
      "identify the owner of a book or bag",
      "distinguish my, your, his, and her possessions",
      "describe family and friendship relations",
      "connect the assembled drawing and key to Iwan's old book"
    ],
