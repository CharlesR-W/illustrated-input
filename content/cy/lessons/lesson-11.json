  },
  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l11-s01",
        "title": "Llyfr a bag",
        "segments": [
          {
            "id": "cy-draig-01-l11-s001",
            "text": "Mae Mali, Sam, Nia, Dafi a Tad-cu Iwan yn yr ystafell fawr. Mae pedwar llyfr ar y bwrdd a phedwar bag wrth y bwrdd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-scene",
                "presentation": "inline_scene",
                "src": "media/images/cy-l11-scene.svg",
                "alt": "Mali, Sam, Nia, Dafi, and Iwan gather around four colour-coded books and bags while Dafi puts a black book into Mali's red bag; Iwan's old book and the small key are also visible.",
                "covers_lexeme_ids": [
                  "cy-llyfr",
                  "cy-bag"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l11-books-bags",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-books-bags.svg",
                "alt": "Four books are paired with four open bags by matching colour, while a crossed arrow shows the black book wrongly entering the red bag.",
                "covers_lexeme_ids": [
                  "cy-llyfr",
                  "cy-bag"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s002",
            "text": "Mae llyfr coch gan Mali, llyfr du gan Sam, llyfr gwyn gan Nia, a hen lyfr mawr gan Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s003",
            "text": "Mae Dafi'n rhoi'r llyfr du yn y bag coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s004",
            "text": "Dafi: “Dy lyfr di yn dy fag di, Mali.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-possessives",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-possessives.svg",
                "alt": "Owner arrows contrast fy mag i, dy fag di, ei lyfr e, and ei llyfr hi, with the changed initial letters highlighted.",
                "covers_lexeme_ids": [
                  "cy-fy",
                  "cy-dy",
                  "cy-ei",
                  "cy-llyfr",
                  "cy-bag"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s005",
            "text": "Mae Mali'n edrych ar y llyfr du. “Nac ydy. Dydy'r llyfr du ddim yn fy llyfr i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s006",
            "text": "Nawr mae Dafi'n rhoi'r llyfr gwyn yn y bag coch. Mae Nia'n edrych yn trist.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s02",
        "title": "Brawd a chwaer",
        "segments": [
          {
            "id": "cy-draig-01-l11-s010",
            "text": "Mae Sam yn agor y llyfr du. Mae llun yn y llyfr: merch fach a Sam.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-siblings",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-siblings.svg",
                "alt": "Sam and a girl are joined by a two-way family line labelled ei chwaer e and ei brawd hi.",
                "covers_lexeme_ids": [
                  "cy-brawd",
                  "cy-chwaer",
                  "cy-ei"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s011",
            "text": "Sam: “Fy chwaer i.” Mae Sam yn frawd, ac mae'r ferch fach yn chwaer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s012",
            "text": "Mae brawd a chwaer yn y llun. Mali: “Ei chwaer e; ei brawd hi.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s013",
            "text": "Dafi: “Dy lyfr di, Sam?” Sam: “Ie. Fy llyfr i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s014",
            "text": "Mae Dafi'n rhoi llyfr Sam yn ei fag e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s015",
            "text": "Mae Nia'n agor y llyfr gwyn. Mae cath fach wen yn y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s016",
            "text": "Mali: “Ei chath hi.” Mae Dafi'n rhoi llyfr Nia yn ei bag hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s017",
            "text": "Mae Mali'n agor y llyfr coch. Mae Pero yn y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s018",
            "text": "Nia: “Ei chi hi.” Mae Dafi'n rhoi llyfr Mali yn ei bag hi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s03",
        "title": "Llun yr hen lyfr",
        "segments": [
          {
            "id": "cy-draig-01-l11-s019",
            "text": "Nawr mae hen lyfr Iwan ar y bwrdd. Mae pedwar papur o'r llyfr yma hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s020",
            "text": "Mae Mali'n rhoi un papur wrth un papur, a dau bapur wrth ddau bapur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s021",
            "text": "Nawr mae un llun mawr ar y bwrdd: Dafi, e, a'r hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s022",
            "text": "Mae'r pedwar papur yn perthyn i'r hen lyfr. Mae'r llun yn perthyn i hen lyfr Iwan. Mae'r papur bach dan y bocs yn perthyn i'r llyfr hefyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-belongs",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-belongs.svg",
                "alt": "Four torn paper pieces assemble into one drawing and an arrow labelled perthyn points from the completed drawing into Iwan's old book.",
                "covers_lexeme_ids": [
                  "cy-perthyn",
                  "cy-llyfr"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s023",
            "text": "Iwan: “Fy llyfr i.” Dafi: “Dy lyfr di?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s024",
            "text": "Iwan: “Ie, fy hen lyfr i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s025",
            "text": "Mae Mali'n rhoi'r pedwar papur yn ei lyfr e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s026",
            "text": "Mae Iwan yn rhoi ei lyfr e yn ei fag e.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l11-s04",
        "title": "Ei allwedd e?",
        "segments": [
          {
            "id": "cy-draig-01-l11-s027",
            "text": "Ond mae allwedd fach dan y papur yn hen lyfr Iwan.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l11-key-sleeper",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l11-key-sleeper.svg",
                "alt": "A small old key moves from under the assembled drawing toward the pictured sleeping boy, while a dotted question line joins Iwan and the boy as possible old friends.",
                "covers_lexeme_ids": [
                  "cy-allwedd",
                  "cy-ffrind",
                  "cy-ei"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l11-s028",
            "text": "Mae Nia'n agor y llyfr eto. Mae Dafi'n edrych ar yr allwedd ac ar e yn y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s029",
            "text": "Dafi: “Dy allwedd di, Iwan?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s030",
            "text": "Iwan: “Nage. Dydy'r allwedd ddim yn fy allwedd i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s031",
            "text": "Mae Dafi'n rhoi'r allwedd ar y papur. “Ei allwedd e?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s032",
            "text": "Mae Iwan yn edrych ar e yn y llun, yn hapus ac yn trist.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s033",
            "text": "Iwan: “Fy hen ffrind i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s034",
            "text": "Mali: “Dy ffrind di?” Mae Mali'n edrych ar Iwan. Mae Iwan yn hen, ond mae e'n fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s035",
            "text": "Mae Iwan yn edrych eto. “Nage. Dydy e ddim yn fy ffrind i. Mae e'n hen ffrind yn yr hen lyfr.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l11-s036",
            "text": "Mae Dafi'n edrych ar ei allwedd e ac ar Iwan. Pwy ydy e? Pam mae ei allwedd e yn llyfr Iwan?",
            "inference_aids": []
          }
        ]
      }
    ]
  },
