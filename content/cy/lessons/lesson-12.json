  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l12-s01",
        "title": "Yr hen lyfr",
        "segments": [
          {
            "id": "cy-draig-01-l12-s001",
            "text": "Mae Mali, Sam, Nia, Iwan, Dafi a Pero yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-scene-team-repairs-book",
                "presentation": "inline_scene",
                "src": "media/images/cy-l12-scene-team-repairs-book.svg",
                "alt": "Mali and Sam work on four torn sheets while Nia and Iwan clean the old book; Dafi and Pero offer help around the library table.",
                "covers_lexeme_ids": [
                  "cy-helpu",
                  "cy-gweithio",
                  "cy-glanhau",
                  "cy-trwsio"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l12-personau",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-personau.svg",
                "alt": "Three person groups show rydyn ni for a group including the speaker, rydych chi for the people addressed, and maen nhw for a group talked about.",
                "covers_lexeme_ids": [
                  "cy-rydyn",
                  "cy-rydych",
                  "cy-maen",
                  "cy-ni",
                  "cy-chi",
                  "cy-nhw"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s002",
            "text": "Mae hen lyfr Iwan ar y bwrdd, ac mae pedwar papur o'r llyfr wrth y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s003",
            "text": "Mae'r llyfr yn ddu, dydy e ddim yn dda, ac mae'r papur yn hen hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s004",
            "text": "Mali: “Rydyn ni'n gweithio ar yr hen lyfr nawr.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s005",
            "text": "Sam: “Dyn ni'n helpu Iwan, ac rydyn ni'n trwsio ei lyfr e.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s006",
            "text": "Nia: “Mali a Sam, rydych chi'n gweithio ar y pedwar papur.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s007",
            "text": "Nia: “Iwan, rydyn ni'n glanhau'r llyfr.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s008",
            "text": "Mae Dafi'n edrych ar y ffrindiau; maen nhw'n gweithio, ac mae e eisiau helpu hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s009",
            "text": "Dafi: “Rydych chi'n gweithio ar y llyfr. Dw i'n helpu!”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s02",
        "title": "Pedwar papur",
        "segments": [
          {
            "id": "cy-draig-01-l12-s010",
            "text": "Mae Mali'n cael dau bapur, ac mae Sam yn cael dau bapur.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-four-papers",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-four-papers.svg",
                "alt": "Four separated torn sheets are cleaned and repaired into one large continuous picture.",
                "covers_lexeme_ids": [
                  "cy-glanhau",
                  "cy-trwsio"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s011",
            "text": "Maen nhw'n glanhau'r pedwar papur: mae Mali'n glanhau dau, ac mae Sam yn glanhau dau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s012",
            "text": "Mae Mali'n rhoi ei phapur hi ar y bwrdd, ac mae Sam yn rhoi ei bapur e wrth ei phapur hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s013",
            "text": "Maen nhw'n rhoi'r papur coch wrth y papur du, a'r papur mawr wrth y papur bach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s014",
            "text": "Mali: “Rydyn ni'n trwsio'r llun.” Sam: “Rydyn ni'n trwsio'r pedwar papur.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s015",
            "text": "Nawr mae un llun mawr ar y pedwar papur, ac mae'r llun yn perthyn i'r hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s016",
            "text": "Wrth y papur, mae Nia ac Iwan yn glanhau'r llyfr du.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-clean-repair",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-clean-repair.svg",
                "alt": "A dark dusty book becomes clean, while four torn sheets become one repaired picture.",
                "covers_lexeme_ids": [
                  "cy-glanhau",
                  "cy-trwsio"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s017",
            "text": "Maen nhw'n gweithio ar y llyfr: mae Nia'n glanhau, ac mae Iwan yn trwsio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s018",
            "text": "Nia: “Rydyn ni'n trwsio'r llyfr. Maen nhw'n trwsio'r llun. Rydyn ni'n helpu.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s03",
        "title": "Mae Dafi'n helpu",
        "segments": [
          {
            "id": "cy-draig-01-l12-s019",
            "text": "Mae Dafi eisiau glanhau hefyd, ac mae cwpan o ddŵr gan y ddraig fach.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-helping-jobs",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-helping-jobs.svg",
                "alt": "Dafi first reaches toward the old paper with water, then helps safely by putting pencils in a bag and books on a shelf.",
                "covers_lexeme_ids": [
                  "cy-helpu",
                  "cy-gweithio",
                  "cy-glanhau"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s020",
            "text": "Dafi: “Rydych chi'n glanhau'r llyfr. Dw i'n glanhau'r papur gyda dŵr.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s021",
            "text": "Nia: “Nac wyt, Dafi! Dydy dŵr ddim yn dda i'r hen bapur.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s022",
            "text": "Mae Dafi'n edrych ar y dŵr, yn edrych ar y papur, ac yn yfed y dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s023",
            "text": "Mae e'n rhoi'r cwpan ar y bwrdd; nawr mae e'n helpu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s024",
            "text": "Mae Dafi'n rhoi'r pensiliau yn y bag ac yn rhoi'r llyfrau bach ar y silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s025",
            "text": "Mae papur bach dan Pero. Mae Pero'n rhoi'r papur i Mali, ac mae Mali'n ei roi ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s026",
            "text": "Dafi: “Pero, rydyn ni'n helpu.” Mali: “Ie, rydych chi'n helpu'n dda.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s027",
            "text": "Mae Pero a Dafi wrth y bwrdd. Maen nhw'n helpu ac maen nhw'n gweithio.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-we-you-they",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-we-you-they.svg",
                "alt": "Dafi points to himself and Pero for rydyn ni, Mali addresses them as rydych chi, and Nia refers to them as maen nhw.",
                "covers_lexeme_ids": [
                  "cy-rydyn",
                  "cy-rydych",
                  "cy-maen",
                  "cy-ni",
                  "cy-chi",
                  "cy-nhw",
                  "cy-helpu"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s04",
        "title": "Drws yn y llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l12-s028",
            "text": "Mae'r pedwar papur yn yr hen lyfr eto, ac mae'r llyfr yn dda nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s029",
            "text": "Iwan: “Rydyn ni'n glanhau'r llyfr, rydyn ni'n trwsio'r papur, ac rydyn ni'n helpu Mali a Sam.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s030",
            "text": "Mali: “Nawr rydyn ni'n agor y llyfr.” Mae Pero'n edrych ar y llyfr o dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s031",
            "text": "Mali, Sam, Nia, Iwan a Dafi: “Rydyn ni'n agor yr hen lyfr.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-scene-page-door",
                "presentation": "inline_scene",
                "src": "media/images/cy-l12-scene-page-door.svg",
                "alt": "The five friends open the repaired old book together; a new red door appears across its pages with a clear gold crown symbol.",
                "covers_lexeme_ids": [
                  "cy-rydyn",
                  "cy-ni",
                  "cy-coron"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s032",
            "text": "Maen nhw'n agor y llyfr. Mae Dafi'n hapus, ond mae Iwan yn edrych ar y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s033",
            "text": "Mae drws newydd yn y llyfr. Mae'r drws yn fach ac yn goch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s034",
            "text": "Mae coron ar y drws. Mae'r goron yn fawr, ac mae Dafi'n edrych ar y goron.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-crown-door",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-crown-door.svg",
                "alt": "A gold crown is isolated above the same crown symbol on the small red door in the book.",
                "covers_lexeme_ids": [
                  "cy-coron"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s035",
            "text": "Dafi: “Coron!” Iwan: “Rydych chi'n edrych ar y drws; dw i'n edrych ar y goron.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s036",
            "text": "Mae ei allwedd e gan Iwan. Mae e'n rhoi ei allwedd e ar y drws, ond dydy'r drws ddim yn agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s037",
            "text": "Rydyn ni'n trwsio hen lyfr; nawr mae drws newydd yn y llyfr, ac mae coron ar y drws.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
