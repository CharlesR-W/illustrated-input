  "grammar_observation": {
    "target_language": "Nia + Iwan: rydyn ni. Mali + Sam: rydych chi / maen nhw. Rydyn ni'n helpu; rydych chi'n helpu; maen nhw'n helpu.",
    "bridge_language": "Use rydyn ni (or colloquial dyn ni) for “we are,” rydych chi for plural or polite “you are,” and maen nhw for “they are,” followed here by yn/'n + verbal noun."
  },
