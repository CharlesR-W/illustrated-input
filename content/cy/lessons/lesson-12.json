  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l12-s01",
        "title": "Y sefyllfa",
        "segments": [
          {
            "id": "cy-draig-01-l12-s001",
            "text": "Mae'r bore yn dechrau yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l12-personau",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l12-personau.svg",
                "alt": "Rydyn ni, rydych chi, maen nhw — yn helpu."
              }
            ]
          },
          {
            "id": "cy-draig-01-l12-s002",
            "text": "Mae Mali, Nia, Sam, Dafi a Pero yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s003",
            "text": "Mae llawer o waith yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s004",
            "text": "Mae Mali'n edrych ar y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s005",
            "text": "Mae Nia'n edrych ar y silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s006",
            "text": "Mae Sam yn edrych ar y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s007",
            "text": "Mae Dafi'n edrych ar y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s008",
            "text": "Mae Pero'n edrych ar bawb.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s009",
            "text": "Mae pawb eisiau helpu.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s02",
        "title": "Y digwyddiad",
        "segments": [
          {
            "id": "cy-draig-01-l12-s010",
            "text": "“Rydyn ni'n helpu heddiw,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s011",
            "text": "Dyn ni'n gweithio yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s012",
            "text": "Dyn ni'n glanhau'r ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s013",
            "text": "Dyn ni'n trwsio'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s014",
            "text": "Mae Mali a Sam yn glanhau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s015",
            "text": "Maen nhw'n gweithio gyda'i gilydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s016",
            "text": "Mae Nia a Dafi yn trwsio'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s017",
            "text": "Maen nhw'n helpu hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s018",
            "text": "Mae Pero yn eistedd dan y bwrdd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s03",
        "title": "Y newid",
        "segments": [
          {
            "id": "cy-draig-01-l12-s019",
            "text": "Mae dau ymwelydd wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s020",
            "text": "Mae Nia'n gofyn, “Rydych chi'n helpu?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s021",
            "text": "“Ydyn, rydyn ni'n helpu,” meddai'r ymwelwyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s022",
            "text": "Rydych chi'n glanhau'r ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s023",
            "text": "Rydych chi'n trwsio'r cadeiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s024",
            "text": "Mae Mali'n dweud, “Diolch, rydych chi'n gweithio'n dda.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s025",
            "text": "Maen nhw i gyd yn gweithio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s026",
            "text": "Maen nhw i gyd yn glanhau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s027",
            "text": "Mae'r llyfrgell yn newid.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s04",
        "title": "Y diwedd",
        "segments": [
          {
            "id": "cy-draig-01-l12-s028",
            "text": "Nawr mae'r drws yn lân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s029",
            "text": "Nawr mae'r ffenestr yn lân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s030",
            "text": "Nawr mae'r silff yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s031",
            "text": "“Dyn ni'n gorffen?” gofynna Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s032",
            "text": "“Ddim eto,” meddai Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s033",
            "text": "Rydyn ni'n helpu; rydych chi'n helpu; maen nhw'n helpu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s034",
            "text": "Mae pawb yn gweithio gyda'i gilydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s035",
            "text": "Mae Dafi'n fach, ond mae e'n helpu llawer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s036",
            "text": "Mae'r llyfrgell yn llawn ffrindiau.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l12-s05",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l12-s037",
            "text": "Mae Mali a Sam yn glanhau'r ffenestr fawr, ac mae Nia a Dafi yn trwsio'r hen silff wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s038",
            "text": "Mae Pero dan y bwrdd yn edrych ar bawb, ond dydy Pero ddim yn glanhau nac yn trwsio dim.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s039",
            "text": "Mae'r ddau ymwelydd yn agor y bocsys, ac rydyn ni'n rhoi'r llyfrau ar y silff gyda'n gilydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s040",
            "text": "“Rydych chi'n gweithio'n dda,” meddai Nia, ac mae'r ymwelwyr yn helpu Mali gyda'r ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s041",
            "text": "Mae Dafi'n fach, ond mae e'n codi papur, pensiliau a llyfrau bach o'r bocs mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s042",
            "text": "Mae Mali'n gofyn, “Dafi, wyt ti'n glanhau'r bocs?” ac mae Dafi'n ateb, “Ydw, dw i'n helpu.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s043",
            "text": "Mae Nia a Sam wrth y silff; maen nhw'n rhoi'r llyfrau mawr ar y silff a'r papur yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s044",
            "text": "Mae'r gwaith yn fawr, ond mae llawer o ffrindiau yma ac mae pawb eisiau helpu'r llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s045",
            "text": "Rydyn ni'n glanhau'r drws a'r ffenestr, rydych chi'n trwsio'r cadeiriau, ac maen nhw'n gweithio wrth y silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s046",
            "text": "Mae'r bore yn dechrau gyda llyfrgell hen, ond nawr mae'r ystafell yn lân ac mae'r drws yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s047",
            "text": "Mae Sam yn edrych ar y bwrdd ac yn gofyn am Nia, ac mae Pero'n edrych ar Sam wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s048",
            "text": "Mae dau gwpan ar y bwrdd, pedair cadair wrth y ffenestr, a llawer o lyfrau ar yr hen silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s049",
            "text": "Mae Dafi eisiau darllen, ond mae Mali'n dweud, “Mae'r gwaith yma ac mae'r llyfr yn y bocs.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s050",
            "text": "Ar ddiwedd y bore mae pawb yn edrych ar yr ystafell, ac mae'r llyfrgell yn llawn ffrindiau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s051",
            "text": "Mae'r ymwelwyr yn mynd at y drws, ond mae Mali, Nia, Sam a Dafi yn aros ac yn gorffen y gwaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l12-s052",
            "text": "Mae Nia'n edrych ar y silff lân, ac mae Sam yn edrych ar y ffenestr lân gyda gwên fawr.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
