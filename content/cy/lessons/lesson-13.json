  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l13-s01",
        "title": "Bob bore",
        "segments": [
          {
            "id": "cy-draig-01-l13-s001",
            "text": "Bob bore mae Nia'n codi ac yn mynd i'r llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-scene-morning-library",
                "presentation": "inline_scene",
                "src": "media/images/cy-l13-scene-morning-library.svg",
                "alt": "In the morning light Nia opens the library, Mali and Pero arrive, and Dafi rises from his box as the day's work begins.",
                "covers_lexeme_ids": [
                  "cy-bore",
                  "cy-bob",
                  "cy-codi",
                  "cy-dechrau"
                ]
              },
              {
                "type": "image",
                "ref": "cy-l13-amser",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-amser.svg",
                "alt": "A circular day line shows morning, afternoon, and night as three parts of time.",
                "covers_lexeme_ids": [
                  "cy-bore",
                  "cy-prynhawn",
                  "cy-nos",
                  "cy-amser"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s002",
            "text": "Bob bore mae hi'n agor drws y llyfrgell, ac maen nhw'n dechrau gweithio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s004",
            "text": "Mae Dafi'n codi o'r bocs, ond mae Pero'n edrych dan y bwrdd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-codi-cysgu",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-codi-cysgu.svg",
                "alt": "Dafi rises from his box in one panel and sleeps curled inside it in the contrasting panel.",
                "covers_lexeme_ids": [
                  "cy-codi",
                  "cy-cysgu"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s005",
            "text": "Mae Pero'n cysgu; dydy Pero ddim eisiau codi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s006",
            "text": "Dafi: “Bob bore dw i'n codi. Pero, wyt ti'n codi?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s008",
            "text": "Mae Mali'n rhoi ei bag hi wrth y bwrdd ac yn dechrau gweithio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s010",
            "text": "Bob bore mae Nia'n agor y drws. Mae amser y llyfrgell yn dechrau.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-dechrau-gorffen",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-dechrau-gorffen.svg",
                "alt": "An arrow runs from an opening library door labelled dechrau to a closing door labelled gorffen.",
                "covers_lexeme_ids": [
                  "cy-dechrau",
                  "cy-gorffen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s012",
            "text": "Mae Dafi'n edrych ar y drws bach coch yn yr hen lyfr.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s02",
        "title": "Bob prynhawn",
        "segments": [
          {
            "id": "cy-draig-01-l13-s013",
            "text": "Bob prynhawn mae Sam yn dod o'r caffi i'r llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-bob-loop",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-bob-loop.svg",
                "alt": "Three small circular sequences repeat the same morning opening, afternoon visit, and night reading.",
                "covers_lexeme_ids": [
                  "cy-bob",
                  "cy-bore",
                  "cy-prynhawn",
                  "cy-nos"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s014",
            "text": "Mae dau gwpan gan Sam, ac mae e'n rhoi un cwpan i Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s015",
            "text": "Mae e'n rhoi un cwpan i Fali, ond does dim cwpan gan Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s017",
            "text": "Mae Dafi'n yfed y dŵr, ac mae Pero'n codi nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s018",
            "text": "Bob prynhawn mae Mali'n trwsio papur, ac mae Sam yn glanhau'r bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s020",
            "text": "Mae Dafi'n dechrau edrych ar y papur mawr, ond dydy e ddim yn darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s021",
            "text": "Mae e'n edrych ar y goron, ar y drws coch, ac ar y bachgen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s022",
            "text": "Mae'r bachgen yn y papur ac yn y llyfr; mae e'n cysgu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s023",
            "text": "Dafi: “Pwy ydy e? Pam mae e'n cysgu?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s024",
            "text": "Dydy Dafi ddim yn cofio, ac mae amser y prynhawn yn gorffen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s025",
            "text": "Mae Sam yn mynd i'r caffi, ac mae Mali'n rhoi'r papur yn y llyfr.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s03",
        "title": "Bob nos",
        "segments": [
          {
            "id": "cy-draig-01-l13-s026",
            "text": "Bob nos maen nhw'n gorffen gweithio, ac mae Nia'n cau'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s027",
            "text": "Bob nos mae Mali, Pero, Sam ac Iwan yn mynd o'r llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s028",
            "text": "Mae Dafi'n mynd i'r bocs, ac mae'r hen lyfr gyda Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s029",
            "text": "Ond dydy Dafi ddim yn cysgu yn y nos.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s030",
            "text": "Bob nos mae e'n codi o'r bocs ac yn agor yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s031",
            "text": "Bob nos mae e'n edrych ar y drws bach coch yn y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s032",
            "text": "Mae e'n dechrau darllen: “A—t—r.” Ond does dim enw yma.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-damaged-name",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-damaged-name.svg",
                "alt": "The red painted door bears only the damaged letters A—t—r beside a question mark; the sleeping boy remains unnamed.",
                "covers_lexeme_ids": [
                  "cy-bachgen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s033",
            "text": "Mae Dafi'n darllen eto: “A—t—r.” Mae e'n edrych ar y bachgen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s034",
            "text": "Mae e'n rhoi'r allwedd ar y drws, ond dydy'r drws ddim yn agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s035",
            "text": "Mae Dafi'n gorffen darllen ac yn cau'r llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s036",
            "text": "Mae e'n mynd yn ôl i'r bocs, ond dydy e ddim yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s037",
            "text": "Yn y bore mae e'n helpu; yn y prynhawn mae e'n edrych; bob nos mae e'n darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s038",
            "text": "Mae'r nos yn amser Dafi gyda'r drws, yr allwedd, a'r bachgen.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s04",
        "title": "Heddiw",
        "segments": [
          {
            "id": "cy-draig-01-l13-s039",
            "text": "Heddiw mae'r bore yn dechrau, mae'r prynhawn yn gorffen, ac mae'r nos yn dod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s040",
            "text": "Mae Nia'n cau'r drws. Mae Dafi'n mynd i'r bocs gyda'r llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s041",
            "text": "Mae e'n edrych ar Pero. Mae Pero'n cysgu dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s042",
            "text": "Mae Dafi'n codi eto ac yn rhoi'r llyfr ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s043",
            "text": "Mae e'n dechrau darllen: “A—t—r. Pwy wyt ti?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s044",
            "text": "Dydy'r drws ddim yn agor. Dydy'r allwedd ddim yn agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s045",
            "text": "Ond heddiw mae'r bachgen yn y llun yn edrych ar Dafi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-scene-sleeper-wakes",
                "presentation": "inline_scene",
                "src": "media/images/cy-l13-scene-sleeper-wakes.svg",
                "alt": "At night Dafi stares at the open book while the dark-haired boy in a deep-blue tunic opens his eyes and looks back; Pero sleeps beneath the table and the damaged letters A—t—r glow on the painted door.",
                "covers_lexeme_ids": [
                  "cy-nos",
                  "cy-heddiw",
                  "cy-cysgu",
                  "cy-bachgen"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s046",
            "text": "Dydy e ddim yn cysgu nawr. Mae e'n edrych ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s047",
            "text": "Mae Dafi'n edrych ar y bachgen. Dydy e ddim yn darllen nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s048",
            "text": "Un, dau. Nawr mae'r bachgen yn cysgu eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s049",
            "text": "Mae Dafi'n agor y llyfr, yn cau'r llyfr, ac yn agor y llyfr eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s050",
            "text": "Ond mae'r bachgen yn cysgu eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s051",
            "text": "Mae Dafi'n edrych ar “A—t—r” ac ar y bachgen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s052",
            "text": "Dafi: “Dydy A—t—r ddim yn enw. Pwy wyt ti?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s053",
            "text": "Mae amser Dafi'n gorffen? Nac ydy.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s054",
            "text": "Heddiw mae e'n dechrau eto: “Pwy ydy'r bachgen?”",
            "inference_aids": []
          }
        ]
      }
    ]
  },
