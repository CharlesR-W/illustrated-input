  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l13-s01",
        "title": "Y sefyllfa",
        "segments": [
          {
            "id": "cy-draig-01-l13-s001",
            "text": "Mae bore newydd ym Mhorth Helyg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s002",
            "text": "Bob bore mae Nia'n codi'n gynnar.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l13-amser",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l13-amser.svg",
                "alt": "Bob bore, bob prynhawn, bob nos."
              }
            ]
          },
          {
            "id": "cy-draig-01-l13-s003",
            "text": "Bob bore mae hi'n mynd i'r llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s004",
            "text": "Mae hi'n agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s005",
            "text": "Mae'r gwaith yn dechrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s006",
            "text": "Mae Mali'n dod gyda Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s007",
            "text": "Mae Sam yn dod o'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s008",
            "text": "Mae Dafi'n codi o'i focs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s009",
            "text": "Mae pawb yn dweud, “Bore da.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s02",
        "title": "Y digwyddiad",
        "segments": [
          {
            "id": "cy-draig-01-l13-s010",
            "text": "Amser cinio, mae Sam yn dod eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s011",
            "text": "Yn y prynhawn mae e'n gweithio yn y caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s012",
            "text": "Mae Mali'n gweithio yn y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s013",
            "text": "Mae Nia'n glanhau bob prynhawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s014",
            "text": "Mae Dafi'n edrych ar lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s015",
            "text": "Mae e'n dechrau darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s016",
            "text": "Mae e'n darllen un gair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s017",
            "text": "Yna mae e'n darllen dau air.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s018",
            "text": "Mae'r prynhawn yn amser darllen.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s03",
        "title": "Y newid",
        "segments": [
          {
            "id": "cy-draig-01-l13-s019",
            "text": "Heddiw mae'r gwaith yn gorffen yn hwyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s020",
            "text": "Mae'r haul yn mynd i lawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s021",
            "text": "Mae'r stryd yn dawel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s022",
            "text": "Mae Nia'n cau'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s023",
            "text": "Mae Sam yn mynd adref.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s024",
            "text": "Mae Mali a Pero yn mynd adref hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s025",
            "text": "Ond dydy Dafi ddim yn cysgu eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s026",
            "text": "Mae e'n darllen yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s027",
            "text": "Mae'r nos yn amser tawel.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s04",
        "title": "Y diwedd",
        "segments": [
          {
            "id": "cy-draig-01-l13-s028",
            "text": "Bob nos mae Dafi'n darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s029",
            "text": "Bob nos mae Pero'n cysgu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s030",
            "text": "Bob bore mae Pero'n codi gyda Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s031",
            "text": "Bob bore mae Nia'n agor y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s032",
            "text": "Bob prynhawn mae Sam yn ymweld.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s033",
            "text": "Heddiw, mae'r drefn yr un fath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s034",
            "text": "Mae'r bore yn dechrau gyda drws agored.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s035",
            "text": "Mae'r nos yn gorffen gyda drws caeedig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s036",
            "text": "Mae amser y llyfrgell yn dechrau eto yfory.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l13-s05",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l13-s037",
            "text": "Bob bore mae Nia'n codi'n gynnar, yn mynd i'r llyfrgell, ac yn agor y drws; yna mae Mali'n dod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s038",
            "text": "Mae Mali a Pero yn dod ar hyd y stryd, ac mae Sam yn dod o'r caffi gyda dau gwpan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s039",
            "text": "Bob prynhawn mae Sam yn gweithio yn y caffi, ond amser cinio mae e'n ymweld â'r llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s040",
            "text": "Mae Dafi'n dechrau'r bore yn ei focs, ond mae e'n gorffen y nos gyda llyfr ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s041",
            "text": "Yn y bore mae'r stryd yn brysur; yn y nos mae'r stryd yn dawel ac mae'r ffenestri'n dywyll.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s042",
            "text": "Mae Nia'n glanhau bob prynhawn, mae Mali'n trwsio bob bore, ac mae Sam yn helpu amser cinio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s043",
            "text": "Mae Pero'n codi gyda Mali bob bore, yn edrych ar Dafi bob prynhawn, ac yn cysgu bob nos.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s044",
            "text": "Mae Dafi'n darllen un gair, yna dau air, ac ar ôl amser mae e'n darllen tudalen fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s045",
            "text": "“Wyt ti'n cysgu?” mae Mali'n gofyn, ond mae Dafi'n ateb, “Nac ydw, dw i'n darllen.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s046",
            "text": "Heddiw mae'r gwaith yn dechrau'n gynnar ac yn gorffen yn hwyr; mae llawer o lyfrau yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s047",
            "text": "Mae'r haul yn mynd i lawr, mae Nia'n cau'r drws, ac mae'r ffrindiau'n mynd adref.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s048",
            "text": "Mae'r bore yn amser gweithio, mae'r prynhawn yn amser darllen, ac mae'r nos yn amser cysgu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s049",
            "text": "Bob dydd mae'r drefn yr un fath, ond bob dydd mae Dafi'n darllen un gair newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s050",
            "text": "Ar ôl y nos mae bore newydd, ac mae amser y llyfrgell yn dechrau eto gyda Nia wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s051",
            "text": "Bob bore mae'r bocs yn agor, bob prynhawn mae llyfr ynddo, a bob nos mae Dafi'n cau'r bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s052",
            "text": "Mae Nia'n cofio amser agor a chau, ac mae Sam yn cofio amser cinio ac amser gweithio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s053",
            "text": "Mae Mali'n gorffen un gwaith ac yn dechrau gwaith arall, ond mae Pero'n cysgu drwy'r gwaith hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l13-s054",
            "text": "Ar ddiwedd y nos mae pawb adref, ond bob bore mae'r ffrindiau yn y llyfrgell eto.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
