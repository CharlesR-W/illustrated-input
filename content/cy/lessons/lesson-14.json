  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l14-s01",
        "title": "Pedwar papur Nia",
        "segments": [
          {
            "id": "cy-draig-01-l14-s001",
            "text": "Heddiw mae Nia, Mali, Sam, Iwan, Dafi a Pero yn y llyfrgell.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-scene-reconstruction",
                "presentation": "inline_scene",
                "src": "media/images/cy-l14-scene-reconstruction.svg",
                "alt": "Nia arranges four event pictures around the warm library table while Mali, Sam, Iwan, Dafi, and Pero study the repaired book and its closed red painted door.",
                "covers_lexeme_ids": [
                  "cy-ddoe",
                  "cy-agorodd",
                  "cy-edrychodd",
                  "cy-tan",
                  "cy-mwg"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s002",
            "text": "Mae'r hen lyfr ar y bwrdd, ac mae'r allwedd wrth y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s003",
            "text": "Mae'r drws bach coch yn y llyfr, ond dydy'r drws ddim yn agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s004",
            "text": "Mae gan Nia bedwar papur, ac mae llun ar bob papur.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-ddoe-heddiw",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-ddoe-heddiw.svg",
                "alt": "A timeline contrasts yesterday, when the painted door was open amid smoke, with today, when the old book rests on the table.",
                "covers_lexeme_ids": [
                  "cy-ddoe",
                  "cy-agorodd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s005",
            "text": "Ar un papur mae Mali gyda'r llyfr; ar un mae Dafi gyda thân bach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s006",
            "text": "Ar un papur mae mwg du dros y llyfr; ar un mae'r drws yn agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s007",
            "text": "Mae Nia'n rhoi'r pedwar papur o flaen y ffrindiau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s008",
            "text": "Mae Sam yn edrych ar bapur Mali, ac mae Iwan yn edrych ar bapur y mwg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s009",
            "text": "Mae Dafi'n edrych ar bapur y drws, ar “A—t—r”, ac ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s010",
            "text": "“Ddoe?” gofynnodd Nia.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-events",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-events.svg",
                "alt": "Four numbered panels order yesterday's events: Mali opened the book, Dafi looked, fire and smoke appeared, and the painted door opened.",
                "covers_lexeme_ids": [
                  "cy-ddoe",
                  "cy-agorodd",
                  "cy-edrychodd",
                  "cy-tan",
                  "cy-mwg",
                  "cy-sydyn"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s011",
            "text": "“Ie, ddoe,” atebodd Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s012",
            "text": "Gofynnodd Dafi, “Agorodd y drws ddoe?”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s02",
        "title": "Tân bach",
        "segments": [
          {
            "id": "cy-draig-01-l14-s013",
            "text": "Ddoe agorodd Mali'r hen lyfr ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s014",
            "text": "Edrychodd Mali ar y drws bach coch, ac edrychodd Sam ar y goron.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s015",
            "text": "Edrychodd Dafi ar y bachgen, ac edrychodd y bachgen ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s016",
            "text": "Gofynnodd Dafi, “Pwy wyt ti? A—t—r?”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-fire-smoke",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-fire-smoke.svg",
                "alt": "A small orange fire and dark grey smoke are contrasted on paper, with a burst symbol marking how suddenly they appeared.",
                "covers_lexeme_ids": [
                  "cy-tan",
                  "cy-mwg",
                  "cy-sydyn"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s017",
            "text": "Atebodd y bachgen? Nac atebodd: caeodd y bachgen ei lygaid e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s018",
            "text": "Edrychodd Dafi ar y goron eto. Tân bach ar y papur—tân sydyn!",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s019",
            "text": "Mwg du dros y papur—mwg sydyn! Dim bachgen, dim coron, dim drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s020",
            "text": "Helpodd Sam gyda dŵr, a helpodd Nia gyda'r hen lyfr.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-scene-hand-at-door",
                "presentation": "inline_scene",
                "src": "media/images/cy-l14-scene-hand-at-door.svg",
                "alt": "Grey smoke crosses the open book as its painted red door swings open. A pale hand reaches through and points toward the hill outside the library window while Mali, Dafi, and Pero stare.",
                "covers_lexeme_ids": [
                  "cy-agorodd",
                  "cy-caeodd",
                  "cy-edrychodd",
                  "cy-helpodd",
                  "cy-gofynnodd",
                  "cy-atebodd",
                  "cy-tan",
                  "cy-mwg",
                  "cy-sydyn"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s021",
            "text": "Helpodd Mali gyda'r papur, ond dydy Mali ddim yn cau'r llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s022",
            "text": "“Caeodd Mali'r llyfr?” gofynnodd Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s023",
            "text": "“Nac atebodd—nac caeodd,” atebodd Sam. “Edrychodd Mali ar y mwg.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s024",
            "text": "Edrychodd Iwan ar yr allwedd, ond dydy'r allwedd ddim yn helpu.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s03",
        "title": "Agorodd y drws",
        "segments": [
          {
            "id": "cy-draig-01-l14-s025",
            "text": "Ddoe, gyda mwg dros y papur, agorodd y drws bach coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s026",
            "text": "Agorodd y drws yn sydyn. Edrychodd Mali; edrychodd Sam; edrychodd Pero.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-gofyn-ateb",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-gofyn-ateb.svg",
                "alt": "Dafi asks who and where; an arrow runs from the open red door toward the hill as the door answers there.",
                "covers_lexeme_ids": [
                  "cy-gofynnodd",
                  "cy-atebodd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s027",
            "text": "Edrychodd Dafi yn y drws. Dydy'r bachgen ddim yn y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s028",
            "text": "Gofynnodd Dafi, “Pwy wyt ti? Pwy ydy'r bachgen?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s029",
            "text": "Atebodd y drws: dim enw, dim “A—t—r”. Atebodd y drws, “Ycw.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s030",
            "text": "“Ycw?” gofynnodd Dafi. “Ycw,” atebodd y drws.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-past-forms",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-past-forms.svg",
                "alt": "A Welsh verb chart maps familiar verb-nouns to the new regular third-person past forms used in the reconstruction.",
                "covers_lexeme_ids": [
                  "cy-agorodd",
                  "cy-caeodd",
                  "cy-edrychodd",
                  "cy-helpodd",
                  "cy-gofynnodd",
                  "cy-atebodd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s031",
            "text": "Edrychodd Dafi ycw. Edrychodd Mali ycw. Edrychodd Iwan ycw hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s032",
            "text": "Caeodd y drws yn sydyn. Nawr: dim drws agored, dim tân, ychydig o fwg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s033",
            "text": "Agorodd Mali'r llyfr eto, ond dydy'r drws ddim yn agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s034",
            "text": "Agorodd Sam y llyfr hefyd, ond dydy'r drws ddim yn ateb.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s035",
            "text": "Helpodd Iwan gyda'r allwedd. Dydy'r allwedd ddim yn agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s036",
            "text": "Caeodd Mali'r hen lyfr, ac edrychodd y ffrindiau ar Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s04",
        "title": "Un, dau, tri, pedwar",
        "segments": [
          {
            "id": "cy-draig-01-l14-s037",
            "text": "Heddiw mae Nia'n rhoi'r pedwar papur wrth yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s038",
            "text": "Mae hi'n rhoi papur y llyfr o flaen papur y tân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s039",
            "text": "Mae hi'n rhoi papur y mwg wrth bapur y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s040",
            "text": "Nia: “Un: agorodd Mali'r llyfr. Dau: edrychodd Dafi ar y drws.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s041",
            "text": "Nia: “Tri: tân bach a mwg du. Pedwar: agorodd y drws.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s042",
            "text": "“Caeodd y drws?” gofynnodd Nia. “Ie, caeodd y drws,” atebodd Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s043",
            "text": "“Helpodd Sam?” gofynnodd Nia. “Ie, helpodd Sam a helpodd Mali,” atebodd Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s044",
            "text": "Mae Nia'n edrych ar bob papur. Nawr mae'r pedwar papur yn dda.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s045",
            "text": "Mae Dafi'n edrych ar y ffenestr. Mae e'n edrych ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s046",
            "text": "Mae Pero'n mynd i'r drws mawr, ond mae Mali'n cau drws y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s047",
            "text": "Mae'r allwedd gyda Iwan; mae'r hen lyfr gyda Mali; mae'r pedwar papur gyda Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s048",
            "text": "Nawr mae Dafi eisiau mynd ycw, ond mae Mali'n edrych ar y tân a'r mwg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s049",
            "text": "Mae Mali eisiau helpu Dafi, ond mae hi'n rhoi'r papur yn ei bag hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s050",
            "text": "Mae Sam yn rhoi dŵr wrth y llyfr, ac mae Nia'n cau'r llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s051",
            "text": "Mae Iwan yn rhoi'r allwedd yn ei fag e ac yn edrych ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s052",
            "text": "Mae Pero wrth ddrws y llyfrgell. Mae Dafi wrth Pero, ac mae'r ddau yn edrych ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s053",
            "text": "Gofynnodd Dafi, “Pwy?” Ond atebodd y drws, “Ycw.”",
            "inference_aids": []
          }
        ]
      }
    ]
  },
