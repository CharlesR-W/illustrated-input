  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l14-s01",
        "title": "Y sefyllfa",
        "segments": [
          {
            "id": "cy-draig-01-l14-s001",
            "text": "Heddiw mae Nia'n edrych ar y drws du.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s002",
            "text": "Mae marc du wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s003",
            "text": "“Beth ddigwyddodd ddoe?” gofynnodd Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s004",
            "text": "Edrychodd Mali ar y marc.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s005",
            "text": "Edrychodd Sam ar y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s006",
            "text": "Edrychodd Dafi ar ei draed.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s007",
            "text": "Roedd mwg yn y llyfrgell ddoe.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s008",
            "text": "Roedd tân bach a sydyn hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s009",
            "text": "Mae pawb yn cofio'r bore.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s02",
        "title": "Y digwyddiad",
        "segments": [
          {
            "id": "cy-draig-01-l14-s010",
            "text": "Ddoe, agorodd Mali'r drws.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l14-gorffennol",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l14-gorffennol.svg",
                "alt": "Ddoe: agorodd, edrychodd, helpodd."
              }
            ]
          },
          {
            "id": "cy-draig-01-l14-s011",
            "text": "Agorodd hi'r ffenestr hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s012",
            "text": "Helpodd Sam gyda'r bocsys.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s013",
            "text": "Helpodd Nia gyda'r llyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s014",
            "text": "Edrychodd Pero dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s015",
            "text": "Edrychodd Dafi ar bapur coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s016",
            "text": "Gofynnodd Mali, “Dafi, beth wyt ti'n wneud?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s017",
            "text": "Atebodd Dafi, “Dw i'n helpu.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s018",
            "text": "Yna dechreuodd y mwg.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s03",
        "title": "Y newid",
        "segments": [
          {
            "id": "cy-draig-01-l14-s019",
            "text": "Edrychodd Mali ar Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s020",
            "text": "Edrychodd Dafi ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s021",
            "text": "Llosgodd y papur am eiliad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s022",
            "text": "Helpodd Sam yn sydyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s023",
            "text": "Helpodd Nia yn sydyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s024",
            "text": "Caeodd Mali'r bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s025",
            "text": "Agorodd Sam y drws mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s026",
            "text": "Agorodd Nia'r ffenestr fawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s027",
            "text": "Gorffennodd y tân bach.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s04",
        "title": "Y diwedd",
        "segments": [
          {
            "id": "cy-draig-01-l14-s028",
            "text": "Ar ôl y tân, glanhaodd pawb yr ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s029",
            "text": "Trwsiodd Mali'r bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s030",
            "text": "Helpodd Dafi gyda'r papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s031",
            "text": "Gofynnodd Nia, “Oedd y tân yn fawr?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s032",
            "text": "Atebodd Mali, “Nac oedd, roedd e'n fach.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s033",
            "text": "Gofynnodd Nia, “Oedd y mwg yn sydyn?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s034",
            "text": "Atebodd Sam, “Oedd, yn sydyn iawn.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s035",
            "text": "Caeodd Nia'r drws ar ddiwedd y dydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s036",
            "text": "Ddoe roedd problem; heddiw mae cynllun.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l14-s05",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l14-s037",
            "text": "Ddoe edrychodd Mali ar y papur coch, gofynnodd gwestiwn i Dafi, ac agorodd y drws mawr yn sydyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s038",
            "text": "Agorodd Sam y ffenestr, helpodd Nia gyda'r bocsys, a chaeodd Mali'r bocs wrth y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s039",
            "text": "Dechreuodd y mwg; edrychodd Pero dan y bwrdd, ond edrychodd Dafi ar ei draed a'r papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s040",
            "text": "Gofynnodd Nia beth ddigwyddodd, ac atebodd Mali, “Edrychodd Dafi ar y papur; yna dechreuodd y mwg.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s041",
            "text": "Helpodd Sam gyda dŵr, helpodd Nia gyda'r ffenestr, ac agorodd Mali'r drws i'r stryd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s042",
            "text": "Llosgodd y papur am eiliad yn unig, ac yna gorffennodd y tân bach yn sydyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s043",
            "text": "Ar ôl y tân glanhaodd pawb yr ystafell, trwsiodd Mali'r bocs, a chaeodd Nia'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s044",
            "text": "Gofynnodd Dafi, “Wnes i broblem fawr?” ac atebodd Mali, “Naddo; dechreuodd mwg, ond gorffennodd y tân.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s045",
            "text": "Edrychodd Nia ar y marc du wrth y drws ac edrychodd Sam ar y papur coch yn y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s046",
            "text": "Dechreuodd y bore gyda gwaith arferol, ond gorffennodd y bore gyda drws agored a ffenestr agored.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s047",
            "text": "Helpodd Dafi gyda'r papur glân, ond llosgodd y papur coch am eiliad wrth y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s048",
            "text": "Ddoe agorodd Mali'r drws; heddiw ysgrifennodd hi gynllun i gadw papur draw oddi wrth Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s049",
            "text": "Gofynnodd Nia un cwestiwn arall; atebodd Mali, atebodd Sam, ac yn olaf atebodd Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s050",
            "text": "Ar ddiwedd y dydd caeodd Nia'r llyfrgell, ond parhaodd pawb i feddwl am y tân bach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s051",
            "text": "Agorodd Nia'r bocs eto, edrychodd ar y papur du, a gofynnodd gwestiwn arall i Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s052",
            "text": "Atebodd Dafi, “Dw i eisiau helpu,” ond gofynnodd Mali, “Wyt ti'n gweld y rheol newydd?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s053",
            "text": "Ysgrifennodd Mali dri gair mawr ar bapur glân, ac edrychodd Dafi ar bob gair yn ofalus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s054",
            "text": "Helpodd Sam i roi'r arwydd wrth y bocs, a helpodd Nia i symud y papur oddi wrth Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s055",
            "text": "Ar ddiwedd y stori atebodd Dafi bob cwestiwn, caeodd y bocs, ac edrychodd ar y dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s056",
            "text": "Edrychodd Mali ar y drws a'r ffenestr, ac ysgrifennodd hi bob ateb ar y papur mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s057",
            "text": "Gofynnodd Sam am y dŵr, agorodd Nia'r bocs bach, a helpodd Pero drwy eistedd wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s058",
            "text": "Caeodd Mali'r ffenestr fach, agorodd Sam y ffenestr fawr, ac edrychodd Nia ar y mwg olaf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l14-s059",
            "text": "Gorffennodd y dydd gyda bocs da, ystafell lân, a chynllun clir wrth y drws ar gyfer bore newydd.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
