  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l15-s01",
        "title": "Y drws coch",
        "segments": [
          {
            "id": "cy-draig-01-l15-s001",
            "text": "Ddoe caeodd y drws coch yn yr hen lyfr, ond edrychodd pawb ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s003",
            "text": "“Mae'r drws yma, ond mae'r ateb ycw,” atebodd Dafi.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-mynd-dod",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l15-mynd-dod.svg",
                "alt": "Four paired panels contrast first-person and third-person movement: es i and aeth e move away, while des i and daeth e move toward the speaker.",
                "covers_lexeme_ids": [
                  "cy-es",
                  "cy-aeth",
                  "cy-des",
                  "cy-daeth"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s004",
            "text": "Gofynnodd Nia, “Ble mae Pero?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s005",
            "text": "Edrychodd Mali dan y bwrdd, wrth y bocs, a thu ôl i'r silff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s006",
            "text": "Dydy Pero ddim yn yr ystafell, a dydy e ddim o flaen y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s007",
            "text": "Agorodd Dafi ddrws y llyfrgell, ac edrychodd ar y stryd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s008",
            "text": "“Es i allan,” atebodd e, ac aeth y ddraig fach goch i'r stryd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-scene-allan",
                "presentation": "inline_scene",
                "src": "media/images/cy-l15-scene-allan.svg",
                "alt": "Outside the warm library, tiny red Dafi hurries toward the distant hill with Mali following; Sam approaches from the sea-green café while Iwan stands in the library doorway with the old key.",
                "covers_lexeme_ids": [
                  "cy-es",
                  "cy-aeth",
                  "cy-daeth",
                  "cy-allan"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s009",
            "text": "Aeth Dafi o'r llyfrgell, aeth e i'r stryd, ac aeth e ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s010",
            "text": "Aeth Mali allan hefyd, ac aeth hi i'r stryd gyda Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s011",
            "text": "Agorodd Nia'r ffenestr; edrychodd hi ar Dafi a Mali yn y stryd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s02",
        "title": "Dau ateb",
        "segments": [
          {
            "id": "cy-draig-01-l15-s013",
            "text": "Daeth Mali yn ôl gyntaf, a daeth Dafi yn ôl ar ei hôl hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s014",
            "text": "Mae Nia'n agor y llyfr eto ac yn rhoi papur mawr ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s015",
            "text": "Gofynnodd hi, “Ble aeth Dafi?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s016",
            "text": "Atebodd Mali, “Aeth Dafi allan gyntaf. Es i allan gyda Dafi.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s017",
            "text": "“Es i ycw, ddim adref. Aeth Dafi ycw hefyd.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-allan-adref",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l15-allan-adref.svg",
                "alt": "One panel shows Dafi going out through the library door, labelled allan; another shows Mali going toward a small home, labelled adref.",
                "covers_lexeme_ids": [
                  "cy-allan",
                  "cy-adref",
                  "cy-es",
                  "cy-aeth"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s018",
            "text": "Ces i bapur gan Nia, a gwnes i lun o'r drws a'r stryd.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s020",
            "text": "Atebodd Dafi, “Aeth Mali allan gyntaf. Es i allan gyda Mali.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s021",
            "text": "“Aeth Mali i'r caffi, ond es i ycw. Gwnes i chwilio ycw.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s023",
            "text": "Gofynnodd Nia, “Pwy aeth i'r caffi?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s024",
            "text": "“Sam,” atebodd Mali. “Ond dydy Sam ddim yma nawr.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s03",
        "title": "Sam ac Iwan",
        "segments": [
          {
            "id": "cy-draig-01-l15-s025",
            "text": "Yn sydyn, agorodd drws y llyfrgell, a daeth Sam o'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s027",
            "text": "“Des i o'r caffi,” atebodd Sam. “Es i ddim adref.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-gwneud-cael",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l15-gwneud-cael.svg",
                "alt": "Paired panels show Mali saying gwnes i lun and Dafi as gwnaeth hi lun, then Iwan saying ces i'r allwedd and Mali as cafodd e'r allwedd.",
                "covers_lexeme_ids": [
                  "cy-gwnes",
                  "cy-gwnaeth",
                  "cy-ces",
                  "cy-cafodd"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s028",
            "text": "“Ces i ddŵr yn y caffi, a gwnes i gacen yn y bore.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s029",
            "text": "Gofynnodd Nia, “Pwy ddaeth i'r caffi?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s030",
            "text": "Atebodd Sam, “Daeth Dafi i'r caffi. Daeth e at y drws.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s031",
            "text": "“Es i ycw, ddim i'r caffi!” atebodd Dafi, ac edrychodd ar Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s033",
            "text": "Daeth Iwan o du ôl i'r silff, gyda'r hen lyfr yn ei fag e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s034",
            "text": "“Es i ddim adref,” atebodd Iwan. “Es i tu ôl i'r silff.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s035",
            "text": "“Gwnes i chwilio yn fy mag i ac yn yr hen lyfr.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s036",
            "text": "“Ces i'r allwedd.” Cafodd Iwan yr hen allwedd o'r llyfr.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s04",
        "title": "Pedwar llun",
        "segments": [
          {
            "id": "cy-draig-01-l15-s037",
            "text": "Cafodd Mali bensil, cafodd Sam bapur, a chafodd Dafi ychydig o gacen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s038",
            "text": "Gwnaeth Mali lun o'r llyfrgell, y stryd, a Dafi ycw.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-pedwar-llwybr",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l15-pedwar-llwybr.svg",
                "alt": "A simple four-colour route diagram reconciles Dafi going from the library toward the hill, Mali following, Sam coming from the café, and Iwan getting the key; a dotted fifth route from beneath the shelf is labelled llwybr.",
                "covers_lexeme_ids": [
                  "cy-aeth",
                  "cy-daeth",
                  "cy-gwnaeth",
                  "cy-cafodd",
                  "cy-l15-llwybr"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s039",
            "text": "Gwnaeth Sam lun o'r caffi, y ddau gwpan, a drws y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s040",
            "text": "Gwnaeth Iwan lun o'r silff, yr hen lyfr, a'r allwedd fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s041",
            "text": "Gwnaeth Dafi lun o Fali, Pero, y stryd, a'r drws coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s042",
            "text": "Dafi: “Es i o'r llyfrgell i'r stryd. Es i ycw.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s043",
            "text": "Mali: “Es i allan gyda Dafi. Des i yn ôl gyda fy llun i.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s044",
            "text": "Sam: “Des i o'r caffi. Daeth Dafi at ddrws y caffi.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s045",
            "text": "Iwan: “Ces i'r allwedd. Des i o du ôl i'r silff.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s046",
            "text": "Mae'r pedwar llun ar y bwrdd, ac mae'r hen allwedd ar lun Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s047",
            "text": "Ond dydy Pero ddim yn llun Mali, Sam, nac Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s048",
            "text": "Gofynnodd Nia eto, “Ble aeth Pero?”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s05",
        "title": "Llwybr Pero",
        "segments": [
          {
            "id": "cy-draig-01-l15-s049",
            "text": "Yn sydyn daeth Pero o dan yr hen silff; mae mwd ar ei draed e.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-scene-pero",
                "presentation": "inline_scene",
                "src": "media/images/cy-l15-scene-pero.svg",
                "alt": "Muddy black-and-white Pero emerges beside a newly visible narrow path beneath the old shelf; Mali, tiny red Dafi, Sam, Nia, and Iwan stare while the old key rests on their four route drawings.",
                "covers_lexeme_ids": [
                  "cy-daeth",
                  "cy-l15-mwd",
                  "cy-l15-traed",
                  "cy-l15-llwybr"
                ]
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s050",
            "text": "Daeth Pero yn ôl, ond ddaeth e ddim o'r drws na'r ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s051",
            "text": "Aeth Pero ar bapur Mali, a gwnaeth e lun gyda'i draed e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s052",
            "text": "Edrychodd pawb ar lun Pero: un, dau, tri, pedwar ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s053",
            "text": "Edrychodd Mali dan y silff. Mae llwybr bach yno nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s054",
            "text": "Ddoe edrychodd Mali yno: dim llwybr. Edrychodd Iwan yno hefyd: dim llwybr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s055",
            "text": "Nawr mae'r llwybr yn mynd o dan y silff, o'r llyfrgell, ac ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s056",
            "text": "“Aeth Pero ar y llwybr,” atebodd Mali. “Daeth e yn ôl gyda mwd.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s057",
            "text": "Cafodd Iwan yr allwedd; cafodd Pero y llwybr; cafodd y ffrindiau ateb newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s058",
            "text": "Mae Nia'n rhoi'r allwedd ar lun Pero, wrth y drws bach coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s059",
            "text": "Mae Dafi'n edrych ar y llwybr, ar yr allwedd, ac ycw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s060",
            "text": "“Es i allan; aeth Pero ycw. Des i yn ôl; daeth Pero o'r llwybr.”",
            "inference_aids": []
          }
        ]
      }
    ]
  },
