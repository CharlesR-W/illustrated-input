  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l15-s01",
        "title": "Ar ôl y mwg",
        "segments": [
          {
            "id": "cy-draig-01-l15-s001",
            "text": "Mae arogl mwg yn y llyfrgell o hyd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l15-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l15-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 15."
              }
            ]
          },
          {
            "id": "cy-draig-01-l15-s002",
            "text": "Mae Nia eisiau gwybod beth ddigwyddodd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s003",
            "text": "Mae Mali, Sam a Dafi yn eistedd wrth y bwrdd mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s004",
            "text": "Mae Pero o dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s005",
            "text": "Mae pawb yn edrych ar y llun o'r tân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s006",
            "text": "“Pwy aeth allan gyntaf?” mae Nia'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s007",
            "text": "“Es i allan,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s008",
            "text": "“Aeth Pero allan gyda fi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s009",
            "text": "Aeth Sam i'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s010",
            "text": "Ond aeth Dafi i gefn y llyfrgell.” Mae Dafi'n edrych ar y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s011",
            "text": "“Pam est ti i'r cefn, Dafi?” mae Mali'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s012",
            "text": "“Roedd y blwch coch yno,” meddai Dafi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s02",
        "title": "Stori Mali",
        "segments": [
          {
            "id": "cy-draig-01-l15-s013",
            "text": "Mae Mali'n adrodd ei stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s014",
            "text": "“Es i allan drwy'r drws blaen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s015",
            "text": "Ces i fwced wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s016",
            "text": "Des i'n ôl gyda'r bwced, ond doedd dim dŵr ynddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s017",
            "text": "Felly es i i'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s018",
            "text": "Roedd Sam yn y caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s019",
            "text": "Gwnaeth Sam baned, ond gwnes i ddim paned.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s020",
            "text": "Ces i ddŵr oer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s021",
            "text": "Daeth Sam gyda fi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s022",
            "text": "Daeth Pero hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s023",
            "text": "Pan ddaethon ni'n ôl, roedd Nia wrth y drws.” Mae Nia'n nodio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s024",
            "text": "“Ie.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s025",
            "text": "Ces i'r allwedd gan Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s026",
            "text": "Gwnes i agor y drws mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s027",
            "text": "Aeth Mali a Sam i mewn.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s03",
        "title": "Stori Dafi",
        "segments": [
          {
            "id": "cy-draig-01-l15-s028",
            "text": "Nawr mae Dafi'n adrodd ei stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s029",
            "text": "“Aeth pawb allan, ond es i i'r cefn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s030",
            "text": "Roedd y blwch coch ar y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s031",
            "text": "Ces i'r blwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s032",
            "text": "Roedd papur yn y blwch, a ches i syniad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s033",
            "text": "Gwnes i lun o'r tân ar y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s034",
            "text": "Yna clywais i Mali wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s035",
            "text": "Des i'n ôl gyda'r llun.” “Ond pam?” mae Sam yn gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s036",
            "text": "“Roedd y llun yn dangos y mwg,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s037",
            "text": "“Roedd y mwg yn dod o'r hen lamp, nid o'r llyfrau.” Mae Nia'n edrych ar y lamp.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s038",
            "text": "“Da iawn, Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s039",
            "text": "Ces i ateb oherwydd y llun.” Mae Dafi'n gwenu.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s04",
        "title": "Beth ddigwyddodd?",
        "segments": [
          {
            "id": "cy-draig-01-l15-s040",
            "text": "Mae'r pedwar yn rhoi'r storïau mewn trefn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s041",
            "text": "Aeth Mali allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s042",
            "text": "Aeth Sam i'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s043",
            "text": "Aeth Dafi i'r cefn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s044",
            "text": "Ces i fwced, meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s045",
            "text": "Ces i ddŵr, meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s046",
            "text": "Ces i flwch, meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s047",
            "text": "Daeth Mali a Sam yn ôl gyda dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s048",
            "text": "Daeth Dafi yn ôl gyda llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s049",
            "text": "Gwnaeth Nia agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s050",
            "text": "Gwnaeth pawb helpu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s051",
            "text": "“Felly, pwy wnaeth y tân?” mae Pero'n edrych ar y lamp.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s052",
            "text": "Nid person wnaeth y tân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s053",
            "text": "Gwnaeth yr hen lamp y mwg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s054",
            "text": "Mae Nia'n diffodd y lamp.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s055",
            "text": "Ar ddiwedd y dydd, aeth Sam adref.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s056",
            "text": "Aeth Nia adref yn hwyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s057",
            "text": "Aeth Pero gyda Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s058",
            "text": "Aeth Dafi allan yn olaf, gyda'i lun o dan ei fraich.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l15-s05",
        "title": "Tair stori, un digwyddiad",
        "segments": [
          {
            "id": "cy-draig-01-l15-s059",
            "text": "Mae Nia'n gofyn i bob un adrodd yr un digwyddiad unwaith eto, ond y tro hwn heb edrych ar y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s060",
            "text": "Mae Mali'n dechrau: “Es i allan oherwydd roedd angen dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s061",
            "text": "Ces i fwced gwag, felly es i at Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s062",
            "text": "Des i'n ôl gyda Sam a dŵr.” Mae Sam yn parhau: “Es i i'r caffi cyn Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s063",
            "text": "Gwnes i baratoi dŵr, nid paned.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s064",
            "text": "Pan ddaeth Mali, des i'n ôl gyda hi.” Mae Dafi'n gorffen: “Es i i'r cefn oherwydd gwelais i'r blwch coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s065",
            "text": "Ces i bapur ynddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s066",
            "text": "Gwnes i lun o'r mwg, ac yna des i'n ôl.” Mae Nia'n ysgrifennu pedwar pâr ar y bwrdd: es i—aeth; des i—daeth; gwnes i—gwnaeth; ces i—cafodd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s067",
            "text": "Mae Mali'n darllen pob pâr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s068",
            "text": "Es i allan; aeth Pero allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s069",
            "text": "Des i'n ôl; daeth Sam yn ôl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s070",
            "text": "Gwnes i chwilio; gwnaeth Dafi lun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s071",
            "text": "Ces i ddŵr; cafodd Dafi bapur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s072",
            "text": "Nawr mae trefn y stori'n glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s073",
            "text": "Nid yw'r tri adroddiad yn cystadlu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s074",
            "text": "Mae pob un yn dangos rhan wahanol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s075",
            "text": "Aeth Mali am gymorth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s076",
            "text": "Gwnaeth Sam baratoi'r dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s077",
            "text": "Cafodd Dafi y cliw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s078",
            "text": "Daeth y tri yn ôl at Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s079",
            "text": "“A beth wnes i?” mae Nia'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s080",
            "text": "“Gwnaethost ti wrando,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s081",
            "text": "Nid yw'r ffurf hon ar y bwrdd eto, ond mae pawb yn deall y weithred.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l15-s082",
            "text": "Mae Nia'n gwenu ac yn tynnu cylch o gwmpas y pedwar pâr.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
