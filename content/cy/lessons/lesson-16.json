  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l16-s01",
        "title": "Y map yn y llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l16-s001",
            "text": "Y bore wedyn, mae Mali'n agor yr hen lyfr.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l16-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l16-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 16."
              }
            ]
          },
          {
            "id": "cy-draig-01-l16-s002",
            "text": "Mae map bach rhwng dwy dudalen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s003",
            "text": "“Edrychwch,” meddai hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s004",
            "text": "“Mae'r map yn dangos y llyfrgell.” Mae Iwan yn dod at y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s005",
            "text": "Mae'n edrych ar y map am amser hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s006",
            "text": "“Roedd y llyfrgell yn wahanol pan oeddwn i'n fach,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s007",
            "text": "“Roedd drws yma, ond doedd dim ffenestr yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s008",
            "text": "Roedd y caffi yn y cefn, a roedd y bwrdd mawr wrth y wal.” Mae Mali'n edrych o'r map i'r ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s009",
            "text": "Nawr mae ffenestr fawr wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s010",
            "text": "Nawr mae'r caffi ar yr ochr arall.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l16-s02",
        "title": "Yr ystafell gynt",
        "segments": [
          {
            "id": "cy-draig-01-l16-s011",
            "text": "Mae Iwan yn cofio'r hen ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s012",
            "text": "“Roedd dau fwrdd hir yn y canol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s013",
            "text": "Roedd y llyfrau Cymraeg ar y chwith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s014",
            "text": "Roedd y llyfrau mawr ar y dde.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s015",
            "text": "Doedd dim cyfrifiadur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s016",
            "text": "Doedd dim caffi newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s017",
            "text": "Roedd cadair goch wrth bob bwrdd.” “Oedd y blwch coch yma?” mae Dafi'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s018",
            "text": "“Oedd,” meddai Iwan, “ond roedd e ar silff uchel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s019",
            "text": "Doedd e ddim ar y llawr.” Mae Dafi'n edrych i fyny.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s020",
            "text": "Mae hen farc coch ar y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s021",
            "text": "Mae'r marc uwchben y silff newydd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l16-s03",
        "title": "Y map a'r ystafell",
        "segments": [
          {
            "id": "cy-draig-01-l16-s022",
            "text": "Mae Mali'n rhoi'r map ar y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s023",
            "text": "Mae hi'n cerdded o'r hen ddrws i'r hen gaffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s024",
            "text": "Roedd y drws lle mae'r ffenestr nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s025",
            "text": "Roedd y caffi lle mae'r bwrdd mawr nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s026",
            "text": "Roedd y blwch ar y silff lle mae'r llun o'r ddraig nawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s027",
            "text": "Mae Pero'n dilyn Mali o gwmpas yr ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s028",
            "text": "Mae Dafi'n symud cadair i'r hen le.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s029",
            "text": "“Roedd y gadair yma?” mae'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s030",
            "text": "“Nac oedd,” meddai Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s031",
            "text": "“Roedd hi wrth y drws.” Mae Dafi'n symud y gadair eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s032",
            "text": "Nawr mae'r map a'r ystafell yn cyd-fynd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l16-s04",
        "title": "Marc newydd",
        "segments": [
          {
            "id": "cy-draig-01-l16-s033",
            "text": "Ond mae un peth yn rhyfedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s034",
            "text": "Mae seren fach ar y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s035",
            "text": "Roedd y seren y tu ôl i'r blwch coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s036",
            "text": "Doedd dim drws yno, meddai Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s037",
            "text": "Doedd dim ffenestr yno chwaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s038",
            "text": "Roedd wal wen yn unig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s039",
            "text": "Mae Mali'n edrych ar y wal bresennol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s040",
            "text": "Mae llun mawr o'r harbwr arni.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s041",
            "text": "Mae hi'n symud y llun ychydig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s042",
            "text": "Y tu ôl iddo mae'r un seren fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s043",
            "text": "“Roedd y seren yma pan oeddet ti'n fach?” mae hi'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s044",
            "text": "“Nac oedd,” meddai Iwan yn araf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s045",
            "text": "Roedd y map yn hen, ond roedd y seren yn newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s046",
            "text": "Mae rhywun wedi ychwanegu marc at yr hen fap.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l16-s05",
        "title": "Cof a map",
        "segments": [
          {
            "id": "cy-draig-01-l16-s047",
            "text": "Mae Mali'n copïo'r map ar ddarn mawr o bapur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s048",
            "text": "Ar un ochr mae hi'n ysgrifennu NAWR; ar yr ochr arall mae hi'n ysgrifennu CYNT.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s049",
            "text": "Nawr mae'r caffi ar y dde; cynt roedd y caffi yn y cefn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s050",
            "text": "Nawr mae un bwrdd mawr; cynt roedd dau fwrdd hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s051",
            "text": "Nawr mae cyfrifiadur wrth y ffenestr; cynt doedd dim cyfrifiadur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s052",
            "text": "Nawr mae'r blwch coch ar y llawr; cynt roedd e ar silff uchel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s053",
            "text": "Mae Dafi'n darllen y parau ac yn cerdded i bob lle.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s054",
            "text": "Mae Iwan yn ei gywiro pan fo angen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s055",
            "text": "“Roedd y drws fan hyn.” “Nac oedd; roedd e wrth y wal arall.” “Oedd y llyfrau mawr ar y chwith?” “Nac oedden; roedd y llyfrau Cymraeg ar y chwith.” Mae'r cwestiynau'n helpu Iwan i gofio mwy.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s056",
            "text": "Pan oedd e'n fach, roedd y llyfrgell yn dawel yn y bore, ond roedd hi'n brysur ar ôl ysgol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s057",
            "text": "Roedd ei fam yn gweithio wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s058",
            "text": "Roedd ei dad yn dod o'r harbwr gyda phapurau gwlyb.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s059",
            "text": "Roedd Iwan yn eu rhoi wrth y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s060",
            "text": "Un diwrnod roedd y map yn un o'r papurau hynny.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s061",
            "text": "Roedd y llinell las arno, ond doedd dim seren.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s062",
            "text": "Mae Mali'n rhoi seren newydd ar ei chopi, mewn lliw gwahanol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l16-s063",
            "text": "Bellach mae'r copi'n dangos dau amser: y map fel roedd e, a'r map fel mae e nawr.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
