  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l17-s01",
        "title": "Pan oedd Iwan yn ifanc",
        "segments": [
          {
            "id": "cy-draig-01-l17-s001",
            "text": "Mae pawb eisiau gwybod am y map.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l17-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l17-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 17."
              }
            ]
          },
          {
            "id": "cy-draig-01-l17-s002",
            "text": "Mae Iwan yn eistedd wrth y ffenestr ac yn edrych ar lun yr harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s003",
            "text": "“Pan oeddwn i'n ifanc,” meddai, “roeddwn i'n dod i'r llyfrgell bob dydd Sadwrn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s004",
            "text": "Roeddet ti'n darllen?” mae Mali'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s005",
            "text": "“Oeddwn, ond roeddwn i'n gweithio yn yr harbwr hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s006",
            "text": "Roedd fy nhad yn pysgota.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s007",
            "text": "Pan oedden ni'n mynd i'r môr, roedd y map hwn gyda ni.” Mae Iwan yn rhoi bys ar linell las y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s008",
            "text": "Mae'r llinell yn mynd o'r llyfrgell i'r harbwr, ac o'r harbwr i ynys fach.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l17-s02",
        "title": "Y bore yn yr harbwr",
        "segments": [
          {
            "id": "cy-draig-01-l17-s009",
            "text": "Un bore, pan oedd Iwan yn un ar bymtheg, roedd yr awyr yn las a'r môr yn dawel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s010",
            "text": "Roedd Iwan a'i dad yn paratoi'r cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s011",
            "text": "Roedd ei dad yn rhoi'r rhwyd yn y cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s012",
            "text": "Roedd Iwan yn rhoi dŵr a bara ynddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s013",
            "text": "Roedd pysgotwyr eraill yn siarad ar y lan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s014",
            "text": "“Roedden ni'n meddwl bod y tywydd yn dda,” meddai Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s015",
            "text": "“Roeddwn i'n hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s016",
            "text": "Roedd fy nhad yn hapus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s017",
            "text": "Pan oedden ni'n gadael yr harbwr, roedd Pero arall—ci fy nhad—yn rhedeg ar hyd y lan.” Mae Pero presennol yn codi ei ben wrth glywed y gair ci.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l17-s03",
        "title": "Y storm",
        "segments": [
          {
            "id": "cy-draig-01-l17-s018",
            "text": "Pan oedden nhw yng nghanol y môr, newidiodd y tywydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s019",
            "text": "Roedd y gwynt yn gryf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s020",
            "text": "Roedd y glaw yn drwm.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s021",
            "text": "Roedd y cwch bach yn mynd i fyny ac i lawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s022",
            "text": "Roedd Iwan yn dal y map, ac roedd ei dad yn dal y cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s023",
            "text": "“Oeddet ti'n ofnus?” mae Dafi'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s024",
            "text": "“Oeddwn,” meddai Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s025",
            "text": "“Roeddwn i'n ofnus iawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s026",
            "text": "Pan oedd y storm yn gryf, roedden ni'n gweld golau ar yr ynys.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s027",
            "text": "Roedd cwch arall ger y golau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s028",
            "text": "Roedd dau berson yn y dŵr.” Roedd tad Iwan yn troi'r cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s029",
            "text": "Roedd Iwan yn taflu rhaff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s030",
            "text": "Roedd y ddau berson yn dal y rhaff, ac roedd y pysgotwyr yn eu tynnu i'r cwch.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l17-s04",
        "title": "Y daith adref",
        "segments": [
          {
            "id": "cy-draig-01-l17-s031",
            "text": "Ar ôl y storm, roedd pawb yn oer ac yn wlyb.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s032",
            "text": "Roedd y môr yn dawel eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s033",
            "text": "Roedden nhw'n dod yn ôl i'r harbwr yn araf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s034",
            "text": "Pan oedden nhw'n cyrraedd y lan, roedd llawer o bobl yn aros.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s035",
            "text": "Roedd mam Iwan yno.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s036",
            "text": "Roedd y ci yno hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s037",
            "text": "“Pan oeddwn i'n cerdded adref,” meddai Iwan, “roedd y map yn fy mhoced.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s038",
            "text": "Yn y llyfrgell, roeddwn i'n sychu'r map wrth y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s039",
            "text": "Wedyn roedd marc glas newydd arno—llinell y daith.” Mae Mali'n edrych ar y llinell las.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s040",
            "text": "Nawr mae hi'n deall: nid addurn yw'r llinell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s041",
            "text": "Cof am daith ydy hi.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l17-s05",
        "title": "Y map sych",
        "segments": [
          {
            "id": "cy-draig-01-l17-s042",
            "text": "Mae Iwan yn troi'r map drosodd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s043",
            "text": "Mae smotiau golau ar y cefn lle roedd dŵr y môr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s044",
            "text": "“Pan oedden ni'n dod adref,” meddai, “roeddwn i'n meddwl bod y map wedi'i golli.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s045",
            "text": "Roedd e'n wlyb iawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s046",
            "text": "Pan oedd fy mam yn ei weld, roedd hi'n rhoi'r map rhwng dau lyfr mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s047",
            "text": "Bob bore roeddwn i'n edrych arno.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s048",
            "text": "Roedd e'n sychu'n araf.” Mae Mali'n cymharu'r smotiau â'r llinell las.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s049",
            "text": "Mae un smotyn wrth yr ynys, lle roedd y storm.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s050",
            "text": "Mae un wrth yr harbwr, lle roedd y bobl yn aros.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s051",
            "text": "Mae un wrth y llyfrgell, lle roedd y map yn sychu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s052",
            "text": "Felly mae'r map yn cadw mwy nag un math o gof: llinell a dynnodd person, a marciau a wnaeth y dŵr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s053",
            "text": "Mae Dafi'n ailadrodd y daith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s054",
            "text": "Pan oedd y bore'n dawel, roedd Iwan yn paratoi'r cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s055",
            "text": "Pan oedd y storm yn gryf, roedd e'n dal y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s056",
            "text": "Pan oedd pobl yn y dŵr, roedd e'n taflu'r rhaff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s057",
            "text": "Pan oedden nhw ar y lan, roedd pawb yn aros.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s058",
            "text": "Pan oedd y map yn y llyfrgell, roedd e'n sychu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s059",
            "text": "Mae Iwan yn nodio ar ôl pob cam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s060",
            "text": "Dyma'r union stori roedd y llinell las yn ei chuddio.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l17-s06",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l17-s061",
            "text": "Mae Mali'n rhoi'r map wrth ymyl llun yr harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s062",
            "text": "Pan oedd Iwan yn ifanc, roedd y llun yn newydd; nawr mae e'n hen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l17-s063",
            "text": "Ond mae'r môr, yr ynys a'r llinell las yn dal yno.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
