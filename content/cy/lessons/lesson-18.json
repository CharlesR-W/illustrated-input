  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l18-s01",
        "title": "Yr hysbysiad",
        "segments": [
          {
            "id": "cy-draig-01-l18-s001",
            "text": "Mae hysbysiad mawr ar ddrws y llyfrgell: BYDD Y LLYFRGELL AR GAU.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l18-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l18-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 18."
              }
            ]
          },
          {
            "id": "cy-draig-01-l18-s002",
            "text": "Mae Mali'n darllen y geiriau ddwywaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s003",
            "text": "“Bydd y llyfrgell ar gau?” mae hi'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s004",
            "text": "Mae Nia'n edrych yn drist.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s005",
            "text": "“Bydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s006",
            "text": "Bydd y cyngor yn cau'r adeilad ar ddiwedd y mis.” Bydd y caffi ar gau hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s007",
            "text": "Bydd y bwrdd mawr yn wag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s008",
            "text": "Bydd y llyfrau mewn blychau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s009",
            "text": "Bydd y plant heb le i ddarllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s010",
            "text": "Mae Dafi'n edrych o'r hysbysiad i'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s011",
            "text": "“Bydd y ddraig heb gartref,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s012",
            "text": "Mae Pero'n eistedd ar ei droed.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l18-s02",
        "title": "Beth fydd yn digwydd?",
        "segments": [
          {
            "id": "cy-draig-01-l18-s013",
            "text": "“Beth fydd yn digwydd i'r map?” mae Sam yn gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s014",
            "text": "“Bydd e mewn blwch,” meddai Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s015",
            "text": "“A beth fydd yn digwydd i'r lluniau?” “Byddan nhw mewn blychau hefyd.” Mae Mali'n ysgwyd ei phen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s016",
            "text": "“Fydd y stori ddim mewn blwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s017",
            "text": "Bydd pobl Porth Helyg eisiau ei gweld.” Mae Iwan yn cytuno.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s018",
            "text": "Bydd e'n siarad am yr hen harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s019",
            "text": "Bydd Sam yn gwneud bwyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s020",
            "text": "Bydd Nia'n dangos yr hen lyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s021",
            "text": "Bydd Dafi'n dangos ei lun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s022",
            "text": "“A bydda i'n dangos y map,” meddai Mali.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l18-s03",
        "title": "Cynllun y ffrindiau",
        "segments": [
          {
            "id": "cy-draig-01-l18-s023",
            "text": "Mae'r ffrindiau'n gwneud cynllun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s024",
            "text": "Byddan nhw'n cynnal arddangosfa am straeon Porth Helyg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s025",
            "text": "Bydd yr arddangosfa yn y llyfrgell os gall fod, neu o flaen yr adeilad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s026",
            "text": "Bydd Mali'n ysgrifennu am y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s027",
            "text": "Bydd Iwan yn ysgrifennu am y storm.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s028",
            "text": "Bydd Sam yn paratoi'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s029",
            "text": "Bydd Nia'n cadw'r llyfrau arbennig yn ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s030",
            "text": "Bydd Dafi'n gwneud llun mawr o'r ddraig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s031",
            "text": "Bydd Pero yn croesawu pawb—neu bydd e'n bwyta'r bwyd, meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s032",
            "text": "Mae pawb yn chwerthin.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l18-s04",
        "title": "Yfory",
        "segments": [
          {
            "id": "cy-draig-01-l18-s033",
            "text": "“Pryd byddwn ni'n dechrau?” mae Nia'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s034",
            "text": "“Yfory,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s035",
            "text": "“Bydda i yma yn y bore.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s036",
            "text": "Bydd Sam yma am ddeg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s037",
            "text": "Bydd Iwan yma ar ôl cinio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s038",
            "text": "Bydd Dafi yma drwy'r dydd.” “Fydda i ddim yma drwy'r dydd,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s039",
            "text": "“Bydd rhaid i'r ddraig gysgu.” Mae Mali'n rhoi'r hysbysiad wrth ymyl y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s040",
            "text": "Mae un papur yn dweud y bydd y llyfrgell yn cau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s041",
            "text": "Mae'r papur arall yn dangos hanes y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s042",
            "text": "Yfory bydd y ffrindiau'n dewis pa stori fydd yn agor y drws.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l18-s05",
        "title": "Llythyr at y dref",
        "segments": [
          {
            "id": "cy-draig-01-l18-s043",
            "text": "Cyn mynd adref, mae Mali'n ysgrifennu llythyr byr at bobl Porth Helyg.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s044",
            "text": "Mae hi'n darllen pob llinell, ac mae'r lleill yn ychwanegu manylion.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s045",
            "text": "“Bydd arddangosfa yn y llyfrgell.” “Bydd hen fap yno.” “Bydd Iwan yn adrodd stori'r storm.” “Bydd Nia'n dangos y llyfrau arbennig.” “Bydd Sam yn paratoi bwyd.” “Bydd Dafi'n dangos draig fawr.” Mae Dafi'n ychwanegu, “Bydd Pero yno hefyd.” Mae Nia'n gofyn beth fydd yn digwydd ar ôl yr arddangosfa.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s046",
            "text": "Bydd pobl yn ysgrifennu eu straeon.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s047",
            "text": "Bydd y straeon yn mynd ar y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s048",
            "text": "Bydd y cyngor yn gweld bod y llyfrgell yn bwysig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s049",
            "text": "Efallai bydd y cynllun cau'n newid, ond nid yw Mali'n dweud hynny fel ffaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s050",
            "text": "Mae hi'n cadw at yr hyn y gallan nhw ei wneud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s051",
            "text": "Byddan nhw'n paratoi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s052",
            "text": "Byddan nhw'n ysgrifennu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s053",
            "text": "Byddan nhw'n gwahodd pobl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s054",
            "text": "Byddan nhw'n dangos y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s055",
            "text": "Mae Sam yn gwneud dau gopi o'r llythyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s056",
            "text": "Bydd un ar ddrws y caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s057",
            "text": "Bydd un ar y giât.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s058",
            "text": "Bydd Mali'n gwneud mwy yfory.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s059",
            "text": "Pan maen nhw'n gadael, mae'r hysbysiad cau o hyd ar y drws, ond mae llythyr yr arddangosfa wrth ei ymyl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s060",
            "text": "Mae'r ddau yn sôn am y dyfodol; dim ond un ohonyn nhw sy'n cynnig gobaith.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l18-s06",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l18-s061",
            "text": "Drannoeth, mae pob person yn cadw ei addewid.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s062",
            "text": "Mae Mali'n dod yn gynnar ac yn ysgrifennu tri pharagraff.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s063",
            "text": "Mae Sam yn cyrraedd am ddeg gyda bara a chacennau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s064",
            "text": "Mae Iwan yn dod ar ôl cinio gyda hen lun o'r cwch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s065",
            "text": "Mae Nia'n dangos lle bydd y map yn ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s066",
            "text": "Mae Dafi'n dod â draig bapur sy'n rhy fawr i fynd drwy'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s067",
            "text": "Bydd rhaid iddo ei phlygu, ond fydd e ddim yn ei thorri.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s068",
            "text": "Ar ddiwedd y prynhawn, bydd y cynllun cyntaf yn barod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s069",
            "text": "Bydd y llyfrgell yn cau os na fydd dim yn newid, ond bydd pobl y dref yn gweld beth sydd ynddi cyn hynny.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l18-s070",
            "text": "Bydd pob un yn dod eto yn gynnar bore yfory.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
