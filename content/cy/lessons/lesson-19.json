  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l19-s01",
        "title": "Dau gynllun",
        "segments": [
          {
            "id": "cy-draig-01-l19-s001",
            "text": "Mae'r arddangosfa yn agos, ond does neb yn gwybod sut bydd y tywydd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l19-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l19-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 19."
              }
            ]
          },
          {
            "id": "cy-draig-01-l19-s002",
            "text": "Mae Sam eisiau arddangos popeth tu allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s003",
            "text": "Mae Nia eisiau cadw'r hen lyfrau tu mewn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s004",
            "text": "Mae Mali'n tynnu dwy golofn ar bapur: HAUL a GLAW.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s005",
            "text": "“Bydd gennym ni ddau gynllun,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s006",
            "text": "“Os bydd hi'n heulog, bydd yr arddangosfa o flaen y llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s007",
            "text": "Os bydd hi'n bwrw glaw, bydd hi yn y neuadd.” Mae Dafi'n rhoi llun o haul uwchben un golofn a chwmwl uwchben y llall.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l19-s02",
        "title": "Os bydd haul",
        "segments": [
          {
            "id": "cy-draig-01-l19-s008",
            "text": "Maen nhw'n dechrau gyda'r cynllun haul.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s009",
            "text": "Os bydd hi'n heulog, bydd Sam yn rhoi byrddau tu allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s010",
            "text": "Bydd Nia'n agor y drws mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s011",
            "text": "Bydd Iwan yn siarad wrth y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s012",
            "text": "Bydd Mali'n rhoi'r lluniau ar y wal allanol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s013",
            "text": "Os bydd y gwynt yn ysgafn, bydd y papurau'n ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s014",
            "text": "Os bydd y gwynt yn gryf, byddan nhw'n defnyddio cerrig bach ar y corneli.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s015",
            "text": "Bydd Pero wrth y giât.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s016",
            "text": "Os bydd llawer o bobl yn dod, bydd Dafi'n dangos y ffordd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s017",
            "text": "“Os bydd Pero'n dangos y ffordd,” meddai Sam, “bydd pawb yn mynd i'r caffi.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l19-s03",
        "title": "Os bydd glaw",
        "segments": [
          {
            "id": "cy-draig-01-l19-s018",
            "text": "Nawr y cynllun glaw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s019",
            "text": "Os bydd hi'n bwrw glaw, bydd pawb tu mewn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s020",
            "text": "Bydd y llyfrau'n sych yn y neuadd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s021",
            "text": "Bydd Sam yn rhoi'r bwyd yn y caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s022",
            "text": "Bydd Nia'n cadw'r drws ar agor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s023",
            "text": "Os bydd pobl yn wlyb, bydd tywelion wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s024",
            "text": "Os bydd y gwynt yn gryf, bydd y ffenestri ar gau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s025",
            "text": "Os bydd plant yn dod, bydd Dafi'n adrodd stori'r ddraig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s026",
            "text": "Os bydd y neuadd yn llawn, bydd Iwan yn siarad ddwywaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s027",
            "text": "Mae'r cynllun glaw yn hirach, ond mae popeth ynddo'n ddiogel.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l19-s04",
        "title": "Y dewis",
        "segments": [
          {
            "id": "cy-draig-01-l19-s028",
            "text": "Mae Mali'n edrych ar y ddau gynllun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s029",
            "text": "“Does dim angen dewis nawr,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s030",
            "text": "“Byddwn ni'n paratoi'r ddau.” Maen nhw'n rhoi pabell fach wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s031",
            "text": "Os bydd haul, bydd y babell yn rhoi cysgod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s032",
            "text": "Os bydd glaw, bydd hi'n cadw'r ymwelwyr yn sych.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s033",
            "text": "Maen nhw'n rhoi'r byrddau ger y neuadd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s034",
            "text": "Os bydd y tywydd yn newid, bydd yn hawdd eu symud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s035",
            "text": "Yn sydyn mae diferion ar y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s036",
            "text": "Mae Dafi'n edrych allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s037",
            "text": "“Mae hi'n bwrw glaw!” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s038",
            "text": "Ond munud wedyn, mae'r haul yn dod allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s039",
            "text": "Mae pawb yn chwerthin.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s040",
            "text": "Mae Porth Helyg eisoes yn profi'r ddau gynllun.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l19-s05",
        "title": "Profi’r cynlluniau",
        "segments": [
          {
            "id": "cy-draig-01-l19-s041",
            "text": "Y diwrnod wedyn, mae'r ffrindiau'n profi'r cynlluniau heb aros am y tywydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s042",
            "text": "Mae Sam yn sefyll tu allan ac yn galw, “Haul!” Mae pawb yn symud y byrddau at y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s043",
            "text": "Mae Mali'n gosod y map mewn lle sych.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s044",
            "text": "Mae Dafi'n rhoi cerrig ar gorneli'r papurau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s045",
            "text": "Yna mae Sam yn galw, “Glaw!” Mae pawb yn cario'r pethau i'r neuadd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s046",
            "text": "Mae Nia'n cau'r ffenestri.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s047",
            "text": "Mae Iwan yn rhoi tywelion wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s048",
            "text": "Y tro cyntaf, mae un llun yn aros tu allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s049",
            "text": "Y tro nesaf, mae Mali'n ychwanegu'r llun at ei rhestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s050",
            "text": "Os bydd Sam yn galw haul, bydd Dafi'n agor y babell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s051",
            "text": "Os bydd e'n galw glaw, bydd Dafi'n cau ei hochrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s052",
            "text": "Os bydd y gwynt yn gryf, bydd Nia'n symud y llyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s053",
            "text": "Os bydd y neuadd yn llawn, bydd Iwan yn dechrau ei ail stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s054",
            "text": "Maen nhw'n profi'r newid dair gwaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s055",
            "text": "Bob tro mae'n gyflymach ac yn dawelach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s056",
            "text": "Ar y diwedd, mae Pero'n rhedeg i mewn cyn i Sam alw unrhyw beth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s057",
            "text": "Mae e wedi gweld cwmwl tywyll drwy'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s058",
            "text": "Eiliad wedyn, mae glaw'n taro'r ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s059",
            "text": "“Pero sy'n gwybod y tywydd,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s060",
            "text": "Mae cynllun y glaw eisoes yn barod.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l19-s06",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l19-s061",
            "text": "Mae Mali'n ysgrifennu'r penderfyniadau ar gefn y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s062",
            "text": "Bydd y map tu mewn bob amser, oherwydd rhaid iddo aros yn sych.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s063",
            "text": "Bydd copïau o'r map tu allan os bydd haul.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s064",
            "text": "Bydd y bwyd o dan y babell os bydd y gwynt yn ysgafn; os bydd y gwynt yn gryf, bydd e yn y caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s065",
            "text": "Bydd y stori gyntaf wrth y drws, fel y gall pobl ei chlywed cyn mynd i mewn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s066",
            "text": "Mae pob penderfyniad yn gweithio yn y ddau gynllun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s067",
            "text": "Felly nid dau ddigwyddiad gwahanol sydd ganddyn nhw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s068",
            "text": "Un arddangosfa ydy hi, gyda ffordd hyblyg o ymateb i'r haul, y glaw a'r gwynt.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s069",
            "text": "Os bydd popeth yn barod, fydd neb yn ofni'r cymylau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l19-s070",
            "text": "Mae'n gweithio.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
