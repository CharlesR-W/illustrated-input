      "directions": "Cwblhewch o ystyr y stori. Atebwch yn Gymraeg.",
      "items": [
        {
          "id": "pb1",
          "prompt": "Dewiswch y gair Cymraeg cywir o'r stori: sy'n.",
          "type": "cloze",
          "accepted_answers": [
            "sy'n"
          ]
        },
