  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l20-s01",
        "title": "Y pos",
        "segments": [
          {
            "id": "cy-draig-01-l20-s001",
            "text": "Mae Mali'n darllen neges ar gefn y map: CHWILIWCH AM Y LLYFR SY'N CANU.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l20-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l20-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 20."
              }
            ]
          },
          {
            "id": "cy-draig-01-l20-s002",
            "text": "“Llyfr sy'n canu?” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s003",
            "text": "“Dydy llyfr ddim yn canu.” Ond mae Dafi'n clywed sain fach wrth y ffenestr: hŵŵ, hŵŵ.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s004",
            "text": "Mae'r sain yn stopio pan fydd y gwynt yn stopio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s005",
            "text": "Mae'n dechrau eto pan fydd y gwynt yn dod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s006",
            "text": "“Mae rhywbeth sy'n canu yma,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s007",
            "text": "Mae Nia'n dod â thri llyfr arbennig: llyfr coch sy'n agor yn hawdd, llyfr glas sydd â chloch fach, a llyfr gwyrdd sy'n hen iawn.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l20-s02",
        "title": "Tri llyfr",
        "segments": [
          {
            "id": "cy-draig-01-l20-s008",
            "text": "Mae Sam yn dewis y llyfr glas.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s009",
            "text": "“Dyma'r llyfr sy'n canu,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s010",
            "text": "Mae'n symud y llyfr, ac mae'r gloch yn gwneud sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s011",
            "text": "Ond pan mae'r llyfr ar y bwrdd, dydy e ddim yn canu gyda'r gwynt.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s012",
            "text": "“Mae hwn yn llyfr sydd â chloch,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s013",
            "text": "“Nid y llyfr sy'n canu gyda'r gwynt.” Mae Nia'n dewis y llyfr coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s014",
            "text": "Mae ei dudalennau'n symud yn y gwynt, ond does dim sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s015",
            "text": "“Mae hwn yn llyfr sy'n dawnsio,” meddai Dafi, “ond nid llyfr sy'n canu.”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l20-s03",
        "title": "Y llyfr sy’n canu",
        "segments": [
          {
            "id": "cy-draig-01-l20-s016",
            "text": "Mae Mali'n edrych ar y llyfr gwyrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s017",
            "text": "Mae e'n llyfr sydd â chloriau trwchus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s018",
            "text": "Mae twll bach yn un clawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s019",
            "text": "Pan mae Mali'n dal y twll wrth y ffenestr, mae'r gwynt yn mynd drwyddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s020",
            "text": "Hŵŵ, hŵŵ.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s021",
            "text": "Mae pawb yn clywed y sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s022",
            "text": "“Dyma'r llyfr sy'n canu!” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s023",
            "text": "Mae Iwan yn gwybod y sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s024",
            "text": "“Mae hwn yn debyg i chwiban,” meddai.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s025",
            "text": "Mae'r twll sy'n gwneud y sain yn fwriadol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s026",
            "text": "Mae marc bach o gwmpas y twll—yr un seren sydd ar y map.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l20-s04",
        "title": "Yr ateb",
        "segments": [
          {
            "id": "cy-draig-01-l20-s027",
            "text": "Mae Nia'n agor y llyfr sy'n canu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s028",
            "text": "Mae llawer o dudalennau'n wag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s029",
            "text": "Ond yng nghanol y llyfr mae llun o'r hen lyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s030",
            "text": "Mae seren wrth y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s031",
            "text": "Mae'r llun sy'n dangos y seren yn edrych fel map Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s032",
            "text": "Mae nodyn o dan y llun: MAE'R DRWS SYDD HEB DDOLEN Y TU ÔL I'R STORI.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s033",
            "text": "“Pos arall,” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s034",
            "text": "Mae Dafi'n gwrando ar y llyfr unwaith eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s035",
            "text": "Nawr mae'r sain yn glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s036",
            "text": "Nid cân mewn geiriau ydy hi, ond cân y gwynt.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s037",
            "text": "Y llyfr anghywir oedd y llyfr â'r gloch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s038",
            "text": "Y llyfr cywir ydy'r llyfr sydd â'r twll.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l20-s05",
        "title": "Pethau sy’n gwneud sain",
        "segments": [
          {
            "id": "cy-draig-01-l20-s039",
            "text": "Mae Dafi eisiau gwneud yn siŵr bod eu hateb yn gywir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s040",
            "text": "Mae'n casglu pethau eraill sy'n gwneud sain: y gloch sy'n canu pan mae rhywun yn ei symud, y drws sy'n sgrechian pan mae'n agor, a'r ffenestr sy'n curo pan mae'r gwynt yn gryf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s041",
            "text": "Mae Mali'n disgrifio pob un.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s042",
            "text": "Dyma gloch sy'n gwneud sain oherwydd llaw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s043",
            "text": "Dyma ddrws sy'n gwneud sain oherwydd ei hen bren.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s044",
            "text": "Dyma ffenestr sy'n gwneud sain oherwydd y gwynt.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s045",
            "text": "Ond dyma lyfr sydd â thwll arbennig; mae e'n gwneud un nodyn clir pan mae'r gwynt yn mynd drwyddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s046",
            "text": "Mae Sam yn rhoi'r tri llyfr yn ôl ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s047",
            "text": "Pa un sydd â chloch?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s048",
            "text": "Y llyfr glas.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s049",
            "text": "Pa un sy'n symud ei dudalennau?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s050",
            "text": "Y llyfr coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s051",
            "text": "Pa un sy'n canu drwy dwll?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s052",
            "text": "Y llyfr gwyrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s053",
            "text": "Mae Dafi'n cau ei lygaid tra bod Mali'n profi pob llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s054",
            "text": "Mae'n adnabod y llyfr cywir o'r sain yn unig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s055",
            "text": "Yna mae Nia'n cau'r ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s056",
            "text": "Heb wynt, does dim cân.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s057",
            "text": "Mae hi'n ei hagor, ac mae'r nodyn yn dychwelyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s058",
            "text": "Mae'r prawf yn cadarnhau'r cliw: nid unrhyw lyfr sy'n gwneud sain, ond y llyfr sy'n canu pan mae'r gwynt yn chwythu.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l20-s06",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l20-s059",
            "text": "Mae Mali'n copïo'r cliw o'r map ac yn rhoi llinell o dan y gair sy'n.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s060",
            "text": "Mae hi'n gofyn am ddisgrifiadau newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s061",
            "text": "Pero ydy'r ci sy'n aros wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s062",
            "text": "Iwan ydy'r dyn sy'n cofio'r harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s063",
            "text": "Nia ydy'r person sy'n cadw'r llyfrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s064",
            "text": "Sam ydy'r dyn sydd â'r caffi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s065",
            "text": "Dafi ydy'r bachgen sy'n clywed y sain gyntaf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s066",
            "text": "Y llyfr gwyrdd ydy'r llyfr sydd â thwll ac sy'n canu yn y gwynt.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s067",
            "text": "Mae pob disgrifiad yn dewis un person neu un peth o blith llawer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s068",
            "text": "Mae'r patrwm yn troi'n offeryn ar gyfer datrys y pos, nid rhestr o ffurfiau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s069",
            "text": "Pan mae Mali'n dweud “y llyfr gwyrdd”, mae'r lliw yn ddigon.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s070",
            "text": "Pan mae hi'n dweud “y llyfr sy'n canu”, mae'r weithred yn ddigon.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s071",
            "text": "Mae'r ddau yn arwain at yr un llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s072",
            "text": "Mae Sam yn cynnig “y llyfr sydd ar y chwith”, ond mae Mali'n ei symud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s073",
            "text": "Mae'r lle'n newid; dydy'r nodwedd ddim.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l20-s074",
            "text": "Mae'r llyfr yn dal yn un sy'n canu.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
