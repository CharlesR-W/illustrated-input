  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l21-s01",
        "title": "Y bwrdd cliwiau",
        "segments": [
          {
            "id": "cy-draig-01-l21-s001",
            "text": "Mae Mali'n gwneud bwrdd cliwiau.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l21-pattern",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l21-pattern.svg",
                "alt": "Diagram Cymraeg ar gyfer patrwm gwers 21."
              }
            ]
          },
          {
            "id": "cy-draig-01-l21-s002",
            "text": "Ar y chwith mae hi'n rhoi'r map a gafodd hi yn yr hen lyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s003",
            "text": "Yn y canol mae hi'n rhoi'r nodyn a ddarllenodd Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s004",
            "text": "Ar y dde mae hi'n rhoi'r allwedd a gollodd Dafi ddoe.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s005",
            "text": "“Do'n i ddim wedi colli'r allwedd,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s006",
            "text": "“Yr allwedd a roddodd Nia i mi oedd honno.” Mae Nia'n gofyn, “A ble mae'r allwedd nawr?” Mae Dafi'n edrych yn ei bocedi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s007",
            "text": "Mae Pero'n edrych o dan y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s008",
            "text": "Nid oes allwedd yno.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l21-s02",
        "title": "Y pethau a gafwyd",
        "segments": [
          {
            "id": "cy-draig-01-l21-s009",
            "text": "Maen nhw'n adolygu pob peth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s010",
            "text": "Y map a gafodd Mali oedd mewn llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s011",
            "text": "Y nodyn a ddarllenodd Sam oedd ar gefn y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s012",
            "text": "Y llyfr a ganodd yn y gwynt oedd ar silff ger y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s013",
            "text": "Y llun a welodd Nia oedd yng nghanol y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s014",
            "text": "Yr allwedd a gafodd Dafi oedd mewn blwch coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s015",
            "text": "Ond pa ddrws mae hi'n ei agor?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s016",
            "text": "Mae marc seren ar y map, ar y llyfr, ac ar yr allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s017",
            "text": "Mae'r tri marc yr un fath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s018",
            "text": "“Dyma un stori, nid tri phos,” meddai Mali.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l21-s03",
        "title": "Y stori a adeiladon nhw",
        "segments": [
          {
            "id": "cy-draig-01-l21-s019",
            "text": "Mae pob person yn ychwanegu llinell at y stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s020",
            "text": "“Mali gafodd y map,” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s021",
            "text": "“Sam ddarllenodd y nodyn,” meddai Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s022",
            "text": "“Dafi glywodd y llyfr,” meddai Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s023",
            "text": "“Iwan adnabododd y llun,” meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s024",
            "text": "Mae Iwan yn cywiro'r llinell olaf: “Iwan oedd y person a oedd yn cofio'r hen ystafell.” Mae Pero'n cyfarth wrth y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s025",
            "text": "“A Pero gafodd y drws,” meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s026",
            "text": "Mae'r bwrdd cliwiau bellach yn dangos person, peth a gweithred ym mhob llinell.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l21-s04",
        "title": "Y drws",
        "segments": [
          {
            "id": "cy-draig-01-l21-s027",
            "text": "Maen nhw'n dilyn y marciau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s028",
            "text": "Mae'r seren ar y map yng nghornel yr hen ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s029",
            "text": "Mae'r seren a welodd Mali y tu ôl i lun yr harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s030",
            "text": "Mae'r allwedd a gafodd Dafi yn ffitio mewn twll bach yn y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s031",
            "text": "Mae Mali'n troi'r allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s032",
            "text": "Mae rhan o'r wal yn symud yn araf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s033",
            "text": "Y tu ôl iddi mae drws cul heb ddolen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s034",
            "text": "Dyma'r drws a ddisgrifiodd y nodyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s035",
            "text": "Mae Nia'n agor y drws gyda'r allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s036",
            "text": "Mae ystafell dywyll y tu ôl iddo, ac mae blwch hir yn y canol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s037",
            "text": "Nid ydynt yn agor y blwch eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s038",
            "text": "Mae Mali'n rhoi'r map, y nodyn a'r allwedd ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s039",
            "text": "Nawr mae pob cliw wedi arwain at yr un lle.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l21-s05",
        "title": "Pwy wnaeth beth?",
        "segments": [
          {
            "id": "cy-draig-01-l21-s040",
            "text": "Cyn agor yr ystafell dywyll, mae Nia'n profi'r gadwyn unwaith eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s041",
            "text": "“Pwy gafodd y map?” “Mali gafodd y map.” “Pa fap?” “Y map a gafodd Mali yn yr hen lyfr.” “Pwy ddarllenodd y nodyn?” “Sam ddarllenodd y nodyn.” “Pa nodyn?” “Y nodyn a ddarllenodd Sam ar gefn y map.” “Pwy gollodd yr allwedd?” Mae Dafi'n protestio eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s042",
            "text": "“Ni chollais i hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s043",
            "text": "Pero gafodd yr allwedd o dan y gadair.” Mae pawb yn edrych ar Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s044",
            "text": "Felly maen nhw'n newid y llinell: yr allwedd a gafodd Pero o dan y gadair, ac a roddodd e i Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s045",
            "text": "Mae'r manylder yn bwysig, oherwydd mae'r bwrdd cliwiau'n cofnodi pwy wnaeth bob gweithred.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s046",
            "text": "Mae Mali'n ychwanegu saethau rhwng y pethau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s047",
            "text": "Mae'r map a gafodd hi yn arwain at y llyfr a glywodd Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s048",
            "text": "Mae'r llyfr a agorodd Nia yn arwain at y llun a adnabu Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s049",
            "text": "Mae'r llun yn arwain at y wal y crafodd Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s050",
            "text": "Mae'r wal yn cuddio'r drws a agorodd yr allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s051",
            "text": "Mae'r gadwyn bellach heb fwlch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s052",
            "text": "Maen nhw'n barod i fynd i mewn, ond mae Nia'n dweud y byddan nhw'n aros nes bod golau ganddyn nhw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s053",
            "text": "Mae'r penderfyniad yn siomedig i Dafi, ond mae'n ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s054",
            "text": "Mae'r stori'n stopio wrth y drws, nid ar ôl iddo.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l21-s06",
        "title": "Darllen eto",
        "segments": [
          {
            "id": "cy-draig-01-l21-s055",
            "text": "Mae Dafi'n copïo'r gadwyn mewn llyfr nodiadau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s056",
            "text": "Nid yw'n copïo enwau'n unig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s057",
            "text": "Mae'n copïo'r pethau a wnaeth pob person.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s058",
            "text": "Mali yw'r person a gafodd y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s059",
            "text": "Sam yw'r person a ddarllenodd y nodyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s060",
            "text": "Dafi yw'r person a glywodd y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s061",
            "text": "Iwan yw'r person a adnabu'r hen ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s062",
            "text": "Pero yw'r ci a gafodd yr allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s063",
            "text": "Nia yw'r person a agorodd y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s064",
            "text": "Yna mae'n troi'r disgrifiadau at y pethau: dyma'r map a gafodd Mali; dyma'r nodyn a ddarllenodd Sam; dyma'r llyfr a glywodd Dafi; dyma'r llun a adnabu Iwan; dyma'r allwedd a gafodd Pero; dyma'r drws a agorodd Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s065",
            "text": "Mae'r ddwy ffordd o adrodd yn cysylltu'r un bobl, pethau a gweithredoedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s066",
            "text": "Pan fydd ymwelydd yn gweld y bwrdd, bydd yn gallu dilyn y stori heb wybod y cyfrinach ymlaen llaw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l21-s067",
            "text": "Mae Mali'n dweud y bydd y bwrdd cliwiau'n rhan o'r arddangosfa, ond byddan nhw'n cuddio'r ateb olaf y tu ôl i ddarn o bapur.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
