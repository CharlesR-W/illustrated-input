  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l25-s01",
        "title": "Dechrau'r gwaith",
        "segments": [
          {
            "id": "cy-draig-01-l25-s001",
            "text": "Mae Mali'n rhoi papur ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s002",
            "text": "Tyrd yma, Dafi, meddai hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s003",
            "text": "Edrych ar y cynllun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s004",
            "text": "Gwranda ar Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s005",
            "text": "Dal y papur yn ofalus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s006",
            "text": "Rho'r glud ar y cefn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s007",
            "text": "Dos â'r llun at y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s008",
            "text": "Mae Dafi'n dilyn pob cam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s009",
            "text": "Mae'r llun cyntaf yn syth.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s02",
        "title": "Tân bach",
        "segments": [
          {
            "id": "cy-draig-01-l25-s010",
            "text": "Mae Dafi'n dal yr ail lun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s011",
            "text": "Mae e'n gyffrous iawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s012",
            "text": "Mae mwg bach yn dod o'i drwyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s013",
            "text": "Paid â llosgi'r papur! meddai Mali.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l25-gorchymyn",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l25-gorchymyn.svg",
                "alt": "Rho'r papur. Paid â llosgi."
              }
            ]
          },
          {
            "id": "cy-draig-01-l25-s014",
            "text": "Mae Dafi'n stopio ar unwaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s015",
            "text": "Paid â chwythu ar y llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s016",
            "text": "Rho'r llun ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s017",
            "text": "Dos at y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s018",
            "text": "Anadla'n araf ac yn ofalus.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s03",
        "title": "Cyfarwyddiadau clir",
        "segments": [
          {
            "id": "cy-draig-01-l25-s019",
            "text": "Torra'r tâp, meddai Nia wrth Mali.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s020",
            "text": "Ond wrth Dafi mae hi'n dweud: paid â thorri'r map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s021",
            "text": "Dal y tâp, ond paid â dal y lamp.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s022",
            "text": "Edrych ar y marc coch.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s023",
            "text": "Rho'r gornel ar y marc.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s024",
            "text": "Paid â symud y papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s025",
            "text": "Gwranda cyn symud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s026",
            "text": "Mae Dafi'n gweithio'n ofalus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s027",
            "text": "Does dim tân y tro hwn.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s04",
        "title": "Y wal orffenedig",
        "segments": [
          {
            "id": "cy-draig-01-l25-s028",
            "text": "Tyrd yn ôl, Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s029",
            "text": "Edrych ar y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s030",
            "text": "Mae'r lluniau i gyd yn syth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s031",
            "text": "Mae'r map yn ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s032",
            "text": "Mae Mali'n dweud: rho dy enw yma.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s033",
            "text": "Mae Dafi'n ysgrifennu ei enw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s034",
            "text": "Paid â phoeni, meddai Sam.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s035",
            "text": "Nawr mae pawb yn rhoi cyfarwyddiadau clir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s036",
            "text": "Nawr mae Dafi'n gwrando'n ofalus.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s05",
        "title": "Y cynllun ar y wal",
        "segments": [
          {
            "id": "cy-draig-01-l25-s037",
            "text": "Mae Nia'n sefyll o flaen y wal ac mae'r cynllun gyda hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s038",
            "text": "Mae hi'n edrych ar Mali, ar Sam, ac ar Dafi cyn dechrau.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l25-scene-wal",
                "presentation": "inline_scene",
                "src": "media/images/cy-l25-scene-wal.svg",
                "alt": "Dal y papur. Paid â llosgi'r llun!"
              }
            ]
          },
          {
            "id": "cy-draig-01-l25-s039",
            "text": "“Tyrd yma, Mali, a dal ben y papur,” meddai Nia.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s040",
            "text": "“Sam, rho'r bocs bach o dan y bwrdd, os gweli di'n dda.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s041",
            "text": "Mae Sam yn cario'r bocs yn ofalus ac yn ei roi yn y lle cywir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s042",
            "text": "“Dafi, paid â symud y lamp eto,” meddai Mali, gan edrych ar ei drwyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s043",
            "text": "Mae Dafi'n edrych ar y lamp, ond dydy e ddim yn ei chyffwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s044",
            "text": "Mae Pero'n eistedd wrth y drws ac yn gwylio pob un ohonyn nhw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s045",
            "text": "“Edrychwch,” meddai Nia, “mae'r llun cyntaf yn rhy uchel.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s046",
            "text": "Mae Mali'n symud y papur i lawr ac mae Sam yn edrych o'r ochr arall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s047",
            "text": "“Dal e fan hyn,” meddai Sam, “ac wedyn bydd y llun yn syth.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s048",
            "text": "Mae pawb yn edrych eto, ac y tro hwn mae'r papur yn y lle gorau.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s06",
        "title": "Gwaith i bob un",
        "segments": [
          {
            "id": "cy-draig-01-l25-s049",
            "text": "Mae mwy o luniau ar y bwrdd, ond does dim lle i bob un ar y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s050",
            "text": "Mae angen dewis y rhai gorau cyn torri'r papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s051",
            "text": "“Edrych ar y llun o'r harbwr,” meddai Mali wrth Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s052",
            "text": "Mae Dafi'n dal y llun yn ei ddwylo ac yn cofio stori Iwan am y storm.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s053",
            "text": "“Paid â phlygu'r gornel,” meddai hi, “mae'r papur yn hen.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s054",
            "text": "Mae Dafi'n agor ei ddwylo'n araf ac yn dal y llun wrth yr ochrau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s055",
            "text": "Mae Sam yn cymharu'r llun mawr â'r map bach ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s056",
            "text": "“Rho'r map yn y canol, a rho'r llun wrth ei ochr,” meddai e.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s057",
            "text": "Mae Mali'n gwneud hynny, ond mae Nia'n ysgwyd ei phen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s058",
            "text": "“Paid â rhoi popeth yn y canol,” meddai Nia, “mae angen lle i'r neges.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s059",
            "text": "Mae'r grŵp yn symud y pethau eto, heb frys y tro hwn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s060",
            "text": "Yn y diwedd, mae'r map, y llun, a'r neges yn adrodd un stori glir.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s07",
        "title": "Mwg o dan y bwrdd",
        "segments": [
          {
            "id": "cy-draig-01-l25-s061",
            "text": "Mae Dafi'n mynd o'r wal at y bwrdd i nôl y glud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s062",
            "text": "Mae e'n hapus oherwydd mae pawb yn gadael iddo helpu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s063",
            "text": "Mae e'n gweld darn bach o bapur ar y llawr ac yn plygu i'w godi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s064",
            "text": "Ond wrth blygu, mae ei gynffon yn taro ochr y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s065",
            "text": "Mae'r lamp yn symud, ac mae Mali'n gweiddi, “Dal y lamp!”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s066",
            "text": "Mae Sam yn dal y lamp cyn iddi syrthio, ac mae Nia'n dal y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s067",
            "text": "Mae tipyn bach o fwg yn dod o drwyn Dafi oherwydd ei fod yn ofnus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s068",
            "text": "“Anadla'n araf,” meddai Mali, “a phaid ag edrych ar y papur.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s069",
            "text": "Mae Dafi'n anadlu i gyfeiriad y drws, ymhell oddi wrth y lluniau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s070",
            "text": "Mae Pero'n dod ato ac yn rhoi ei ben ar ei droed.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s071",
            "text": "“Edrych ar Pero,” meddai Sam, “mae e'n dawel, ac rwyt ti'n ddiogel.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s072",
            "text": "Mae'r mwg yn diflannu, ac mae Dafi'n chwerthin gyda'r lleill.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s08",
        "title": "Y neges olaf",
        "segments": [
          {
            "id": "cy-draig-01-l25-s073",
            "text": "Dim ond un lle gwag sydd ar ôl ar y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s074",
            "text": "Mae Nia'n dal y neges o'r cyngor, ond mae'r neges yn hir iawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s075",
            "text": "“Torra'r papur yma,” meddai hi wrth Mali, gan ddangos llinell fer.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s076",
            "text": "Mae Mali'n codi'r siswrn, ond mae hi'n stopio cyn torri.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s077",
            "text": "“Y llinell hon, neu'r llinell o dan y marc?” mae hi'n gofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s078",
            "text": "“Y llinell o dan y marc,” meddai Nia, “a phaid â thorri'r geiriau.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s079",
            "text": "Mae Dafi'n gwrando'n ofalus ac yn dilyn y llinell â'i fys.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s080",
            "text": "Mae Sam yn dal ochr arall y papur fel nad yw e'n symud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s081",
            "text": "Mae Mali'n torri'n araf, ac mae'r neges newydd yn ffitio'r lle gwag.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s082",
            "text": "“Rho hi wrth y map,” meddai Nia, “oherwydd dyna ddechrau'r stori.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s083",
            "text": "Mae Mali'n rhoi'r neges ar y wal ac mae pawb yn camu'n ôl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s084",
            "text": "Nawr mae'r wal yn dangos y broblem, y cliwiau, a chynllun y gymuned.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l25-s09",
        "title": "Cyn gadael",
        "segments": [
          {
            "id": "cy-draig-01-l25-s085",
            "text": "Mae'r nos yn dod, ond dydy'r grŵp ddim eisiau gadael y gwaith yn anniogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s086",
            "text": "Mae Nia'n cerdded o un pen y wal i'r pen arall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s087",
            "text": "“Edrych ar bob cornel,” meddai hi wrth Sam, “a dal unrhyw bapur rhydd.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s088",
            "text": "Mae Sam yn gweld un gornel yn symud ac yn rhoi mwy o lud oddi tani.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s089",
            "text": "“Gwranda,” meddai Mali, ac mae pawb yn sefyll yn dawel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s090",
            "text": "Does dim papur yn symud, does dim lamp yn siglo, a does dim mwg yn yr ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s091",
            "text": "Mae Dafi'n edrych yn falch, ond mae e'n cadw ei geg ar gau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s092",
            "text": "“Dos at y drws,” meddai Nia wrtho, “a gwna'n siŵr fod y ffordd yn glir.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s093",
            "text": "Mae Dafi'n mynd at y drws gyda Pero ac yn edrych y tu allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s094",
            "text": "Mae'r ffordd yn glir, ac mae'r arwydd ar y drws yn syth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l25-s095",
            "text": "“Tyrd yn ôl yfory,” meddai Mali, “ond paid â dod â thân gyda ti.”",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l25-scene-diogel",
                "presentation": "inline_scene",
                "src": "media/images/cy-l25-scene-diogel.svg",
                "alt": "Mae'r wal yn barod ac yn ddiogel."
              }
            ]
          },
          {
            "id": "cy-draig-01-l25-s096",
            "text": "Mae Dafi'n addo bod yn ofalus, ac mae pawb yn gadael y llyfrgell yn hapus.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
