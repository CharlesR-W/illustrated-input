  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l26-s01",
        "title": "Y rhestr",
        "segments": [
          {
            "id": "cy-draig-01-l26-s001",
            "text": "Mae'r arddangosfa yfory.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s002",
            "text": "Mae'n rhaid i ni orffen heddiw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s003",
            "text": "Mae Nia'n ysgrifennu rhestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s004",
            "text": "Mae'n rhaid i Mali drefnu'r lluniau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s005",
            "text": "Mae'n rhaid i Sam argraffu'r rhaglen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s006",
            "text": "Mae'n rhaid i Dafi baentio'r arwydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s007",
            "text": "Dylai Tad-cu wirio'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s008",
            "text": "Dylai Pero aros allan o'r paent.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s009",
            "text": "Mae gwaith i bawb.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s02",
        "title": "Pam?",
        "segments": [
          {
            "id": "cy-draig-01-l26-s010",
            "text": "Mae Mali'n trefnu'r lluniau er mwyn adrodd y stori.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l26-rhaid",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l26-rhaid.svg",
                "alt": "Rhaid gwneud er mwyn helpu."
              }
            ]
          },
          {
            "id": "cy-draig-01-l26-s011",
            "text": "Mae Sam yn argraffu rhaglenni er mwyn helpu'r ymwelwyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s012",
            "text": "Mae Dafi'n paentio arwydd er mwyn dangos y ffordd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s013",
            "text": "Mae Nia'n gwahodd pobl er mwyn llenwi'r llyfrgell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s014",
            "text": "Mae Tad-cu'n agor y ffenestri er mwyn cael awyr iach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s015",
            "text": "Dylai'r arwydd fod yn glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s016",
            "text": "Dylai'r rhaglen fod yn fyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s017",
            "text": "Mae'n rhaid i'r stori fod yn hawdd ei dilyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s018",
            "text": "Mae pawb yn deall y pwrpas.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s03",
        "title": "Cyn ac ar ôl",
        "segments": [
          {
            "id": "cy-draig-01-l26-s019",
            "text": "Cyn paentio, mae Dafi'n rhoi papur ar y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s020",
            "text": "Ar ôl paentio, mae e'n golchi'r brwsh.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s021",
            "text": "Cyn argraffu, mae Sam yn gwirio'r geiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s022",
            "text": "Ar ôl argraffu, mae e'n plygu'r rhaglenni.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s023",
            "text": "Cyn gwahodd pobl, mae Nia'n gwirio'r amser.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s024",
            "text": "Ar ôl anfon y gwahoddiadau, mae hi'n ffonio'r cyngor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s025",
            "text": "Mae'n rhaid gwirio cyn gorffen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s026",
            "text": "Dylai pawb lanhau ar ôl gweithio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s027",
            "text": "Mae'r rhestr yn mynd yn fyrrach.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s04",
        "title": "Y noson olaf",
        "segments": [
          {
            "id": "cy-draig-01-l26-s028",
            "text": "Mae'n rhaid i ni wneud un peth arall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s029",
            "text": "Mae angen rhoi'r map yn y canol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s030",
            "text": "Mae Dafi'n dal y map er mwyn i Mali ei osod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s031",
            "text": "Mae Sam yn symud y lamp er mwyn i bawb weld.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s032",
            "text": "Mae Nia'n cloi'r drws ar ôl gorffen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s033",
            "text": "Dylai pawb gysgu cyn yfory.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s034",
            "text": "Mae'r gwaith ar ben.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s035",
            "text": "Mae'r ystafell yn barod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s036",
            "text": "Yfory, bydd y drysau ar agor.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s05",
        "title": "Rhestr y bore",
        "segments": [
          {
            "id": "cy-draig-01-l26-s037",
            "text": "Yn gynnar y bore, mae Nia'n rhoi rhestr hir ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s038",
            "text": "Mae'r arddangosfa'n agor yfory, ac mae llawer o waith heb ei orffen.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l26-scene-rhestr",
                "presentation": "inline_scene",
                "src": "media/images/cy-l26-scene-rhestr.svg",
                "alt": "Mae'n rhaid i bob un helpu."
              }
            ]
          },
          {
            "id": "cy-draig-01-l26-s039",
            "text": "Mae'n rhaid i Mali drefnu'r lluniau er mwyn i'r stori fod yn glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s040",
            "text": "Mae'n rhaid i Sam argraffu'r gwahoddiadau cyn i'r ymwelwyr ddod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s041",
            "text": "Mae'n rhaid i Iwan wirio'r map oherwydd mae e'n cofio'r hen harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s042",
            "text": "Mae'n rhaid i Dafi helpu heb losgi dim, ac mae pawb yn edrych arno.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s043",
            "text": "“Dylai Dafi gario'r bocsys ysgafn,” meddai Mali, “nid y lampau.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s044",
            "text": "Mae Dafi'n cytuno ac yn rhoi'r bocs cyntaf wrth y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s045",
            "text": "Ar ôl rhoi'r bocs i lawr, mae e'n dod yn ôl am yr ail un.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s046",
            "text": "Mae Pero'n dilyn Dafi er mwyn dangos y ffordd rhwng y byrddau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s047",
            "text": "Cyn dechrau, mae Nia'n darllen pob swydd yn uchel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s048",
            "text": "Wedyn mae pob un yn gwybod beth mae'n rhaid iddo ei wneud.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s06",
        "title": "Y gwahoddiadau",
        "segments": [
          {
            "id": "cy-draig-01-l26-s049",
            "text": "Mae Sam yn eistedd wrth y cyfrifiadur gyda'r neges o'r cyngor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s050",
            "text": "Mae'n rhaid iddo ysgrifennu gwahoddiad byr y gall pawb ei ddeall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s051",
            "text": "Mae e'n ysgrifennu enw'r llyfrgell, yr amser, a'r rheswm dros yr arddangosfa.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s052",
            "text": "Mae Mali'n darllen y geiriau ac yn dweud bod y teitl yn rhy fach.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s053",
            "text": "“Dylai'r teitl fod yn fwy er mwyn i bobl ei weld o'r drws,” meddai hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s054",
            "text": "Mae Sam yn newid y teitl ac yn argraffu un copi i'w brofi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s055",
            "text": "Ar ôl argraffu'r copi, mae e'n ei roi ar ochr y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s056",
            "text": "Mae Nia'n edrych o ben arall yr ystafell, ond dydy hi ddim yn gallu darllen yr amser.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s057",
            "text": "Mae'n rhaid i Sam wneud yr amser yn fwy hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s058",
            "text": "Mae e'n newid y geiriau unwaith eto ac yn argraffu dau gopi newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s059",
            "text": "Y tro hwn, mae Nia'n gallu darllen popeth heb symud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s060",
            "text": "Mae'n rhaid iddyn nhw argraffu mwy, ond nawr mae'r patrwm yn gywir.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s07",
        "title": "Trefnu'r llwybr",
        "segments": [
          {
            "id": "cy-draig-01-l26-s061",
            "text": "Yn y prynhawn, mae'r lluniau ar y wal ond mae'r bocsys ar hyd y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s062",
            "text": "Mae'n rhaid i'r grŵp wneud llwybr diogel o'r drws at y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s063",
            "text": "Mae Mali'n symud bocs bach er mwyn i gadair allu mynd heibio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s064",
            "text": "Mae Sam yn cario'r rhaff i'r ochr er mwyn i neb syrthio drosti.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s065",
            "text": "Mae Dafi'n sefyll yn y canol ac yn edrych ar y llwybr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s066",
            "text": "“Dylai'r llwybr fynd i'r chwith,” meddai e, gan bwyntio at y wal.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s067",
            "text": "Mae Nia'n cerdded y ffordd honno, ond mae'r lamp yn rhy agos.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s068",
            "text": "“Mae'n rhaid i ni symud y lamp cyn agor,” meddai hi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s069",
            "text": "Mae Iwan yn cynnig lle newydd wrth y ffenestr, rhwng dau lun byr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s070",
            "text": "Ar ôl symud y lamp, mae Nia'n cerdded y llwybr eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s071",
            "text": "Mae digon o le nawr, ac mae'r map yn hawdd ei weld.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s072",
            "text": "Maen nhw'n rhoi marc ar y llawr er mwyn cofio'r ffordd orau.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s08",
        "title": "Pwrpas pob peth",
        "segments": [
          {
            "id": "cy-draig-01-l26-s073",
            "text": "Mae Iwan yn gofyn pam mae pob rhan o'r arddangosfa yn y lle hwnnw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s074",
            "text": "Mae Nia'n dangos y neges gyntaf wrth y drws er mwyn dechrau'r stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s075",
            "text": "Wedyn mae'r map yn y canol er mwyn dangos lle digwyddodd y pethau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s076",
            "text": "Mae'r llun o'r storm wrth y map er mwyn dangos beth ddigwyddodd yn y gorffennol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s077",
            "text": "Mae'r allwedd mewn bocs clir er mwyn i bobl ei gweld heb ei cholli.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s078",
            "text": "Mae'r llyfr sy'n canu ar fwrdd isel er mwyn i blant ei glywed.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s079",
            "text": "Mae Dafi'n gofyn a ddylai'r lamp fod yn nes at y llyfr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s080",
            "text": "“Na,” meddai Mali, “mae'n rhaid i'r lamp aros ymhell o'r papur.”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s081",
            "text": "Mae Pero'n eistedd rhwng y bwrdd a'r drws fel pe bai e'n gwarchod popeth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s082",
            "text": "Mae Iwan yn chwerthin ac yn dweud bod gan bob aelod swydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s083",
            "text": "Mae pwrpas i bob llun, pob bocs, a phob darn o olau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s084",
            "text": "Dyna pam mae'n rhaid gorffen y cynllun cyn ychwanegu unrhyw beth newydd.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l26-s09",
        "title": "Y prawf olaf",
        "segments": [
          {
            "id": "cy-draig-01-l26-s085",
            "text": "Ar ôl gorffen y gwaith, mae'r grŵp yn gwneud prawf fel pe bai'r ymwelwyr wedi dod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s086",
            "text": "Mae Sam yn mynd allan ac yn dod drwy'r drws gyda gwahoddiad yn ei law.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s087",
            "text": "Mae Mali'n ei groesawu ac yn dangos y llwybr cyntaf iddo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s088",
            "text": "Mae'n rhaid i Sam gerdded yn araf er mwyn gweld pob rhan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s089",
            "text": "Wrth y map, mae e'n gofyn cwestiwn y gallai ymwelydd ei ofyn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s090",
            "text": "Mae Iwan yn ateb ac yn dangos y marc bach yng nghornel y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s091",
            "text": "Wedyn mae Sam yn symud at y llyfr ac yn gwrando ar y sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s092",
            "text": "Mae Dafi'n aros wrth y lamp, yn ofalus iawn, ac mae Nia'n gwenu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s093",
            "text": "Ar ddiwedd y llwybr, mae Sam yn dweud bod un gwahoddiad ar y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s094",
            "text": "Mae'n rhaid iddyn nhw symud y papur er mwyn cadw'r llwybr yn glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l26-s095",
            "text": "Mae Mali'n ei godi, ac mae pawb yn gwneud y prawf unwaith eto.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l26-scene-llwybr",
                "presentation": "inline_scene",
                "src": "media/images/cy-l26-scene-llwybr.svg",
                "alt": "Y llwybr drwy'r arddangosfa"
              }
            ]
          },
          {
            "id": "cy-draig-01-l26-s096",
