  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l27-s01",
        "title": "Y si",
        "segments": [
          {
            "id": "cy-draig-01-l27-s001",
            "text": "Mae si yn y dref.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s002",
            "text": "Mae rhywun yn dweud bod y llyfrgell yn cau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s003",
            "text": "Mae Sam yn meddwl bod y si'n wir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s004",
            "text": "Mae Mali'n credu bod rhywbeth o'i le.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s005",
            "text": "Mae Dafi'n ofni bod yr arddangosfa'n rhy hwyr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s006",
            "text": "Ond dydy Nia ddim yn credu pob si.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s007",
            "text": "Mae hi'n dweud bod angen gwirio.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s008",
            "text": "Mae celwydd yn gallu teithio'n gyflym.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s009",
            "text": "Mae'r gwir yn aros yn y cyngor.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s02",
        "title": "Beth ddywedodd y cyngor?",
        "segments": [
          {
            "id": "cy-draig-01-l27-s010",
            "text": "Mae Nia'n ffonio'r cyngor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s011",
            "text": "Dywedodd swyddog nad oes penderfyniad eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s012",
            "text": "Dywedodd hi fod y cyngor yn cyfarfod yfory.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l27-adrodd",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l27-adrodd.svg",
                "alt": "Mae'n wir. Dywedodd hi fod e'n wir."
              }
            ]
          },
          {
            "id": "cy-draig-01-l27-s013",
            "text": "Dywedodd hi fod yr arddangosfa'n bwysig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s014",
            "text": "Ni ddywedodd hi fod y llyfrgell yn cau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s015",
            "text": "Mae Nia'n ysgrifennu pob gair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s016",
            "text": "Mae hi'n gofyn eto oherwydd bod y si'n ddifrifol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s017",
            "text": "Mae'r ateb yr un fath.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s018",
            "text": "Does dim penderfyniad eto.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s03",
        "title": "Adrodd yn gywir",
        "segments": [
          {
            "id": "cy-draig-01-l27-s019",
            "text": "Mae Nia'n dweud wrth Mali fod y cyngor yn cyfarfod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s020",
            "text": "Mae Mali'n dweud wrth Sam nad oes penderfyniad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s021",
            "text": "Mae Sam yn dweud wrth Dafi fod y si'n anghywir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s022",
            "text": "Mae Dafi'n meddwl bod hynny'n newyddion da.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s023",
            "text": "Mae Tad-cu'n credu bod angen parhau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s024",
            "text": "Mae pawb yn cytuno bod y gwir yn bwysig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s025",
            "text": "Dydyn nhw ddim yn dweud bod popeth yn ddiogel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s026",
            "text": "Maen nhw'n dweud bod cyfle o hyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s027",
            "text": "Mae hynny'n fwy gonest.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s04",
        "title": "Neges i'r dref",
        "segments": [
          {
            "id": "cy-draig-01-l27-s028",
            "text": "Mae Sam yn ysgrifennu neges.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s029",
            "text": "Mae'r neges yn dweud bod yr arddangosfa yfory.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s030",
            "text": "Mae hi'n dweud nad yw'r llyfrgell wedi cau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s031",
            "text": "Mae hi'n dweud bod y cyngor heb benderfynu.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s032",
            "text": "Mae Nia'n gwirio bod pob gair yn wir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s033",
            "text": "Mae Dafi'n gofyn a yw'r si'n gelwydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s034",
            "text": "Mae Nia'n dweud bod y si heb dystiolaeth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s035",
            "text": "Mae'r grŵp yn rhannu'r neges.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s036",
            "text": "Nawr mae'r dref yn gwybod y gwir.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s05",
        "title": "Sïon wrth y drws",
        "segments": [
          {
            "id": "cy-draig-01-l27-s037",
            "text": "Mae Nia'n cyrraedd y llyfrgell ac yn gweld tri pherson wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s038",
            "text": "Mae un person yn dweud bod y llyfrgell yn cau heddiw.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l27-scene-sion",
                "presentation": "inline_scene",
                "src": "media/images/cy-l27-scene-sion.svg",
                "alt": "Sïon neu wir?"
              }
            ]
          },
          {
            "id": "cy-draig-01-l27-s039",
            "text": "Mae person arall yn credu bod y cyngor wedi newid y penderfyniad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s040",
            "text": "Mae'r trydydd yn meddwl bod yr arddangosfa wedi ei chanslo.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s041",
            "text": "Mae Mali'n edrych ar Nia ac yn gofyn pa stori sy'n wir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s042",
            "text": "Mae Nia'n dweud nad yw sïon yn benderfyniad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s043",
            "text": "Mae hi'n gofyn pwy ddywedodd y geiriau cyntaf a phryd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s044",
            "text": "Does neb yn cofio enw'r person, ac mae hynny'n gwneud y stori'n wan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s045",
            "text": "Mae Sam yn dweud bod angen gwirio'r neges wreiddiol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s046",
            "text": "Mae Iwan yn credu bod copi yn y bocs wrth y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s047",
            "text": "Mae Dafi'n meddwl bod y bocs ar y bwrdd mawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s048",
            "text": "Maen nhw'n mynd i mewn er mwyn chwilio am dystiolaeth, nid am sïon.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s06",
        "title": "Beth ddywedodd y cyngor?",
        "segments": [
          {
            "id": "cy-draig-01-l27-s049",
            "text": "Mae Sam yn agor y bocs ac yn dod o hyd i ddwy neges.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s050",
            "text": "Mae'r neges gyntaf yn dweud bod y cyngor yn ystyried cau'r adeilad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s051",
            "text": "Mae'r ail neges yn dweud bod penderfyniad yn dod ar ôl yr arddangosfa.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s052",
            "text": "Mae Mali'n dweud bod y ddwy neges yn wahanol iawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s053",
            "text": "Mae Iwan yn meddwl bod rhywun wedi darllen y neges gyntaf yn unig.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s054",
            "text": "Mae Nia'n nodi nad yw “ystyried” yn golygu bod rhywbeth wedi digwydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s055",
            "text": "Mae Dafi'n dweud ei fod e wedi clywed bod y drws yn cau am byth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s056",
            "text": "Mae Sam yn gofyn pwy ddywedodd hynny wrtho.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s057",
            "text": "Mae Dafi'n cofio bod Pero wedi clywed dau berson yn siarad y tu allan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s058",
            "text": "Mae pawb yn chwerthin oherwydd dydy Pero ddim yn gallu adrodd y geiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s059",
            "text": "Mae Nia'n dweud bod angen gofyn i'r cyngor yn uniongyrchol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s060",
            "text": "Mae hi'n ysgrifennu'r cwestiwn: “A oes penderfyniad terfynol?”",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s07",
        "title": "Galwad glir",
        "segments": [
          {
            "id": "cy-draig-01-l27-s061",
            "text": "Mae Nia'n ffonio'r swyddfa ac mae'r grŵp yn gwrando'n dawel.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s062",
            "text": "Mae'r swyddog yn dweud bod y cyngor heb wneud penderfyniad terfynol eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s063",
            "text": "Mae hi'n dweud bod yr arddangosfa'n bwysig oherwydd bydd y cyngor yn gweld cefnogaeth y dref.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s064",
            "text": "Mae Nia'n gofyn a yw'r llyfrgell yn cau heddiw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s065",
            "text": "Mae'r swyddog yn ateb nad yw'r llyfrgell yn cau heddiw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s066",
            "text": "Mae hi'n dweud bod y drws yn aros ar agor tan ar ôl y cyfarfod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s067",
            "text": "Ar ôl yr alwad, mae Mali'n adrodd bod mwy o amser ganddyn nhw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s068",
            "text": "Mae Sam yn dweud bod angen rhannu'r gwir gyda'r bobl wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s069",
            "text": "Mae Iwan yn credu y dylai'r neges ddefnyddio'r union eiriau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s070",
            "text": "Mae Dafi'n meddwl bod llun mawr o ddrws agored yn helpu hefyd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s071",
            "text": "Mae Nia'n cytuno bod geiriau clir a llun clir yn well na sïon.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s072",
            "text": "Maen nhw'n dechrau gwneud arwydd newydd ar gyfer y ffenestr.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s08",
        "title": "Y gwir yn y ffenestr",
        "segments": [
          {
            "id": "cy-draig-01-l27-s073",
            "text": "Mae Sam yn ysgrifennu bod y llyfrgell ar agor heddiw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s074",
            "text": "Mae Mali'n ychwanegu bod y penderfyniad terfynol yn dod ar ôl yr arddangosfa.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s075",
            "text": "Mae Iwan yn dweud bod y gymuned yn gallu helpu drwy ddod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s076",
            "text": "Mae Nia'n darllen pob brawddeg ac yn gwirio ei bod yn wir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s077",
            "text": "Mae Dafi'n gofyn a allan nhw ddweud bod y llyfrgell wedi ei hachub.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s078",
            "text": "Mae Nia'n ateb na allan nhw ddweud hynny eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s079",
            "text": "Mae hi'n egluro bod gobaith yn wahanol i benderfyniad.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s080",
            "text": "Mae Dafi'n meddwl am hyn ac yn newid ei lun o faner i gwestiwn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s081",
            "text": "Mae Sam yn rhoi'r arwydd yn y ffenestr lle gall pawb ei weld.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s082",
            "text": "Mae'r tri pherson wrth y drws yn darllen y geiriau newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s083",
            "text": "Mae un ohonyn nhw'n dweud ei fod wedi deall y sïon yn anghywir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s084",
            "text": "Mae'r lleill yn addo dweud y gwir wrth eu ffrindiau.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l27-s09",
        "title": "Stori sy'n newid",
        "segments": [
          {
            "id": "cy-draig-01-l27-s085",
            "text": "Yn y nos, mae'r grŵp yn edrych yn ôl ar y diwrnod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s086",
            "text": "Mae Mali'n dweud bod un neges fer wedi troi'n dair sïon wahanol.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s087",
            "text": "Mae Sam yn meddwl bod pobl yn ychwanegu pethau pan nad ydyn nhw'n gwybod popeth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s088",
            "text": "Mae Iwan yn cofio bod yr un peth wedi digwydd yn yr harbwr flynyddoedd yn ôl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s089",
            "text": "Dywedodd un person fod storm yn dod, ond dywedodd un arall fod y storm wedi cyrraedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s090",
            "text": "Mae Nia'n dweud bod amser y geiriau yn newid ystyr y stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s091",
            "text": "Mae Dafi'n adrodd bod Pero wedi clywed sŵn, ond dydy e ddim yn dweud bod Pero'n deall y sŵn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s092",
            "text": "Mae pawb yn gweld bod adrodd yn gyfrifoldeb, nid dim ond ailadrodd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s093",
            "text": "Mae Sam yn cadw'r ddwy neges gyda'r arwydd newydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s094",
            "text": "Mae Mali'n dweud y bydd y tair dogfen yn rhan dda o'r arddangosfa.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l27-s095",
            "text": "Byddan nhw'n dangos sut mae gwirionedd, cred, a sïon yn wahanol.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l27-scene-ffenestr",
                "presentation": "inline_scene",
                "src": "media/images/cy-l27-scene-ffenestr.svg",
                "alt": "Mae'r llyfrgell ar agor heddiw."
              }
            ]
          },
          {
            "id": "cy-draig-01-l27-s096",
            "text": "Mae Nia'n cau'r bocs ac yn dweud bod y stori wir yn ddigon diddorol.",
            "inference_aids": []
          }
        ]
