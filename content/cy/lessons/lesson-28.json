  "story": {
    "sections": [
      {
        "id": "cy-draig-01-l28-s01",
        "title": "Y bore",
        "segments": [
          {
            "id": "cy-draig-01-l28-s001",
            "text": "Mae bore'r arddangosfa wedi dod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s002",
            "text": "Mae Mali wedi cyrraedd yn gynnar.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s003",
            "text": "Mae Nia wedi agor y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s004",
            "text": "Mae Sam wedi gwneud te.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s005",
            "text": "Mae Dafi wedi bwyta brecwast.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s006",
            "text": "Mae Pero wedi cysgu wrth y bocs.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s007",
            "text": "Mae'r ystafell bron yn barod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s008",
            "text": "Ond mae'r rhestr yn dal yn hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s009",
            "text": "Mae Mali'n gofyn am bob tasg.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s02",
        "title": "Y tasgau",
        "segments": [
          {
            "id": "cy-draig-01-l28-s010",
            "text": "Beth wyt ti wedi'i wneud, Sam?",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l28-wedi",
                "presentation": "margin_diagram",
                "src": "media/diagrams/cy-l28-wedi.svg",
                "alt": "Heb wneud; wedi gwneud."
              }
            ]
          },
          {
            "id": "cy-draig-01-l28-s011",
            "text": "Dw i wedi argraffu'r rhaglenni.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s012",
            "text": "Wyt ti wedi'u plygu nhw?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s013",
            "text": "Ydw, dw i wedi'u plygu nhw eisoes.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s014",
            "text": "Beth mae Nia wedi'i wneud?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s015",
            "text": "Mae hi wedi anfon y gwahoddiadau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s016",
            "text": "Mae hi wedi derbyn ugain ateb.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s017",
            "text": "Mae hi wedi gweld neges y cyngor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s018",
            "text": "Dydy hi ddim wedi'i darllen yn uchel eto.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s03",
        "title": "Y map coll",
        "segments": [
          {
            "id": "cy-draig-01-l28-s019",
            "text": "Mae Dafi wedi symud y map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s020",
            "text": "Ble wyt ti wedi'i roi e?",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s021",
            "text": "Dw i wedi'i roi ar y bwrdd, meddai Dafi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s022",
            "text": "Ond dydy'r map ddim ar y bwrdd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s023",
            "text": "Mae Pero wedi gweld rhywbeth o dan y gadair.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s024",
            "text": "Mae e wedi dod o hyd i'r map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s025",
            "text": "Dydy Pero erioed wedi darllen map.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s026",
            "text": "Ond mae e wedi achub y map ddwywaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s027",
            "text": "Mae Dafi wedi dysgu gwirio.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s04",
        "title": "Barod",
        "segments": [
          {
            "id": "cy-draig-01-l28-s028",
            "text": "Mae Mali wedi hongian y llun olaf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s029",
            "text": "Mae Sam wedi gosod y rhaglenni.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s030",
            "text": "Mae Nia wedi darllen neges y cyngor.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s031",
            "text": "Dydyn nhw ddim wedi gwneud penderfyniad eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s032",
            "text": "Mae Tad-cu wedi agor y ffenestri.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s033",
            "text": "Mae Dafi wedi gorffen yr arwydd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s034",
            "text": "Mae pawb wedi gwneud eu gwaith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s035",
            "text": "Mae'r arddangosfa'n barod.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s036",
            "text": "Dydyn nhw erioed wedi bod mor gyffrous.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s05",
        "title": "Y rhestr wedi newid",
        "segments": [
          {
            "id": "cy-draig-01-l28-s037",
            "text": "Mae Mali'n rhoi'r rhestr waith ar y bwrdd ac yn tynnu llinell o dan y teitl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s038",
            "text": "Mae rhai swyddi wedi eu gorffen, ond mae eraill yn dal heb eu gwneud.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l28-scene-rhestr",
                "presentation": "inline_scene",
                "src": "media/images/cy-l28-scene-rhestr.svg",
                "alt": "Wedi gorffen · heb orffen"
              }
            ]
          },
          {
            "id": "cy-draig-01-l28-s039",
            "text": "Mae Sam wedi argraffu'r gwahoddiadau ac wedi rhoi rhai wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s040",
            "text": "Mae Nia wedi ffonio'r cyngor ac wedi ysgrifennu'r ateb cywir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s041",
            "text": "Mae Iwan wedi gwirio'r map, ond dydy e ddim wedi gosod y label olaf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s042",
            "text": "Mae Dafi wedi cario'r bocsys ysgafn, ond mae e wedi anghofio un wrth y ffenestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s043",
            "text": "Mae Mali'n gofyn, “Beth wyt ti wedi'i wneud ers y bore, Dafi?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s044",
            "text": "Mae Dafi'n dangos y wal ac yn dweud ei fod wedi dal pob llun yn ofalus.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s045",
            "text": "Mae Pero wedi dilyn pawb, ond dydy e ddim wedi symud unrhyw waith.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s046",
            "text": "Mae Sam yn dweud bod Pero wedi cadw'r llwybr yn glir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s047",
            "text": "Mae Mali'n rhoi marc wrth bob swydd sydd wedi ei gorffen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s048",
            "text": "Mae'r rhestr yn fyrrach, ond mae'r swyddi olaf yn bwysig.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s06",
        "title": "Pethau sydd ar goll",
        "segments": [
          {
            "id": "cy-draig-01-l28-s049",
            "text": "Mae Nia'n gofyn a oes rhywun wedi gweld y label ar gyfer yr allwedd.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s050",
            "text": "Mae Sam wedi gweld y label yn y bore, ond dydy e ddim yn cofio ble.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s051",
            "text": "Mae Mali wedi edrych ar y bwrdd ac o dan y bocsys.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s052",
            "text": "Mae Iwan wedi agor y cwpwrdd, ond dydy'r label ddim yno.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s053",
            "text": "Mae Dafi'n dweud ei fod wedi clywed papur yn symud wrth y drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s054",
            "text": "Mae Pero eisoes wedi mynd at y drws ac mae e'n arogli rhywbeth.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s055",
            "text": "O dan ei droed mae darn bach o bapur gyda'r gair “allwedd”.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s056",
            "text": "Mae Pero wedi dod o hyd i'r label cyn i unrhyw un arall ei weld.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s057",
            "text": "Mae Mali'n ei godi ac yn gofyn sut mae e wedi cyrraedd y llawr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s058",
            "text": "Mae Sam yn cofio ei fod wedi agor y drws gyda llawer o wahoddiadau yn ei law.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s059",
            "text": "Mae'r gwynt wedi symud y label pan agorodd e'r drws.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s060",
            "text": "Maen nhw wedi datrys y broblem, ac mae Mali'n gludo'r label yn ei le.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s07",
        "title": "Beth sydd heb ei wneud?",
        "segments": [
          {
            "id": "cy-draig-01-l28-s061",
            "text": "Ar ôl cinio, mae Nia'n darllen y rhestr eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s062",
            "text": "Mae'r grŵp wedi gorffen y wal, y map, a'r gwahoddiadau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s063",
            "text": "Dydyn nhw ddim wedi profi'r sain o'r llyfr gyda llawer o bobl yn yr ystafell.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s064",
            "text": "Dydyn nhw ddim wedi symud y lamp olaf i ffwrdd o'r papur.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s065",
            "text": "Dydy Iwan ddim wedi paratoi ei stori am yr harbwr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s066",
            "text": "Dydy Dafi ddim wedi ymarfer aros yn dawel pan fydd rhywun yn darllen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s067",
            "text": "Mae Dafi'n dweud nad yw e erioed wedi aros yn dawel am amser hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s068",
            "text": "Mae Mali'n gofyn iddo geisio am un funud, nid am y diwrnod cyfan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s069",
            "text": "Mae Sam yn dechrau'r amser ac mae Dafi'n eistedd wrth Pero.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s070",
            "text": "Mae e wedi aros yn dawel am hanner munud pan mae ei drwyn yn cosi.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s071",
            "text": "Ond dydy e ddim wedi gwneud mwg, ac mae pawb yn falch ohono.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s072",
            "text": "Mae Nia'n rhoi hanner marc wrth ei swydd ac yn addo prawf arall.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s08",
        "title": "Y prawf gyda phobl",
        "segments": [
          {
            "id": "cy-draig-01-l28-s073",
            "text": "Mae pedwar ffrind wedi dod i helpu gyda'r prawf olaf.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s074",
            "text": "Mae Nia wedi rhoi gwahoddiad i bob un ac wedi gofyn iddyn nhw ddilyn y llwybr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s075",
            "text": "Mae Mali wedi sefyll wrth y map er mwyn ateb cwestiynau.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s076",
            "text": "Mae Sam wedi sefyll wrth y llyfr sy'n canu er mwyn dangos y sain.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s077",
            "text": "Mae Iwan wedi dechrau ei stori, ond mae dau berson wedi stopio wrth y lamp.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s078",
            "text": "Mae'r lamp wedi cuddio un o'r lluniau pan oedd yr ystafell yn llawn.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s079",
            "text": "Mae Nia wedi gweld y broblem ac wedi symud y lamp at y wal arall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s080",
            "text": "Mae'r ymwelwyr wedi cerdded y llwybr eto ac wedi gweld pob llun.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s081",
            "text": "Mae Dafi wedi aros yn dawel drwy stori gyfan Iwan.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s082",
            "text": "Ar y diwedd, mae e wedi anadlu mwg bach tuag at y ffenestr agored.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s083",
            "text": "Does dim papur wedi llosgi, ac mae'r ymwelwyr wedi chwerthin.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s084",
            "text": "Mae'r prawf wedi dangos un broblem ac wedi profi bod y cynllun newydd yn gweithio.",
            "inference_aids": []
          }
        ]
      },
      {
        "id": "cy-draig-01-l28-s09",
        "title": "Barod o'r diwedd",
        "segments": [
          {
            "id": "cy-draig-01-l28-s085",
            "text": "Mae'r haul wedi mynd i lawr ac mae'r llyfrgell yn dawel eto.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s086",
            "text": "Mae Mali wedi casglu'r offer ac wedi cau'r glud.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s087",
            "text": "Mae Sam wedi cyfrif y gwahoddiadau sydd ar ôl.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s088",
            "text": "Mae Iwan wedi rhoi ei nodiadau wrth y map er mwyn cofio ei stori.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s089",
            "text": "Mae Nia wedi cerdded y llwybr olaf heb ddod o hyd i broblem arall.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s090",
            "text": "Mae Dafi wedi edrych ar bob darn o bapur ac wedi cadw ei drwyn ymhell oddi wrthyn nhw.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s091",
            "text": "Mae Pero wedi gorwedd wrth y drws, wedi blino ar ôl diwrnod hir.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s092",
            "text": "Mae Mali'n gofyn, “Ydyn ni wedi gorffen popeth?”",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s093",
            "text": "Mae Sam yn ateb eu bod wedi gwneud popeth ar y rhestr.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s094",
            "text": "Mae Iwan yn ychwanegu nad ydyn nhw erioed wedi gwneud arddangosfa fel hon o'r blaen.",
            "inference_aids": []
          },
          {
            "id": "cy-draig-01-l28-s095",
            "text": "Mae Nia'n rhoi'r marc olaf ac yn troi'r rhestr drosodd.",
            "inference_aids": [
              {
                "type": "image",
                "ref": "cy-l28-scene-prawf",
                "presentation": "inline_scene",
                "src": "media/images/cy-l28-scene-prawf.svg",
                "alt": "Mae'r arddangosfa'n barod."
              }
            ]
          },
          {
            "id": "cy-draig-01-l28-s096",
            "text": "Mae'r gwaith wedi gorffen; nawr mae'n rhaid i'r gymuned ddod i weld y stori.",
            "inference_aids": []
          }
        ]
      }
    ]
  },
