{
  "schema_version": 1,
  "lesson_id": "grc-skil-01-l01",
  "segments": {
    "grc-skil-01-l01-s001": {
      "text": "Ἅμα τῇ ἡμέρᾳ ὁ Ξενοφῶν ἐκ τῆς οἰκίας ἐξῆλθεν.",
      "items": [
        {
          "text": "Ἅμα τῇ ἡμέρᾳ",
          "lemma": "ἅμα τῇ ἡμέρᾳ",
          "pos": "phr.",
          "en": "at daybreak",
          "components": [
            {
              "text": "Ἅμα",
              "lemma": "ἅμα",
              "pos": "prep.",
              "form": "+ dat., of time",
              "en": "at (daybreak)"
            }
          ]
        }
      ]
    },
    "grc-skil-01-l01-s010": {
      "text": "ὑπὲρ δὲ τοῦ ποταμοῦ ὄρος ἦν, καὶ ἐν τῷ ὄρει πολλὴ ὕλη.",
      "items": [
        {
          "text": "ὄρος",
          "lemma": "ὄρος",
          "pos": "n.",
          "form": "nom. sg. n.",
          "en": "mountain"
        },
        {
          "text": "τῷ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "dat. sg. n.",
          "en": "the"
        }
      ]
    },
    "grc-skil-01-l01-s011": {
      "text": "παρὰ δὲ τῇ ὕλῃ μικρὸς ναὸς ἦν, ὁ τῆς Ἀρτέμιδος.",
      "items": [
        {
          "text": "ὁ τῆς Ἀρτέμιδος",
          "lemma": "ὁ τῆς Ἀρτέμιδος",
          "pos": "phr.",
          "en": "Artemis' temple",
          "note": "The article stands for the temple just mentioned."
        }
      ]
    },
    "grc-skil-01-l01-s015": {
      "text": "«Ἀπὸ τοῦ χωρίου ἡμῶν εἰς Ὀλυμπίαν ὁδός ἐστιν ὡς εἴκοσι σταδίων.»",
      "items": [
        {
          "text": "τοῦ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "gen. sg. n.",
          "en": "the"
        }
      ]
    },
    "grc-skil-01-l01-s018": {
      "text": "Οἱ δὲ κύνες διώκειν ἐβούλοντο, ὁ δὲ Ξενοφῶν οὐκ εἴα.",
      "items": [
        {
          "text": "οὐκ εἴα",
          "lemma": "οὐκ ἐάω",
          "pos": "phr.",
          "en": "would not allow it"
        }
      ]
    },
    "grc-skil-01-l01-s019": {
      "text": "«Διὰ τί, ὦ πάτερ;» ἠρώτησεν ὁ Διόδωρος.",
      "items": [
        {
          "text": "Διὰ τί",
          "lemma": "διὰ τί",
          "pos": "phr.",
          "en": "why?"
        }
      ]
    },
    "grc-skil-01-l01-s020": {
      "text": "«Νῦν μέν,» ἔφη ὁ Ξενοφῶν, «τὸ χωρίον σκοποῦμεν· ἄλλῃ δὲ ἡμέρᾳ διώξομεν.»",
      "items": [
        {
          "text": "ἄλλῃ δὲ ἡμέρᾳ",
          "lemma": "ἄλλῃ ἡμέρᾳ",
          "pos": "phr.",
          "en": "but on another day"
        }
      ]
    },
    "grc-skil-01-l01-s022": {
      "text": "Ἐτύγχανε δὲ λαγὼς παρὰ τῷ ποταμῷ ὤν.",
      "items": [
        {
          "text": "Ἐτύγχανε",
          "lemma": "τυγχάνω",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "happened to be",
          "note": "With ὤν: happened to be there."
        }
      ]
    },
    "grc-skil-01-l01-s024": {
      "text": "καὶ εὐθὺς ἔλαθε τὸν Σωσίαν ἀπελθοῦσα.",
      "items": [
        {
          "text": "ἔλαθε τὸν Σωσίαν ἀπελθοῦσα",
          "lemma": "λανθάνω",
          "pos": "phr.",
          "en": "went away unnoticed by Sosias",
          "note": "λανθάνω with a participle: the action passes unnoticed."
        }
      ]
    },
    "grc-skil-01-l01-s027": {
      "text": "Πρῶτον μὲν ἡ Ἀλκὴ διέβη τὸν ποταμόν, ἔπειτα δὲ ἀνέβη εἰς τὸ ὄρος.",
      "items": [
        {
          "text": "Πρῶτον μὲν",
          "lemma": "πρῶτον μέν",
          "pos": "phr.",
          "en": "first",
          "components": [
            {
              "text": "μὲν",
              "lemma": "μέν",
              "pos": "part.",
              "en": "(marks the first step)"
            }
          ]
        },
        {
          "text": "ἔπειτα δὲ",
          "lemma": "ἔπειτα δέ",
          "pos": "phr.",
          "en": "then"
        }
      ]
    },
    "grc-skil-01-l01-s039": {
      "text": "«Ταῦτα μὲν τοῦ λαγώ ἐστιν, ταῦτα δὲ τῆς Ἀλκῆς.»",
      "items": [
        {
          "text": "Ταῦτα",
          "lemma": "οὗτος",
          "pos": "pron.",
          "form": "nom. pl. n.",
          "en": "these tracks"
        },
        {
          "text": "τοῦ λαγώ ἐστιν",
          "lemma": "εἰμί",
          "pos": "phr.",
          "en": "belong to the hare",
          "note": "εἰμί with a genitive expresses possession."
        },
        {
          "text": "ταῦτα",
          "lemma": "οὗτος",
          "pos": "pron.",
          "form": "nom. pl. n.",
          "en": "these tracks"
        }
      ]
    },
    "grc-skil-01-l01-s043": {
      "text": "«Πολλὰ ἔτη τοὺς κύνας ἄγω, ὦ παῖ, καὶ πολλὰ ἴχνη εἶδον.»",
      "items": [
        {
          "text": "Πολλὰ ἔτη",
          "lemma": "πολλὰ ἔτη",
          "pos": "phr.",
          "en": "for many years"
        }
      ]
    },
    "grc-skil-01-l01-s044": {
      "text": "«Οἶμαι τὴν Ἀλκὴν πρὸς τὸν ναὸν ἐλθεῖν· ἐκεῖ γὰρ φέρει τὰ ἴχνη.»",
      "items": [
        {
          "text": "ἐλθεῖν",
          "lemma": "ἔρχομαι",
          "pos": "v.",
          "form": "aor. inf.",
          "en": "to have gone",
          "note": "The aorist infinitive reports an action already completed."
        },
        {
          "text": "τὰ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "nom. pl. n.",
          "en": "the"
        },
        {
          "text": "ἴχνη",
          "lemma": "ἴχνος",
          "pos": "n.",
          "form": "nom. pl. n.",
          "en": "tracks"
        }
      ]
    },
    "grc-skil-01-l01-s046": {
      "text": "ἐκεῖ ἡ Ἀλκὴ ἐτύγχανε παρὰ τῇ στήλῃ κειμένη.",
      "items": [
        {
          "text": "ἐτύγχανε",
          "lemma": "τυγχάνω",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "happened to be",
          "note": "With κειμένη: happened to be lying."
        }
      ]
    },
    "grc-skil-01-l01-s047": {
      "text": "ὁ δὲ λαγὼς οὐκέτι ἐκεῖ ἦν· ἔλαθε γὰρ τὴν κύνα φυγών.",
      "items": [
        {
          "text": "ἔλαθε γὰρ τὴν κύνα φυγών",
          "lemma": "λανθάνω",
          "pos": "phr.",
          "en": "for he fled unnoticed by the dog",
          "note": "λανθάνω with a participle: the action passes unnoticed."
        }
      ]
    },
    "grc-skil-01-l01-s048": {
      "text": "ὁ μὲν Γρύλλος παρὰ τὴν Ἀλκὴν ἦλθε καὶ «Ὦ κακὴ κύον,» ἔφη, «ποῦ ἐστιν ὁ λαγώς;»",
      "items": [
        {
          "text": "παρὰ",
          "lemma": "παρά",
          "pos": "prep.",
          "form": "with acc.",
          "en": "up to"
        }
      ]
    },
    "grc-skil-01-l01-s049": {
      "text": "ὁ δὲ Διόδωρος πρὸς τὴν στήλην προσῆλθεν· ἐν γὰρ τῇ στήλῃ γράμματα ἦν.",
      "items": [
        {
          "text": "ἦν",
          "lemma": "εἰμί",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "there were",
          "note": "A neuter plural subject takes a singular verb."
        }
      ]
    },
    "grc-skil-01-l01-s050": {
      "text": "«Ἀνάγνωθι ἡμῖν τὰ γράμματα,» ἔφη ὁ Γρύλλος.",
      "items": [
        {
          "text": "γράμματα",
          "lemma": "γράμμα",
          "pos": "n.",
          "form": "acc. pl. n.",
          "en": "letters"
        }
      ]
    },
    "grc-skil-01-l01-s053": {
      "text": "τὸν ἔχοντα καὶ καρπούμενον τὴν μὲν δεκάτην καταθύειν ἑκάστου ἔτους.",
      "items": [
        {
          "text": "τὸν ἔχοντα καὶ καρπούμενον",
          "lemma": "ἔχω καὶ καρπόω",
          "pos": "phr.",
          "en": "the holder enjoying its produce",
          "note": "Accusative subject of the following directive infinitives."
        },
        {
          "text": "ἑκάστου ἔτους",
          "lemma": "ἑκάστου ἔτους",
          "pos": "phr.",
          "en": "each year"
        }
      ]
    },
    "grc-skil-01-l01-s054": {
      "text": "ἐκ δὲ τοῦ περιττοῦ τὸν ναὸν ἐπισκευάζειν.",
      "items": [
        {
          "text": "τοῦ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "gen. sg. n.",
          "en": "the"
        }
      ]
    },
    "grc-skil-01-l01-s055": {
      "text": "ἂν δέ τις μὴ ποιῇ ταῦτα, τῇ θεῷ μελήσει.»",
      "items": [
        {
          "text": "τῇ θεῷ μελήσει",
          "lemma": "μέλω",
          "pos": "phr.",
          "en": "the goddess will see to it"
        }
      ]
    },
    "grc-skil-01-l01-s056": {
      "text": "Ὁ δὲ Ξενοφῶν καὶ αὐτὸς διέβη τὸν ποταμὸν καὶ ἀνέβη πρὸς τὸν ναόν· τοῦ δὲ παιδὸς ἀναγιγνώσκοντος ᾔσθετο καὶ προσῆλθεν.",
      "items": [
        {
          "text": "καὶ αὐτὸς",
          "lemma": "καὶ αὐτός",
          "pos": "phr.",
          "en": "he too"
        },
        {
          "text": "ᾔσθετο",
          "lemma": "αἰσθάνομαι",
          "pos": "v.",
          "form": "aor. mid. 3sg",
          "en": "heard"
        }
      ]
    },
    "grc-skil-01-l01-s058": {
      "text": "«Τοῦτο λέγει ἡ στήλη· τὸ χωρίον τῆς θεοῦ ἐστιν.»",
      "items": [
        {
          "text": "τὸ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "nom. sg. n.",
          "en": "the"
        },
        {
          "text": "χωρίον",
          "lemma": "χωρίον",
          "pos": "n.",
          "form": "nom. sg. n.",
          "en": "estate"
        },
        {
          "text": "τῆς θεοῦ ἐστιν",
          "lemma": "εἰμί",
          "pos": "phr.",
          "en": "belongs to the goddess"
        }
      ]
    },
    "grc-skil-01-l01-s059": {
      "text": "«Ἑκάστου οὖν ἔτους τὸ δέκατον μέρος τῇ θεῷ θύομεν.»",
      "items": [
        {
          "text": "Ἑκάστου οὖν ἔτους",
          "lemma": "ἑκάστου ἔτους",
          "pos": "phr.",
          "en": "so each year"
        }
      ]
    },
    "grc-skil-01-l01-s060": {
      "text": "«Ἐκ δὲ τοῦ λοιποῦ τὸν ναὸν πάλιν καλὸν ποιοῦμεν.»",
      "items": [
        {
          "text": "τοῦ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "gen. sg. n.",
          "en": "the"
        },
        {
          "text": "πάλιν καλὸν ποιοῦμεν",
          "lemma": "πάλιν καλὸν ποιέω",
          "pos": "phr.",
          "en": "we restore to good condition",
          "components": [
            {
              "text": "καλὸν",
              "lemma": "καλός",
              "pos": "adj.",
              "form": "acc. sg. m.",
              "en": "in good condition"
            }
          ]
        }
      ]
    },
    "grc-skil-01-l01-s061": {
      "text": "«Εἰ δέ τις ταῦτα μὴ ποιεῖ, ἡ θεὸς αὐτὴ δίκην λήψεται παρʼ αὐτοῦ.»",
      "items": [
        {
          "text": "δίκην λήψεται",
          "lemma": "δίκην λαμβάνω",
          "pos": "phr.",
          "en": "will exact punishment",
          "note": "With παρά + genitive: punish someone."
        },
        {
          "text": "παρʼ",
          "lemma": "παρά",
          "pos": "prep.",
          "form": "elided; + gen.",
          "en": "from"
        }
      ]
    },
    "grc-skil-01-l01-s063": {
      "text": "«Διὰ τί, ὦ πάτερ, ἐνταῦθα τῇ Ἀρτέμιδι ναὸν ἐποίησας;»",
      "items": [
        {
          "text": "Διὰ τί",
          "lemma": "διὰ τί",
          "pos": "phr.",
          "en": "why?"
        }
      ]
    },
    "grc-skil-01-l01-s065": {
      "text": "«Πρὸ πολλῶν ἐτῶν ἐν τῇ Ἀσίᾳ πόλεμος ἦν.»",
      "items": [
        {
          "text": "Πρὸ",
          "lemma": "πρό",
          "pos": "prep.",
          "form": "+ gen.",
          "en": "before",
          "note": "Πρὸ πολλῶν ἐτῶν: many years ago."
        }
      ]
    },
    "grc-skil-01-l01-s066": {
      "text": "«Ἐκ δὲ τοῦ πολέμου τὴν δεκάτην τῇ θεῷ ἔδομεν.»",
      "items": [
        {
          "text": "δεκάτην",
          "lemma": "δέκατος",
          "pos": "adj.",
          "form": "acc. sg. f., substantive",
          "en": "tithe of the war spoils",
          "note": "Artemis's share of the tithe from the war spoils funded the estate; this differs from its yearly offering."
        }
      ]
    },
    "grc-skil-01-l01-s067": {
      "text": "«Ἐκ ταύτης τὸ χωρίον τῇ θεῷ ἐκτησάμην καὶ τὸν ναὸν ἐποίησα.»",
      "items": [
        {
          "text": "Ἐκ ταύτης",
          "lemma": "ἐκ ταύτης",
          "pos": "phr.",
          "en": "with this tithe"
        }
      ]
    },
    "grc-skil-01-l01-s068": {
      "text": "Ὁ δὲ Γρύλλος πολλὰ ἐδεῖτο τοῦ πατρὸς λέγειν περὶ τοῦ πολέμου.",
      "items": [
        {
          "text": "πολλὰ",
          "lemma": "πολύς",
          "pos": "adv.",
          "form": "acc. pl. n., adverbial",
          "en": "earnestly"
        }
      ]
    },
    "grc-skil-01-l01-s070": {
      "text": "«Οὐ νῦν, ὦ Γρύλλε· ἄλλῃ ἡμέρᾳ.»",
      "items": [
        {
          "text": "ἄλλῃ ἡμέρᾳ",
          "lemma": "ἄλλῃ ἡμέρᾳ",
          "pos": "phr.",
          "en": "on another day"
        }
      ]
    },
    "grc-skil-01-l01-s071": {
      "text": "«Νῦν δὲ καταβαίνετε, ὦ παῖδες, καὶ τὴν Ἀλκὴν εἰς τὴν οἰκίαν ἄγετε.»",
      "items": [
        {
          "text": "παῖδες",
          "lemma": "παῖς",
          "pos": "n.",
          "form": "voc. pl. m.",
          "en": "boys"
        }
      ]
    },
    "grc-skil-01-l01-s072": {
      "text": "πάντες οὖν ἀπὸ τοῦ ὄρους κατέβησαν καὶ τὸν ποταμὸν διέβησαν.",
      "items": [
        {
          "text": "τοῦ",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "gen. sg. n.",
          "en": "the"
        }
      ]
    },
    "grc-skil-01-l01-s073": {
      "text": "Ὁ δὲ Γρύλλος παρὰ τοῦ πατρὸς ἀπῆλθε πρὸς τὸν ἀδελφόν.",
      "items": [
        {
          "text": "παρὰ",
          "lemma": "παρά",
          "pos": "prep.",
          "form": "with gen.",
          "en": "from"
        }
      ]
    }
  }
}
