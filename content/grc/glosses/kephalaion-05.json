          "lemma": "φημί",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "said (Sosias)"
        }
      ]
    },
    "grc-skil-01-l05-s019": {
      "text": "«Πῶς οὖν,» ἔφη ὁ Γρύλλος, «τὸν ἵππον εὑρήσομεν;»",
      "items": [
        {
          "text": "ἔφη",
          "lemma": "φημί",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "said (Gryllus)"
