        {
          "text": "ἔφη",
          "lemma": "φημί",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "said (Gryllus)"
        }
      ]
    },
    "grc-skil-01-l05-s014": {
      "text": "«Ἴωμεν δή,» ἔφη.",
      "items": [
        {
          "text": "δή",
          "lemma": "δή",
          "pos": "part.",
          "form": "emphatic particle",
          "en": "now, then (urging departure)"
        },
        {
          "text": "ἔφη",
          "lemma": "φημί",
          "pos": "v.",
          "form": "impf. 3sg",
          "en": "said (Kleandros)"
        }
      ]
    },
    "grc-skil-01-l05-s016": {
      "text": "οἱ δὲ κύνες πρὸ αὐτῶν ἔθεον.",
      "items": [
        {
          "text": "αὐτῶν",
          "lemma": "αὐτός",
          "pos": "pron.",
          "form": "gen. pl. m.",
          "en": "them (the four searchers)"
        }
      ]
    },
    "grc-skil-01-l05-s017": {
      "text": "«Ἆρα ταύτῃ τῇ ἡμέρᾳ τοὺς λῃστὰς ὀψόμεθα;» ἤρετο ὁ Γρύλλος.",
      "items": [
        {
          "text": "ἤρετο",
          "lemma": "ἔρομαι",
          "pos": "v.",
          "form": "aor. mid. 3sg",
          "en": "asked (Gryllus)"
        }
