        }
      ]
    },
    "grc-skil-01-l05-s025": {
      "text": "ἔτυχε δὲ ἡ Ψυχὴ πρώτη τῶν ἰχνῶν αἰσθομένη, καὶ εὐθὺς ἐσήμαινεν.",
      "items": [
        {
          "text": "τῶν",
          "lemma": "ὁ",
          "pos": "art.",
          "form": "gen. pl. n.",
