          "form": "dat. sg. m.",
          "en": "him (Sosias)"
        }
      ]
    },
    "grc-skil-01-l05-s003": {
      "text": "ὁ γὰρ πατὴρ αὐτὸν ἄγειν ἔμελλεν.",
