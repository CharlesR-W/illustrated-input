          "form": "pres. 3pl."
        }
      ]
    },
    "is-kvold-01-l07-s041": {
      "text": "Kýrin hefur gras og hey, en fólkið borðar graut. Grautur er matur; hann er ekki þurr.",
      "items": [
        {
          "text": "graut",
          "lemma": "grautur",
          "pos": "n.",
