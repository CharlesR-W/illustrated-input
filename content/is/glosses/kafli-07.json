          "lemma": "annar",
          "pos": "pron.",
          "en": "another; a different name",
          "form": "acc. sg. n."
        }
      ]
    },
    "is-kvold-01-l07-s040": {
      "text": "Guðrún tekur matinn. Þórunn og Manga borða, og afi hefur bókina.",
      "items": [
        {
          "text": "matinn",
          "lemma": "matur",
          "pos": "n.",
          "en": "the food",
          "form": "acc. sg. m. def."
        },
        {
          "text": "borða",
          "lemma": "borða",
          "pos": "v.",
          "en": "eat",
          "form": "pres. 3pl."
        }
      ]
    },
    "is-kvold-01-l07-s041": {
      "text": "Kýrin hefur gras og hey, en fólkið borðar graut. Grautur er matur; hann er ekki þurr.",
      "items": [
        {
          "text": "graut",
          "lemma": "grautur",
          "pos": "n.",
          "en": "porridge",
          "form": "acc. sg. m."
        },
        {
          "text": "Grautur",
          "lemma": "grautur",
          "pos": "n.",
          "en": "porridge",
          "form": "nom. sg. m."
        },
        {
          "text": "matur",
          "lemma": "matur",
          "pos": "n.",
          "en": "food",
          "form": "nom. sg. m."
        }
      ]
    },
    "is-kvold-01-l07-s042": {
      "text": "Siggi á ask, og grauturinn er í askinum. Ásta á annan ask. Hún tekur askinn og borðar.",
      "items": [
        {
          "text": "ask",
          "lemma": "askur",
          "pos": "n.",
          "en": "a traditional lidded wooden food bowl",
          "form": "acc. sg. m."
        },
        {
          "text": "annan",
          "lemma": "annar",
          "pos": "pron.",
          "en": "another (bowl)",
          "form": "acc. sg. m."
        }
      ]
    },
    "is-kvold-01-l07-s050": {
      "text": "Svo kveður hann hátt. Hann les ekki úr bók. Þórunn heyrir hann og stendur upp hjá rokknum.",
      "items": [
        {
          "text": "kveður",
          "lemma": "kveða",
          "pos": "v.",
          "en": "chants (in a traditional melodic recitation)",
          "form": "pres. 3sg."
        }
      ]
    },
    "is-kvold-01-l07-s051": {
      "text": "Gesturinn kveður rímu: sagan er um konung og höll. Fólkið heyrir rímuna.",
      "items": [
        {
          "text": "rímu",
          "lemma": "ríma",
          "pos": "n.",
          "en": "a narrative poem or canto in traditional metrical verse, normally chanted",
          "form": "acc. sg. f."
        }
      ]
    },
    "is-kvold-01-l07-s058": {
      "text": "„Hallur fer heim að bæ og heim að öðrum bæ. En hvar er hann heima?“",
      "items": [
        {
          "text": "öðrum",
          "lemma": "annar",
          "pos": "pron.",
          "en": "another (farm)",
          "form": "dat. sg. m."
        }
      ]
    },
    "is-kvold-01-l07-s061": {
      "text": "„Edda! Saga um Óðin og höllina. Góð saga í bókinni. Hér er önnur saga um Óðin og höllina,“ segir Hallur og kveður aftur.",
      "items": [
        {
          "text": "önnur",
          "lemma": "annar",
          "pos": "pron.",
          "en": "another (story)",
          "form": "nom. sg. f."
        }
      ]
    },
    "is-kvold-01-l07-s064": {
      "text": "„Um jólin!“ segir afi. „Hallur kveður um höllina, og afi les um hana.“",
      "items": [
        {
          "text": "jólin",
          "lemma": "jól",
          "pos": "n.",
          "en": "Christmas; um jólin = at Christmas",
          "form": "acc. pl. n. def."
        }
      ]
    },
    "is-kvold-01-l07-s066": {
      "text": "„Jólin eru í vetur. Þá er kvöldvaka með mat og sögum. Afi segir sögu, og Hallur kveður aðra.“",
      "items": [
        {
          "text": "aðra",
