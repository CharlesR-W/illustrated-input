    "is-kvold-01-l07-s034": {
      "text": "„Afi minn!“ segir Siggi. „Hvað segir hann?“",
      "items": [
        {
          "text": "minn",
          "lemma": "minn",
          "pos": "pron.",
          "en": "my, mine; afi minn = my grandfather",
          "form": "nom. sg. m."
        }
      ]
    },
    "is-kvold-01-l07-s039": {
      "text": "„Nei, Ásta mín! Hér er saga, og hér er maður. Sagan er í bókinni.“",
      "items": [
        {
          "text": "mín",
          "lemma": "minn",
          "pos": "pron.",
          "en": "my, mine; Ásta mín = my dear Ásta",
          "form": "nom. sg. f."
        }
      ]
    },
    "is-kvold-01-l07-s033": {
      "text": "„Hér er annar maður. Hann hefur annað nafn,“ segir afi. Hann kemur með bókina og opnar hana. „Gylfi!“",
      "items": [
        {
          "text": "annar",
          "lemma": "annar",
          "pos": "pron.",
          "en": "another; a different man",
          "form": "nom. sg. m."
