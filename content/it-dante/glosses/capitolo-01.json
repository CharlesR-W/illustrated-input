  "segments": {
    "it-dante-01-l01-s020": {
      "text": "«Dio vi salvi», disse Lapo.",
      "items": [
        {
          "text": "Dio vi salvi",
          "lemma": "Dio vi salvi",
          "pos": "phr.",
          "en": "God keep you (a greeting)"
        }
      ]
    },
    "it-dante-01-l01-s029": {
      "text": "«Sì, messere. Mi chiamo Lapo.»",
      "items": [
        {
          "text": "Mi chiamo",
          "lemma": "chiamarsi",
          "pos": "phr.",
          "en": "my name is (literally: I call myself)"
        }
      ]
    },
    "it-dante-01-l01-s013": {
      "text": "Ser Bindo fa i conti della compagnia.",
      "items": [
        {
          "text": "fa i conti",
          "lemma": "fare i conti",
          "pos": "phr.",
          "en": "keeps the accounts"
        }
      ]
    },
    "it-dante-01-l01-s038": {
      "text": "Lapo fece il conto una volta, poi un'altra.",
      "items": [
        {
          "text": "fece il conto",
          "lemma": "fare il conto",
          "pos": "phr.",
          "en": "did the sum"
