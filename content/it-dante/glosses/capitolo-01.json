        {
          "text": "una volta, poi un'altra",
          "lemma": "una volta, poi un'altra",
          "pos": "phr.",
          "en": "once, then again"
        }
      ]
    },
    "it-dante-01-l01-s037": {
      "text": "«Quanto fa la somma, ragazzo?»",
      "items": [
        {
          "text": "Quanto fa",
          "lemma": "quanto fa?",
          "pos": "phr.",
          "en": "how much does it come to?"
        }
      ]
    },
    "it-dante-01-l01-s051": {
      "text": "«Domani vieni prima del sole», disse.",
      "items": [
        {
          "text": "prima del sole",
          "lemma": "prima del sole",
          "pos": "phr.",
          "en": "before sunrise"
        }
      ]
    },
    "it-dante-01-l01-s084": {
      "text": "«Come io con te, ragazzo.»",
      "items": [
        {
          "text": "Come io con te",
          "lemma": "come io con te",
          "pos": "phr.",
          "en": "as I did with you"
        }
      ]
    },
    "it-dante-01-l01-s087": {
      "text": "Gherardo fu con Lapo all'abaco per tre anni.",
      "items": [
        {
          "text": "all'abaco",
          "lemma": "all'abaco",
          "pos": "phr.",
          "en": "at abacus school"
        }
      ]
    },
    "it-dante-01-l01-s092": {
      "text": "«Selvaggi di Acone, mercanti di lana, nuovi ricchi.",
      "items": [
        {
          "text": "nuovi ricchi",
          "lemma": "nuovi ricchi",
          "pos": "phr.",
          "en": "new rich men, upstarts"
        }
      ]
    },
    "it-dante-01-l01-s099": {
      "text": "«Tu e i tuoi numeri!",
      "items": [
        {
          "text": "Tu e i tuoi numeri",
          "lemma": "tu e i tuoi numeri",
          "pos": "phr.",
          "en": "you and your numbers!"
        }
      ]
    },
    "it-dante-01-l01-s105": {
      "text": "Fra dieci anni io sono a Roma, con il papa, non in questa città di lana.»",
      "items": [
        {
          "text": "Fra dieci anni",
          "lemma": "fra dieci anni",
          "pos": "phr.",
          "en": "in ten years' time"
        }
      ]
    },
    "it-dante-01-l01-s122": {
      "text": "«Baldo. Non nella mia casa.»",
      "items": [
        {
          "text": "Non nella mia casa",
          "lemma": "non nella mia casa",
          "pos": "phr.",
          "en": "not in my house"
        }
      ]
    },
    "it-dante-01-l01-s097": {
      "text": "Lapo non disse ogni cosa.",
      "items": [
        {
          "text": "non disse ogni cosa",
          "lemma": "non dire ogni cosa",
          "pos": "phr.",
          "en": "did not tell everything"
        }
      ]
    },
    "it-dante-01-l01-s057": {
      "text": "«Vengo da casa Donati, per il panno.»",
      "items": [
        {
          "text": "da casa Donati",
          "lemma": "da casa Donati",
          "pos": "phr.",
          "en": "from the Donati household"
