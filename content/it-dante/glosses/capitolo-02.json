{
  "schema_version": 1,
  "lesson_id": "it-dante-01-l02",
  "segments": {
    "it-dante-01-l02-s011": {
      "text": "«Da una parte scriviamo chi deve dare, e dall'altra chi deve avere.",
      "items": [
        {
          "text": "chi deve dare",
          "lemma": "dovere dare",
          "pos": "phr.",
          "en": "who owes (is debited)"
        },
        {
          "text": "chi deve avere",
          "lemma": "dovere avere",
          "pos": "phr.",
          "en": "who is owed (is credited)"
        }
      ]
    },
    "it-dante-01-l02-s015": {
      "text": "Chi compra deve dare, e chi vende deve avere.",
      "items": [
        {
          "text": "deve dare",
          "lemma": "dovere dare",
          "pos": "phr.",
          "en": "owes"
        },
        {
          "text": "deve avere",
          "lemma": "dovere avere",
          "pos": "phr.",
          "en": "is owed"
        }
      ]
    },
    "it-dante-01-l02-s038": {
      "text": "«Quando le due parti fanno la stessa somma, il libro torna», disse Ser Bindo.",
      "items": [
        {
          "text": "fanno la stessa somma",
          "lemma": "fare la stessa somma",
          "pos": "phr.",
          "en": "come to the same total"
        },
        {
          "text": "il libro torna",
          "lemma": "il libro torna",
          "pos": "phr.",
          "en": "the book balances"
        }
      ]
    },
    "it-dante-01-l02-s039": {
      "text": "«Se una parte non c'è, il libro non torna, e io voglio sapere perché. Capisci?»",
      "items": [
        {
          "text": "il libro non torna",
          "lemma": "il libro non torna",
          "pos": "phr.",
          "en": "the book does not balance"
        }
      ]
    },
    "it-dante-01-l02-s031": {
      "text": "«Hai ragione», disse Ser Bindo, e guardò i due giovani al banco.",
      "items": [
        {
          "text": "Hai ragione",
          "lemma": "avere ragione",
          "pos": "phr.",
          "en": "you're right"
        }
      ]
    },
    "it-dante-01-l02-s072": {
      "text": "«Volete mandare un giovane a Roma, messere? Avete ragione: possiamo.",
      "items": [
        {
          "text": "Avete ragione",
          "lemma": "avere ragione",
          "pos": "phr.",
          "en": "you're right (voi)"
        }
      ]
    },
    "it-dante-01-l02-s043": {
      "text": "Lapo scrisse nel libro, ma non perse una parola.",
      "items": [
        {
          "text": "non perse una parola",
          "lemma": "non perdere una parola",
          "pos": "phr.",
          "en": "did not miss a word"
        }
      ]
    },
    "it-dante-01-l02-s056": {
      "text": "A Roma devono fare il cambio.",
      "items": [
        {
          "text": "fare il cambio",
          "lemma": "fare il cambio",
          "pos": "phr.",
          "en": "change money"
        }
      ]
    },
    "it-dante-01-l02-s083": {
      "text": "«Questa sera conti tu il mese, fino a oggi», disse.",
      "items": [
        {
          "text": "conti tu il mese",
          "lemma": "contare il mese",
          "pos": "phr.",
          "en": "you total the month (conti = you count)"
        }
      ]
    },
    "it-dante-01-l02-s084": {
      "text": "«Partita per partita, da una parte e dall'altra.",
      "items": [
        {
          "text": "Partita per partita",
          "lemma": "partita per partita",
          "pos": "phr.",
          "en": "entry by entry"
        }
      ]
    },
    "it-dante-01-l02-s135": {
      "text": "«Qui il dare, nel libro grande l'avere: i due libri fanno un solo conto.",
      "items": [
        {
          "text": "il dare",
          "lemma": "il dare",
          "pos": "n.",
          "en": "the debit (the owing side)"
        },
        {
          "text": "l'avere",
          "lemma": "l'avere",
          "pos": "n.",
          "en": "the credit (the owed side)"
        },
        {
          "text": "fanno un solo conto",
          "lemma": "fare un solo conto",
          "pos": "phr.",
          "en": "make one account between them"
        }
      ]
    },
    "it-dante-01-l02-s079": {
      "text": "«Grazie dei conti, Ser Bindo. Voi parlate come il libro.»",
      "items": [
        {
          "text": "Grazie dei conti",
          "lemma": "grazie di",
          "pos": "phr.",
          "en": "thanks for the sums"
        }
      ]
    },
    "it-dante-01-l02-s094": {
      "text": "Del nome c'era solo una lettera.",
      "items": [
        {
          "text": "una lettera",
          "lemma": "lettera",
          "pos": "n.",
          "en": "one letter (of the alphabet): an initial"
        }
      ]
    },
    "it-dante-01-l02-s075": {
      "text": "«Così gli Spini guadagnano, e noi perdiamo. Questo è certo.»",
      "items": [
        {
          "text": "Questo è certo",
          "lemma": "questo è certo",
          "pos": "phr.",
          "en": "that's certain"
        }
      ]
    },
    "it-dante-01-l02-s150": {
      "text": "Lo disse una parola dopo l'altra.",
      "items": [
        {
          "text": "una parola dopo l'altra",
          "lemma": "una parola dopo l'altra",
          "pos": "phr.",
          "en": "one word after another"
        }
      ]
    },
    "it-dante-01-l02-s049": {
      "text": "«Chi non è di Roma deve andare ogni giorno a San Pietro e a San Paolo, per quindici giorni.»",
      "items": [
        {
          "text": "San Pietro",
          "lemma": "San Pietro",
          "pos": "prop. n.",
          "en": "St Peter's (the basilica in Rome)"
        },
        {
          "text": "San Paolo",
          "lemma": "San Paolo",
          "pos": "prop. n.",
          "en": "St Paul's (the basilica outside the walls of Rome)"
        }
      ]
    },
    "it-dante-01-l02-s019": {
      "text": "Paghiamo fra un mese.",
      "items": [
        {
          "text": "fra un mese",
          "lemma": "fra un mese",
          "pos": "phr.",
          "en": "in a month's time"
        }
      ]
    },
    "it-dante-01-l02-s109": {
      "text": "La mattina dopo, prima del sole, Lapo era già alla bottega.",
      "items": [
        {
          "text": "La mattina dopo",
          "lemma": "la mattina dopo",
          "pos": "phr.",
          "en": "the next morning"
        }
      ]
    },
    "it-dante-01-l02-s089": {
      "text": "Cominciò dalla prima pagina, e contò fino a tardi.",
      "items": [
        {
          "text": "fino a tardi",
          "lemma": "fino a tardi",
          "pos": "phr.",
          "en": "until late"
        }
      ]
    },
    "it-dante-01-l02-s131": {
      "text": "Solo allora mostrò il libro a Lapo.",
      "items": [
        {
          "text": "Solo allora",
          "lemma": "solo allora",
          "pos": "phr.",
          "en": "only then"
        }
      ]
    },
    "it-dante-01-l02-s152": {
      "text": "«Oggi nessuno.»",
      "items": [
        {
          "text": "Oggi nessuno",
          "lemma": "oggi nessuno",
          "pos": "phr.",
          "en": "nobody, today"
        }
      ]
    },
    "it-dante-01-l02-s144": {
      "text": "«Questo, ragazzo, non lo devi sapere.»",
      "items": [
        {
          "text": "non lo devi sapere",
          "lemma": "non dovere sapere",
          "pos": "phr.",
          "en": "you must not know it"
        }
      ]
    },
    "it-dante-01-l02-s149": {
      "text": "E se un giorno qualcuno ti domanda di questo libro, tu non l'hai mai visto.»",
      "items": [
        {
          "text": "non l'hai mai visto",
          "lemma": "non averlo mai visto",
          "pos": "phr.",
          "en": "you have never seen it"
        }
      ]
    },
    "it-dante-01-l02-s120": {
      "text": "«E che cosa dici? Che il vecchio non sa più contare?»",
      "items": [
        {
          "text": "non sa più contare",
          "lemma": "non sapere più contare",
          "pos": "phr.",
          "en": "can no longer count"
        }
      ]
    },
    "it-dante-01-l02-s032": {
      "text": "«Voi due, che cosa fate? Contate i panni o guardate Lapo?»",
      "items": [
        {
          "text": "Voi due",
          "lemma": "voi due",
          "pos": "phr.",
          "en": "you two"
        }
      ]
    },
    "it-dante-01-l02-s127": {
      "text": "«Lo leggono i soci, e lo leggo io. Gli altri no.»",
      "items": [
        {
          "text": "Lo leggono i soci",
          "lemma": "leggerlo",
          "pos": "phr.",
          "en": "the partners read it"
        },
        {
          "text": "lo leggo io",
          "lemma": "leggerlo",
          "pos": "phr.",
          "en": "I read it"
        }
      ]
    },
    "it-dante-01-l02-s148": {
      "text": "«Quello che non vedi, non lo sai.",
      "items": [
        {
          "text": "Quello che non vedi, non lo sai",
          "lemma": "quello che",
          "pos": "phr.",
          "en": "what you don't see, you don't know"
        }
      ]
    },
    "it-dante-01-l02-s066": {
      "text": "Gli Spini, i mercanti del papa, non hanno solo una tavola.»",
      "items": [
        {
          "text": "i mercanti del papa",
          "lemma": "i mercanti del papa",
          "pos": "phr.",
          "en": "the pope's bankers"
        }
      ]
    },
    "it-dante-01-l02-s024": {
      "text": "Scrivi, e scrivi bene: chi scrive male non scrive più in questo libro.»",
      "items": [
        {
          "text": "non scrive più",
          "lemma": "non scrivere più",
          "pos": "phr.",
          "en": "writes no more"
        }
      ]
    },
    "it-dante-01-l02-s046": {
      "text": "«Per quanto tempo?» domandò Ser Bindo.",
      "items": [
        {
          "text": "Per quanto tempo",
          "lemma": "per quanto tempo",
          "pos": "phr.",
          "en": "for how long"
        }
      ]
    },
    "it-dante-01-l02-s054": {
      "text": "«Io faccio sempre i conti, messere.",
      "items": [
        {
          "text": "faccio sempre i conti",
          "lemma": "fare i conti",
          "pos": "phr.",
          "en": "I always do the sums"
        }
      ]
    },
    "it-dante-01-l02-s053": {
      "text": "«Voi fate già i conti?»",
      "items": [
        {
          "text": "fate già i conti",
          "lemma": "fare i conti",
          "pos": "phr.",
          "en": "are you already doing the sums"
        }
      ]
    },
    "it-dante-01-l02-s062": {
      "text": "«Cento soldi al giorno: cinque lire, messere.",
      "items": [
        {
          "text": "al giorno",
          "lemma": "al giorno",
          "pos": "phr.",
          "en": "a day, per day"
        }
      ]
    }
  }
}
