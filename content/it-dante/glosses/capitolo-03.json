{
  "schema_version": 1,
  "lesson_id": "it-dante-01-l03",
  "segments": {
    "it-dante-01-l03-s001": {
      "text": "Gherardo tornò da Roma dopo più di un mese, e la sera stessa venne a cercare Lapo.",
      "items": [
        {
          "text": "la sera stessa",
          "lemma": "la sera stessa",
          "pos": "phr.",
          "en": "that same evening"
        }
      ]
    },
    "it-dante-01-l03-s006": {
      "text": "Sul ponte tirava vento.",
      "items": [
        {
          "text": "tirava vento",
          "lemma": "tira vento",
          "pos": "phr.",
          "en": "it was windy, the wind was blowing"
        }
      ]
    },
    "it-dante-01-l03-s011": {
      "text": "Gherardo raccontava e raccontava, come all'abaco.",
      "items": [
        {
          "text": "come all'abaco",
          "lemma": "come all'abaco",
          "pos": "phr.",
          "en": "as he used to at abacus school"
        }
      ]
    },
    "it-dante-01-l03-s012": {
      "text": "«A Roma c'era una folla: pellegrini da tutto il mondo.",
      "items": [
        {
          "text": "da tutto il mondo",
          "lemma": "da tutto il mondo",
          "pos": "phr.",
          "en": "from all over the world"
        }
      ]
    },
    "it-dante-01-l03-s016": {
      "text": "Da una parte tutti andavano verso la chiesa, dall'altra tutti tornavano: dalla mattina alla sera, così.»",
      "items": [
        {
          "text": "Da una parte",
          "lemma": "da una parte … dall'altra",
          "pos": "phr.",
          "en": "on one side … on the other"
        },
        {
          "text": "dalla mattina alla sera",
          "lemma": "dalla mattina alla sera",
          "pos": "phr.",
          "en": "from morning till evening, all day long"
        }
      ]
    },
    "it-dante-01-l03-s018": {
      "text": "«Noi avevamo una tavola vicino al ponte.",
      "items": [
        {
          "text": "una tavola",
          "lemma": "tavola",
          "pos": "phr.",
          "en": "a table: here a money-changer's table, a bank"
        }
      ]
    },
    "it-dante-01-l03-s019": {
      "text": "I pellegrini portavano denari di cento città, e noi facevamo il cambio.",
      "items": [
        {
          "text": "facevamo il cambio",
          "lemma": "fare il cambio",
          "pos": "phr.",
          "en": "to change money"
        }
      ]
    },
    "it-dante-01-l03-s024": {
      "text": "E quello che restava, lo lasciavano nella chiesa.»",
      "items": [
        {
          "text": "quello che restava",
          "lemma": "quello che resta",
          "pos": "phr.",
          "en": "what was left"
        }
      ]
    },
    "it-dante-01-l03-s033": {
      "text": "«Voleva sapere il cambio del fiorino.",
      "items": [
        {
          "text": "il cambio del fiorino",
          "lemma": "il cambio",
          "pos": "phr.",
          "en": "the exchange rate (of the florin)"
        }
      ]
    },
    "it-dante-01-l03-s034": {
      "text": "Poi mi domandò di Firenze, e dei Cerchi: chi erano, che cosa facevano, quanto oro avevano.»",
      "items": [
        {
          "text": "mi domandò di Firenze",
          "lemma": "domandare di",
          "pos": "phr.",
          "en": "asked me about Florence"
        }
      ]
    },
    "it-dante-01-l03-s044": {
      "text": "«Eravamo sei, e la sera avevamo la tavola piena d'oro.»",
      "items": [
        {
          "text": "sei",
          "lemma": "sei",
          "pos": "num.",
          "en": "six"
        }
      ]
    },
    "it-dante-01-l03-s045": {
      "text": "«Avevate paura?»",
      "items": [
        {
          "text": "Avevate paura",
          "lemma": "avere paura",
          "pos": "phr.",
          "en": "to be afraid"
        }
      ]
    },
    "it-dante-01-l03-s107": {
      "text": "«La notizia, in casa Donati, la sanno tutti: non dicono altro.",
      "items": [
        {
          "text": "La notizia, in casa Donati, la sanno tutti",
          "lemma": "la notizia, la sanno tutti",
          "pos": "phr.",
          "en": "the news, everyone knows it (la repeats la notizia)"
        },
        {
          "text": "non dicono altro",
          "lemma": "non dire altro",
          "pos": "phr.",
          "en": "to talk of nothing else"
        }
      ]
    },
    "it-dante-01-l03-s144": {
      "text": "Sul ponte c'erano ancora due o tre uomini, e il vento portava le loro voci.",
      "items": [
        {
          "text": "le loro voci",
          "lemma": "le loro voci",
          "pos": "phr.",
          "en": "their voices"
        }
      ]
    },
    "it-dante-01-l03-s027": {
      "text": "«E il papa? Lo vedesti?»",
      "items": [
        {
          "text": "Lo vedesti",
          "lemma": "lo vedesti?",
          "pos": "phr.",
          "en": "did you see him? (lo = him, the pope)"
        }
      ]
    },
    "it-dante-01-l03-s140": {
      "text": "Le parole, tu le senti in bottega, e la sera le porti a me, qui sul ponte.",
      "items": [
        {
          "text": "tu le senti",
          "lemma": "le senti",
          "pos": "phr.",
          "en": "you hear them (le = the words)"
        },
        {
          "text": "le porti a me",
          "lemma": "le porti a me",
          "pos": "phr.",
          "en": "you bring them to me (le = the words)"
        }
      ]
    },
    "it-dante-01-l03-s025": {
      "text": "Lapo l'ascoltava, e pensò alla bottega dei Cerchi.",
      "items": [
        {
          "text": "l'ascoltava",
          "lemma": "l'ascoltava",
          "pos": "n.",
          "en": "was listening to him (l' = lo, Gherardo)"
        }
      ]
    },
    "it-dante-01-l03-s146": {
      "text": "«Non lo faccio.»",
      "items": [
        {
          "text": "Non lo faccio",
          "lemma": "non lo faccio",
          "pos": "phr.",
          "en": "I won't do it (lo = it, what Gherardo asks)"
        }
      ]
    },
    "it-dante-01-l03-s109": {
      "text": "Da Roma manda a dire che il papa non tace: domanda a Firenze i suoi uomini, e poi fa pagare caro chi li accusò.»",
      "items": [
        {
          "text": "manda a dire",
          "lemma": "mandare a dire",
          "pos": "phr.",
          "en": "sends word"
        },
        {
          "text": "fa pagare caro",
          "lemma": "far pagare caro",
          "pos": "phr.",
          "en": "makes (someone) pay dearly"
        }
      ]
    },
    "it-dante-01-l03-s031": {
      "text": "Un giorno un cardinale mi chiamò nel suo palazzo.»",
      "items": [
        {
          "text": "mi chiamò nel suo palazzo",
          "lemma": "chiamare",
          "pos": "phr.",
          "en": "sent for me, summoned me to his palace"
        }
      ]
    },
    "it-dante-01-l03-s058": {
      "text": "Io lo dicevo: anche i Cerchi devono avere una tavola a Roma.",
      "items": [
        {
          "text": "Io lo dicevo",
          "lemma": "io lo dicevo",
          "pos": "phr.",
          "en": "I always said so"
        }
      ]
    },
    "it-dante-01-l03-s059": {
      "text": "E ora chi fa il viaggio a Roma per i Cerchi?»",
      "items": [
        {
          "text": "fa il viaggio",
          "lemma": "fare il viaggio",
          "pos": "phr.",
          "en": "makes the journey"
        }
      ]
    },
    "it-dante-01-l03-s064": {
      "text": "Restò sulla porta, come l'altra volta; ma non rideva più, e aveva un'altra voce, che Lapo non conosceva.",
      "items": [
        {
          "text": "aveva un'altra voce",
          "lemma": "avere un'altra voce",
          "pos": "phr.",
          "en": "his voice had changed (literally: he had another voice)"
        }
      ]
    },
    "it-dante-01-l03-s071": {
      "text": "«Non ti credo», disse Gherardo.",
      "items": [
        {
          "text": "Non ti credo",
          "lemma": "non ti credo",
          "pos": "phr.",
          "en": "I don't believe you"
        }
      ]
    },
    "it-dante-01-l03-s083": {
      "text": "Ser Bindo scrisse ancora un numero, poi lasciò la penna.",
      "items": [
        {
          "text": "lasciò la penna",
          "lemma": "lasciare la penna",
          "pos": "phr.",
          "en": "put down his pen"
        }
      ]
    },
    "it-dante-01-l03-s085": {
      "text": "Se non lo so, non posso dirlo lo stesso.»",
      "items": [
        {
          "text": "lo stesso",
          "lemma": "lo stesso",
          "pos": "phr.",
          "en": "all the same, anyway"
        }
      ]
    },
    "it-dante-01-l03-s090": {
      "text": "Messer Vieri teme il papa, e aspetta: aspetta tutta la vita.",
      "items": [
        {
          "text": "tutta la vita",
          "lemma": "tutta la vita",
          "pos": "phr.",
          "en": "all his life"
        }
      ]
    },
    "it-dante-01-l03-s101": {
      "text": "Io taccio, e tu fai come me.»",
      "items": [
        {
          "text": "fai come me",
          "lemma": "fare come me",
          "pos": "phr.",
          "en": "do as I do"
        }
      ]
    },
    "it-dante-01-l03-s113": {
      "text": "Fra un anno messer Corso torna, e i Cerchi vengono da lui a domandare perdono.»",
      "items": [
        {
          "text": "domandare perdono",
          "lemma": "domandare perdono",
          "pos": "phr.",
          "en": "to beg pardon"
        }
      ]
    },
    "it-dante-01-l03-s116": {
      "text": "Lapo lo disse prima di pensare.",
      "items": [
        {
          "text": "prima di pensare",
          "lemma": "prima di pensare",
          "pos": "phr.",
          "en": "before thinking"
        }
      ]
    },
    "it-dante-01-l03-s123": {
      "text": "Tessa guardò Lapo a lungo, e sua madre guardò Tessa.",
      "items": [
        {
          "text": "a lungo",
          "lemma": "a lungo",
          "pos": "phr.",
          "en": "for a long time"
        }
      ]
    },
    "it-dante-01-l03-s126": {
      "text": "Dopo cena Tessa e Baldo uscirono senza dire altro.",
      "items": [
        {
          "text": "senza dire altro",
          "lemma": "senza dire altro",
          "pos": "phr.",
          "en": "without another word"
        }
      ]
    },
    "it-dante-01-l03-s130": {
      "text": "«L'altra sera ero un altro», disse.",
      "items": [
        {
          "text": "ero un altro",
          "lemma": "ero un altro",
          "pos": "phr.",
          "en": "I wasn't myself (literally: I was another man)"
        }
      ]
    },
    "it-dante-01-l03-s133": {
      "text": "«Io mangio il pane degli Spini, Lapo, come tu quello dei Cerchi.",
      "items": [
        {
          "text": "mangio il pane degli Spini",
          "lemma": "mangiare il pane di qualcuno",
          "pos": "phr.",
          "en": "to eat someone's bread: to live by working for him"
        }
      ]
    },
    "it-dante-01-l03-s135": {
      "text": "Poi Gherardo tacque per un poco, come chi cerca le parole.",
      "items": [
        {
          "text": "per un poco",
          "lemma": "per un poco",
          "pos": "phr.",
          "en": "for a little while"
        },
        {
          "text": "come chi cerca le parole",
          "lemma": "come chi cerca le parole",
          "pos": "phr.",
          "en": "like someone looking for words"
        }
      ]
    },
    "it-dante-01-l03-s139": {
      "text": "«Senti anche le parole: che cosa dicono i soci, che cosa dice Ser Bindo, da che parte tira il vento.",
      "items": [
        {
          "text": "da che parte tira il vento",
          "lemma": "da che parte tira il vento",
          "pos": "phr.",
          "en": "which way the wind blows"
        }
      ]
    },
    "it-dante-01-l03-s141": {
      "text": "Non ti domando molto.",
      "items": [
        {
          "text": "Non ti domando molto",
          "lemma": "non ti domando molto",
          "pos": "phr.",
          "en": "I'm not asking you for much"
        }
      ]
    },
    "it-dante-01-l03-s142": {
      "text": "Lo fai per me?»",
      "items": [
        {
          "text": "Lo fai per me",
          "lemma": "lo fai per me?",
          "pos": "phr.",
          "en": "will you do it for me? (the present speaks of the future)"
        }
      ]
    },
    "it-dante-01-l03-s151": {
      "text": "Gherardo lo guardò a lungo.",
      "items": [
        {
          "text": "a lungo",
          "lemma": "a lungo",
          "pos": "phr.",
          "en": "for a long time"
        }
      ]
    },
    "it-dante-01-l03-s155": {
      "text": "Va bene: siamo amici lo stesso.»",
      "items": [
        {
          "text": "Va bene",
          "lemma": "va bene",
          "pos": "phr.",
          "en": "all right"
        },
        {
          "text": "lo stesso",
          "lemma": "lo stesso",
          "pos": "phr.",
          "en": "all the same, anyway"
        }
      ]
    },
    "it-dante-01-l03-s156": {
      "text": "Si guardarono, e risero tutti e due, come all'abaco.",
      "items": [
        {
          "text": "Si guardarono",
          "lemma": "guardarsi",
          "pos": "phr.",
          "en": "they looked at each other"
        },
        {
          "text": "tutti e due",
          "lemma": "tutti e due",
          "pos": "phr.",
          "en": "both of them"
        },
        {
          "text": "come all'abaco",
          "lemma": "come all'abaco",
          "pos": "phr.",
          "en": "as at abacus school, as they used to"
        }
      ]
    },
    "it-dante-01-l03-s129": {
      "text": "Tirava vento, come la prima sera; ma Gherardo rideva di nuovo, quasi come prima.",
      "items": [
        {
          "text": "di nuovo",
          "lemma": "di nuovo",
          "pos": "phr.",
          "en": "again"
        }
      ]
    },
    "it-dante-01-l03-s159": {
      "text": "Lapo pensò al suo no.",
      "items": [
        {
          "text": "al suo no",
          "lemma": "pensare a",
          "pos": "phr.",
          "en": "thought about his no"
        }
      ]
    },
    "it-dante-01-l03-s160": {
      "text": "All'abaco Gherardo domandava sempre due volte.",
      "items": [
        {
          "text": "domandava sempre due volte",
          "lemma": "domandare due volte",
          "pos": "phr.",
          "en": "always asked twice"
        }
      ]
    }
  }
}
