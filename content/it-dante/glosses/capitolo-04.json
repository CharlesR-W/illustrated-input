    "it-dante-01-l04-s102": {
      "text": "Gli hanno tagliato il naso!»",
      "items": [
        {
          "text": "Gli",
          "lemma": "gli",
          "pos": "pron.",
          "en": "to him (here: his)"
        }
      ]
    },
    "it-dante-01-l04-s103": {
      "text": "«Lo so», disse Ser Bindo.",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l04-s107": {
      "text": "«Questa mattina abbiamo venduto due panni a un mercante di Siena, e nel libro non ci sono ancora.»",
      "items": [
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "n.",
          "en": "cloths, lengths of cloth"
        }
      ]
    },
    "it-dante-01-l04-s111": {
      "text": "Il libro va avanti.»",
      "items": [
        {
          "text": "va avanti",
          "lemma": "andare avanti",
          "pos": "phr.",
          "en": "goes on, keeps going"
        }
      ]
    },
    "it-dante-01-l04-s112": {
      "text": "Lapo prese la penna e scrisse nel libro, come ogni giorno: i due panni, il nome del mercante, la somma, due volte, da una parte e dall'altra.",
      "items": [
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "n.",
          "en": "cloths, lengths of cloth"
        }
      ]
    },
    "it-dante-01-l04-s114": {
      "text": "«Bene. Ancora un conto», disse Ser Bindo.",
      "items": [
        {
          "text": "Ancora un conto",
          "lemma": "ancora un conto",
          "pos": "phr.",
          "en": "one more entry"
        }
      ]
    },
    "it-dante-01-l04-s115": {
      "text": "«Scrivi: oggi, primo di maggio, dati per i fanti di questa notte, alle case di messer Vieri, tre fiorini d'oro.»",
      "items": [
        {
          "text": "fiorini d'oro",
          "lemma": "fiorino d'oro",
          "pos": "phr.",
          "en": "gold florins"
        }
      ]
    },
    "it-dante-01-l04-s117": {
      "text": "«Ne ho veduti venti dalla finestra, alla porta di messer Vieri.»",
      "items": [
        {
          "text": "Ne",
          "lemma": "ne",
          "pos": "pron.",
          "en": "of them (twenty of them)"
        }
      ]
    },
    "it-dante-01-l04-s124": {
      "text": "La sua mano tremava, e il numero gli venne male.",
      "items": [
        {
          "text": "gli venne male",
          "lemma": "venire male",
          "pos": "phr.",
          "en": "came out badly for him (of handwriting)"
