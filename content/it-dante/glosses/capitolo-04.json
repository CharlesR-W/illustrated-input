        {
          "text": "ha perso il naso",
          "lemma": "perdere",
          "pos": "phr.",
          "en": "has lost his nose"
        }
      ]
    },
    "it-dante-01-l04-s079": {
      "text": "I suoi compagni l'hanno portato a casa.»",
      "items": [
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (l' = lo)"
        }
      ]
    },
    "it-dante-01-l04-s082": {
      "text": "Davanti a una casa una donna piangeva, e un'altra le teneva la mano.",
      "items": [
        {
          "text": "le teneva la mano",
          "lemma": "tenere la mano a qualcuno",
          "pos": "phr.",
          "en": "was holding her hand (le = a lei)",
          "components": [
            {
              "text": "le",
              "lemma": "le",
