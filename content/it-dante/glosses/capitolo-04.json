      ]
    },
    "it-dante-01-l04-s143": {
      "text": "Il giovane gettò la spada sulla tavola, vicino al libro, e guardò Lapo.",
      "items": [
        {
          "text": "gettò",
          "lemma": "gettare",
          "pos": "v.",
          "en": "threw down"
        },
        {
          "text": "vicino",
          "lemma": "vicino",
          "pos": "adv.",
          "en": "near (vicino a: near to)"
        }
      ]
    },
    "it-dante-01-l04-s144": {
      "text": "«Vieni avanti», disse.",
      "items": [
        {
          "text": "Vieni avanti",
          "lemma": "venire avanti",
          "pos": "phr.",
          "en": "come forward"
        }
      ]
