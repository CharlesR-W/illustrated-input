        {
          "text": "correva più di lui",
          "lemma": "correre",
          "pos": "phr.",
          "en": "ran faster than he did"
        }
      ]
    },
    "it-dante-01-l04-s067": {
      "text": "«Hanno ferito un Cerchi!» gridò forte un uomo da una finestra.",
      "items": [
        {
          "text": "forte",
          "lemma": "forte",
          "pos": "adv.",
          "en": "loudly"
        }
      ]
    },
    "it-dante-01-l04-s068": {
      "text": "«Gli hanno tagliato il naso!» rispose una donna dalla strada.",
      "items": [
        {
          "text": "Gli hanno tagliato il naso",
          "lemma": "tagliare il naso a qualcuno",
          "pos": "phr.",
          "en": "they've cut his nose off (gli = a lui)",
          "components": [
            {
              "text": "Gli",
              "lemma": "gli",
              "pos": "pron.",
              "en": "to him (here: his)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l04-s069": {
      "text": "«Chi è stato?»",
      "items": [
        {
          "text": "Chi è stato?",
          "lemma": "chi è stato?",
          "pos": "phr.",
          "en": "who did it? (literally: who has it been?)"
        }
      ]
    },
    "it-dante-01-l04-s071": {
      "text": "Hanno messo mano alle spade in piazza, e le donne sono fuggite in chiesa.»",
      "items": [
        {
          "text": "Hanno messo mano alle spade",
          "lemma": "mettere mano alla spada",
          "pos": "phr.",
          "en": "they drew their swords"
        }
      ]
    },
    "it-dante-01-l04-s072": {
      "text": "«Chi l'ha detto?»",
      "items": [
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (l' = lo)"
        }
      ]
    },
    "it-dante-01-l04-s073": {
      "text": "«L'hanno detto i fanti dei Cerchi.»",
      "items": [
        {
          "text": "L'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (l' = lo)"
        }
      ]
    },
    "it-dante-01-l04-s074": {
      "text": "«Ma chi ha dato il colpo?»",
      "items": [
        {
          "text": "ha dato il colpo",
          "lemma": "dare un colpo",
          "pos": "phr.",
          "en": "struck the blow"
        }
      ]
    },
    "it-dante-01-l04-s077": {
      "text": "«Morti no.",
      "items": [
        {
          "text": "Morti no",
          "lemma": "morti no",
          "pos": "phr.",
          "en": "no one dead"
        }
      ]
    },
    "it-dante-01-l04-s078": {
      "text": "Un cavaliere è caduto da cavallo, e Ricoverino de' Cerchi non è morto, ma ha perso il naso.",
      "items": [
        {
          "text": "morto",
          "lemma": "morto",
          "pos": "adj.",
          "en": "dead"
