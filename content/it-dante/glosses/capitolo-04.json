  "segments": {
    "it-dante-01-l04-s002": {
      "text": "Quel giorno le botteghe di Firenze chiusero presto, e la sera tutta la città uscì per le strade.",
      "items": [
        {
          "text": "presto",
          "lemma": "presto",
          "pos": "adv.",
          "en": "early"
        },
        {
          "text": "tutta la città uscì per le strade",
          "lemma": "uscire",
          "pos": "phr.",
          "en": "the whole city went out into the streets"
        }
      ]
    },
    "it-dante-01-l04-s003": {
      "text": "Lapo trovò Gherardo davanti a Santa Trinita, vicino al palazzo degli Spini.",
      "items": [
        {
          "text": "vicino",
          "lemma": "vicino",
          "pos": "adv.",
          "en": "near (vicino a: near to)"
        }
      ]
    },
    "it-dante-01-l04-s006": {
      "text": "«Ser Bindo ha chiuso la bottega presto, ma prima ho contato tutti i panni.»",
      "items": [
        {
          "text": "presto",
          "lemma": "presto",
          "pos": "adv.",
          "en": "early"
        },
        {
          "text": "ma prima",
          "lemma": "ma prima",
          "pos": "phr.",
          "en": "but first"
        },
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "n.",
          "en": "cloths, lengths of cloth"
        }
      ]
    },
    "it-dante-01-l04-s009": {
      "text": "Gherardo rise, e Lapo con lui, come prima.",
      "items": [
        {
          "text": "come prima",
          "lemma": "come prima",
          "pos": "phr.",
          "en": "as before"
        }
      ]
    },
    "it-dante-01-l04-s011": {
      "text": "La musica veniva da tutte le parti.",
      "items": [
        {
          "text": "da tutte le parti",
          "lemma": "da tutte le parti",
          "pos": "phr.",
          "en": "from all sides, everywhere"
        }
      ]
    },
    "it-dante-01-l04-s016": {
      "text": "Erano i giovani nobili delle grandi case, a cavallo, in brigate.",
      "items": [
        {
          "text": "grandi",
          "lemma": "grande",
          "pos": "adj.",
          "en": "great, prominent"
        },
        {
          "text": "a cavallo",
          "lemma": "a cavallo",
          "pos": "phr.",
          "en": "on horseback"
        }
      ]
    },
    "it-dante-01-l04-s020": {
      "text": "Quelli là li ho visti dagli Spini, al banco: sono amici nostri.»",
      "items": [
        {
          "text": "li",
          "lemma": "li",
          "pos": "pron.",
          "en": "them (masculine object pronoun)"
        }
      ]
    },
    "it-dante-01-l04-s021": {
      "text": "Poi Gherardo disse i nomi dei cavalieri, uno per uno, e Lapo li sentì tutti.",
      "items": [
        {
          "text": "li",
          "lemma": "li",
          "pos": "pron.",
          "en": "them"
        }
      ]
    },
    "it-dante-01-l04-s022": {
      "text": "Lapo guardò i panni dei cavalieri.",
      "items": [
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "n.",
          "en": "clothes (here: the riders' fine gowns)"
        }
      ]
    },
    "it-dante-01-l04-s023": {
      "text": "«Panni di Francia, e li abbiamo venduti noi», disse.",
      "items": [
        {
          "text": "Panni di Francia",
          "lemma": "panno",
          "pos": "n.",
          "en": "cloth from France (lengths of fine woollen cloth)",
          "components": [
            {
              "text": "Panni",
              "lemma": "panno",
              "pos": "n.",
              "en": "cloth, lengths of woollen cloth"
            }
          ]
        },
        {
          "text": "li",
          "lemma": "li",
          "pos": "pron.",
          "en": "them (the cloths)"
        }
      ]
    },
    "it-dante-01-l04-s024": {
      "text": "«I Donati non sono amici dei Cerchi, ma i panni dei Cerchi li vogliono.»",
      "items": [
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "n.",
          "en": "cloth, lengths of cloth"
        },
        {
          "text": "li",
          "lemma": "li",
          "pos": "pron.",
          "en": "them (repeating i panni)"
        }
      ]
    },
    "it-dante-01-l04-s025": {
      "text": "Gherardo rise forte.",
      "items": [
        {
          "text": "forte",
          "lemma": "forte",
          "pos": "adv.",
          "en": "loudly"
        }
      ]
    },
    "it-dante-01-l04-s026": {
      "text": "«I nobili a cavallo, e noi a piedi», disse.",
      "items": [
        {
          "text": "a piedi",
          "lemma": "a piedi",
          "pos": "phr.",
          "en": "on foot"
        }
      ]
    },
    "it-dante-01-l04-s030": {
      "text": "Tra i fanti Lapo vide una faccia: la conosceva.",
      "items": [
        {
          "text": "faccia",
          "lemma": "faccia",
          "pos": "n.",
          "en": "face"
        },
        {
          "text": "la",
          "lemma": "la",
          "pos": "pron.",
          "en": "it, her (here: the face)"
        }
      ]
    },
    "it-dante-01-l04-s036": {
      "text": "Erano i giovani dei Cerchi, anche loro a cavallo, anche loro con bei panni.",
      "items": [
        {
          "text": "bei panni",
          "lemma": "panno",
          "pos": "phr.",
          "en": "fine clothes"
        }
      ]
    },
    "it-dante-01-l04-s039": {
      "text": "Non ci fu più musica.",
      "items": [
        {
          "text": "Non ci fu più",
          "lemma": "non c'è più",
          "pos": "phr.",
          "en": "there was no more"
        }
      ]
    },
    "it-dante-01-l04-s042": {
      "text": "Le due brigate spinsero i cavalli l'una contro l'altra.",
      "items": [
        {
          "text": "l'una contro l'altra",
          "lemma": "l'uno contro l'altro",
          "pos": "phr.",
          "en": "against each other"
        }
      ]
    },
    "it-dante-01-l04-s043": {
      "text": "Qualcuno mise mano alla spada, poi un altro, poi tutti.",
      "items": [
        {
          "text": "mise mano alla spada",
          "lemma": "mettere mano alla spada",
          "pos": "phr.",
          "en": "drew his sword (literally: put his hand to the sword)"
        }
      ]
    },
    "it-dante-01-l04-s046": {
      "text": "Le donne fuggirono, e gridavano, e una giovane piangeva tra i fiori.",
      "items": [
        {
          "text": "giovane",
          "lemma": "giovane",
          "pos": "n.",
          "en": "a young woman"
        }
      ]
    },
    "it-dante-01-l04-s048": {
      "text": "Una spada passò davanti alla sua faccia e gli tagliò il naso.",
      "items": [
        {
          "text": "faccia",
          "lemma": "faccia",
          "pos": "n.",
          "en": "face"
        },
        {
          "text": "gli tagliò il naso",
          "lemma": "tagliare il naso a qualcuno",
          "pos": "phr.",
          "en": "cut off his nose (gli = a lui)",
          "components": [
            {
              "text": "gli",
              "lemma": "gli",
              "pos": "pron.",
              "en": "to him (here: his)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l04-s049": {
      "text": "Il giovane portò le mani alla faccia; il sangue gli usciva tra le mani.",
      "items": [
        {
          "text": "faccia",
          "lemma": "faccia",
          "pos": "n.",
          "en": "face"
        },
        {
          "text": "gli",
          "lemma": "gli",
          "pos": "pron.",
          "en": "to him (here: from him, his)"
        }
      ]
    },
    "it-dante-01-l04-s051": {
      "text": "I suoi compagni lo portarono fuori dalla piazza, ancora a cavallo.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him"
        }
      ]
    },
    "it-dante-01-l04-s052": {
      "text": "Lapo non vide chi diede il colpo.",
      "items": [
        {
          "text": "diede il colpo",
          "lemma": "dare un colpo",
          "pos": "phr.",
          "en": "struck the blow"
        }
      ]
    },
    "it-dante-01-l04-s055": {
      "text": "Lapo si gettò sotto una porta, e lì si fermò.",
      "items": [
        {
          "text": "si gettò sotto una porta",
          "lemma": "gettarsi",
          "pos": "phr.",
          "en": "threw himself into a doorway"
        }
      ]
    },
    "it-dante-01-l04-s056": {
      "text": "Cercò Gherardo, ma Gherardo non c'era più.",
      "items": [
        {
          "text": "non c'era più",
          "lemma": "non c'è più",
          "pos": "phr.",
          "en": "was gone"
        }
      ]
    },
    "it-dante-01-l04-s059": {
      "text": "Poi Lapo non lo vide più.",
      "items": [
        {
          "text": "non lo vide più",
          "lemma": "non... più",
          "pos": "phr.",
          "en": "did not see him any more",
          "components": [
            {
              "text": "lo",
              "lemma": "lo",
              "pos": "pron.",
              "en": "him"
            }
          ]
        }
      ]
    },
    "it-dante-01-l04-s062": {
      "text": "Lapo corse per le strade, verso Porta San Piero.",
      "items": [
        {
          "text": "verso",
          "lemma": "verso",
          "pos": "prep.",
          "en": "towards"
        }
      ]
    },
    "it-dante-01-l04-s064": {
      "text": "Era quasi notte, una notte di maggio, ma le strade erano ancora piene di gente.",
      "items": [
        {
          "text": "una notte di maggio",
          "lemma": "una notte di maggio",
          "pos": "phr.",
          "en": "a May night"
        }
      ]
    },
    "it-dante-01-l04-s065": {
      "text": "La gente era alle porte e alle finestre, e parlava a voce alta.",
      "items": [
        {
          "text": "a voce alta",
          "lemma": "a voce alta",
          "pos": "phr.",
          "en": "aloud, loudly"
        }
      ]
    },
    "it-dante-01-l04-s066": {
      "text": "La notizia correva più di lui.",
