    },
    "it-dante-01-l04-s135": {
      "text": "«Questa notte è la stessa cosa.»",
      "items": [
        {
          "text": "la stessa cosa",
          "lemma": "la stessa cosa",
          "pos": "phr.",
          "en": "the same thing"
        }
      ]
    },
    "it-dante-01-l04-s136": {
      "text": "Più tardi qualcuno chiamò forte alla porta.",
      "items": [
        {
          "text": "forte",
          "lemma": "forte",
          "pos": "adv.",
          "en": "loudly"
        }
      ]
    },
    "it-dante-01-l04-s139": {
      "text": "Lapo vide la sua faccia: era uno dei cavalieri della piazza.",
      "items": [
        {
          "text": "faccia",
          "lemma": "faccia",
          "pos": "n.",
          "en": "face"
        }
      ]
    },
    "it-dante-01-l04-s142": {
      "text": "«È scritto, messere.»",
      "items": [
        {
          "text": "È scritto",
          "lemma": "essere scritto",
          "pos": "phr.",
          "en": "it is written (in the book)"
