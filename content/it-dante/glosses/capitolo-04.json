      ]
    },
    "it-dante-01-l04-s128": {
      "text": "«Non è niente: è un conto come un altro.»",
      "items": [
        {
          "text": "un conto come un altro",
          "lemma": "un conto come un altro",
          "pos": "phr.",
          "en": "an account like any other"
        }
