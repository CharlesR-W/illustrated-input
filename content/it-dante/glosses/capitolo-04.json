    "it-dante-01-l04-s086": {
      "text": "L'hai visto?»",
      "items": [
        {
          "text": "L'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (l' = lo)"
        }
      ]
    },
    "it-dante-01-l04-s087": {
      "text": "La madre piangeva ancora, e Lapo la guardò.",
      "items": [
        {
          "text": "la",
          "lemma": "la",
          "pos": "pron.",
          "en": "her"
        }
      ]
    },
    "it-dante-01-l04-s088": {
      "text": "«Non lo so», disse.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l04-s092": {
      "text": "Ne venivano altri da tutte le strade.",
      "items": [
        {
          "text": "Ne venivano altri",
          "lemma": "ne",
          "pos": "phr.",
          "en": "more of them were coming",
