          "pos": "pron.",
          "en": "him (Baldo)"
        }
      ]
    },
    "it-dante-01-l05-s055": {
      "text": "«Se lo sapranno, lo cercheranno. Gli taglieranno il naso, come a Ricoverino.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
