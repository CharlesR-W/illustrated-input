      ]
    },
    "it-dante-01-l05-s128": {
      "text": "«Lo direte a messer Vieri?»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l05-s131": {
      "text": "«Perché niuno me l'ha domandato.»",
      "items": [
