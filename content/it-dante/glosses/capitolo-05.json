          "lemma": "ai primi di",
          "pos": "phr.",
          "en": "in the first days of June"
        }
      ]
    },
    "it-dante-01-l05-s090": {
      "text": "Veniva, diceva il papa, a fare la pace tra i Cerchi e i Donati.",
