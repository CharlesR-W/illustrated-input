          "text": "sei",
          "lemma": "sei",
          "pos": "num.",
          "en": "six"
        }
      ]
    },
    "it-dante-01-l05-s125": {
      "text": "I Donati tornarono dalla piazza per questa strada, e co' loro fanti, a piedi, c'era il marito di tua sorella.",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "det.",
          "en": "their"
