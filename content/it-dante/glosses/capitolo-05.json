      ]
    },
    "it-dante-01-l05-s073": {
      "text": "«Non l'ho fatto per i Donati.»",
      "items": [
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l05-s074": {
      "text": "«Lo so. L'hai fatto per tua sorella. Ma il mio padrone lo saprà lo stesso.»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it, so (lo so: I know)"
