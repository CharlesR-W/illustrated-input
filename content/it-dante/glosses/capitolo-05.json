          "pos": "n.",
          "en": "face"
        }
      ]
    },
    "it-dante-01-l05-s024": {
      "text": "Lapo aspettò un poco prima di rispondere. «C'era molta gente, messere.»",
      "items": [
        {
          "text": "un poco",
          "lemma": "un poco",
          "pos": "phr.",
          "en": "a little while"
        }
      ]
    },
    "it-dante-01-l05-s034": {
      "text": "La casa di Tessa e di Baldo era vicino alle case de' Donati.",
      "items": [
        {
          "text": "vicino",
          "lemma": "vicino",
          "pos": "adv.",
          "en": "near (vicino a: near)"
