          "lemma": "per primo",
          "pos": "phr.",
          "en": "first (before he could)"
        }
      ]
    },
    "it-dante-01-l05-s037": {
      "text": "«C'era anche lui», disse. «Lo sai.»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l05-s038": {
      "text": "«Lo so. L'ho visto.»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
