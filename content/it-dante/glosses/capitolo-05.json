      ]
    },
    "it-dante-01-l05-s134": {
      "text": "«E se messer Vieri lo saprà? Che farà di me?»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
