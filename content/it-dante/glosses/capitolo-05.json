      ]
    },
    "it-dante-01-l05-s104": {
      "text": "«E il naso di Ricoverino? Chi lo pagherà, con questa pace? E l'onore de' Cerchi non conta più?",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (Ricoverino's nose)"
        }
      ]
    },
    "it-dante-01-l05-s110": {
      "text": "«Li dirò, messere, se messer Vieri lo vorrà», disse. «Ma io aspetterei.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (se lo vorrà: if he wants it)"
        }
      ]
    },
    "it-dante-01-l05-s120": {
      "text": "«E quella notte, dopo la festa, desti sei nomi.»",
      "items": [
