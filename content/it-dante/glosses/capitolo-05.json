    },
    "it-dante-01-l05-s153": {
      "text": "Dalla festa di maggio Lapo non lo vedeva.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (Gherardo)"
        }
      ]
    },
    "it-dante-01-l05-s154": {
      "text": "«Sei vivo!» disse Gherardo. «Quella sera ti ho cercato per tutta la piazza.»",
