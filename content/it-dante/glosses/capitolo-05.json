      "items": [
        {
          "text": "parte",
          "lemma": "parte",
          "pos": "n.",
          "en": "a share, some"
        }
      ]
    },
    "it-dante-01-l05-s096": {
      "text": "«Oggi una parte. Domani li vorrà tutti, e il consiglio glieli darà.»",
      "items": [
        {
          "text": "parte",
          "lemma": "parte",
          "pos": "n.",
          "en": "a share, some"
        }
      ]
    },
    "it-dante-01-l05-s097": {
      "text": "«Il consiglio non gli darà niente senza la Signoria. E la Signoria dirà di no.»",
