          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        },
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        },
        {
          "text": "lo stesso",
          "lemma": "lo stesso",
          "pos": "phr.",
          "en": "all the same, anyway"
        }
      ]
    },
    "it-dante-01-l05-s077": {
      "text": "Lapo prese un fiorino e lo pesò nella mano, come ser Bindo.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the florin)"
