      ]
    },
    "it-dante-01-l05-s080": {
      "text": "«Un giorno, quando i Cerchi cadranno, e cadranno, verrai da me a domandare aiuto», disse Baldo. «E io ci sarò.»",
      "items": [
        {
          "text": "ci sarò",
