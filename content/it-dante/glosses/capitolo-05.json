          "lemma": "sei",
          "pos": "num.",
          "en": "six"
        }
      ]
    },
    "it-dante-01-l05-s044": {
      "text": "«Non lo cercano. Non hanno il suo nome.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (Baldo)"
        }
      ]
    },
