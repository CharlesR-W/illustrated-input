{
  "schema_version": 1,
  "lesson_id": "it-dante-01-l08",
  "segments": {
    "it-dante-01-l08-s001": {
      "text": "Era già il coprifuoco, e nella strada non c'era più niuno.",
      "items": [
        {
          "text": "più",
          "lemma": "più",
          "pos": "phr.",
          "en": "(non… più) any more, no longer"
        }
      ]
    },
    "it-dante-01-l08-s015": {
      "text": "Gherardo guardò ancora la strada, prima da una parte e poi dall'altra.",
      "items": [
        {
          "text": "ancora",
          "lemma": "ancora",
          "pos": "phr.",
          "en": "again"
        }
      ]
    },
    "it-dante-01-l08-s016": {
      "text": "«Non ho molto tempo. Tre sere fa, in Santa Trinita, ci fu un consiglio segreto. Gli amici de' Donati, e gli amici del papa. I Neri, come li chiamano ora; e voi siete i Bianchi.",
      "items": [
        {
          "text": "Tre sere fa",
          "lemma": "tre sere fa",
          "pos": "phr.",
          "en": "three evenings ago",
          "components": [
            {
              "text": "fa",
              "lemma": "fare",
              "pos": "v.",
              "en": "ago"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s018": {
      "text": "«E tu che c'entri?»",
      "items": [
        {
          "text": "che c'entri",
          "lemma": "che c'entri",
          "pos": "phr.",
          "en": "what has it got to do with you?"
        }
      ]
    },
    "it-dante-01-l08-s029": {
      "text": "«Qui, in casa tua, a fare conti, come facevamo da ragazzi. Fino a tardi.",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "phr.",
          "en": "accounts, sums (fare conti: do accounts)"
        },
        {
          "text": "da ragazzi",
          "lemma": "da ragazzi",
          "pos": "phr.",
          "en": "as boys"
        }
      ]
    },
    "it-dante-01-l08-s034": {
      "text": "Era stato in casa, alla tavola, con i conti di ser Bindo; sua madre gli aveva portato del pane ed era andata a dormire.",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "phr.",
          "en": "accounts, sums"
        }
      ]
    },
    "it-dante-01-l08-s043": {
      "text": "«Gli Spini non mi conoscono più, da ieri. Se gli ufficiali mi prendono, è il confino, se va bene. Se va male, non lo so.»",
      "items": [
        {
          "text": "più",
          "lemma": "più",
          "pos": "phr.",
          "en": "(non… più) any more, no longer"
        },
        {
          "text": "se va bene",
          "lemma": "se va bene",
          "pos": "phr.",
          "en": "if things go well"
        }
      ]
    },
    "it-dante-01-l08-s049": {
      "text": "Lapo sentì che la bugia era venuta da sé, come un numero.",
      "items": [
        {
          "text": "venuta da sé",
          "lemma": "venire da sé",
          "pos": "phr.",
          "en": "come by itself, unbidden"
        }
      ]
    },
    "it-dante-01-l08-s053": {
      "text": "Gherardo disse «Grazie», come si risponde a un sì, e se ne andò.",
      "items": [
        {
          "text": "come si risponde a un sì",
          "lemma": "rispondere a un sì",
          "pos": "phr.",
          "en": "as one answers a yes"
        },
        {
          "text": "se ne andò",
          "lemma": "andarsene",
          "pos": "phr.",
          "en": "went off, went away",
          "components": [
            {
              "text": "ne",
              "lemma": "ne",
              "pos": "pron.",
              "en": "(andarsene) away, off"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s069": {
      "text": "«Quattro sere fa, dopo il coprifuoco, dove eri?»",
      "items": [
        {
          "text": "Quattro sere fa",
          "lemma": "quattro sere fa",
          "pos": "phr.",
          "en": "four evenings ago",
          "components": [
            {
              "text": "fa",
              "lemma": "fare",
              "pos": "v.",
              "en": "ago"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s070": {
      "text": "«A casa mia, messere. Facevo i conti per ser Bindo.»",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "phr.",
          "en": "accounts, sums"
        }
      ]
    },
    "it-dante-01-l08-s078": {
      "text": "«Fino a quando? Sei certo?»",
      "items": [
        {
          "text": "certo",
          "lemma": "certo",
          "pos": "phr.",
          "en": "sure, certain"
        }
      ]
    },
    "it-dante-01-l08-s089": {
      "text": "«Dubito che un giovane de' Cerchi dica bugie per salvare uno degli Spini», disse. «Che ragione avrebbe?»",
      "items": [
        {
          "text": "dica",
          "lemma": "dire",
          "pos": "phr.",
          "en": "(that he) tells"
        }
      ]
    },
    "it-dante-01-l08-s094": {
      "text": "«Che sia scritto», disse l'ufficiale, e il notaio scrisse.",
      "items": [
        {
          "text": "Che sia scritto",
          "lemma": "che sia scritto",
          "pos": "phr.",
          "en": "let it be written"
        }
      ]
    },
    "it-dante-01-l08-s095": {
      "text": "Se ne andarono senza un'altra parola.",
      "items": [
        {
          "text": "Se ne andarono",
          "lemma": "andarsene",
          "pos": "phr.",
          "en": "went off, went away",
          "components": [
            {
              "text": "ne",
              "lemma": "ne",
              "pos": "pron.",
              "en": "(andarsene) away, off"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s100": {
      "text": "«Domandavano di Gherardo. Dove era quattro sere fa.»",
      "items": [
        {
          "text": "quattro sere fa",
          "lemma": "quattro sere fa",
          "pos": "phr.",
          "en": "four evenings ago",
          "components": [
            {
              "text": "fa",
              "lemma": "fare",
              "pos": "v.",
              "en": "ago"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s104": {
      "text": "Bindo scrisse ancora un numero, e lo rilesse.",
      "items": [
        {
          "text": "ancora un numero",
          "lemma": "ancora un numero",
          "pos": "phr.",
          "en": "one more figure",
          "components": [
            {
              "text": "ancora",
              "lemma": "ancora",
              "pos": "adv.",
              "en": "one more, another"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s110": {
      "text": "«Per Gherardo. Volevano sapere dove era quattro sere fa.»",
      "items": [
        {
          "text": "quattro sere fa",
          "lemma": "quattro sere fa",
          "pos": "phr.",
          "en": "four evenings ago",
          "components": [
            {
              "text": "fa",
              "lemma": "fare",
              "pos": "v.",
              "en": "ago"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s117": {
      "text": "«Bene», disse Cione dopo un poco. «Spero che non te lo domandino più. Ma se te lo domandano un'altra volta, di' la stessa cosa. Sempre la stessa.»",
      "items": [
        {
          "text": "più",
          "lemma": "più",
          "pos": "phr.",
          "en": "(non… più) any more, no longer"
        }
      ]
    },
    "it-dante-01-l08-s119": {
      "text": "Lapo prese il suo pane, e nessuno parlò più di Gherardo.",
      "items": [
        {
          "text": "più",
          "lemma": "più",
          "pos": "phr.",
          "en": "(nessuno… più) any more"
        }
      ]
    },
    "it-dante-01-l08-s125": {
      "text": "«Ci fu chi disse di sì. Il papa è il papa.",
      "items": [
        {
          "text": "Il papa è il papa",
          "lemma": "il papa è il papa",
          "pos": "phr.",
          "en": "the pope is the pope (there's no refusing him)"
        }
      ]
    },
    "it-dante-01-l08-s135": {
      "text": "Nihil fiat.»",
      "items": [
        {
          "text": "Nihil fiat",
          "lemma": "nihil fiat",
          "pos": "phr.",
          "en": "(Latin) let nothing be done"
        }
      ]
    },
    "it-dante-01-l08-s138": {
      "text": "«Che non si faccia niente! E il papa che deve fare? Ringraziarlo? Ce la farà pagare cara, a tutti noi.»",
      "items": [
        {
          "text": "Ce la farà pagare cara",
          "lemma": "farla pagare cara",
          "pos": "phr.",
          "en": "he will make us pay dearly for it"
        }
      ]
    },
    "it-dante-01-l08-s144": {
      "text": "Lapo domandò, prima di pensarci: «E voi, ser Bindo? Credete che abbia fatto bene?»",
      "items": [
        {
          "text": "abbia",
          "lemma": "avere",
          "pos": "v.",
          "en": "(that he) has (auxiliary: abbia fatto, has done)",
          "form": "pres. subj. 3sg"
        }
      ]
    },
    "it-dante-01-l08-s146": {
      "text": "«Credo che abbia ragione. E credo che in Firenze ci siano pochi uomini che dicano di no al papa davanti a tutto il consiglio.",
      "items": [
        {
          "text": "abbia ragione",
          "lemma": "avere ragione",
          "pos": "phr.",
          "en": "is right"
        }
      ]
    },
    "it-dante-01-l08-s147": {
      "text": "E temo che la paghi cara.»",
      "items": [
        {
          "text": "la paghi cara",
          "lemma": "pagarla cara",
          "pos": "phr.",
          "en": "will pay dearly for it",
          "components": [
            {
              "text": "paghi",
              "lemma": "pagare",
              "pos": "v.",
              "en": "(that he) pay",
              "form": "pres. subj. 3sg"
            },
            {
              "text": "cara",
              "lemma": "caro",
              "pos": "adv.",
              "en": "dearly (pagarla cara: pay dearly for it)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s151": {
      "text": "Messer Carlo di Valois, fratello del re di Francia, venne dal papa con i suoi cavalieri francesi, e a Firenze non si parlò d'altro.",
      "items": [
        {
          "text": "non si parlò d'altro",
          "lemma": "non parlare d'altro",
          "pos": "phr.",
          "en": "people talked of nothing else"
        }
      ]
    },
    "it-dante-01-l08-s156": {
      "text": "Sulla tavola c'erano altre tre lettere di cambio, già scritte, per Bologna.",
      "items": [
        {
          "text": "lettere di cambio",
          "lemma": "lettera di cambio",
          "pos": "phr.",
          "en": "bills of exchange"
        }
      ]
    },
    "it-dante-01-l08-s157": {
      "text": "«Scrivi», disse Bindo. «Mandiamo mille fiorini a Bologna, ai nostri amici di là. Nelle due parti, come sempre.»",
      "items": [
        {
          "text": "ai nostri amici di là",
          "lemma": "di là",
          "pos": "phr.",
          "en": "to our friends there (the company's correspondents)"
        },
        {
          "text": "Nelle due parti",
          "lemma": "nelle due parti",
          "pos": "phr.",
          "en": "on both sides (of the books: debit and credit)",
          "components": [
            {
              "text": "parti",
              "lemma": "parte",
              "pos": "n.",
              "en": "sides (of an account)",
              "form": "f. pl."
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s158": {
      "text": "Lapo scrisse il dare e l'avere.",
      "items": [
        {
          "text": "il dare e l'avere",
          "lemma": "il dare e l'avere",
          "pos": "phr.",
          "en": "the debit and the credit (the two sides of an entry)",
          "components": [
            {
              "text": "dare",
              "lemma": "dare",
              "pos": "n.",
              "en": "the debit side (what is owed)",
              "form": "m. sg."
            },
            {
              "text": "avere",
              "lemma": "avere",
              "pos": "n.",
              "en": "the credit side (what is due)",
              "form": "m. sg."
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s169": {
      "text": "«Credo che li ascolti molto bene. E che poi faccia quello che voleva fare prima.»",
      "items": [
        {
          "text": "faccia",
          "lemma": "fare",
          "pos": "phr.",
          "en": "(that he) does"
        }
      ]
    },
    "it-dante-01-l08-s174": {
      "text": "«I soci vogliono che io faccia quello che faccio. Non vogliono sapere come.»",
      "items": [
        {
          "text": "faccia",
          "lemma": "fare",
          "pos": "phr.",
          "en": "(that I) do"
        }
      ]
    },
    "it-dante-01-l08-s186": {
      "text": "«Che cosa volete che io faccia?»",
      "items": [
        {
          "text": "faccia",
          "lemma": "fare",
          "pos": "phr.",
          "en": "(that I) should do"
        }
      ]
    },
    "it-dante-01-l08-s187": {
      "text": "«Niente. Te lo dico perché tu sappia dove è il pericolo.»",
      "items": [
        {
          "text": "Te lo dico perché tu sappia",
          "lemma": "perché + subjunctive",
          "pos": "phr.",
          "en": "I tell you so that you may know",
          "components": [
            {
              "text": "sappia",
              "lemma": "sapere",
              "pos": "v.",
              "en": "(that you) know",
              "form": "pres. subj. 2sg"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s188": {
      "text": "Lapo guardò la pagina dove il suo nome tornava, scritto dalla sua mano, accanto a ogni somma.",
      "items": [
        {
          "text": "tornava",
          "lemma": "tornare",
          "pos": "phr.",
          "en": "came back, recurred"
        }
      ]
    },
    "it-dante-01-l08-s190": {
      "text": "«Dio ce ne guardi», disse Bindo, e chiuse il libro.",
      "items": [
        {
          "text": "Dio ce ne guardi",
          "lemma": "Dio ce ne guardi",
          "pos": "phr.",
          "en": "God keep us from it"
        }
      ]
    },
    "it-dante-01-l08-s192": {
      "text": "Portava panni nuovi, neri, e tutta la strada lo guardava.",
      "items": [
        {
          "text": "Portava",
          "lemma": "portare",
          "pos": "phr.",
          "en": "wore"
        },
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "phr.",
          "en": "clothes"
        }
      ]
    },
    "it-dante-01-l08-s195": {
      "text": "«Ti piace il colore?» disse Gherardo. «Il nero sta bene a tutti, oggi più che mai.»",
      "items": [
        {
          "text": "nero",
          "lemma": "nero",
          "pos": "phr.",
          "en": "black (the colour)"
        },
        {
          "text": "sta bene a tutti",
          "lemma": "stare bene a",
          "pos": "phr.",
          "en": "suits everyone"
        },
        {
          "text": "più che mai",
          "lemma": "più che mai",
          "pos": "phr.",
          "en": "more than ever"
        }
      ]
    },
    "it-dante-01-l08-s197": {
      "text": "«Non mi avevi mai guardato bene. Il nero è il mio colore, ora; e non è caro, per quello che salva.»",
      "items": [
        {
          "text": "nero",
          "lemma": "nero",
          "pos": "phr.",
          "en": "black (the colour)"
        }
      ]
    },
    "it-dante-01-l08-s200": {
      "text": "Il notaio ha scritto bene. Quelli di Santa Trinita li hanno condannati; me no. Credo che tu mi abbia salvato dal confino.»",
      "items": [
        {
          "text": "tu mi abbia salvato",
          "lemma": "salvare",
          "pos": "phr.",
          "en": "(that) you have saved me",
          "components": [
            {
              "text": "abbia",
              "lemma": "avere",
              "pos": "v.",
              "en": "(that you) have (auxiliary: abbia salvato, have saved)",
              "form": "pres. subj. 2sg"
            },
            {
              "text": "salvato",
              "lemma": "salvare",
              "pos": "v.",
              "en": "saved",
              "form": "past part."
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s205": {
      "text": "«Sei in pericolo anche tu, e non lo sai. Bisogna che tu trovi un altro padrone finché c'è tempo, prima che vengano i francesi.»",
      "items": [
        {
          "text": "trovi",
          "lemma": "trovare",
          "pos": "phr.",
          "en": "(that you) find"
        }
      ]
    },
    "it-dante-01-l08-s207": {
      "text": "«Hai ragione, sono ricchi. Ma i Cerchi aspettano. Una cosa è certa: messer Corso non aspetta. Si prepara.",
      "items": [
        {
          "text": "Hai ragione",
          "lemma": "avere ragione",
          "pos": "phr.",
          "en": "you are right"
        }
      ]
    },
    "it-dante-01-l08-s210": {
      "text": "«Allora spero che tu abbia amici fra i Neri. I Bianchi non ti salveranno.»",
      "items": [
        {
          "text": "tu abbia amici",
          "lemma": "avere",
          "pos": "phr.",
          "en": "(that) you have friends",
          "components": [
            {
              "text": "abbia",
              "lemma": "avere",
              "pos": "v.",
              "en": "(that you) have",
              "form": "pres. subj. 2sg"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s216": {
      "text": "«Un'altra cosa. Messer Carlo è passato in Toscana, con i suoi francesi.",
      "items": [
        {
          "text": "è passato",
          "lemma": "passare",
          "pos": "phr.",
          "en": "has crossed (into)",
          "components": [
            {
              "text": "passato",
              "lemma": "passare",
              "pos": "v.",
              "en": "passed, crossed (past participle)",
              "form": "past part."
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s217": {
      "text": "Voi dei Cerchi lo saprete domani; noi lo sappiamo da ieri sera. Meglio che tu lo sappia da me.»",
      "items": [
        {
          "text": "Meglio che tu lo sappia",
          "lemma": "meglio che tu lo sappia",
          "pos": "phr.",
          "en": "better that you know it",
          "components": [
            {
              "text": "sappia",
              "lemma": "sapere",
              "pos": "v.",
              "en": "(that you) know",
              "form": "pres. subj. 2sg"
            }
          ]
        }
      ]
    },
    "it-dante-01-l08-s218": {
      "text": "Poi se ne andò, nei suoi panni neri, per la strada piena di sole.",
      "items": [
        {
          "text": "se ne andò",
          "lemma": "andarsene",
          "pos": "phr.",
          "en": "went off, went away",
          "components": [
            {
              "text": "ne",
              "lemma": "ne",
              "pos": "pron.",
              "en": "(andarsene) away, off"
            }
          ]
        },
        {
          "text": "panni",
          "lemma": "panno",
          "pos": "phr.",
          "en": "clothes"
        }
      ]
    }
  }
