{
  "schema_version": 1,
  "lesson_id": "it-dante-01-l11",
  "segments": {
    "it-dante-01-l11-s001": {
      "text": "Il giorno prima di Natale la bottega de' Cerchi teneva aperta una finestra sola.",
      "items": [
        {
          "text": "teneva aperta una finestra sola",
          "lemma": "tenere aperto",
          "pos": "phr.",
          "en": "kept only one shutter open"
        }
      ]
    },
    "it-dante-01-l11-s002": {
      "text": "Le altre erano ancora rotte, dalla notte di novembre, e sopra la porta il muro era nero di fumo.",
      "items": [
        {
          "text": "dalla notte di novembre",
          "lemma": "notte",
          "pos": "phr.",
          "en": "since the night in November (the looting)"
        }
      ]
    },
    "it-dante-01-l11-s005": {
      "text": "Le ferite di novembre gli facevano ancora male, e quando si alzava teneva una mano sulla tavola.",
      "items": [
        {
          "text": "gli facevano ancora male",
          "lemma": "fare male",
          "pos": "phr.",
          "en": "still hurt him",
          "components": [
            {
              "text": "gli",
              "lemma": "gli",
              "pos": "pron.",
              "en": "to him (indirect object)"
            }
          ]
        },
        {
          "text": "si alzava",
          "lemma": "alzarsi",
          "pos": "v.",
          "en": "got up, stood up"
        }
      ]
    },
    "it-dante-01-l11-s006": {
      "text": "I libri della compagnia erano nel palazzo del podestà; Bindo scriveva i conti di quei giorni in un libro piccolo e nuovo, e la sera lo portava a casa con sé.",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "n.",
          "en": "accounts (m. pl.)"
        },
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the small book)"
        }
      ]
    },
    "it-dante-01-l11-s007": {
      "text": "Verso sera si sentirono cavalli correre per la strada, e poi delle voci.",
      "items": [
        {
          "text": "Verso",
          "lemma": "verso",
          "pos": "prep.",
          "en": "towards (verso sera: towards evening)"
        }
      ]
    },
    "it-dante-01-l11-s008": {
      "text": "Uno dei fanti aprì la porta, guardò fuori e la chiuse di nuovo.",
      "items": [
        {
          "lemma": "la",
          "pos": "art.",
          "en": "the (feminine singular)",
          "text": "la"
        },
        {
          "text": "la",
          "lemma": "la",
          "pos": "pron.",
          "en": "it (the door)"
        }
      ]
    },
    "it-dante-01-l11-s009": {
      "text": "«Hanno ucciso messer Niccola.»",
      "items": [
        {
          "text": "Hanno ucciso",
          "lemma": "uccidere",
          "pos": "v.",
          "en": "they have killed"
        }
      ]
    },
    "it-dante-01-l11-s012": {
      "text": "«Al ponte sull'Affrico, fuori della città.",
      "items": [
        {
          "text": "sull'Affrico",
          "lemma": "Affrico",
          "pos": "prop. n.",
          "en": "over the Affrico, a stream east of the city"
        }
      ]
    },
    "it-dante-01-l11-s013": {
      "text": "Tornava dal suo mulino.»",
      "items": [
        {
          "text": "Tornava",
          "lemma": "tornare",
          "pos": "v.",
          "en": "he was coming back"
        }
      ]
    },
    "it-dante-01-l11-s015": {
      "text": "Per la strada correva gente verso le case de' Cerchi, e ognuno raccontava un'altra cosa.",
      "items": [
        {
          "text": "verso",
          "lemma": "verso",
          "pos": "prep.",
          "en": "towards"
        }
      ]
    },
    "it-dante-01-l11-s016": {
      "text": "Un ragazzo disse che messer Niccola tornava dal mulino con due compagni soli.",
      "items": [
        {
          "text": "tornava",
          "lemma": "tornare",
          "pos": "v.",
          "en": "was coming back"
        }
      ]
    },
    "it-dante-01-l11-s017": {
      "text": "Un fante disse che Simone, il figlio di messer Corso, l'aveva aspettato al ponte con i suoi uomini.",
      "items": [
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (Niccola)"
        }
      ]
    },
    "it-dante-01-l11-s018": {
      "text": "Era stato un agguato, disse un altro: i Donati erano là prima di lui, e lo aspettavano.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (Niccola)"
        }
      ]
    },
    "it-dante-01-l11-s020": {
      "text": "Un vecchio rispose che l'aveva, e che prima di cadere aveva ferito Simone.",
      "items": [
        {
          "text": "l'",
          "lemma": "la",
          "pos": "pron.",
          "en": "it (the sword)"
        },
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        }
      ]
    },
    "it-dante-01-l11-s021": {
      "text": "Poi una voce disse che Simone era suo nipote, e per un poco nessuno disse più niente.",
      "items": [
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "per un poco",
          "lemma": "un poco",
          "pos": "phr.",
          "en": "for a little while"
        }
      ]
    },
    "it-dante-01-l11-s024": {
      "text": "Verso notte venne un cavallo, con un fante a piedi accanto, e sopra il cavallo c'era un uomo coperto da un panno.",
      "items": [
        {
          "text": "Verso",
          "lemma": "verso",
          "pos": "prep.",
          "en": "towards (verso notte: towards night)"
        }
      ]
    },
    "it-dante-01-l11-s025": {
      "text": "Lapo guardò il panno: era un panno di Francia, di quelli che i Cerchi vendevano in bottega.",
      "items": [
        {
          "text": "vendevano",
          "lemma": "vendere",
          "pos": "v.",
          "en": "sold, used to sell"
        }
      ]
    },
    "it-dante-01-l11-s029": {
      "text": "«Dicono che Simone l'ha aspettato al ponte.",
      "items": [
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "him (Niccola)"
        }
      ]
    },
    "it-dante-01-l11-s031": {
      "text": "Una donna dice che messer Niccola non aveva la spada, e un vecchio dice che l'aveva, e che ha ferito Simone.",
      "items": [
        {
          "text": "l'",
          "lemma": "la",
          "pos": "pron.",
          "en": "it (the sword)"
        },
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        }
      ]
    },
    "it-dante-01-l11-s032": {
      "text": "E dicono che Simone è suo nipote.»",
      "items": [
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        }
      ]
    },
    "it-dante-01-l11-s034": {
      "text": "Sua madre era una Cerchi.",
      "items": [
        {
          "text": "una Cerchi",
          "lemma": "Cerchi",
          "pos": "prop. n.",
          "en": "a woman of the Cerchi family"
        }
      ]
    },
    "it-dante-01-l11-s036": {
      "text": "Lo sapevano tutti, anche i Donati.»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (that fact)"
        }
      ]
    },
    "it-dante-01-l11-s037": {
      "text": "L'altro fante, il più giovane, si alzò.",
      "items": [
        {
          "text": "si alzò",
          "lemma": "alzarsi",
          "pos": "v.",
          "en": "stood up"
        }
      ]
    },
    "it-dante-01-l11-s038": {
      "text": "«Stanotte i Cerchi avranno la loro vendetta.»",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "det.",
          "en": "their"
        }
      ]
    },
    "it-dante-01-l11-s039": {
      "text": "«Stanotte messer Vieri chiuderà le porte e conterà i suoi uomini.»",
      "items": [
        {
          "text": "Stanotte",
          "lemma": "stanotte",
          "pos": "adv.",
          "en": "tonight"
        }
      ]
    },
    "it-dante-01-l11-s043": {
      "text": "Pensò che quel conto restava aperto, e si domandò chi l'avrebbe chiuso.",
      "items": [
        {
          "text": "si domandò",
          "lemma": "domandarsi",
          "pos": "v.",
          "en": "he wondered"
        },
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the account)"
        }
      ]
    },
    "it-dante-01-l11-s046": {
      "text": "Quando Lapo tornò a casa, le loro case erano chiuse, e dalle finestre si sentivano soltanto le donne che piangevano.",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "det.",
          "en": "their"
        }
      ]
    },
    "it-dante-01-l11-s049": {
      "text": "«Simone è morto stanotte, della sua ferita.",
      "items": [
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "è morto stanotte",
          "lemma": "morire",
          "pos": "phr.",
          "en": "died last night"
        }
      ]
    },
    "it-dante-01-l11-s056": {
      "text": "Come me.»",
      "items": [
        {
          "text": "Come me",
          "lemma": "come",
          "pos": "phr.",
          "en": "Like me (neither do I)"
        }
      ]
    },
    "it-dante-01-l11-s060": {
      "text": "Baldo dice che la vendetta l'ha già avuta: messer Niccola è morto.»",
      "items": [
        {
          "text": "l'",
          "lemma": "la",
          "pos": "pron.",
          "en": "it (the revenge)"
        },
        {
          "text": "è morto",
          "lemma": "morire",
          "pos": "phr.",
          "en": "is dead"
        }
      ]
    },
    "it-dante-01-l11-s062": {
      "text": "«Uno de' Cerchi e uno de' Donati.»",
      "items": [
        {
          "text": "Uno de' Cerchi e uno de' Donati",
          "lemma": "uno",
          "pos": "phr.",
          "en": "One of the Cerchi and one of the Donati (one dead on each side)"
        }
      ]
    },
    "it-dante-01-l11-s063": {
      "text": "«E nessuno de' nostri.»",
      "items": [
        {
          "text": "de' nostri",
          "lemma": "nostro",
          "pos": "phr.",
          "en": "of our people (our family)"
        }
      ]
    },
    "it-dante-01-l11-s065": {
      "text": "Giovanni Villani, in quegli anni, era un giovane mercante di Firenze.",
      "items": [
        {
          "text": "Giovanni Villani",
          "lemma": "Giovanni Villani",
          "pos": "prop. n.",
          "en": "Giovanni Villani (c. 1280–1348), merchant and chronicler of Florence",
          "components": [
            {
              "text": "Giovanni",
              "lemma": "Giovanni",
              "pos": "prop. n.",
              "en": "Giovanni (Villani)"
            },
            {
              "text": "Villani",
              "lemma": "Villani",
              "pos": "prop. n.",
              "en": "Villani (Giovanni, the chronicler)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s067": {
      "text": "«[…] avvenne il dì di Pasqua di Natale presente, andando messer Niccola de' Cerchi bianchi al suo podere e molina con suoi compagni a cavallo, passando per la piazza di Santa Croce, che vi si facea il predicare, Simone di messer Corso Donati, nipote per madre del detto messer Niccola, sospinto e confortato di mal fare, con suoi compagni e masnadieri seguì a cavallo il detto messer Niccola, e giugnendolo al ponte ad Affrico l'assalì combattendo:",
      "items": [
        {
          "text": "Pasqua di Natale presente",
          "lemma": "Pasqua di Natale",
          "pos": "phr.",
          "en": "Christmas Day of this year (presente: this, the present one)"
        },
        {
          "text": "de' Cerchi bianchi",
          "lemma": "Cerchi",
          "pos": "phr.",
          "en": "of the White Cerchi (the branch of the family on the White side)"
        },
        {
          "text": "Santa Croce",
          "lemma": "Santa Croce",
          "pos": "prop. n.",
          "en": "Santa Croce, the Franciscan church and its square",
          "components": [
            {
              "text": "Santa",
              "lemma": "Santa Croce",
              "pos": "prop. n.",
              "en": "Santa (Croce)"
            },
            {
              "text": "Croce",
              "lemma": "Santa Croce",
              "pos": "prop. n.",
              "en": "(Santa) Croce"
            }
          ]
        },
        {
          "text": "che vi si facea il predicare",
          "lemma": "predicare",
          "pos": "phr.",
          "en": "where a sermon was being preached"
        },
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "nipote per madre",
          "lemma": "nipote",
          "pos": "phr.",
          "en": "nephew on his mother's side"
        },
        {
          "text": "sospinto e confortato di mal fare",
          "lemma": "sospingere, confortare",
          "pos": "phr.",
          "en": "driven and urged on to do harm"
        },
        {
          "text": "l'assalì combattendo",
          "lemma": "assalire",
          "pos": "phr.",
          "en": "attacked him, fighting",
          "components": [
            {
              "text": "l'",
              "lemma": "lo",
              "pos": "pron.",
              "en": "him (Niccola)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s068": {
      "text": "per la qual cosa il detto messer Niccola sanza colpa o cagione, né guardandosi di Simone dal detto suo nipote fu morto e atterrato da cavallo.",
      "items": [
        {
          "text": "per la qual cosa",
          "lemma": "quale",
          "pos": "phr.",
          "en": "for which reason, and so"
        },
        {
          "text": "né guardandosi di Simone",
          "lemma": "guardarsi",
          "pos": "phr.",
          "en": "nor being on his guard against Simone",
          "components": [
            {
              "text": "Simone",
              "lemma": "Simone",
              "pos": "prop. n.",
              "en": "Simone Donati, messer Corso's son"
            }
          ]
        },
        {
          "text": "fu morto",
          "lemma": "morire",
          "pos": "phr.",
          "en": "was killed (old passive of morire = uccidere)"
        },
        {
          "text": "atterrato da cavallo",
          "lemma": "atterrare",
          "pos": "phr.",
          "en": "thrown from his horse"
        }
      ]
    },
    "it-dante-01-l11-s069": {
      "text": "Ma come piacque a Dio, la pena fu apparecchiata alla colpa, che fedito il detto Simone dal detto messer Niccola per lo fianco, la notte presente morio, […] ed era tutta la speranza del suo padre messer Corso […].»",
      "items": [
        {
          "text": "la pena fu apparecchiata alla colpa",
          "lemma": "pena",
          "pos": "phr.",
          "en": "the punishment was made ready for the crime"
        },
        {
          "text": "Simone",
          "lemma": "Simone",
          "pos": "prop. n.",
          "en": "Simone Donati, messer Corso's son"
        },
        {
          "text": "per lo fianco",
          "lemma": "fianco",
          "pos": "phr.",
          "en": "in the side (lo = il, old use after per)"
        },
        {
          "text": "la notte presente",
          "lemma": "notte",
          "pos": "phr.",
          "en": "that same night"
        },
        {
          "text": "del suo padre",
          "lemma": "padre",
          "pos": "phr.",
          "en": "of his father"
        }
      ]
    },
    "it-dante-01-l11-s070": {
      "text": "Villani non raccontò la cosa come la raccontavano quella sera per la strada: per lui era il giorno di Natale, e Simone morì la notte stessa.",
      "items": [
        {
          "text": "Villani",
          "lemma": "Villani",
          "pos": "prop. n.",
          "en": "Villani (Giovanni, the chronicler)"
        }
      ]
    },
    "it-dante-01-l11-s071": {
      "text": "Dopo Natale i fanti alla porta della bottega erano quattro, e la sera non se ne andavano prima del coprifuoco.",
      "items": [
        {
          "text": "se",
          "lemma": "si",
          "pos": "pron.",
          "en": "(se ne andavano: andarsene, go away)"
        }
      ]
    },
    "it-dante-01-l11-s072": {
      "text": "Una sera di gennaio, appena i fanti se ne furono andati, Bindo chiuse la finestra, la sola che non era rotta, e mise la lanterna sul banco, fra sé e Lapo.",
      "items": [
        {
          "text": "se",
          "lemma": "si",
          "pos": "pron.",
          "en": "(se ne furono andati: andarsene, go away)"
        },
        {
          "text": "fra sé e Lapo",
          "lemma": "sé",
          "pos": "phr.",
          "en": "between himself and Lapo"
        }
      ]
    },
    "it-dante-01-l11-s075": {
      "text": "«Oggi ho parlato con un notaio che conosco da quarant'anni.",
      "items": [
        {
          "text": "da quarant'anni",
          "lemma": "da",
          "pos": "phr.",
          "en": "for forty years (and still)"
        }
      ]
    },
    "it-dante-01-l11-s077": {
      "text": "Mi ha detto che i notai del podestà leggono i nostri libri pagina per pagina, e che non cercano errori di conto.»",
      "items": [
        {
          "text": "pagina per pagina",
          "lemma": "pagina",
          "pos": "phr.",
          "en": "page by page"
        }
      ]
    },
    "it-dante-01-l11-s081": {
      "text": "Una partita sola, e la condanna è fatta.",
      "items": [
        {
          "text": "la condanna è fatta",
          "lemma": "condanna",
          "pos": "phr.",
          "en": "that is enough for a conviction",
          "components": [
            {
              "text": "condanna",
              "lemma": "condanna",
              "pos": "n.",
              "en": "conviction, sentence (f. sg.)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s082": {
      "text": "E con i notai c'è uno che sa leggere un libro di compagnia meglio di loro.»",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "pron.",
          "en": "them"
        }
      ]
    },
    "it-dante-01-l11-s084": {
      "text": "Pensò al giorno, quasi due anni prima, quando aveva trovato nel libro grande una partita sola, e Bindo gli aveva mostrato il libro segreto con un fiorino sopra il nome.",
      "items": [
        {
          "text": "gli",
          "lemma": "gli",
          "pos": "pron.",
          "en": "to him (indirect object)"
        }
      ]
    },
    "it-dante-01-l11-s092": {
      "text": "Ora il nostro lo leggono loro.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (our book)"
        }
      ]
    },
    "it-dante-01-l11-s093": {
      "text": "«Un dono è contro la legge?»",
      "items": [
        {
          "text": "legge",
          "lemma": "legge",
          "pos": "n.",
          "en": "law"
        }
      ]
    },
    "it-dante-01-l11-s094": {
      "text": "«Un dono a un priore è contro la legge da sempre.",
      "items": [
        {
          "text": "legge",
          "lemma": "legge",
          "pos": "n.",
          "en": "law"
        }
      ]
    },
    "it-dante-01-l11-s097": {
      "text": "«Tutto.",
      "items": [
        {
          "text": "Tutto",
          "lemma": "tutto",
          "pos": "phr.",
          "en": "In full (the whole name)"
        }
      ]
    },
    "it-dante-01-l11-s098": {
      "text": "L'ho scritto io, di mia mano.»",
      "items": [
        {
          "text": "L'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the name)"
        },
        {
          "text": "di mia mano",
          "lemma": "mano",
          "pos": "phr.",
          "en": "in my own hand"
        }
      ]
    },
    "it-dante-01-l11-s105": {
      "text": "Un prestito con l'interesse scritto non è un dono: questo lo sa ogni mercante.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (repeating questo)"
        }
      ]
    },
    "it-dante-01-l11-s106": {
      "text": "«E il podestà lo sa?»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l11-s109": {
      "text": "Bindo si alzò, piano, per la ferita: da novembre si alzava così.",
      "items": [
        {
          "text": "piano",
          "lemma": "piano",
          "pos": "adv.",
          "en": "slowly"
        }
      ]
    },
    "it-dante-01-l11-s110": {
      "text": "Chiuse il libro piccolo e lo tenne un poco fra le mani.",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the book)"
        }
      ]
    },
    "it-dante-01-l11-s112": {
      "text": "A Bologna c'è il denaro della compagnia: ce l'abbiamo mandato noi, tu e io, lettera dopo lettera.",
      "items": [
        {
          "text": "ce",
          "lemma": "ci",
          "pos": "pron.",
          "en": "there (ci, before lo: ce l'abbiamo mandato, we sent it there)"
        },
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (the money)"
        }
      ]
    },
    "it-dante-01-l11-s114": {
      "text": "A Bologna c'è sempre lavoro per uno che sa tenere un libro.»",
      "items": [
        {
          "text": "tenere un libro",
          "lemma": "tenere",
          "pos": "phr.",
          "en": "keep a set of account books"
        }
      ]
    },
    "it-dante-01-l11-s119": {
      "text": "Se parto io, chi resta con loro?»",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "pron.",
          "en": "them"
        }
      ]
    },
    "it-dante-01-l11-s122": {
      "text": "«Sta bene.",
      "items": [
        {
          "text": "Sta bene",
          "lemma": "stare bene",
          "pos": "phr.",
          "en": "All right."
        }
      ]
    },
    "it-dante-01-l11-s123": {
      "text": "Quando avranno letto tutto, vorranno sapere chi l'ha scritto.",
      "items": [
        {
          "text": "l'",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l11-s131": {
      "text": "Da quando la bottega era chiusa, la mattina Lapo non aveva dove andare.",
      "items": [
        {
          "text": "Da quando",
          "lemma": "da quando",
          "pos": "phr.",
          "en": "Ever since"
        }
      ]
    },
    "it-dante-01-l11-s133": {
      "text": "La piazza era piena di cittadini, e nessuno parlava forte.",
      "items": [
        {
          "text": "La piazza",
          "lemma": "piazza",
          "pos": "n.",
          "en": "the square (before the podestà's palace)"
        },
        {
          "text": "forte",
          "lemma": "forte",
          "pos": "adv.",
          "en": "loudly"
        }
      ]
    },
    "it-dante-01-l11-s135": {
      "text": "Il banditore lesse prima le sentenze come le avevano scritte i notai del podestà, e Lapo ne capì poche parole.",
      "items": [
        {
          "lemma": "le",
          "pos": "art.",
          "en": "the (feminine plural)",
          "text": "le"
        },
        {
          "text": "le",
          "lemma": "le",
          "pos": "pron.",
          "en": "them (the sentences)"
        }
      ]
    },
    "it-dante-01-l11-s136": {
      "text": "Poi le lesse di nuovo, con parole che tutti potevano capire.",
      "items": [
        {
          "text": "le",
          "lemma": "le",
          "pos": "pron.",
          "en": "them (the sentences)"
        }
      ]
    },
    "it-dante-01-l11-s138": {
      "text": "Questi sono i condannati per baratteria, e per denari presi contro la legge negli uffici del Comune; e perché furono contro il papa, e non vollero che messer Carlo venisse in Firenze, e furono contro la pace della città.»",
      "items": [
        {
          "text": "legge",
          "lemma": "legge",
          "pos": "n.",
          "en": "law"
        }
      ]
    },
    "it-dante-01-l11-s145": {
      "text": "«Allora ci resti», rispose un altro, e qualcuno rise.",
      "items": [
        {
          "text": "ci resti",
          "lemma": "restare",
          "pos": "phr.",
          "en": "let him stay there",
          "components": [
            {
              "text": "ci",
              "lemma": "ci",
              "pos": "pron.",
              "en": "there"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s146": {
      "text": "«E sieno condannati a pagare ciascuno cinquemila lire di fiorini piccoli, entro tre dì; e chi non pagherà perda tutto quello che ha.",
      "items": [
        {
          "text": "lire di fiorini piccoli",
          "lemma": "lira",
          "pos": "phr.",
          "en": "lire reckoned in the small silver coin (not gold florins)"
        },
        {
          "text": "entro tre dì",
          "lemma": "entro",
          "pos": "phr.",
          "en": "within three days",
          "components": [
            {
              "text": "entro",
              "lemma": "entro",
              "pos": "prep.",
              "en": "within"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s148": {
      "text": "E questo lo sappiano tutti i cittadini di Firenze.»",
      "items": [
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (repeating questo)"
        }
      ]
    },
    "it-dante-01-l11-s150": {
      "text": "Chi le ha, cinquemila lire?»",
      "items": [
        {
          "text": "le",
          "lemma": "le",
          "pos": "pron.",
          "en": "them (the lire)"
        }
      ]
    },
    "it-dante-01-l11-s155": {
      "text": "Erano uomini che Lapo aveva veduto in bottega o in piazza, uomini de' Bianchi; nessuno di loro era sulla piazza ad ascoltare.",
      "items": [
        {
          "text": "loro",
          "lemma": "loro",
          "pos": "pron.",
          "en": "them"
        }
      ]
    },
    "it-dante-01-l11-s157": {
      "text": "Lapo sentì quel nome come se fosse il suo.",
      "items": [
        {
          "text": "come se fosse il suo",
          "lemma": "come se",
          "pos": "phr.",
          "en": "as if it were his own"
        }
      ]
    },
    "it-dante-01-l11-s158": {
      "text": "La condanna era la stessa: la multa, i due anni lontano dalla Toscana, gli uffici del Comune chiusi per sempre.",
      "items": [
        {
          "text": "La condanna",
          "lemma": "condanna",
          "pos": "n.",
          "en": "the sentence, the conviction",
          "components": [
            {
              "text": "condanna",
              "lemma": "condanna",
              "pos": "n.",
              "en": "sentence, conviction (f. sg.)"
            }
          ]
        }
      ]
    },
    "it-dante-01-l11-s159": {
      "text": "Appena il banditore ebbe taciuto, la gente cominciò ad andarsene.",
      "items": [
        {
          "text": "ebbe taciuto",
          "lemma": "tacere",
          "pos": "v.",
          "en": "had fallen silent"
        }
      ]
    },
    "it-dante-01-l11-s162": {
      "text": "«Tano è fuggito ai primi di gennaio, di notte.",
      "items": [
        {
          "text": "ai primi di gennaio",
          "lemma": "primo",
          "pos": "phr.",
          "en": "in the first days of January"
        }
      ]
    },
    "it-dante-01-l11-s163": {
      "text": "Lo sapevi?»",
      "items": [
        {
          "text": "Lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it"
        }
      ]
    },
    "it-dante-01-l11-s167": {
      "text": "Il podestà l'ha trovata là dentro.»",
      "items": [
        {
          "text": "l'",
          "lemma": "la",
          "pos": "pron.",
          "en": "it (the guilt)"
        }
      ]
    },
    "it-dante-01-l11-s170": {
      "text": "Chi vuoi che sia?»",
      "items": [
        {
          "text": "Chi vuoi che sia?",
          "lemma": "volere",
          "pos": "phr.",
          "en": "Who else would it be?"
        }
      ]
    },
    "it-dante-01-l11-s171": {
      "text": "Risero tutti e due, e se ne andarono.",
      "items": [
        {
          "text": "se",
          "lemma": "si",
          "pos": "pron.",
          "en": "(se ne andarono: andarsene, they went away)"
        }
      ]
    },
    "it-dante-01-l11-s178": {
      "text": "Cione gli domandò che cosa aveva detto il banditore.",
      "items": [
        {
          "text": "gli",
          "lemma": "gli",
          "pos": "pron.",
          "en": "him (indirect object: asked him)"
        }
      ]
    },
    "it-dante-01-l11-s179": {
      "text": "Lapo raccontò che il banditore aveva letto le sentenze, che i condannati dovevano pagare una multa di cinquemila lire entro tre dì e che sarebbero stati fuori della Toscana due anni.",
      "items": [
        {
          "text": "entro",
          "lemma": "entro",
          "pos": "prep.",
          "en": "within"
        }
      ]
    },
    "it-dante-01-l11-s180": {
      "text": "Disse che fra i nomi c'era quello di Tano Baldovini, e che la condanna era la stessa.",
      "items": [
        {
          "text": "condanna",
          "lemma": "condanna",
          "pos": "n.",
          "en": "sentence, conviction"
        }
      ]
    },
    "it-dante-01-l11-s184": {
      "text": "Lapo restò alla tavola con la lanterna, come le sere in cui faceva i conti di Bindo.",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "n.",
          "en": "accounts (m. pl.)"
        }
      ]
    },
    "it-dante-01-l11-s185": {
      "text": "Ma ora non aveva conti da fare.",
      "items": [
        {
          "text": "conti",
          "lemma": "conto",
          "pos": "n.",
          "en": "accounts, sums (m. pl.)"
        }
      ]
    },
    "it-dante-01-l11-s187": {
      "text": "Se lo ricordava parola per parola, in lettere e non in cifre, come Bindo voleva.",
      "items": [
        {
          "text": "Se",
          "lemma": "si",
          "pos": "pron.",
          "en": "himself (se before lo: ricordarselo, remember it)"
        },
        {
          "text": "lo",
          "lemma": "lo",
          "pos": "pron.",
          "en": "it (what he had written)"
        }
      ]
    },
    "it-dante-01-l11-s188": {
      "text": "«Tano Baldovini, camarlingo del Comune, deve dare cento fiorini d'oro, prestati a lui il dì sopra scritto per la dote della figlia; e dieci fiorini d'interesse.»",
      "items": [
        {
          "text": "il dì sopra scritto",
          "lemma": "dì",
          "pos": "phr.",
          "en": "on the day written above"
        }
      ]
    }
  }
}
