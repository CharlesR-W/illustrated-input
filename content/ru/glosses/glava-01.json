            }
          ]
        }
      ]
    },
    "ru-mir-01-l01-s016": {
      "text": "Э́то Москва́, большо́й го́род.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "form": "nom. sg. m.",
          "en": "big"
        }
      ]
    },
    "ru-mir-01-l01-s022": {
      "text": "Петербу́рг то́же большо́й го́род.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "form": "nom. sg. m.",
          "en": "big"
        }
      ]
    },
    "ru-mir-01-l01-s030": {
      "text": "Вот уе́здный го́род.",
      "items": [
        {
          "text": "уе́здный го́род",
          "lemma": "уе́здный го́род",
          "pos": "phr.",
          "en": "district seat"
        }
      ]
    },
    "ru-mir-01-l01-s030a": {
      "text": "Где уе́здный го́род? В уе́зде.",
      "items": [
        {
          "text": "уе́здный го́род",
          "lemma": "уе́здный го́род",
          "pos": "phr.",
          "en": "district seat"
        }
      ]
    },
    "ru-mir-01-l01-s031": {
      "text": "Уе́здный го́род — не Москва́ и не Ряза́нь.",
      "items": [
        {
          "text": "Уе́здный го́род",
          "lemma": "уе́здный го́род",
          "pos": "phr.",
          "en": "district seat"
        }
      ]
    },
    "ru-mir-01-l01-s033": {
      "text": "А э́то желе́зная доро́га: Москва́, Ряза́нь, уе́здный го́род.",
      "items": [
        {
          "text": "желе́зная доро́га",
          "lemma": "желе́зная доро́га",
          "pos": "phr.",
          "en": "railway"
        },
        {
          "text": "уе́здный го́род",
          "lemma": "уе́здный го́род",
          "pos": "phr.",
          "en": "district seat"
        }
      ]
    },
    "ru-mir-01-l01-s035": {
      "text": "Доро́га ста́рая, а желе́зная доро́га — но́вая.",
      "items": [
        {
          "text": "желе́зная доро́га",
          "lemma": "желе́зная доро́га",
          "pos": "phr.",
          "en": "railway"
        }
      ]
    },
    "ru-mir-01-l01-s032": {
      "text": "Уе́здный го́род ма́ленький, но там желе́зная доро́га.",
      "items": [
        {
          "text": "Уе́здный го́род",
          "lemma": "уе́здный го́род",
          "pos": "phr.",
          "en": "district seat"
        },
        {
          "text": "желе́зная доро́га",
          "lemma": "желе́зная доро́га",
          "pos": "phr.",
          "en": "railway"
        }
      ]
    },
    "ru-mir-01-l01-s051": {
      "text": "По́ле большо́е, и лес то́же большо́й.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "form": "nom. sg. m.",
          "en": "big"
        }
      ]
    },
    "ru-mir-01-l01-s060": {
      "text": "— Здра́вствуйте! Меня́ зову́т Ива́н.",
      "items": [
        {
          "text": "Меня́ зову́т",
          "lemma": "меня́ зову́т",
          "pos": "phr.",
          "en": "my name is"
        }
      ]
    },
    "ru-mir-01-l01-s058": {
      "text": "Ива́н — ру́сский, и Берёзовка — ру́сская дере́вня.",
      "items": [
        {
          "text": "ру́сский",
          "lemma": "ру́сский",
          "pos": "n.",
          "en": "a Russian",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l01-s059": {
      "text": "Где Ива́н? В Москве́? Нет. В по́ле? Нет. Ива́н здесь, в Берёзовке.",
      "items": [
        {
          "text": "по́ле",
          "lemma": "по́ле",
          "pos": "n.",
          "en": "field",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l01-s061": {
      "text": "— Мне девятна́дцать лет.",
      "items": [
        {
          "text": "Мне девятна́дцать лет",
          "lemma": "мне … лет",
          "pos": "phr.",
          "en": "I am nineteen"
        }
      ]
    },
    "ru-mir-01-l01-s065": {
      "text": "Москва́ — большо́й го́род, а Берёзовка — ма́ленькая дере́вня, но Берёзовка — здесь.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "form": "nom. sg. m.",
          "en": "big"
        }
      ]
    },
    "ru-mir-01-l01-s066": {
      "text": "Меня́ зову́т Ива́н. А как вас зову́т?",
      "items": [
