          "pos": "n.",
          "form": "nom. pl.",
          "en": "letters"
        }
      ]
    },
    "ru-mir-01-l02-s073": {
      "text": "— Вот твоя́ ста́рая доска́, На́стя. Ива́н, почини́ до́ску.",
      "items": [
        {
          "text": "почини́",
          "lemma": "почини́ть",
          "pos": "v.",
          "en": "mend the slate (receptive command)",
          "form": "imperative sg."
        }
      ]
    },
    "ru-mir-01-l02-s075": {
      "text": "— Ты, сын. Ты большо́й. Но́вая доска́ до́рого сто́ит.",
      "items": [
        {
          "text": "до́рого сто́ит",
          "lemma": "до́рого сто́ить",
          "pos": "phr.",
          "en": "costs too much",
          "form": "receptive expression"
        }
      ]
    },
    "ru-mir-01-l02-s010": {
      "text": "Она́ смо́трит: что на столе́?",
      "items": [
        {
          "text": "смо́трит",
          "lemma": "смотре́ть",
          "pos": "v.",
          "en": "looks toward the table",
          "form": "present 3sg."
