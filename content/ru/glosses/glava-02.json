      ]
    },
    "ru-mir-01-l02-s026": {
      "text": "— Мне двена́дцать лет! — говори́т дочь.",
      "items": [
        {
          "text": "Мне двена́дцать лет",
          "lemma": "мне … лет",
          "pos": "phr.",
          "en": "I am twelve"
