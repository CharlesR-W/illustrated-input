    },
    "ru-mir-01-l05-s067": {
      "text": "Ива́н кра́сный, о́чень кра́сный.",
      "items": [
        {
          "text": "кра́сный",
          "lemma": "кра́сный",
          "pos": "adj.",
          "en": "red with embarrassment",
          "form": "nom. sg. m."
