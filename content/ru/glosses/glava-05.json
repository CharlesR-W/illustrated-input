        {
          "text": "доске́",
          "lemma": "доска́",
          "pos": "n.",
          "en": "board",
          "form": "prep. sg."
        },
        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "form": "nom. pl.",
          "en": "letters"
        }
      ]
    },
    "ru-mir-01-l05-s054b": {
      "text": "«Росси́я» — э́то сло́во, а в сло́ве — бу́квы.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "form": "nom. pl.",
          "en": "letters"
        }
      ]
    },
    "ru-mir-01-l05-s058": {
      "text": "— Сейча́с? Как? Сло́во большо́е…",
      "items": [
        {
          "text": "большо́е",
          "lemma": "большо́й",
          "pos": "adj.",
          "en": "long",
          "form": "nom. sg. n."
        }
      ]
    },
    "ru-mir-01-l05-s061": {
      "text": "Он ви́дит ру́сские бу́квы: одна́ бу́ква, две бу́квы, три…",
      "items": [
        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "en": "letters",
          "form": "acc. pl."
