          "form": "gen. sg.",
          "en": "letter"
        }
      ]
    },
    "ru-mir-01-l05-s062": {
      "text": "Три бу́квы он зна́ет. Бу́квы он ви́дит, а сло́во — нет.",
      "items": [
        {
          "text": "Три",
          "lemma": "три",
          "pos": "num.",
          "en": "three",
          "form": "acc."
        },
        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "form": "gen. sg.",
          "en": "letter"
