        {
          "text": "кра́сный",
          "lemma": "кра́сный",
          "pos": "adj.",
          "en": "red with embarrassment",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l05-s068": {
      "text": "Де́ти смо́трят: тако́й большо́й!",
      "items": [
        {
          "text": "тако́й",
          "lemma": "тако́й",
          "pos": "det.",
          "en": "so",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l05-s068a": {
      "text": "— Тако́й большо́й, а чита́ть не уме́ет!",
      "items": [
        {
          "text": "Тако́й",
          "lemma": "тако́й",
          "pos": "det.",
          "en": "so",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l05-s070": {
      "text": "— Я? Мне девятна́дцать лет. Я ведь рабо́таю.",
