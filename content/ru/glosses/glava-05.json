          "text": "уже́ не",
          "lemma": "уже́ не",
          "pos": "phr.",
          "en": "no longer"
        }
      ]
    },
    "ru-mir-01-l05-s083": {
      "text": "— Ва́ня, что ты де́лаешь? — спра́шивает мать.",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "pron.",
          "en": "what",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l05-s088": {
      "text": "— Ва́ня, я зна́ю все бу́квы! — говори́т На́стя.",
      "items": [
        {
          "text": "все",
          "lemma": "весь",
          "pos": "det.",
          "en": "all",
          "form": "acc. pl."
        }
      ]
    },
    "ru-mir-01-l05-s089": {
      "text": "— Учи́ться? Почему́ шко́ла? — спра́шивает оте́ц. — А кто рабо́тает в по́ле?",
      "items": [
        {
          "text": "по́ле",
          "lemma": "по́ле",
          "pos": "n.",
          "en": "field",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l05-s094a": {
      "text": "Тако́й большо́й!",
