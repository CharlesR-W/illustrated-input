{
  "schema_version": 1,
  "lesson_id": "ru-mir-01-l05",
  "segments": {
    "ru-mir-01-l05-s001": {
      "text": "Весна́ — э́то рабо́та в по́ле. А сейча́с де́ти иду́т в шко́лу.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "по́ле",
          "lemma": "по́ле",
          "pos": "n.",
          "en": "field",
          "form": "prep. sg."
        },
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "into; to"
        }
      ]
    },
    "ru-mir-01-l05-s006": {
      "text": "— Така́я молода́я! — говори́т На́стя.",
      "items": [
        {
          "text": "Така́я",
          "lemma": "тако́й",
          "pos": "det.",
          "en": "so",
          "form": "nom. sg. f."
        }
      ]
    },
    "ru-mir-01-l05-s008": {
      "text": "— Учи́тель — э́то он, а она́ — учи́тельница! — говори́т Ми́ша.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s009": {
      "text": "— Здра́вствуйте, де́ти! Меня́ зову́т Ве́ра Никола́евна.",
      "items": [
        {
          "text": "Меня́ зову́т",
          "lemma": "меня́ зову́т",
          "pos": "phr.",
          "en": "my name is"
        }
      ]
    },
    "ru-mir-01-l05-s010": {
      "text": "А как тебя́ зову́т? — спра́шивает она́.",
      "items": [
        {
          "text": "как тебя́ зову́т",
          "lemma": "как тебя́ зову́т",
          "pos": "phr.",
          "en": "what is your name?"
        }
      ]
    },
    "ru-mir-01-l05-s014": {
      "text": "— Ми́ша — э́то и́мя, и Ли́за — э́то и́мя. Каки́е имена́!",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s014a": {
      "text": "А их мать? Как вас зову́т?",
      "items": [
        {
          "text": "Как вас зову́т",
          "lemma": "как вас зову́т",
          "pos": "phr.",
          "en": "what is your name? (polite)"
        }
      ]
    },
    "ru-mir-01-l05-s017": {
      "text": "— Меня́ зову́т На́стя.",
      "items": [
        {
          "text": "Меня́ зову́т",
          "lemma": "меня́ зову́т",
          "pos": "phr.",
          "en": "my name is"
        }
      ]
    },
    "ru-mir-01-l05-s018": {
      "text": "— На́стя — э́то Анаста́сия? Ты дочь Петра́ Матве́евича?",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s020": {
      "text": "— Анаста́сия — э́то и́мя. Петро́вна — э́то о́тчество: твой оте́ц — Пётр.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s024": {
      "text": "— Люблю́! О́чень люблю́! Шко́ла — э́то хорошо́!",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s029": {
      "text": "В шко́ле — стол, ка́рта и доска́.",
      "items": [
        {
          "text": "доска́",
          "lemma": "доска́",
          "pos": "n.",
          "en": "blackboard",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l05-s029a": {
      "text": "Доска́ На́сти ма́ленькая, а э́та доска́ больша́я.",
      "items": [
        {
          "text": "доска́",
          "lemma": "доска́",
          "pos": "n.",
          "en": "blackboard",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l05-s031": {
      "text": "А вот и Ива́н.",
      "items": [
        {
          "text": "А вот и",
          "lemma": "а вот и",
          "pos": "phr.",
          "en": "and here comes"
        }
      ]
    },
    "ru-mir-01-l05-s040": {
      "text": "— А вы? Как вас зову́т?",
      "items": [
        {
          "text": "Как вас зову́т",
          "lemma": "как вас зову́т",
          "pos": "phr.",
          "en": "what is your name? (polite)"
        }
      ]
    },
    "ru-mir-01-l05-s041": {
      "text": "— Меня́? Ва́ня… Ива́н. Ива́н — э́то моё и́мя.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l05-s042": {
      "text": "— Ива́н, а как ва́ше о́тчество?",
      "items": [
        {
          "text": "как ва́ше о́тчество",
          "lemma": "как ва́ше о́тчество",
          "pos": "phr.",
          "en": "what is your patronymic?"
        }
      ]
    },
    "ru-mir-01-l05-s054a": {
