        {
          "text": "по́ле",
          "lemma": "по́ле",
          "pos": "n.",
          "en": "field",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l06-s007": {
      "text": "Сего́дня ве́чером в шко́ле уро́к.",
