          "text": "Кого́",
          "lemma": "кто",
          "pos": "pron.",
          "en": "whom",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s023": {
      "text": "Она́ берёт бра́та за́ руку: рука́ На́сти ма́ленькая, а рука́ Ива́на больша́я.",
      "items": [
        {
          "text": "за́ руку",
          "lemma": "за́ руку",
          "pos": "phr.",
          "en": "by the hand"
        }
      ]
    },
    "ru-mir-01-l06-s138": {
      "text": "И они́ иду́т в шко́лу.",
      "items": [
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "into; to"
        }
      ]
    },
    "ru-mir-01-l06-s024": {
      "text": "В шко́ле большо́й стол.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "en": "big",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l06-s025": {
      "text": "На столе́ — ла́мпа и мел.",
      "items": [
        {
          "text": "мел",
          "lemma": "мел",
          "pos": "n.",
          "en": "chalk",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l06-s027": {
      "text": "У них тетра́ди.",
