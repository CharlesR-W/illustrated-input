          "lemma": "сло́во",
          "pos": "n.",
          "en": "word",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s059": {
      "text": "— Тепе́рь пи́шем! — говори́т Ве́ра Никола́евна.",
      "items": [
        {
          "text": "пи́шем",
          "lemma": "писа́ть",
          "pos": "v.",
          "en": "let’s write",
