        {
          "text": "ещё не",
          "lemma": "ещё не",
          "pos": "phr.",
          "en": "not yet"
        }
      ]
    },
    "ru-mir-01-l06-s031": {
      "text": "Она́ ви́дит Ива́на и На́стю, свою́ учени́цу.",
      "items": [
        {
          "text": "Ива́на",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s140": {
      "text": "Ученики́ ви́дят Ива́на и гро́мко смею́тся: «Ха-ха-ха!»",
      "items": [
        {
          "text": "Ива́на",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s040": {
      "text": "— Сего́дня у нас на уро́ке но́вый учени́к.",
      "items": [
        {
          "text": "у нас",
          "lemma": "у нас",
          "pos": "phr.",
          "en": "we have"
        }
      ]
    },
    "ru-mir-01-l06-s044": {
      "text": "— Зна́ю… три бу́квы, — отвеча́ет Ива́н.",
