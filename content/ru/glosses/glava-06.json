          "lemma": "уро́к",
          "pos": "n.",
          "en": "lesson",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l06-s009": {
      "text": "Ива́н ви́дит ла́мпу, ви́дит окно́, ви́дит Его́ра.",
      "items": [
        {
          "text": "окно́",
