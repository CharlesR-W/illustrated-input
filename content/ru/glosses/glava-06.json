        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "form": "gen. sg.",
          "en": "letter"
        }
      ]
    },
    "ru-mir-01-l06-s070": {
      "text": "— Непра́вильно. Ещё раз!",
