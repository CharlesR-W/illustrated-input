        {
          "text": "три",
          "lemma": "три",
          "pos": "num.",
          "en": "three",
          "form": "acc."
        },
        {
          "text": "бу́квы",
          "lemma": "бу́ква",
          "pos": "n.",
          "form": "gen. sg.",
          "en": "letter"
        }
      ]
    },
    "ru-mir-01-l06-s045": {
      "text": "— Хорошо́. Что вы ви́дите здесь?",
      "items": [
        {
          "text": "Что",
          "lemma": "что",
          "pos": "pron.",
          "en": "what",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s047": {
      "text": "— Ла́мпу. Стол. До́ску. Мел.",
      "items": [
        {
          "text": "Стол",
          "lemma": "стол",
          "pos": "n.",
          "en": "table",
          "form": "acc. sg."
        },
        {
          "text": "До́ску",
          "lemma": "доска́",
          "pos": "n.",
          "en": "blackboard",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s048": {
      "text": "— Пра́вильно. А кого́ вы ви́дите?",
      "items": [
        {
          "text": "кого́",
          "lemma": "кто",
          "pos": "pron.",
          "en": "whom",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s050": {
      "text": "— Вас.",
      "items": [
