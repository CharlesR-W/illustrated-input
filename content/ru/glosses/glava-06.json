    },
    "ru-mir-01-l06-s071": {
      "text": "Ива́н пи́шет ещё раз.",
      "items": [
        {
          "text": "ещё",
          "lemma": "ещё",
          "pos": "adv.",
          "en": "one more",
          "note": "Ещё раз = once more."
        },
        {
          "text": "раз",
          "lemma": "раз",
          "pos": "n.",
          "en": "time (occasion)",
          "form": "acc. sg.",
          "note": "ещё раз = once more."
