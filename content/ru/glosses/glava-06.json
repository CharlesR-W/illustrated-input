        {
          "text": "его́",
          "lemma": "он",
          "pos": "pron.",
          "en": "him",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s011": {
      "text": "Ива́н не идёт в шко́лу.",
