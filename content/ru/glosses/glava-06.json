          "text": "ещё",
          "lemma": "ещё",
          "pos": "adv.",
          "en": "one more",
          "note": "Ещё раз = once more."
        },
        {
          "text": "раз",
          "lemma": "раз",
          "pos": "n.",
          "en": "time (occasion)",
          "form": "acc. sg.",
          "note": "ещё раз = once more."
