        {
          "text": "Ива́н",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "nom. sg."
        },
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "into; to"
        }
      ]
    },
    "ru-mir-01-l06-s012": {
      "text": "Ве́ру Никола́евну он не ви́дит, но слы́шит её: «Э́то Росси́я… Э́то Москва́, большо́й го́род…»",
      "items": [
        {
          "text": "её",
          "lemma": "она́",
          "pos": "pron.",
          "en": "her",
          "form": "acc. sg."
        },
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "en": "big",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l06-s017": {
      "text": "Она́ ви́дит Ива́на.",
      "items": [
        {
          "text": "Ива́на",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l06-s020": {
      "text": "— Кого́ ты ждёшь? Его́ра?",
