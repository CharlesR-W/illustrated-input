          "text": "них",
          "lemma": "они́",
          "pos": "pron.",
          "en": "them",
          "form": "prep. pl."
        }
      ]
    },
    "ru-mir-01-l07-s067": {
      "text": "Сло́во, Пётр, — то́же де́ло.",
      "items": [
        {
          "text": "де́ло",
          "lemma": "де́ло",
          "pos": "n.",
          "en": "an action",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s069": {
      "text": "Вот и Сила́нтий.",
      "items": [
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "(emphasis)",
          "note": "Вот и: here comes."
        }
      ]
    },
    "ru-mir-01-l07-s070": {
      "text": "У него́ газе́та ба́тюшки.",
      "items": [
        {
          "text": "У него́",
          "lemma": "у него́",
          "pos": "phr.",
          "en": "he has"
        }
      ]
    },
    "ru-mir-01-l07-s072": {
      "text": "А у нас тут но́вость!",
      "items": [
        {
          "text": "у нас",
          "lemma": "у нас",
          "pos": "phr.",
          "en": "we have"
        }
      ]
    },
    "ru-mir-01-l07-s073": {
      "text": "Пётр Матве́евич, говоря́т, что ваш Фёдор хо́чет жить в Москве́.",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "conj.",
          "en": "that"
        }
      ]
    },
    "ru-mir-01-l07-s075": {
      "text": "— А земля́? Мо́жет быть, он продаёт зе́млю? Наве́рное, мне! — смеётся Сила́нтий.",
      "items": [
        {
          "text": "Мо́жет быть",
          "lemma": "мо́жет быть",
          "pos": "phr.",
          "en": "perhaps"
        }
      ]
    },
    "ru-mir-01-l07-s076": {
      "text": "А у до́ма стои́т ба́ба и всё слы́шит.",
      "items": [
        {
          "text": "всё",
          "lemma": "весь",
          "pos": "pron.",
          "en": "everything",
          "form": "acc. sg. n."
        }
      ]
    },
    "ru-mir-01-l07-s078": {
      "text": "— Слух, Сила́нтий Кузьми́ч, — ещё не пра́вда.",
      "items": [
        {
          "text": "ещё",
          "lemma": "ещё",
          "pos": "part.",
          "en": "necessarily (with не)"
