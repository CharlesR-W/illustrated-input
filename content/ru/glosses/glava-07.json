      ]
    },
    "ru-mir-01-l07-s112": {
      "text": "Говоря́т, что я хочу́ жить в Москве́. Говоря́т, что я продаю́ зе́млю.",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "conj.",
          "en": "that"
