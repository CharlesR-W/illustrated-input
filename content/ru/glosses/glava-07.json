  "segments": {
    "ru-mir-01-l07-s002": {
      "text": "У́тром вся дере́вня в це́ркви, а сейча́с вся дере́вня говори́т.",
      "items": [
        {
          "text": "це́ркви",
          "lemma": "це́рковь",
          "pos": "n.",
          "en": "church",
          "form": "prep. sg."
