          "text": "кни́ги",
          "lemma": "кни́га",
          "pos": "n.",
          "en": "books",
          "form": "acc. pl."
        }
      ]
    },
    "ru-mir-01-l07-s065": {
      "text": "— А что в них, ба́тюшка?",
      "items": [
