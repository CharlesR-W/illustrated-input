        {
          "text": "говори́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talks",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l07-s003": {
      "text": "Вот коло́дец: в нём вода́, как в реке́.",
      "items": [
        {
          "text": "как",
          "lemma": "как",
          "pos": "conj.",
          "en": "as"
        }
      ]
    },
    "ru-mir-01-l07-s004": {
      "text": "У коло́дца стоя́т ба́бы: Да́рья, жена́ Фёдора, и ещё две ба́бы.",
      "items": [
        {
          "text": "ба́бы",
          "lemma": "ба́ба",
          "pos": "n.",
          "en": "peasant women",
          "form": "nom. pl."
        },
        {
          "text": "ещё",
          "lemma": "ещё",
          "pos": "adv.",
          "en": "another"
        },
        {
          "text": "ба́бы",
          "lemma": "ба́ба",
          "pos": "n.",
          "en": "women",
          "form": "gen. sg."
        }
      ]
    },
    "ru-mir-01-l07-s005": {
      "text": "У Да́рьи ведро́, а в ведре́ вода́.",
      "items": [
        {
          "text": "У Да́рьи",
          "lemma": "у Да́рьи",
          "pos": "phr.",
          "en": "Darya has"
        }
      ]
    },
    "ru-mir-01-l07-s007": {
      "text": "И Ми́ша здесь, сын Фёдора: он ещё ма́льчик.",
      "items": [
        {
          "text": "И",
          "lemma": "и",
          "pos": "part.",
          "en": "also"
        }
      ]
    },
    "ru-mir-01-l07-s008": {
      "text": "Ба́бы говоря́т об учи́тельнице.",
      "items": [
        {
          "text": "говоря́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talk",
          "form": "pres. 3pl"
        }
      ]
    },
    "ru-mir-01-l07-s009": {
      "text": "Она́ живёт в шко́ле, и ве́чером там уро́к.",
      "items": [
        {
          "text": "уро́к",
          "lemma": "уро́к",
          "pos": "n.",
          "en": "lesson",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s011": {
      "text": "— Пра́вда, она́ и но́чью чита́ет, — говори́т друга́я.",
      "items": [
        {
          "text": "Пра́вда",
          "lemma": "пра́вда",
          "pos": "part.",
          "en": "true"
        },
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "even"
        }
      ]
    },
    "ru-mir-01-l07-s014": {
      "text": "Кни́ги на столе́, на окне́, в углу́…",
      "items": [
        {
          "text": "окне́",
          "lemma": "окно́",
          "pos": "n.",
          "en": "windowsill",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l07-s015": {
      "text": "Она́ из Ряза́ни, а Ряза́нь — большо́й го́род.",
      "items": [
        {
          "text": "большо́й",
          "lemma": "большо́й",
          "pos": "adj.",
          "en": "big",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l07-s016": {
      "text": "Но говоря́т, что она́ всё зна́ет и про Москву́.",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "conj.",
          "en": "that"
        },
        {
          "text": "всё",
          "lemma": "весь",
          "pos": "pron.",
          "en": "everything",
          "form": "acc. sg. n."
        },
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "also"
        }
      ]
    },
    "ru-mir-01-l07-s017": {
      "text": "— В Москве́ университе́т, и там у́чится Никола́й, сын поме́щика Орло́ва.",
      "items": [
        {
          "text": "у́чится",
          "lemma": "учи́ться",
          "pos": "v.",
          "en": "studies",
          "form": "pres. 3sg"
        },
        {
          "text": "Никола́й",
          "lemma": "Никола́й",
          "pos": "prop. n.",
          "en": "Nikolay (landowner’s son)",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s018": {
      "text": "Он студе́нт. Мо́жет быть, она́ его́ зна́ет!",
      "items": [
        {
          "text": "Мо́жет быть",
          "lemma": "мо́жет быть",
          "pos": "phr.",
          "en": "perhaps"
        },
        {
          "text": "его́",
          "lemma": "он",
          "pos": "pron.",
          "en": "him",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l07-s022": {
      "text": "— Всё о ней и о ней! — говори́т Да́рья.",
      "items": [
        {
          "text": "Всё",
          "lemma": "всё",
          "pos": "adv.",
          "en": "continually"
        }
      ]
    },
    "ru-mir-01-l07-s023": {
      "text": "— А у нас но́вость.",
      "items": [
        {
          "text": "у нас",
          "lemma": "у нас",
          "pos": "phr.",
          "en": "we have"
        }
      ]
    },
    "ru-mir-01-l07-s025": {
      "text": "— О́труб? Что э́то?",
      "items": [
        {
          "text": "О́труб",
          "lemma": "о́труб",
          "pos": "n.",
          "en": "consolidated private plot",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s026": {
      "text": "— Сейча́с на́ша земля́ и здесь, и там: три полосы́.",
      "items": [
        {
          "text": "и здесь, и там",
          "lemma": "и здесь, и там",
          "pos": "phr.",
          "en": "both here and there",
          "components": [
            {
              "text": "и",
              "lemma": "и",
              "pos": "conj.",
              "en": "both (with a second и)"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l07-s029": {
      "text": "Э́то и есть о́труб.",
      "items": [
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "exactly"
        },
        {
          "text": "есть",
          "lemma": "быть",
          "pos": "v.",
          "en": "is",
          "form": "pres."
        },
        {
          "text": "о́труб",
          "lemma": "о́труб",
          "pos": "n.",
          "en": "consolidated private plot",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s030": {
      "text": "— В одно́м ме́сте? Кака́я но́вость!",
      "items": [
        {
          "text": "Кака́я но́вость",
          "lemma": "кака́я но́вость",
          "pos": "phr.",
          "en": "what news!",
          "components": [
            {
              "text": "Кака́я",
              "lemma": "како́й",
              "pos": "det.",
              "en": "what a (exclamation)",
              "form": "nom. sg. f."
            }
          ]
        }
      ]
    },
    "ru-mir-01-l07-s031": {
      "text": "У Ми́ши копе́йка, и он идёт в ла́вку.",
      "items": [
        {
          "text": "У Ми́ши",
          "lemma": "у Ми́ши",
          "pos": "phr.",
          "en": "Misha has"
        },
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "to"
        }
      ]
    },
    "ru-mir-01-l07-s032": {
      "text": "Тепе́рь у ма́льчика и копе́йка, и но́вость!",
      "items": [
        {
          "text": "у ма́льчика",
          "lemma": "у ма́льчика",
          "pos": "phr.",
          "en": "the boy has"
        },
        {
          "text": "и копе́йка, и но́вость",
          "lemma": "и копе́йка, и но́вость",
          "pos": "phr.",
          "en": "both a kopeck and news",
          "components": [
            {
              "text": "и",
              "lemma": "и",
              "pos": "conj.",
              "en": "both (with a second и)"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l07-s033": {
      "text": "Ба́бы говоря́т у коло́дца, а мужики́ — в ла́вке.",
      "items": [
        {
          "text": "говоря́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talk",
          "form": "pres. 3pl"
        }
      ]
    },
    "ru-mir-01-l07-s036": {
      "text": "— Вот, в газе́те пи́шут о земле́, — говори́т Сила́нтий. — О зако́не.",
      "items": [
        {
          "text": "Вот",
          "lemma": "вот",
          "pos": "part.",
          "en": "look"
        }
      ]
    },
    "ru-mir-01-l07-s038": {
      "text": "— Зако́н говори́т: мо́жно рабо́тать на свое́й земле́, как поме́щик.",
      "items": [
        {
          "text": "как",
          "lemma": "как",
          "pos": "conj.",
          "en": "like"
        }
      ]
    },
    "ru-mir-01-l07-s043": {
      "text": "— Вот и но́вость! Фёдор — хозя́ин. А хозя́ин на свое́й земле́ живёт хорошо́.",
      "items": [
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "indeed",
          "note": "Вот и но́вость!: now that’s news!"
        }
      ]
    },
    "ru-mir-01-l07-s044": {
      "text": "— Тебе́ хорошо́, Сила́нтий Кузьми́ч: ты бога́тый.",
      "items": [
        {
          "text": "Тебе́ хорошо́",
          "lemma": "тебе́ хорошо́",
          "pos": "phr.",
          "en": "you have it good"
        }
      ]
    },
    "ru-mir-01-l07-s045": {
      "text": "— Бога́тый, потому́ что рабо́таю. А у вас то́лько по́лосы, и все бе́дные.",
      "items": [
        {
          "text": "потому́",
          "lemma": "потому́ что",
          "pos": "conj.",
          "en": "because"
        },
        {
          "text": "что",
          "lemma": "потому́ что",
          "pos": "conj.",
          "en": "because (with потому́)"
        },
        {
          "text": "вас",
          "lemma": "вы",
          "pos": "pron.",
          "en": "you (polite/pl.)",
          "form": "gen. pl.",
          "note": "У вас: you have."
        },
        {
          "text": "по́лосы",
          "lemma": "полоса́",
          "pos": "n.",
          "en": "strips of land",
          "form": "nom. pl."
        },
        {
          "text": "все",
          "lemma": "весь",
          "pos": "pron.",
          "en": "everyone",
          "form": "nom. pl."
        }
      ]
    },
    "ru-mir-01-l07-s046": {
      "text": "— Бе́дные, но на миру́, — отвеча́ет сосе́д.",
      "items": [
        {
          "text": "на",
          "lemma": "на",
          "pos": "prep.",
          "en": "among",
          "note": "На миру́: among one’s community."
        }
      ]
    },
    "ru-mir-01-l07-s047": {
      "text": "— А Фёдор не хо́чет жить, как мы.",
      "items": [
        {
          "text": "как",
          "lemma": "как",
          "pos": "conj.",
          "en": "like"
        }
      ]
    },
    "ru-mir-01-l07-s048": {
      "text": "В ла́вку идёт Его́р.",
      "items": [
        {
          "text": "В",
          "lemma": "в",
          "pos": "prep.",
          "en": "to"
        }
      ]
    },
    "ru-mir-01-l07-s053": {
      "text": "— В Москве́? Кака́я но́вость!",
      "items": [
        {
          "text": "Кака́я но́вость",
          "lemma": "кака́я но́вость",
          "pos": "phr.",
          "en": "what news!",
          "components": [
            {
              "text": "Кака́я",
              "lemma": "како́й",
              "pos": "det.",
              "en": "what a (exclamation)",
              "form": "nom. sg. f."
            }
          ]
        }
      ]
    },
    "ru-mir-01-l07-s055": {
      "text": "Но кто слу́шает ма́льчика?",
      "items": [
        {
          "text": "ма́льчика",
          "lemma": "ма́льчик",
          "pos": "n.",
          "en": "boy",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l07-s058": {
      "text": "У до́ма ба́тюшки сидя́т оте́ц Алексе́й и Пётр.",
      "items": [
        {
          "text": "оте́ц",
          "lemma": "оте́ц",
          "pos": "n.",
          "en": "Father (priest)",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l07-s059": {
      "text": "Разгово́р у них не о Фёдоре, а о ми́ре и о шко́ле.",
      "items": [
        {
          "text": "у",
          "lemma": "у",
          "pos": "prep.",
          "en": "between"
        }
      ]
    },
    "ru-mir-01-l07-s060": {
      "text": "— На миру́ и бе́дный не оди́н, ба́тюшка, — говори́т Пётр.",
      "items": [
        {
          "text": "На",
          "lemma": "на",
          "pos": "prep.",
          "en": "among",
          "note": "На миру́: among one’s community."
        },
        {
          "text": "миру́",
          "lemma": "мир",
          "pos": "n.",
          "en": "village commune",
          "form": "loc. sg."
        },
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "even"
        },
        {
          "text": "оди́н",
          "lemma": "оди́н",
          "pos": "adj.",
          "en": "alone",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l07-s061": {
      "text": "— Пра́вда. А Ве́ра Никола́евна рабо́тает хорошо́: и твой Ива́н уже́ чита́ет.",
      "items": [
        {
          "text": "Пра́вда",
          "lemma": "пра́вда",
          "pos": "part.",
          "en": "true"
        },
        {
          "text": "хорошо́",
          "lemma": "хорошо́",
          "pos": "adv.",
          "en": "well"
        },
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "even"
        }
      ]
    },
    "ru-mir-01-l07-s063": {
      "text": "Не все её кни́ги я люблю́.",
      "items": [
        {
          "text": "все",
          "lemma": "весь",
          "pos": "pron.",
          "en": "all",
          "form": "acc. pl."
        },
        {
          "text": "кни́ги",
          "lemma": "кни́га",
          "pos": "n.",
          "en": "books",
          "form": "acc. pl."
        }
      ]
    },
    "ru-mir-01-l07-s064": {
      "text": "Таки́е кни́ги чита́ют студе́нты в университе́те.",
      "items": [
