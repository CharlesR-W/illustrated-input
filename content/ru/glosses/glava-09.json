{
  "schema_version": 1,
  "lesson_id": "ru-mir-01-l09",
  "segments": {
    "ru-mir-01-l09-s004": {
      "text": "Но го́лос на схо́де есть то́лько у хозя́ина двора́: оте́ц говори́т, а сын слу́шает.",
      "items": [
        {
          "text": "есть то́лько у хозя́ина двора́",
          "lemma": "у … есть",
          "pos": "phr.",
          "en": "only the household head has"
        },
        {
          "text": "говори́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "speaks",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s005": {
      "text": "Пётр Соколо́в — хозя́ин двора́, и у него́ есть го́лос.",
      "items": [
        {
          "text": "хозя́ин",
          "lemma": "хозя́ин",
          "pos": "n.",
          "en": "household head",
          "form": "nom. sg."
        },
        {
          "text": "у него́ есть",
          "lemma": "у него́ есть",
          "pos": "phr.",
          "en": "he has"
        }
      ]
    },
    "ru-mir-01-l09-s006": {
      "text": "Фёдор — не хозя́ин: он сын и живёт с отцо́м.",
      "items": [
        {
          "text": "хозя́ин",
          "lemma": "хозя́ин",
          "pos": "n.",
          "en": "household head",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s007": {
      "text": "Но сего́дня у Фёдора в руке́ бума́га.",
      "items": [
        {
          "text": "у Фёдора",
          "lemma": "у Фёдора",
          "pos": "phr.",
          "en": "Fyodor has"
        }
      ]
    },
    "ru-mir-01-l09-s008": {
      "text": "А Ива́н? У Ива́на нет го́лоса.",
      "items": [
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "there is no"
        }
      ]
    },
    "ru-mir-01-l09-s009": {
      "text": "Он стои́т за отцо́м и ви́дит то́лько го́ловы.",
      "items": [
        {
          "text": "за",
          "lemma": "за",
          "pos": "prep.",
          "en": "behind"
        }
      ]
    },
    "ru-mir-01-l09-s011": {
      "text": "За столо́м сиди́т ста́роста Его́р.",
      "items": [
        {
          "text": "За",
          "lemma": "за",
          "pos": "prep.",
          "en": "behind"
        }
      ]
    },
    "ru-mir-01-l09-s012": {
      "text": "У него́ доска́ и мел, и он пи́шет ме́лом на доске́: «Вопро́с о земле́».",
      "items": [
        {
          "text": "У него́",
          "lemma": "у него́",
          "pos": "phr.",
          "en": "he has"
        },
        {
          "text": "доска́",
          "lemma": "доска́",
          "pos": "n.",
          "en": "board",
          "form": "nom. sg."
        },
        {
          "text": "мел",
          "lemma": "мел",
          "pos": "n.",
          "en": "chalk",
          "form": "nom. sg."
        },
        {
          "text": "доске́",
          "lemma": "доска́",
          "pos": "n.",
          "en": "board",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l09-s014": {
      "text": "Он стои́т ти́хо, и рука́ у него́ на са́бле.",
      "items": [
        {
          "text": "рука́ у него́",
          "lemma": "рука́ у него́",
          "pos": "phr.",
          "en": "his hand"
        }
      ]
    },
    "ru-mir-01-l09-s015": {
      "text": "А вот челове́к Орло́ва, прика́зчик: он рабо́тает прика́зчиком в уса́дьбе.",
      "items": [
        {
          "text": "челове́к Орло́ва",
          "lemma": "челове́к Орло́ва",
          "pos": "phr.",
          "en": "Orlov’s man"
        }
      ]
    },
    "ru-mir-01-l09-s016": {
      "text": "У него́ в руке́ бума́ги и каранда́ш.",
      "items": [
        {
          "text": "У него́",
          "lemma": "у него́",
          "pos": "phr.",
          "en": "he has"
        }
      ]
    },
    "ru-mir-01-l09-s019": {
      "text": "Его́р смо́трит на сход.",
      "items": [
        {
          "text": "сход",
          "lemma": "сход",
          "pos": "n.",
          "en": "village assembly",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s020": {
      "text": "— До́брое у́тро, мужики́! — говори́т он. — Весь мир здесь?",
      "items": [
        {
          "text": "До́брое у́тро",
          "lemma": "до́брое у́тро",
          "pos": "phr.",
          "en": "good morning"
        },
        {
          "text": "Весь",
          "lemma": "весь",
          "pos": "det.",
          "en": "whole",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l09-s021": {
      "text": "Вопро́с у нас оди́н, и мир его́ реша́ет.",
      "items": [
        {
          "text": "у нас",
          "lemma": "у нас",
          "pos": "phr.",
          "en": "we have"
        },
        {
          "text": "его́",
          "lemma": "он",
          "pos": "pron.",
          "en": "it",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s024": {
      "text": "— Мир! — говори́т он гро́мко. — У меня́ семья́: жена́ и два ребёнка.",
      "items": [
        {
          "text": "меня́",
          "lemma": "я",
          "pos": "pron.",
          "en": "me",
          "form": "gen. sg.",
          "note": "У меня́: I have."
        }
      ]
    },
    "ru-mir-01-l09-s025": {
      "text": "Я хочу́ жить свое́й семьёй, свои́м дворо́м.",
      "items": [
        {
          "text": "свое́й",
          "lemma": "свой",
          "pos": "det.",
          "en": "one's own",
          "form": "instr. sg. f.",
          "note": "Жить свое́й семьёй, свои́м дворо́м: live as a separate household."
        }
      ]
    },
    "ru-mir-01-l09-s026": {
      "text": "И мне нужна́ моя́ часть земли́.",
      "items": [
        {
          "text": "мне нужна́",
          "lemma": "мне нужна́",
          "pos": "phr.",
          "en": "I need"
        }
      ]
    },
    "ru-mir-01-l09-s027": {
      "text": "Земля́ у нас хоро́шая, а по́лосы плохи́е: одна́ у дере́вни, одна́ у реки́, одна́ у ле́са.",
      "items": [
        {
          "text": "Земля́ у нас",
          "lemma": "земля́ у нас",
          "pos": "phr.",
          "en": "our land"
        },
        {
          "text": "по́лосы",
          "lemma": "полоса́",
          "pos": "n.",
          "en": "strips of land",
          "form": "nom. pl."
        }
      ]
    },
    "ru-mir-01-l09-s028": {
      "text": "Мне ну́жен уча́сток — вся моя́ земля́ в одно́м ме́сте.",
      "items": [
        {
          "text": "Мне ну́жен",
          "lemma": "мне ну́жен",
          "pos": "phr.",
          "en": "I need"
        }
      ]
    },
    "ru-mir-01-l09-s029": {
      "text": "Я си́льный: я могу́ рабо́тать оди́н.",
      "items": [
        {
          "text": "оди́н",
          "lemma": "оди́н",
          "pos": "adj.",
          "en": "alone",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l09-s031": {
      "text": "Сила́нтий смо́трит на Фёдора: ему́ э́то нра́вится.",
      "items": [
        {
          "text": "Фёдора",
          "lemma": "Фёдор",
          "pos": "prop. n.",
          "en": "Fyodor (brother)",
          "form": "acc. sg."
        },
        {
          "text": "ему́ э́то нра́вится",
          "lemma": "нра́виться",
          "pos": "phr.",
          "en": "he likes this"
        }
      ]
    },
    "ru-mir-01-l09-s033": {
      "text": "— Пётр Матве́евич, ты хозя́ин двора́, — говори́т он. — Что ты ду́маешь?",
      "items": [
        {
          "text": "хозя́ин",
          "lemma": "хозя́ин",
          "pos": "n.",
          "en": "household head",
          "form": "nom. sg."
        },
        {
          "text": "Что",
          "lemma": "что",
          "pos": "pron.",
          "en": "what",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s034": {
      "text": "Пётр смо́трит на сы́на.",
      "items": [
        {
          "text": "сы́на",
          "lemma": "сын",
          "pos": "n.",
          "en": "son",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s036": {
      "text": "— Земля́ у нас о́бщая.",
      "items": [
        {
          "text": "Земля́ у нас",
          "lemma": "земля́ у нас",
          "pos": "phr.",
          "en": "our land"
        }
      ]
    },
    "ru-mir-01-l09-s037": {
      "text": "Вот бе́дная ба́ба: хозя́ина у неё нет, а де́ти есть.",
      "items": [
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "there is no"
        }
      ]
    },
    "ru-mir-01-l09-s039": {
      "text": "Мир до́брый: он даёт ей зе́млю и помога́ет паха́ть.",
      "items": [
        {
          "text": "даёт",
          "lemma": "дава́ть",
          "pos": "v.",
          "en": "gives",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s041": {
      "text": "С ми́ру по ни́тке — го́лому руба́шка.",
      "items": [
        {
          "text": "С",
          "lemma": "с",
          "pos": "prep.",
          "en": "from",
          "note": "С ми́ру по ни́тке — го́лому руба́шка: every little helps."
        },
        {
          "text": "ми́ру",
          "lemma": "мир",
          "pos": "n.",
          "en": "world, community",
          "form": "gen. sg. (partitive)"
        },
        {
          "text": "по",
          "lemma": "по",
          "pos": "prep.",
          "en": "from each (distributive)"
        }
      ]
    },
    "ru-mir-01-l09-s042": {
      "text": "— А зако́н? — говори́т Фёдор. — Зако́н — со мной!",
      "items": [
        {
          "text": "Зако́н — со мной",
          "lemma": "зако́н — со мной",
          "pos": "phr.",
          "en": "the law is on my side"
        }
      ]
    },
    "ru-mir-01-l09-s043": {
      "text": "Тут говори́т прика́зчик.",
      "items": [
        {
          "text": "Тут",
          "lemma": "тут",
          "pos": "adv.",
          "en": "then"
        }
      ]
    },
    "ru-mir-01-l09-s044": {
      "text": "— Зако́н, Фёдор Петро́вич, говори́т о хозя́ине.",
      "items": [
        {
          "text": "говори́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "speaks",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s045": {
      "text": "Пра́во на о́труб есть у хозя́ина двора́.",
      "items": [
        {
          "text": "на",
          "lemma": "на",
          "pos": "prep.",
          "en": "to"
        },
        {
          "text": "есть у хозя́ина двора́",
          "lemma": "у … есть",
          "pos": "phr.",
          "en": "belongs to the household head"
        }
      ]
    },
    "ru-mir-01-l09-s046": {
      "text": "А двор — э́то де́ло о́бщины.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        }
      ]
    },
    "ru-mir-01-l09-s047": {
      "text": "— Пра́во у хозя́ина, — говори́т Пётр. — А хозя́ин — я.",
      "items": [
        {
          "text": "Пра́во у хозя́ина",
          "lemma": "пра́во у хозя́ина",
          "pos": "phr.",
          "en": "the household head has the right"
        },
        {
          "text": "хозя́ин",
          "lemma": "хозя́ин",
          "pos": "n.",
          "en": "household head",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s048": {
      "text": "Ты не плохо́й сын, Фёдор. Но земля́ не моя́ и не твоя́: она́ ми́ра.",
      "items": [
        {
          "text": "моя́",
          "lemma": "мой",
          "pos": "pron.",
          "en": "mine",
          "form": "nom. sg. f."
        },
        {
          "text": "твоя́",
          "lemma": "твой",
          "pos": "pron.",
          "en": "yours",
          "form": "nom. sg. f."
        }
      ]
    },
    "ru-mir-01-l09-s049": {
      "text": "— А моё пра́во, оте́ц? Мне на́до ждать? А вре́мя идёт!",
      "items": [
        {
          "text": "Мне на́до",
          "lemma": "на́до",
          "pos": "phr.",
          "en": "I need to"
        },
        {
          "text": "идёт",
          "lemma": "идти́",
          "pos": "v.",
          "en": "passes",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s050": {
      "text": "Тепе́рь все говоря́т гро́мко.",
      "items": [
        {
          "text": "говоря́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talk",
          "form": "pres. 3pl"
        }
      ]
    },
    "ru-mir-01-l09-s051": {
      "text": "И вот мужики́ уже́ не говоря́т, а крича́т.",
      "items": [
        {
          "text": "уже́ не",
          "lemma": "уже́ не",
          "pos": "phr.",
          "en": "no longer",
          "components": [
            {
              "text": "уже́",
              "lemma": "уже́",
              "pos": "adv.",
              "en": "any longer (with не)"
            }
          ]
        },
        {
          "text": "говоря́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talk",
          "form": "pres. 3pl"
        }
      ]
    },
    "ru-mir-01-l09-s052": {
      "text": "Над схо́дом стои́т крик.",
      "items": [
        {
          "text": "стои́т",
          "lemma": "стоя́ть",
          "pos": "v.",
          "en": "rises",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s053": {
      "text": "А Ша́рик лежи́т под теле́гой и слу́шает крик.",
      "items": [
        {
          "text": "крик",
          "lemma": "крик",
          "pos": "n.",
          "en": "shouting",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s056": {
      "text": "— Фёдор — си́льный мужи́к, — говори́т Сила́нтий. — Си́ла у него́ есть.",
      "items": [
        {
          "text": "Си́ла у него́ есть",
          "lemma": "си́ла у него́ есть",
          "pos": "phr.",
          "en": "he has strength"
        }
      ]
    },
    "ru-mir-01-l09-s057": {
      "text": "Он ду́мает свое́й голово́й и мо́жет рабо́тать оди́н.",
      "items": [
        {
          "text": "свое́й",
          "lemma": "свой",
          "pos": "det.",
          "en": "one's own",
          "form": "instr. sg. f.",
          "note": "Ду́мать свое́й голово́й: think for oneself."
        },
        {
          "text": "оди́н",
          "lemma": "оди́н",
          "pos": "adj.",
          "en": "alone",
          "form": "nom. sg. m."
        }
      ]
    },
    "ru-mir-01-l09-s058": {
      "text": "Мир — плохо́й хозя́ин.",
      "items": [
        {
          "text": "хозя́ин",
          "lemma": "хозя́ин",
          "pos": "n.",
          "en": "manager",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s060": {
      "text": "Молоды́е хозя́ева — то́же за Фёдора.",
      "items": [
        {
          "text": "Молоды́е",
          "lemma": "молодо́й",
          "pos": "adj.",
          "form": "nom. pl.",
          "en": "young"
        },
        {
          "text": "за",
          "lemma": "за",
          "pos": "prep.",
          "en": "in favour of"
        },
        {
          "text": "Фёдора",
          "lemma": "Фёдор",
          "pos": "prop. n.",
          "en": "Fyodor (brother)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s061": {
      "text": "— Пра́вда! — крича́т они́. — Хоро́шая земля́ — хоро́шему мужику́!",
      "items": [
        {
          "text": "Пра́вда",
          "lemma": "пра́вда",
          "pos": "part.",
          "en": "true!"
        }
      ]
    },
    "ru-mir-01-l09-s062": {
      "text": "А старики́ — за Петра́.",
      "items": [
        {
          "text": "за",
          "lemma": "за",
          "pos": "prep.",
          "en": "in favour of"
        },
        {
          "text": "Петра́",
          "lemma": "Пётр",
          "pos": "prop. n.",
          "en": "Pyotr (father)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s064": {
      "text": "— Говоря́т, что зако́н — от царя́. А земля́ — от Бо́га, Фёдор.",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "conj.",
          "en": "that"
        }
      ]
    },
    "ru-mir-01-l09-s065": {
      "text": "Она́ о́бщая: её нельзя́ купи́ть и прода́ть.",
      "items": [
        {
          "text": "её",
          "lemma": "она́",
          "pos": "pron.",
          "en": "it",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s066": {
      "text": "Мы на ней живём вме́сте и рабо́таем вме́сте.",
      "items": [
        {
          "text": "ней",
          "lemma": "она́",
          "pos": "pron.",
          "en": "it",
          "form": "prep. sg."
        }
      ]
    },
    "ru-mir-01-l09-s067": {
      "text": "— А земля́ Орло́ва? — кричи́т молодо́й мужи́к. — Её то́же на переде́л!",
      "items": [
        {
          "text": "Её",
          "lemma": "она́",
          "pos": "pron.",
          "en": "it",
          "form": "acc. sg. f."
        },
        {
          "text": "на",
          "lemma": "на",
          "pos": "prep.",
          "en": "for",
          "note": "Её то́же на переде́л!: redistribute his land too."
        }
      ]
    },
    "ru-mir-01-l09-s069": {
      "text": "— Земля́ Андре́я Серге́евича — не о́бщая, и э́то не де́ло о́бщины. Зако́н оди́н: и для него́, и для вас.",
      "items": [
        {
