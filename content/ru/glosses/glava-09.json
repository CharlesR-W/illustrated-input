          "text": "э́то его́ три рубля́",
          "lemma": "э́то его́ три рубля́",
          "pos": "phr.",
          "en": "that is Pyotr’s three roubles",
          "note": "The paper represents the land application and town stay paid for with Father’s money in Chapter 8.",
          "components": [
            {
              "text": "э́то",
              "lemma": "э́то",
              "pos": "pron.",
              "en": "that is",
              "form": "nom. sg. n."
            }
          ]
        }
      ]
    },
    "ru-mir-01-l09-s102": {
      "text": "— Мир реша́ет кри́ком? Хорошо́. Я иду́ с ней в уе́зд, в уе́здный го́род: там есть зако́н.",
      "items": [
        {
          "text": "ней",
          "lemma": "она́",
          "pos": "pron.",
          "en": "it",
          "form": "instr. sg."
        },
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "to"
        },
        {
          "text": "уе́зд",
          "lemma": "уе́зд",
          "pos": "n.",
          "en": "district",
          "form": "acc. sg."
        },
        {
          "text": "в",
          "lemma": "в",
          "pos": "prep.",
          "en": "to"
        },
        {
          "text": "уе́здный",
          "lemma": "уе́здный",
          "pos": "adj.",
          "en": "district",
          "form": "acc. sg. m.",
          "note": "Уе́здный го́род: district seat."
