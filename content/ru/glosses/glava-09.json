      "text": "На́стя смо́трит на Ива́на.",
      "items": [
        {
          "text": "Ива́на",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s116": {
