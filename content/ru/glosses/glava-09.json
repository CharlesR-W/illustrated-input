      "items": [
        {
          "text": "хлеб",
          "lemma": "хлеб",
          "pos": "n.",
          "en": "bread",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s117": {
      "text": "У него́ нет го́лоса, и ему́ хорошо́.",
      "items": [
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "there is no"
        },
        {
          "text": "ему́ хорошо́",
          "lemma": "ему́ хорошо́",
          "pos": "phr.",
          "en": "he is content"
        }
      ]
    },
    "ru-mir-01-l09-s073": {
      "text": "У це́ркви не оди́н мир, а два.",
      "items": [
        {
          "text": "не оди́н мир, а два",
          "lemma": "мир",
          "pos": "phr.",
          "en": "one commune divided into two camps",
          "note": "The young men back Fyodor; the old men back Pyotr."
