        },
        {
          "text": "за Фёдора сего́дня — одна́",
          "lemma": "за Фёдора",
          "pos": "phr.",
          "en": "one third backs Fyodor today",
          "components": [
            {
              "text": "за",
              "lemma": "за",
              "pos": "prep.",
              "en": "in favour of"
            },
            {
              "text": "Фёдора",
              "lemma": "Фёдор",
              "pos": "prop. n.",
              "en": "Fyodor (brother)",
              "form": "acc. sg."
            }
          ]
        }
      ]
    },
    "ru-mir-01-l09-s088": {
      "text": "Фёдор смо́трит на сход и ви́дит бра́та.",
      "items": [
        {
          "text": "сход",
          "lemma": "сход",
          "pos": "n.",
          "en": "village assembly",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s090": {
      "text": "Все смо́трят на Ива́на: и молоды́е, и старики́, и оте́ц.",
      "items": [
        {
          "text": "Ива́на",
          "lemma": "Ива́н",
          "pos": "prop. n.",
          "en": "Ivan (son)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s091": {
      "text": "— У меня́ нет го́лоса, — говори́т Ива́н.",
      "items": [
        {
          "text": "меня́",
          "lemma": "я",
          "pos": "pron.",
          "en": "me",
          "form": "gen. sg.",
          "note": "У меня́ нет: I have no."
        },
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "there is no"
        }
      ]
    },
    "ru-mir-01-l09-s092": {
      "text": "— Го́лоса нет, — говори́т Фёдор. — Но ты мой брат. С кем ты?",
      "items": [
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "there is no"
        }
      ]
    },
    "ru-mir-01-l09-s096": {
      "text": "— Я с семьёй, — говори́т Ива́н.",
      "items": [
        {
          "text": "семьёй",
          "lemma": "семья́",
          "pos": "n.",
          "en": "family",
          "form": "instr. sg."
        }
      ]
    },
    "ru-mir-01-l09-s097": {
      "text": "— С семьёй? — Фёдор смеётся, но ему́ не ве́село. — Я то́же семья́, Ва́ня!",
      "items": [
        {
          "text": "ему́ не ве́село",
          "lemma": "ему́ не ве́село",
          "pos": "phr.",
          "en": "he is unhappy"
        }
      ]
    },
    "ru-mir-01-l09-s098": {
      "text": "— Семья́ — э́то и мир, сын, — говори́т Пётр.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "и",
          "lemma": "и",
          "pos": "part.",
          "en": "also"
        }
      ]
    },
    "ru-mir-01-l09-s099": {
      "text": "Отцу́ э́то не нра́вится, и бра́ту не нра́вится.",
      "items": [
        {
          "text": "Отцу́ э́то не нра́вится",
          "lemma": "нра́виться",
          "pos": "phr.",
          "en": "father does not like this"
        },
        {
          "text": "бра́ту не нра́вится",
          "lemma": "нра́виться",
          "pos": "phr.",
          "en": "his brother does not like it"
        }
      ]
    },
    "ru-mir-01-l09-s101": {
      "text": "Пётр смо́трит на неё: э́то его́ три рубля́.",
      "items": [
        {
          "text": "неё",
          "lemma": "она́",
          "pos": "pron.",
          "en": "it",
          "form": "acc. sg."
        },
