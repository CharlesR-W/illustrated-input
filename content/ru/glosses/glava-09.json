          "lemma": "Пётр",
          "pos": "prop. n.",
          "en": "Pyotr (father)",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s111": {
      "text": "Вся семья́ вме́сте, вре́мя идёт, а в избе́ ти́хо.",
      "items": [
        {
          "text": "идёт",
          "lemma": "идти́",
          "pos": "v.",
          "en": "passes",
          "form": "pres. 3sg"
        },
