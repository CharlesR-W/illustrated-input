      ]
    },
    "ru-mir-01-l09-s109": {
      "text": "Пётр не говори́т с Фёдором, а Фёдор не говори́т с отцо́м.",
      "items": [
        {
          "text": "говори́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talks",
          "form": "pres. 3sg"
        },
        {
          "text": "говори́т",
          "lemma": "говори́ть",
          "pos": "v.",
          "en": "talks",
          "form": "pres. 3sg"
        }
      ]
    },
    "ru-mir-01-l09-s110": {
      "text": "Да́рья смо́трит на Фёдора, а мать — на Петра́.",
      "items": [
