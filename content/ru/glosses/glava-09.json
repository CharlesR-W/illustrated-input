          ]
        }
      ]
    },
    "ru-mir-01-l09-s075": {
      "text": "— Ти́хо, мужики́! — говори́т он. — Крича́ть мо́жно, а си́лой — нельзя́!",
      "items": [
        {
          "text": "Ти́хо",
          "lemma": "ти́хо",
          "pos": "adv.",
          "en": "quiet!"
        }
      ]
    },
    "ru-mir-01-l09-s076": {
      "text": "Мужики́ смо́трят на са́блю уря́дника — и стоя́т.",
      "items": [
        {
          "text": "стоя́т",
          "lemma": "стоя́ть",
          "pos": "v.",
          "en": "stand still",
          "form": "pres. 3pl"
        }
      ]
    },
    "ru-mir-01-l09-s077": {
      "text": "Ста́роста пи́шет ме́лом на доске́: «за» и «про́тив».",
      "items": [
        {
          "text": "за",
          "lemma": "за",
          "pos": "adv.",
          "en": "in favour"
        }
      ]
    },
    "ru-mir-01-l09-s078": {
      "text": "— Кто за? — спра́шивает он.",
      "items": [
        {
          "text": "за",
          "lemma": "за",
          "pos": "adv.",
          "en": "in favour"
        }
      ]
    },
    "ru-mir-01-l09-s079": {
      "text": "— За! — крича́т молоды́е и Сила́нтий.",
      "items": [
        {
          "text": "За",
          "lemma": "за",
          "pos": "adv.",
          "en": "in favour"
        }
      ]
    },
    "ru-mir-01-l09-s082": {
      "text": "Над це́рковью — крик: «Не дава́ть!»",
      "items": [
        {
          "text": "крик",
          "lemma": "крик",
          "pos": "n.",
          "en": "shouting",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s084": {
      "text": "— Мир не даёт, — говори́т ста́роста. — В э́том году́ — нет.",
      "items": [
        {
          "text": "даёт",
          "lemma": "дава́ть",
          "pos": "v.",
          "en": "grants permission",
          "form": "pres. 3sg"
        },
        {
          "text": "В э́том году́",
          "lemma": "в э́том году́",
          "pos": "phr.",
          "en": "this year"
        },
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "no permission"
        }
      ]
    },
    "ru-mir-01-l09-s085": {
      "text": "— А переде́л? — кричи́т молодо́й мужи́к.",
      "items": [
        {
          "text": "переде́л",
          "lemma": "переде́л",
          "pos": "n.",
          "en": "redistribution of land",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s086": {
      "text": "— Переде́л — друго́й вопро́с, и сейча́с не вре́мя, — отвеча́ет ста́роста.",
      "items": [
        {
          "text": "Переде́л",
          "lemma": "переде́л",
          "pos": "n.",
          "en": "redistribution of land",
          "form": "nom. sg."
        }
      ]
    },
    "ru-mir-01-l09-s087": {
      "text": "— Сход — э́то три ча́сти. На переде́л ну́жно две ча́сти, а за Фёдора сего́дня — одна́.",
      "items": [
        {
          "text": "э́то",
          "lemma": "э́то",
          "pos": "part.",
          "en": "is"
        },
        {
          "text": "три ча́сти",
          "lemma": "три ча́сти",
          "pos": "phr.",
          "en": "three equal thirds",
          "note": "Think of the voting household heads in three equal groups."
        },
        {
          "text": "На переде́л ну́жно две ча́сти",
          "lemma": "переде́л / две ча́сти",
          "pos": "phr.",
          "en": "redistribution needs two thirds",
          "note": "This threshold concerns redistribution, a separate question from Fyodor’s request.",
          "components": [
            {
              "text": "На",
              "lemma": "на",
              "pos": "prep.",
              "en": "for"
