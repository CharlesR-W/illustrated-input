          "en": "town, city",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s103": {
      "text": "Ве́чером Соколо́вы сидя́т за столо́м.",
      "items": [
        {
          "text": "за",
          "lemma": "за",
          "pos": "prep.",
          "en": "at"
        }
      ]
    },
    "ru-mir-01-l09-s107": {
      "text": "Мать даёт хлеб и капу́сту.",
      "items": [
        {
          "text": "даёт",
          "lemma": "дава́ть",
          "pos": "v.",
          "en": "serves",
          "form": "pres. 3sg"
        },
        {
          "text": "хлеб",
          "lemma": "хлеб",
          "pos": "n.",
          "en": "bread",
          "form": "acc. sg."
        }
      ]
    },
    "ru-mir-01-l09-s108": {
      "text": "Все ти́хо едя́т, то́лько Пётр не ест: голова́ у него́ в рука́х.",
      "items": [
        {
          "text": "голова́ у него́ в рука́х",
          "lemma": "голова́ у него́ в рука́х",
          "pos": "phr.",
          "en": "he holds his head in his hands"
