    "ru-mir-01-l10-s070": {
      "text": "Но настоя́щего манифе́ста не́ было.",
      "items": [
        {
          "text": "настоя́щего манифе́ста не́ было",
          "lemma": "настоя́щего манифе́ста не́ было",
