    "ru-mir-01-l10-s060": {
      "text": "Во́ля пришла́, а хоро́шая земля́ — нет.",
      "items": [
        {
          "text": "нет",
          "lemma": "нет",
          "pos": "part.",
          "en": "did not come"
        }
      ]
    },
    "ru-mir-01-l10-s061": {
      "text": "Зе́млю нам да́ли, но плоху́ю: на хоро́шей земле́ мы ра́ньше рабо́тали, а тепе́рь она́ была́ то́лько ба́рина.",
