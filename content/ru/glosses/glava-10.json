          "en": "three",
          "form": "acc."
        },
        {
          "text": "свое́й",
          "lemma": "свой",
          "pos": "det.",
          "en": "one's own",
          "form": "prep. sg. f."
        }
      ]
    },
    "ru-mir-01-l10-s034": {
      "text": "Жить мы могли́ то́лько здесь. В Москву́ — то́лько с бума́гой ба́рина.",
      "items": [
        {
          "text": "В",
