          "en": "like"
        }
      ]
    },
    "ru-mir-01-l10-s028": {
      "text": "В мо́лодости я был си́льный, как Фе́дя.",
      "items": [
        {
          "text": "как",
          "lemma": "как",
          "pos": "conj.",
          "en": "like"
        }
      ]
    },
    "ru-mir-01-l10-s031": {
      "text": "Земля́ была́ ба́рина, и мы бы́ли его́ лю́ди.",
      "items": [
        {
          "text": "ба́рина",
          "lemma": "ба́рин",
          "pos": "n.",
          "en": "master, landowner",
          "form": "gen. sg."
        }
      ]
    },
    "ru-mir-01-l10-s032": {
      "text": "Три дня в неде́лю мы рабо́тали на ба́рина, а три дня — на свое́й земле́.",
