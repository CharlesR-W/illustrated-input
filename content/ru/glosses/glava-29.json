  "lesson_id": "ru-mir-01-l29",
  "segments": {
    "ru-mir-01-l29-s014": {
      "text": "Хле́ба не́ было: вме́сто хле́ба дава́ли сухари́, и их приходи́лось есть с водо́й.",
      "items": [
        {
          "text": "есть",
          "lemma": "есть",
          "pos": "v.",
          "form": "inf. ipf.",
          "en": "to eat"
        }
      ]
    },
    "ru-mir-01-l29-s024": {
      "text": "По вечера́м Ива́н чита́л вслух, как о́сенью, но тепе́рь слу́шать хоте́лось ме́ньше: всем хоте́лось есть.",
      "items": [
        {
          "text": "есть",
          "lemma": "есть",
          "pos": "v.",
          "form": "inf. ipf.",
          "en": "to eat"
        }
      ]
    },
    "ru-mir-01-l29-s029": {
      "text": "— Я хочу́ есть, — сказа́л он.",
      "items": [
        {
          "text": "есть",
          "lemma": "есть",
          "pos": "v.",
          "form": "inf. ipf.",
          "en": "to eat"
        }
      ]
    },
    "ru-mir-01-l29-s030": {
      "text": "— Всем хо́чется, — отве́тил Семён. — А есть не́чего.",
      "items": [
        {
          "text": "есть не́чего",
          "lemma": "есть не́чего",
          "pos": "phr.",
          "en": "there is nothing to eat",
          "components": [
            {
              "text": "есть",
              "lemma": "есть",
              "pos": "v.",
              "form": "inf. ipf.",
              "en": "to eat"
            },
            {
              "text": "не́чего",
              "lemma": "не́чего",
              "pos": "pron.",
              "form": "+ inf.",
              "en": "nothing (to eat)"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l29-s044": {
      "text": "На ста́нции одна́ ба́ба продава́ла карто́шку так до́рого, что никто́ не покупа́л. А в магази́не мне сказа́ли: «Со́ли нет и не бу́дет».",
      "items": [
        {
          "text": "одна́",
          "lemma": "оди́н",
          "pos": "det.",
          "form": "nom. sg. f.",
          "en": "a (certain)"
        },
        {
          "text": "так",
          "lemma": "так",
          "pos": "adv.",
          "en": "so"
        }
      ]
    },
    "ru-mir-01-l29-s049": {
      "text": "— Ты что не спишь?",
      "items": [
        {
          "text": "что",
          "lemma": "что",
          "pos": "pron.",
          "form": "colloquial",
          "en": "why"
        }
      ]
    },
    "ru-mir-01-l29-s050": {
      "text": "— Не спи́тся, — отве́тил Про́ша. — Я хочу́ спать, а мне не спи́тся. Всё ду́маю о до́ме.",
      "items": [
        {
          "text": "Всё",
          "lemma": "всё",
          "pos": "adv.",
          "en": "all the time, keep (doing)"
        }
      ]
    },
    "ru-mir-01-l29-s052": {
      "text": "— В де́тстве я ле́том спал на лугу́, на траве́. Со́лнце, ве́тер… И мне всегда́ спало́сь. А тепе́рь не спи́тся.",
      "items": [
        {
          "text": "спало́сь",
          "lemma": "спа́ться",
          "pos": "v.",
          "form": "past n. ipf., impersonal",
          "en": "I slept well"
        }
      ]
    },
    "ru-mir-01-l29-s053": {
      "text": "Мать до́ма одна́, одино́кая. Ле́том ей пришло́ извеще́ние, что я ра́нен. Тепе́рь пи́шет, что дров нет и печь топи́ть не́чем. Мне хо́чется домо́й, Ва́ня.",
      "items": [
        {
          "text": "одна́",
          "lemma": "оди́н",
          "pos": "adj.",
          "form": "nom. sg. f.",
          "en": "alone"
        }
      ]
    },
    "ru-mir-01-l29-s056": {
      "text": "Ива́ну то́же не спало́сь.",
      "items": [
        {
          "text": "не спало́сь",
          "lemma": "не спа́ться",
          "pos": "phr.",
          "en": "could not get to sleep"
        }
      ]
    },
    "ru-mir-01-l29-s059": {
      "text": "«У нас тепе́рь за хле́бом хвосты́.",
      "items": [
        {
          "text": "за хле́бом",
          "lemma": "за хле́бом",
          "pos": "phr.",
          "en": "for bread (to fetch bread)"
        }
      ]
    },
    "ru-mir-01-l29-s061": {
      "text": "Мы не голода́ем, но де́ти боле́ют и всё вре́мя хотя́т есть.",
      "items": [
        {
          "text": "есть",
          "lemma": "есть",
          "pos": "v.",
          "form": "inf. ipf.",
          "en": "to eat"
        }
      ]
    },
    "ru-mir-01-l29-s064": {
      "text": "— Вот вам Петрогра́д: же́нщины в хвоста́х, а рабо́чие на войне́, — сказа́л он.",
      "items": [
        {
          "text": "Вот вам",
          "lemma": "вот вам",
          "pos": "phr.",
          "en": "there you have (it), that's … for you"
        }
      ]
    },
    "ru-mir-01-l29-s070": {
      "text": "Хлеб у нас есть, а купи́ть не́чего: в ла́вке пу́сто, нет ни со́ли, ни са́хара.",
      "items": [
        {
          "text": "купи́ть не́чего",
          "lemma": "купи́ть не́чего",
          "pos": "phr.",
          "en": "there is nothing to buy",
          "components": [
            {
              "text": "не́чего",
              "lemma": "не́чего",
              "pos": "pron.",
              "form": "+ inf.",
              "en": "nothing (to buy)"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l29-s080": {
      "text": "Он ду́мал: Сила́нтий — как спекуля́нты, о кото́рых говори́л Про́ша.",
      "items": [
        {
          "text": "как",
          "lemma": "как",
          "pos": "conj.",
          "en": "like"
        }
      ]
    },
    "ru-mir-01-l29-s087": {
      "text": "— Зна́ет, — сказа́л Семён. — Всё он зна́ет. То́лько ему́ нас не жаль.",
      "items": [
        {
          "text": "ему́ нас не жаль",
          "lemma": "жаль",
          "pos": "phr.",
          "en": "he feels no pity for us"
        }
      ]
    },
    "ru-mir-01-l29-s102": {
      "text": "— На, пей, — сказа́л Ива́н. — Согре́йся, а то отморо́зишь но́ги.",
      "items": [
        {
          "text": "На",
          "lemma": "на",
          "pos": "interj.",
          "en": "here, take it"
        }
      ]
    },
    "ru-mir-01-l29-s106": {
      "text": "— Есть не́чего, — сказа́л Про́ша. — Спроси́ть не́кого. Согре́ться не́где. Како́й смысл тут стоя́ть? Я бо́льше не вы́держу.",
      "items": [
        {
          "text": "Есть не́чего",
          "lemma": "есть не́чего",
          "pos": "phr.",
          "en": "there is nothing to eat",
          "components": [
            {
              "text": "Есть",
              "lemma": "есть",
              "pos": "v.",
              "form": "inf. ipf.",
              "en": "to eat"
            },
            {
              "text": "не́чего",
              "lemma": "не́чего",
              "pos": "pron.",
              "form": "+ inf.",
              "en": "nothing (to eat)"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l29-s121": {
      "text": "— Всем пло́хо, а мне ху́же. Мне тебя́ жаль, Ва́ня: тебе́ за меня́ отвеча́ть.",
      "items": [
        {
          "text": "Мне тебя́ жаль",
          "lemma": "жаль",
          "pos": "phr.",
          "en": "I feel sorry for you"
        }
      ]
    },
    "ru-mir-01-l29-s141": {
      "text": "Про́ша покрасне́л от стыда́, и Ива́ну бы́ло жаль его́.",
      "items": [
        {
          "text": "бы́ло жаль",
          "lemma": "жаль",
          "pos": "phr.",
          "en": "felt sorry (for)"
        }
      ]
    },
    "ru-mir-01-l29-s165": {
      "text": "Ра́ньше они́ не жа́ловались и говори́ли: «Ничего́, поте́рпим».",
      "items": [
        {
          "text": "Ничего́",
          "lemma": "ничего́",
          "pos": "adv.",
          "form": "predicative",
          "en": "never mind, it will be all right"
        }
      ]
    }
  }
}
