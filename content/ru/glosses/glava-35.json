{
  "schema_version": 1,
  "lesson_id": "ru-mir-01-l35",
  "segments": {
    "ru-mir-01-l35-s003": {
      "text": "Ива́н чита́л его́ в око́пе, под дождём. Бума́га ста́ла мо́крой, но он прочита́л всё.",
      "items": [
        {
          "text": "ста́ла мо́крой",
          "lemma": "стать",
          "pos": "v.",
          "en": "became (wet)",
          "form": "past sg. f. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s007": {
      "text": "Всё тепе́рь до́рого: хлеб, соль, са́хар. Це́ны ка́ждый ме́сяц стано́вятся вы́ше.",
      "items": [
        {
          "text": "стано́вятся вы́ше",
          "lemma": "станови́ться",
          "pos": "v.",
          "en": "are getting higher",
          "form": "pres. 3 pl. ipf."
        }
      ]
    },
    "ru-mir-01-l35-s011": {
      "text": "— Де́лят зе́млю, — повтори́л Ахме́т. — Без нас разде́лят, Ива́н.",
      "items": [
        {
          "text": "Без нас",
          "lemma": "без",
          "pos": "prep.",
          "en": "without us"
        }
      ]
    },
    "ru-mir-01-l35-s015": {
      "text": "Иногда́ приезжа́л комисса́р. Одна́жды он вы́ступил пе́ред полко́м и говори́л о ми́ре без анне́ксий и контрибу́ций, но его́ выступле́ния почти́ никто́ не слу́шал.",
      "items": [
        {
          "text": "о ми́ре",
          "lemma": "мир",
          "pos": "n.",
          "en": "(about) peace",
          "form": "prep. sg."
        },
        {
          "text": "без анне́ксий и контрибу́ций",
          "lemma": "без анне́ксий и контрибу́ций",
          "pos": "phr.",
          "en": "without annexations or indemnities (the 1917 peace slogan)"
        }
      ]
    },
    "ru-mir-01-l35-s016": {
      "text": "Комисса́ры выступа́ли, а солда́ты, как то́лько они́ уезжа́ли, опя́ть говори́ли о земле́.",
      "items": [
        {
          "text": "как то́лько",
          "lemma": "как то́лько",
          "pos": "conj.",
          "en": "as soon as"
        }
      ]
    },
    "ru-mir-01-l35-s017": {
      "text": "Ка́ждую ночь кто-нибудь уходи́л из око́пов тайко́м, без докуме́нтов.",
      "items": [
        {
          "text": "кто-нибудь",
          "lemma": "кто-нибудь",
          "pos": "pron.",
          "en": "someone or other"
        }
      ]
    },
    "ru-mir-01-l35-s019": {
      "text": "Ка́ждое у́тро Козло́в де́лал прове́рку: обходи́л око́п и счита́л люде́й. Чем да́льше, тем ме́ньше их станови́лось.",
      "items": [
        {
          "text": "счита́л люде́й",
          "lemma": "счита́ть",
          "pos": "v.",
          "en": "counted (the men)",
          "form": "past sg. m. ipf.",
          "components": [
            {
              "text": "люде́й",
              "lemma": "лю́ди",
              "pos": "n.",
              "form": "acc. pl.",
              "en": "people, men"
            }
          ]
        },
        {
          "text": "Чем да́льше, тем ме́ньше",
          "lemma": "чем …, тем …",
          "pos": "phr.",
          "en": "the further it went, the fewer"
        }
      ]
    },
    "ru-mir-01-l35-s028": {
      "text": "Ива́н то́же навоева́лся. Но е́сли он уйдёт, кем он ста́нет?",
      "items": [
        {
          "text": "кем он ста́нет",
          "lemma": "стать",
          "pos": "v.",
          "en": "what will he become",
          "form": "fut. 3 sg. pf. + instr.",
          "components": [
            {
              "text": "кем",
              "lemma": "кто",
              "pos": "pron.",
              "form": "instr.",
              "en": "(as) what, who"
            },
            {
              "text": "он",
              "lemma": "он",
              "pos": "pron.",
              "en": "he"
            },
            {
              "text": "ста́нет",
              "lemma": "стать",
              "pos": "v.",
              "form": "fut. 3 sg. pf.",
              "en": "will become"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l35-s031": {
      "text": "Дезерти́рами он счита́л всех, кто ушёл.",
      "items": [
        {
          "text": "счита́л всех",
          "lemma": "счита́ть",
          "pos": "v.",
          "en": "considered (+ instr.)",
          "form": "past sg. m. ipf.",
          "components": [
            {
              "text": "счита́л",
              "lemma": "счита́ть",
              "pos": "v.",
              "form": "past sg. m. ipf.",
              "en": "considered"
            },
            {
              "text": "всех",
              "lemma": "весь",
              "pos": "pron.",
              "form": "acc. pl.",
              "en": "everyone"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l35-s036": {
      "text": "Так как секретарём был Ива́н, бума́ги он писа́л сам: два отпускны́х биле́та, себе́ и Ахме́ту.",
      "items": [
        {
          "text": "Так как",
          "lemma": "так как",
          "pos": "conj.",
          "en": "since, because"
        },
        {
          "text": "отпускны́х биле́та",
          "lemma": "отпускно́й биле́т",
          "pos": "phr.",
          "en": "leave passes",
          "form": "gen. sg. after два"
        }
      ]
    },
    "ru-mir-01-l35-s039": {
      "text": "Пра́порщик до́лго проверя́л отпускны́е биле́ты, как бу́дто они́ бы́ли напи́саны не по-ру́сски.",
      "items": [
        {
          "text": "отпускны́е биле́ты",
          "lemma": "отпускно́й биле́т",
          "pos": "phr.",
          "en": "leave passes",
          "form": "acc. pl."
        },
        {
          "text": "как бу́дто",
          "lemma": "как бу́дто",
          "pos": "conj.",
          "en": "as if"
        }
      ]
    },
    "ru-mir-01-l35-s043": {
      "text": "— Е́сли вы уйдёте, вас бу́дут счита́ть дезерти́рами. А за бе́гство бу́дет суд.",
      "items": [
        {
          "text": "счита́ть дезерти́рами",
          "lemma": "счита́ть",
          "pos": "v.",
          "en": "consider (you) deserters",
          "form": "inf. ipf. + instr.",
          "components": [
            {
              "text": "счита́ть",
              "lemma": "счита́ть",
              "pos": "v.",
              "form": "inf. ipf.",
              "en": "to consider"
            },
            {
              "text": "дезерти́рами",
              "lemma": "дезерти́р",
              "pos": "n.",
              "form": "instr. pl.",
              "en": "deserters"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l35-s046": {
      "text": "Несмотря́ на слова́ Семёна, сомне́ние у Ива́на оста́лось. Э́то был уже́ тре́тий отка́з: на Па́сху, в ию́не и сейча́с.",
      "items": [
        {
          "text": "Несмотря́ на",
          "lemma": "несмотря́ на",
          "pos": "prep.",
          "en": "in spite of (+ acc.)"
        }
      ]
    },
    "ru-mir-01-l35-s050": {
      "text": "— Е́дем, Ахме́т, — сказа́л он. — Мы три го́да бы́ли солда́тами. Пора́ опя́ть стать мужика́ми.",
      "items": [
        {
          "text": "стать мужика́ми",
          "lemma": "стать",
          "pos": "v.",
          "en": "to become peasants (again)",
          "form": "inf. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s053": {
      "text": "Ива́н смотре́л на него́, как бу́дто ви́дел его́ в пе́рвый раз. Семён вдруг каза́лся ему́ други́м челове́ком: не солда́том, а челове́ком из большо́го го́рода, где Ива́н никогда́ не был.",
      "items": [
        {
          "text": "как бу́дто",
          "lemma": "как бу́дто",
          "pos": "conj.",
          "en": "as if"
        }
      ]
    },
    "ru-mir-01-l35-s054": {
      "text": "Там у Семёна бу́дет друга́я жизнь, и, мо́жет быть, больша́я.",
      "items": [
        {
          "text": "мо́жет быть",
          "lemma": "мо́жет быть",
          "pos": "phr.",
          "en": "perhaps"
        }
      ]
    },
    "ru-mir-01-l35-s061": {
      "text": "Ива́н вспо́мнил, как на Па́сху они́ похристо́совались: «Христо́с воскре́се!» — «Вои́стину воскре́се!»",
      "items": [
        {
          "text": "Христо́с воскре́се",
          "lemma": "Христо́с воскре́се",
          "pos": "phr.",
          "en": "Christ is risen (Easter greeting)"
        },
        {
          "text": "Вои́стину воскре́се",
          "lemma": "вои́стину воскре́се",
          "pos": "phr.",
          "en": "He is risen indeed (Easter response)"
        }
      ]
    },
    "ru-mir-01-l35-s062": {
      "text": "Так они́ расста́лись и с Козло́вым. До ста́нции бы́ло со́рок вёрст, и шли пешко́м.",
      "items": [
        {
          "text": "и шли пешко́м",
          "lemma": "идти́",
          "pos": "v.",
          "en": "and they went on foot",
          "form": "past pl. ipf."
        }
      ]
    },
    "ru-mir-01-l35-s063": {
      "text": "Шли два дня, по гря́зи и под дождём, и дошли́ до ста́нции то́лько на второ́й ве́чер.",
      "items": [
        {
          "text": "Шли два дня",
          "lemma": "идти́",
          "pos": "v.",
          "en": "they walked (for two days)",
          "form": "past pl. ipf."
        }
      ]
    },
    "ru-mir-01-l35-s065": {
      "text": "Как то́лько подходи́л по́езд, толпа́ бежа́ла к ваго́нам. Ваго́ны бра́ли, как око́п в бою́. Заходи́ли и в две́ри, и в о́кна.",
      "items": [
        {
          "text": "Как то́лько",
          "lemma": "как то́лько",
          "pos": "conj.",
          "en": "as soon as"
        }
      ]
    },
    "ru-mir-01-l35-s069": {
      "text": "Но́чью на кры́ше был тако́й хо́лод, что они́ не спа́ли, а то́лько мёрзли. Шине́ли ста́ли мо́крыми от дождя́.",
      "items": [
        {
          "text": "ста́ли мо́крыми",
          "lemma": "стать",
          "pos": "v.",
          "en": "became wet",
          "form": "past pl. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s072": {
      "text": "Есть бы́ло не́чего: хлеб ко́нчился на второ́й день. Они́ кури́ли махо́рку, а когда́ таба́к ко́нчился, есть хоте́лось ещё бо́льше.",
      "items": [
        {
          "text": "Есть бы́ло не́чего",
          "lemma": "есть",
          "pos": "phr.",
          "en": "there was nothing to eat",
          "components": [
            {
              "text": "Есть",
              "lemma": "есть",
              "pos": "v.",
              "form": "inf.",
              "en": "to eat"
            },
            {
              "text": "бы́ло",
              "lemma": "быть",
              "pos": "v.",
              "form": "past sg. n.",
              "en": "was"
            },
            {
              "text": "не́чего",
              "lemma": "не́чего",
              "pos": "pron.",
              "en": "nothing (to)"
            }
          ]
        },
        {
          "text": "есть хоте́лось",
          "lemma": "хоте́ться",
          "pos": "v.",
          "en": "they wanted to eat",
          "form": "past sg. n. impers.",
          "components": [
            {
              "text": "есть",
              "lemma": "есть",
              "pos": "v.",
              "form": "inf.",
              "en": "to eat"
            },
            {
              "text": "хоте́лось",
              "lemma": "хоте́ться",
              "pos": "v.",
              "form": "past sg. n.",
              "en": "one wanted"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l35-s083": {
      "text": "Офице́р был уже́ не молодо́й. Он прочита́л их отпускны́е биле́ты и по́днял их, что́бы ви́дели все.",
      "items": [
        {
          "text": "отпускны́е биле́ты",
          "lemma": "отпускно́й биле́т",
          "pos": "phr.",
          "en": "leave passes",
          "form": "acc. pl."
        }
      ]
    },
    "ru-mir-01-l35-s085": {
      "text": "Так их отпускны́е биле́ты оказа́лись про́сто бума́гой.",
      "items": [
        {
          "text": "отпускны́е биле́ты",
          "lemma": "отпускно́й биле́т",
          "pos": "phr.",
          "en": "leave passes",
          "form": "acc. pl."
        }
      ]
    },
    "ru-mir-01-l35-s088": {
      "text": "Но солда́ты патруля́ смотре́ли в сто́рону, как бу́дто ничего́ не слы́шали.",
      "items": [
        {
          "text": "как бу́дто",
          "lemma": "как бу́дто",
          "pos": "conj.",
          "en": "as if"
        }
      ]
    },
    "ru-mir-01-l35-s096": {
      "text": "Когда́ по́езд пошёл, Ахме́т на́чал счита́ть по па́льцам.",
      "items": [
        {
          "text": "счита́ть по па́льцам",
          "lemma": "счита́ть",
          "pos": "v.",
          "en": "to count on his fingers",
          "form": "inf. ipf.",
          "components": [
            {
              "text": "счита́ть",
              "lemma": "счита́ть",
              "pos": "v.",
              "form": "inf. ipf.",
              "en": "to count"
            },
            {
              "text": "по",
              "lemma": "по",
              "pos": "prep.",
              "en": "on"
            },
            {
              "text": "па́льцам",
              "lemma": "па́лец",
              "pos": "n.",
              "form": "dat. pl.",
              "en": "fingers"
            }
          ]
        }
      ]
    },
    "ru-mir-01-l35-s099": {
      "text": "— Ты в са́мом де́ле стал геро́й?",
      "items": [
        {
          "text": "в са́мом де́ле",
          "lemma": "в са́мом де́ле",
          "pos": "phr.",
          "en": "really, indeed"
        },
        {
          "text": "стал геро́й",
          "lemma": "стать",
          "pos": "v.",
          "en": "became a hero (Ahmet's slip: стать takes the instrumental, геро́ем)",
          "form": "past sg. m. pf. + nom. (error)"
        }
      ]
    },
    "ru-mir-01-l35-s100": {
      "text": "— Геро́ем, — испра́вил Ива́н. — Нет, не стал. Я стал голо́дным.",
      "items": [
        {
          "text": "не стал",
          "lemma": "стать",
          "pos": "v.",
          "en": "(no,) did not become",
          "form": "past sg. m. pf."
        },
        {
          "text": "стал голо́дным",
          "lemma": "стать",
          "pos": "v.",
          "en": "became hungry",
          "form": "past sg. m. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s101": {
      "text": "И он съел ещё карто́шки. А сам ду́мал: в са́мом де́ле, кем?",
      "items": [
        {
          "text": "в са́мом де́ле",
          "lemma": "в са́мом де́ле",
          "pos": "phr.",
          "en": "really, indeed"
        }
      ]
    },
    "ru-mir-01-l35-s104": {
      "text": "Пре́жде чем расста́ться, они́ посиде́ли на ста́нции и поговори́ли. На ста́нции дава́ли кипято́к, и Ахме́т угости́л Ива́на после́дним са́харом.",
      "items": [
        {
          "text": "Пре́жде чем",
          "lemma": "пре́жде чем",
          "pos": "conj.",
          "en": "before (doing)"
        }
      ]
    },
    "ru-mir-01-l35-s121": {
      "text": "Пе́рвым его́ встре́тил Ша́рик. Он стал ста́рым и се́рым и бежа́л ме́дленно, но узна́л Ива́на сра́зу.",
      "items": [
        {
          "text": "Пе́рвым",
          "lemma": "пе́рвый",
          "pos": "adj.",
          "en": "first (the first to leave)",
          "form": "instr. sg. m."
        },
        {
          "text": "стал ста́рым",
          "lemma": "стать",
          "pos": "v.",
          "en": "had become old",
          "form": "past sg. m. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s123": {
      "text": "Дере́вня ста́ла друго́й и каза́лась ме́ньше, чем ра́ньше.",
      "items": [
        {
          "text": "ста́ла друго́й",
          "lemma": "стать",
          "pos": "v.",
          "en": "had become different",
          "form": "past sg. f. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s126": {
      "text": "— Два́дцать лет я был вла́стью, а стал мужико́м, как все. В мили́цию меня́ не взя́ли. Сам не зна́ю, кто я тепе́рь. Как и ты, наве́рное.",
      "items": [
        {
          "text": "стал мужико́м",
          "lemma": "стать",
          "pos": "v.",
          "en": "became a peasant",
          "form": "past sg. m. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s127": {
      "text": "— В са́мом де́ле с фро́нта? А ты насовсе́м?",
      "items": [
        {
          "text": "В са́мом де́ле",
          "lemma": "в са́мом де́ле",
          "pos": "phr.",
          "en": "really, indeed"
        }
      ]
    },
    "ru-mir-01-l35-s129": {
      "text": "— Ста́роста Его́р стал председа́телем волостно́го земе́льного комите́та, — сказа́л Гаври́лов.",
      "items": [
        {
          "text": "стал председа́телем",
          "lemma": "стать",
          "pos": "v.",
          "en": "has become chairman",
          "form": "past sg. m. pf. + instr."
        }
      ]
    },
    "ru-mir-01-l35-s137": {
      "text": "Ми́мо шко́лы он шёл ме́дленно. Вы́веска была́ та же, ста́рая, а в окне́ горе́л свет: Ве́ра Никола́евна была́ там.",
      "items": [
        {
          "text": "та же",
          "lemma": "тот же",
          "pos": "pron.",
          "en": "the same",
          "form": "nom. sg. f."
        }
      ]
    },
    "ru-mir-01-l35-s139": {
      "text": "Мать стоя́ла в дверя́х. Она́ не крича́ла и не пла́кала, а то́лько смотре́ла.",
      "items": [
        {
          "text": "Мать стоя́ла в дверя́х",
          "lemma": "мать",
